--!strict
local t = require("./harness")
local Format = require("../src/shared/Pure/Format")

t.describe("Format.comma", function()
	t.it("세 자리마다 쉼표를 넣는다", function()
		t.expectEqual(Format.comma(0), "0")
		t.expectEqual(Format.comma(7), "7")
		t.expectEqual(Format.comma(100), "100")
		t.expectEqual(Format.comma(1000), "1,000")
		t.expectEqual(Format.comma(999999), "999,999")
		t.expectEqual(Format.comma(1234567), "1,234,567")
	end)

	t.it("음수 부호를 유지한다", function()
		t.expectEqual(Format.comma(-1500), "-1,500")
	end)

	t.it("소수는 반올림한다", function()
		t.expectEqual(Format.comma(1234.6), "1,235")
		t.expectEqual(Format.comma(1234.4), "1,234")
	end)
end)

t.describe("Format.percent", function()
	t.it("정수는 소수점을 생략한다", function()
		t.expectEqual(Format.percent(20), "20%")
		t.expectEqual(Format.percent(0), "0%")
	end)

	t.it("소수는 자릿수를 맞춘다", function()
		t.expectEqual(Format.percent(12.34), "12.3%")
		t.expectEqual(Format.percent(12.34, 2), "12.34%")
	end)
end)

t.describe("Format.level", function()
	t.it("강화 레벨을 +N 으로 쓴다", function()
		t.expectEqual(Format.level(0), "+0")
		t.expectEqual(Format.level(20), "+20")
	end)
end)

t.describe("Format.duration", function()
	t.it("분:초 형식", function()
		t.expectEqual(Format.duration(65), "1:05")
		t.expectEqual(Format.duration(9), "0:09")
	end)

	t.it("한 시간이 넘으면 시:분:초", function()
		t.expectEqual(Format.duration(3725), "1:02:05")
	end)

	t.it("음수는 0 으로 처리한다", function()
		t.expectEqual(Format.duration(-10), "0:00")
	end)
end)

t.describe("Format.short", function()
	t.it("한국어: 만 아래는 그대로, 위는 만·억·조", function()
		t.expectEqual(Format.short(0, "ko"), "0")
		t.expectEqual(Format.short(9999, "ko"), "9,999")
		t.expectEqual(Format.short(12000, "ko"), "1.2만")
		t.expectEqual(Format.short(510000, "ko"), "51만")
		t.expectEqual(Format.short(1234567, "ko"), "123만")
		t.expectEqual(Format.short(491535000, "ko"), "4.9억")
		t.expectEqual(Format.short(1048577000, "ko"), "10.5억")
		t.expectEqual(Format.short(25021455666, "ko"), "250억")
		t.expectEqual(Format.short(3.2e12, "ko"), "3.2조")
	end)

	t.it("영어: K·M·B·T", function()
		t.expectEqual(Format.short(999, "en"), "999")
		t.expectEqual(Format.short(1200, "en"), "1.2K")
		t.expectEqual(Format.short(120000, "en"), "120K")
		t.expectEqual(Format.short(1234567, "en"), "1.2M")
		t.expectEqual(Format.short(1048577000, "en"), "1.05B")
		t.expectEqual(Format.short(2e12, "en"), "2T")
	end)

	t.it("반올림으로 단위가 꽉 차면 위 단위로 올린다", function()
		t.expectEqual(Format.short(99999999, "ko"), "1억")
		t.expectEqual(Format.short(999999, "en"), "1M")
	end)

	t.it("끝의 0 은 떼고 음수는 부호를 붙인다", function()
		t.expectEqual(Format.short(20000, "ko"), "2만")
		t.expectEqual(Format.short(-15000, "ko"), "-1.5만")
		t.expectEqual(Format.short(-500, "en"), "-500")
	end)

	t.it("언어를 모르면 한국어 규칙", function()
		t.expectEqual(Format.short(12000, nil), "1.2만")
	end)
end)
