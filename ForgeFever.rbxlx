		["error.maintenance"] = "The forge is closed for maintenance.",
		["error.invalid_argument"] = "That request makes no sense.",
		["error.banned"] = "You are barred from the forge.",
		["error.unknown"] = "Something went wrong.",
		["error.load_fail"] = "Could not load your data. Please rejoin.",
		["error.session_end"] = "Your data was opened on another server. Please rejoin.",
	},
} :: { [string]: { [string]: string } }

--[[
	키를 해당 언어의 문자열로 바꾼다.
	해당 언어에 키가 없으면 기본 언어로, 그것도 없으면 키 자체를 돌려준다
	(빈 화면 대신 무엇이 빠졌는지 보이도록).
]]
function Locale.get(language: string?, key: string, ...: any): string
	local lang = language or Locale.DEFAULT_LANGUAGE
	local table_ = Locale.Strings[lang] or Locale.Strings[Locale.DEFAULT_LANGUAGE]
	local template = table_[key] or Locale.Strings[Locale.DEFAULT_LANGUAGE][key]

	if not template then
		return key
	end

	if select("#", ...) == 0 then
		return template
	end

	local ok, formatted = pcall(string.format, template, ...)
	return if ok then formatted else template
end

-- 같은 접두사를 가진 변형 중 하나를 고른다. (예: "feed.success" → feed.success.1~3)
-- 연출용 문구 선택이라 클라이언트에서 뽑아도 되는 값이다.
function Locale.variantCount(language: string?, prefix: string): number
	local lang = language or Locale.DEFAULT_LANGUAGE
	local table_ = Locale.Strings[lang] or Locale.Strings[Locale.DEFAULT_LANGUAGE]

	local count = 0
	while table_[`{prefix}.{count + 1}`] ~= nil do
		count += 1
	end
	return count
end

return Locale
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="11">
        <Properties>
          <string name="Name">Pure</string>
        </Properties>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">BattleLogic</string>
            <string name="Source"><![CDATA[--!strict
--[[
	BattleLogic — 배틀 승률·보상·레이팅 계산의 순수 함수.

	원칙은 EnhanceLogic 과 같다. Roblox API 도, 전역 상태도, 다른 모듈 require 도 없다.
	난수는 서버가 뽑아서 숫자로 넘겨준다.

	배틀로 무기가 파괴되거나 레벨이 내려가는 일은 없다. 걸리는 건 골드와 레이팅뿐.
]]

local BattleLogic = {}

export type RewardParams = {
	baseReward: number,
	opponentLevel: number,
	levelBonusPerLevel: number,
	winProbability: number,
	upsetCap: number,
	accountAgeMultiplier: number, -- 부계정 파밍 방지용 배수 (보통 1, 신규 계정 0.5)
}

-- 0 으로 나누는 것을 막기 위한 하한
local MIN_PROBABILITY = 1e-6

--[[
	레벨 차이로 승률을 구한다.
	P(A 승) = 1 / (1 + 10 ^ ((LvB - LvA) / K))

	같은 레벨이면 50%, K=4 기준 4레벨 차이면 상위 쪽이 약 91%.
]]
function BattleLogic.winProbability(levelA: number, levelB: number, k: number): number
	local exponent = (levelB - levelA) / k
	return 1 / (1 + 10 ^ exponent)
end

-- roll 은 [0, 1). true 면 A 의 승리.
function BattleLogic.resolve(roll: number, winProbability: number): boolean
	return roll < winProbability
end

--[[
	역전 배율. 이길 확률이 낮았을수록 커지고, upsetCap 에서 멈춘다.
	확률이 100% 에 가까우면 1 에 수렴한다(배율 하한도 1).
]]
function BattleLogic.upsetMultiplier(winProbability: number, upsetCap: number): number
	local probability = math.max(winProbability, MIN_PROBABILITY)
	return math.clamp(1 / probability, 1, upsetCap)
end

-- 승자 보상: 기본 보상 × (1 + 레벨 보너스) × 역전 배율 × 계정 배수
function BattleLogic.winnerReward(params: RewardParams): number
	local levelBonus = 1 + params.levelBonusPerLevel * params.opponentLevel
	local upset = BattleLogic.upsetMultiplier(params.winProbability, params.upsetCap)

	local reward = params.baseReward * levelBonus * upset * params.accountAgeMultiplier
	return math.max(0, math.floor(reward))
end

function BattleLogic.loserReward(baseLoserReward: number, accountAgeMultiplier: number): number
	return math.max(0, math.floor(baseLoserReward * accountAgeMultiplier))
end

--[[
	Elo 기대 승률. 레이팅 기준의 표준 공식(400점 차이 = 10배)이다.
	승패 자체는 레벨 기반 winProbability 로 정해지고, 레이팅은 그 결과를 누적한다.
]]
function BattleLogic.expectedScore(ratingA: number, ratingB: number): number
	return 1 / (1 + 10 ^ ((ratingB - ratingA) / 400))
end

-- score: 이겼으면 1, 졌으면 0
function BattleLogic.updateRating(
	rating: number,
	expected: number,
	score: number,
	kFactor: number
): number
	local updated = rating + kFactor * (score - expected)
	return math.max(0, math.floor(updated + 0.5))
end

--[[
	한 판의 결과를 한 번에 계산한다.
	challenger 가 도전자, opponent 가 상대. roll 은 [0, 1).
]]
export type MatchParams = {
	challengerLevel: number,
	opponentLevel: number,
	challengerRating: number,
	opponentRating: number,
	roll: number,
	k: number,
	eloK: number,
	baseReward: number,
	levelBonusPerLevel: number,
	upsetCap: number,
	loserReward: number,
	challengerAgeMultiplier: number,
	opponentAgeMultiplier: number,
	challengerRewardAllowed: boolean, -- 일일 보상 한도를 넘지 않았는지
	opponentRewardAllowed: boolean,
}

export type MatchResult = {
	challengerWon: boolean,
	challengerWinProbability: number,
	challengerGold: number,
	opponentGold: number,
	challengerRating: number,
	opponentRating: number,
}

function BattleLogic.playMatch(params: MatchParams): MatchResult
	local probability =
		BattleLogic.winProbability(params.challengerLevel, params.opponentLevel, params.k)
	local challengerWon = BattleLogic.resolve(params.roll, probability)

	local challengerExpected =
		BattleLogic.expectedScore(params.challengerRating, params.opponentRating)
	local opponentExpected = 1 - challengerExpected

	local challengerScore = if challengerWon then 1 else 0
	local opponentScore = 1 - challengerScore

	local challengerGold: number
	local opponentGold: number

	if challengerWon then
		challengerGold = BattleLogic.winnerReward({
			baseReward = params.baseReward,
			opponentLevel = params.opponentLevel,
			levelBonusPerLevel = params.levelBonusPerLevel,
			winProbability = probability,
			upsetCap = params.upsetCap,
			accountAgeMultiplier = params.challengerAgeMultiplier,
		})
		opponentGold = BattleLogic.loserReward(params.loserReward, params.opponentAgeMultiplier)
	else
		challengerGold = BattleLogic.loserReward(params.loserReward, params.challengerAgeMultiplier)
		opponentGold = BattleLogic.winnerReward({
			baseReward = params.baseReward,
			opponentLevel = params.challengerLevel,
			levelBonusPerLevel = params.levelBonusPerLevel,
			winProbability = 1 - probability,
			upsetCap = params.upsetCap,
			accountAgeMultiplier = params.opponentAgeMultiplier,
		})
	end

	-- 일일 보상 한도를 넘은 쪽은 배틀은 하되 보상이 0 이다.
	if not params.challengerRewardAllowed then
		challengerGold = 0
	end
	if not params.opponentRewardAllowed then
		opponentGold = 0
	end

	return {
		challengerWon = challengerWon,
		challengerWinProbability = probability,
		challengerGold = challengerGold,
		opponentGold = opponentGold,
		challengerRating = BattleLogic.updateRating(
			params.challengerRating,
			challengerExpected,
			challengerScore,
			params.eloK
		),
		opponentRating = BattleLogic.updateRating(
			params.opponentRating,
			opponentExpected,
			opponentScore,
			params.eloK
		),
	}
end

return BattleLogic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">EnhanceLogic</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EnhanceLogic — 강화 결과 계산의 순수 함수.

	원칙:
	- Roblox API, 전역 상태, 다른 모듈에 대한 require 가 전혀 없다.
	  (그래서 Studio 밖에서 그대로 테스트할 수 있다)
	- 난수는 서버가 만든 Random 객체에서 뽑아 숫자로 넘겨받는다.
	  이 모듈은 난수를 직접 만들지 않는다 → 테스트에서 모든 분기를 재현할 수 있다.
	- 확률표도 인자로 받는다. 밸런스 데이터는 Config/EnhanceTable 에만 있다.
]]

local EnhanceLogic = {}

export type Odds = {
	success: number, -- 퍼센트
	keep: number,
	destroy: number,
	cost: number,
}

export type Outcome = "success" | "keep" | "destroy" | "protected"

export type ResolveParams = {
	level: number, -- 현재 강화 레벨 (호출 전에 level < maxLevel 임을 보장할 것)
	maxLevel: number,
	odds: Odds, -- 버프까지 반영된 최종 확률
	roll: number, -- [0, 100) 구간의 난수
	useProtect: boolean, -- 플레이어가 파괴 방지권 사용을 켜 두었는지
	protectTickets: number, -- 보유 방지권 수
	shardExponent: number,
}

export type ResolveResult = {
	outcome: Outcome,
	newLevel: number,
	shardsGained: number,
	ticketsUsed: number,
}

--[[
	확률 버프 이벤트를 적용한다.
	성공 확률에 +bonus %p 를 더하고 그만큼 유지 확률에서만 뺀다.
	파괴 확률은 절대 건드리지 않는다. 유지가 모자라면 더할 수 있는 만큼만 더한다.
]]
function EnhanceLogic.applyBuff(base: Odds, bonus: number): Odds
	local add = math.clamp(bonus, 0, base.keep)

	return {
		success = base.success + add,
		keep = base.keep - add,
		destroy = base.destroy,
		cost = base.cost,
	}
end

--[[
	난수 하나를 결과로 바꾼다.
	roll 은 [0, 100) 이어야 한다. 구간은 [성공)[유지)[파괴) 순서로 붙어 있다.
]]
function EnhanceLogic.roll(odds: Odds, roll: number): "success" | "keep" | "destroy"
	if roll < odds.success then
		return "success"
	elseif roll < odds.success + odds.keep then
		return "keep"
	end
	return "destroy"
end

-- 파괴 시 지급되는 파편 수 = floor(현재레벨 ^ exponent)
function EnhanceLogic.shardsFor(level: number, exponent: number): number
	if level <= 0 then
		return 0
	end
	return math.floor(level ^ exponent)
end

--[[
	강화 1회의 최종 결과.

	파괴 방지권은 "파괴가 실제로 나왔을 때"만 소모된다.
	파괴 확률이 0인 구간에서는 파괴가 나올 수 없으므로 방지권도 소모되지 않는다.
]]
function EnhanceLogic.resolve(params: ResolveParams): ResolveResult
	local raw = EnhanceLogic.roll(params.odds, params.roll)

	if raw == "success" then
		return {
			outcome = "success",
			newLevel = math.min(params.level + 1, params.maxLevel),
			shardsGained = 0,
			ticketsUsed = 0,
		}
	elseif raw == "keep" then
		return {
			outcome = "keep",
			newLevel = params.level,
			shardsGained = 0,
			ticketsUsed = 0,
		}
	end

	-- 파괴가 나왔다. 방지권이 있고 사용 설정이 켜져 있으면 유지로 바꾼다.
	if params.useProtect and params.protectTickets > 0 then
		return {
			outcome = "protected",
			newLevel = params.level,
			shardsGained = 0,
			ticketsUsed = 1,
		}
	end

	return {
		outcome = "destroy",
		newLevel = 0,
		shardsGained = EnhanceLogic.shardsFor(params.level, params.shardExponent),
		ticketsUsed = 0,
	}
end

-- 파편으로 방지권을 몇 개까지 바꿀 수 있는지
function EnhanceLogic.ticketsAffordable(shards: number, shardsPerTicket: number): number
	if shardsPerTicket <= 0 then
		return 0
	end
	return math.floor(shards / shardsPerTicket)
end

return EnhanceLogic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Format — 표시용 문자열 포맷터. Roblox API 를 전혀 쓰지 않으므로
	Lune(또는 순수 Luau)에서 그대로 테스트할 수 있다.

	여기 있는 함수는 숫자/기호만 다룬다. 사람이 읽는 문장은
	LocalizationTable 이 담당한다.
]]

local Format = {}

-- 1234567 → "1,234,567" (소수는 반올림, 음수는 부호 유지)
function Format.comma(value: number): string
	local negative = value < 0
	local whole = tostring(math.floor(math.abs(value) + 0.5))

	local chunked = (whole:reverse():gsub("(%d%d%d)", "%1,")):reverse()
	if chunked:sub(1, 1) == "," then
		chunked = chunked:sub(2)
	end

	if negative and chunked ~= "0" then
		return "-" .. chunked
	end
	return chunked
end

-- 12.5 → "12.5%" / 20 → "20%"  (decimals 기본 1자리, 정수면 소수점 생략)
function Format.percent(value: number, decimals: number?): string
	local places = decimals or 1
	local rounded = math.floor(value * 10 ^ places + 0.5) / 10 ^ places

	if rounded == math.floor(rounded) then
		return string.format("%d%%", rounded)
	end
	return string.format("%." .. places .. "f%%", rounded)
end

-- 7 → "+7" / 0 → "+0"  (강화 레벨 표기)
function Format.level(level: number): string
	return string.format("+%d", level)
end

-- 65 → "1:05", 3725 → "1:02:05"
function Format.duration(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	local hours = total // 3600
	local minutes = (total % 3600) // 60
	local secs = total % 60

	if hours > 0 then
		return string.format("%d:%02d:%02d", hours, minutes, secs)
	end
	return string.format("%d:%02d", minutes, secs)
end

-- 확률 막대나 로그에 쓰는 짧은 비율 표기. 0.25 → "25%"
function Format.ratio(ratio: number, decimals: number?): string
	return Format.percent(ratio * 100, decimals)
end

return Format
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Remotes — 리모트 이름을 한 곳에서 관리한다.
	서버는 Build() 로 인스턴스를 만들고, 클라이언트는 Get() 으로 가져온다.
	문자열 리터럴을 코드 여기저기에 흩뿌리지 말 것.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

Remotes.FOLDER_NAME = "Remotes"

-- RemoteFunction: 클라이언트가 요청하고 결과를 기다리는 것
Remotes.Functions = {
	Enhance = "Enhance", -- 강화 1회 요청 → Types.EnhanceResponse
	SellWeapon = "SellWeapon", -- 무기 판매 → 골드 지급
	BuyProtectTicket = "BuyProtectTicket", -- 파편 → 방지권 교환
	RenameWeapon = "RenameWeapon", -- 무기 이름 변경(필터링 후 저장)
	GetState = "GetState", -- 접속 직후 현재 데이터 + 확률 조회 (복제 이벤트를 놓쳤을 때의 보정)
	GetOdds = "GetOdds", -- 현재 레벨 기준 최종 확률표 조회
	GetBattleTargets = "GetBattleTargets", -- 같은 서버에서 도전할 수 있는 상대 목록
	ChallengeBattle = "ChallengeBattle", -- 배틀 도전 신청
	RespondBattle = "RespondBattle", -- 도전 수락/거절
	GetCodex = "GetCodex", -- 도감/업적 현황
	GetLeaderboard = "GetLeaderboard", -- 랭킹 상위 목록
	GetShopItems = "GetShopItems", -- 상점 목록 조회
	PromptPurchase = "PromptPurchase", -- 구매창 띄우기 요청
	SetSetting = "SetSetting", -- 사운드/언어 설정 변경
}

-- RemoteEvent: 서버가 밀어 주는 것 (클라이언트→서버 방향은 원칙적으로 쓰지 않음)
Remotes.Events = {
	DataChanged = "DataChanged", -- 프로필 변경분 복제
	BattleInvite = "BattleInvite", -- 도전 도착 알림
	BattleResolved = "BattleResolved", -- 배틀 결과 연출용
	FeedMessage = "FeedMessage", -- 결과 피드 한 줄
	LiveOpsChanged = "LiveOpsChanged", -- 이벤트/점검 상태 변경
}

-- 서버 전용: 리모트 폴더와 인스턴스를 생성한다.
function Remotes.Build(): Folder
	local existing = ReplicatedStorage:FindFirstChild(Remotes.FOLDER_NAME)
	if existing then
		return existing :: Folder
	end

	local folder = Instance.new("Folder")
	folder.Name = Remotes.FOLDER_NAME

	for _, name in Remotes.Functions do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
	end

	for _, name in Remotes.Events do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end

	folder.Parent = ReplicatedStorage
	return folder
end

-- 클라이언트 전용: 이름으로 리모트를 가져온다(없으면 대기).
function Remotes.Get(name: string): Instance
	local folder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	return folder:WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Types — 서버/클라이언트가 공유하는 데이터 타입 정의.
	여기 있는 타입은 저장 스키마(ProfileStore)와 리모트 페이로드의 계약이다.
	스키마를 바꾸면 SCHEMA_VERSION 을 올리고 DataService 에 마이그레이션을 추가할 것.
]]

local Types = {}

-- 현재 저장 스키마 버전. PlayerData.schemaVersion 의 기준값.
Types.SCHEMA_VERSION = 3

export type WeaponState = {
	id: string, -- Config/Weapons 의 키
	level: number, -- 0 ~ EnhanceTable.MAX_LEVEL
	customName: string?, -- 필터링을 통과한 이름만 저장
}

export type PlayerStats = {
	enhanceTries: number,
	enhanceSuccess: number,
	destroyed: number,
	highestLevel: number,
	battleWins: number,
	battleLosses: number,
	rating: number, -- 배틀 레이팅, 시작 1000
	-- v3 에서 추가된 업적용 통계
	keepStreak: number, -- 현재 연속 "유지" 횟수
	bestKeepStreak: number, -- 최고 연속 "유지" 횟수
	ticketsUsed: number, -- 지금까지 사용한 파괴 방지권 수
}

export type DailyState = {
	lastLoginDay: number, -- UTC 기준 일자 (os.time() // 86400)
	streak: number,
	battlesToday: number,
	opponentsToday: { [string]: number }, -- userId(문자열) → 오늘 보상 지급 횟수
}

export type PlayerSettings = {
	sfx: boolean,
	language: string,
}

export type PlayerData = {
	schemaVersion: number,
	gold: number,
	shards: number, -- 파괴 시 얻는 보조 재화
	weapon: WeaponState,
	protectTickets: number, -- 파괴 방지권
	stats: PlayerStats,
	codex: { [string]: boolean }, -- "weaponId:level" 달성 여부
	achievements: { [string]: boolean },
	daily: DailyState,
	-- ProcessReceipt 중복 지급 방지용 PurchaseId 목록.
	-- 배열인 이유: 오래된 것부터 버려서 크기를 일정하게 유지해야 하기 때문이다.
	-- (스키마 v1 에서는 { [id]: true } 딕셔너리였고 v2 에서 배열로 옮겼다)
	purchaseHistory: { string },
	settings: PlayerSettings,
	bannedUntil: number?,
}

-- 서버 함수의 공통 반환 형태. 실패는 에러 대신 ok=false 로 돌려준다.
export type Failure = {
	ok: false,
	reason: string,
}

-- 강화 화면에 노출하는 확률(버프 반영 후 최종값, 퍼센트 단위)
export type DisplayOdds = {
	level: number,
	success: number,
	keep: number,
	destroy: number,
	cost: number,
	eventName: string?, -- 적용 중인 확률 버프 이벤트 이름(로컬라이즈 키)
}

export type EnhanceOutcome = "success" | "keep" | "destroy" | "protected"

export type EnhanceSuccess = {
	ok: true,
	result: EnhanceOutcome,
	newLevel: number,
	gold: number,
	shardsGained: number,
	odds: DisplayOdds, -- 새 레벨 기준 확률. 클라이언트가 다시 물어보지 않아도 되도록 같이 보낸다.
}

export type EnhanceResponse = EnhanceSuccess | Failure

export type SellSuccess = {
	ok: true,
	goldGained: number,
	gold: number,
	odds: DisplayOdds,
}

export type SellResponse = SellSuccess | Failure

export type BattleOutcomeSide = "win" | "loss"

-- 같은 서버에서 도전할 수 있는 상대 (공개해도 되는 정보만)
export type BattleTarget = {
	userId: number,
	name: string,
	level: number,
	rating: number,
}

export type BattleInvitePayload = {
	challengerUserId: number,
	challengerName: string,
	challengerLevel: number,
	expiresAt: number, -- os.time() 기준
}

-- 배틀이 끝난 뒤 양쪽 클라이언트에 보내는 연출용 정보
export type BattleResultPayload = {
	won: boolean,
	goldGained: number,
	ratingBefore: number,
	ratingAfter: number,
	opponentName: string,
	opponentLevel: number,
	myLevel: number,
	winProbability: number,
	rewardCapped: boolean,
}

export type Success = { ok: true }

export type RenameSuccess = {
	ok: true,
	name: string, -- 필터링을 통과한 이름 (표시할 때도 이 값을 쓴다)
}

export type RenameResponse = RenameSuccess | Failure

export type TicketPurchaseSuccess = {
	ok: true,
	tickets: number,
}

export type TicketPurchaseResponse = TicketPurchaseSuccess | Failure

-- 상점에 보여 줄 항목 (클라이언트는 ID 를 알 필요가 없다)
-- 도감/업적 화면에 보낼 정보
export type CodexEntry = {
	weaponId: string,
	milestone: number,
	unlocked: boolean,
}

export type AchievementEntry = {
	id: string,
	unlocked: boolean,
	gold: number,
}

export type LeaderboardEntry = {
	rank: number,
	userId: number,
	name: string,
	value: number,
}

export type ShopItem = {
	key: string,
	kind: "gamepass" | "product",
	owned: boolean,
	goldAmount: number,
	ticketAmount: number,
}

export type BattleResponse = Success | Failure

return Types
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="18">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	서버 부트스트랩.
	services 폴더의 모듈을 정해진 순서대로 require → Init() → Start() 한다.

	- Init(): 상태 준비, 리모트 핸들러 등록. 다른 서비스를 호출하지 않는다.
	- Start(): 다른 서비스가 모두 Init 된 뒤에 실행되는 실제 동작 시작점.

	Init 단계에서 에러가 나면 게임이 정상 동작할 수 없으므로 크게 실패시킨다
	(데이터가 준비되지 않은 채로 플레이어를 받으면 안 된다).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

type Service = {
	Name: string?,
	Init: (() -> ())?,
	Start: (() -> ())?,
}

-- 의존 순서대로 나열한다. 여기 없는 모듈은 생명주기 없는 유틸로 간주하고 건너뛴다.
local SERVICE_ORDER = {
	"DataService",
	"AnalyticsService",
	"LiveOpsService",
	"EconomyService",
	"EnhanceService",
	"ChatCommandService",
	"BattleService",
	"ShopService",
	"CodexService",
	"LeaderboardService",
	"AdminService",
}

local servicesFolder = script:WaitForChild("services")

local function loadService(name: string): Service
	local module = servicesFolder:FindFirstChild(name)
	assert(
		module and module:IsA("ModuleScript"),
		`[Bootstrap] 서비스 모듈을 찾을 수 없습니다: {name}`
	)
	return require(module) :: Service
end

local function runStage(stage: "Init" | "Start", services: { Service })
	for _, service in services do
		local fn = if stage == "Init" then service.Init else service.Start
		if not fn then
			continue
		end

		local ok, err = xpcall(fn, debug.traceback)
		if not ok then
			warn(`[Bootstrap] {service.Name or "?"}.{stage} 실패:\n{err}`)
			if stage == "Init" then
				error(`[Bootstrap] {service.Name or "?"}.Init 실패로 서버 시작을 중단합니다`, 0)
			end
		end
	end
end

-- 리모트는 서비스가 핸들러를 붙이기 전에 미리 만들어 둔다.
Remotes.Build()

local services: { Service } = {}
for _, name in SERVICE_ORDER do
	local service = loadService(name)
	service.Name = service.Name or name
	table.insert(services, service)
end

runStage("Init", services)
runStage("Start", services)

print(`[Bootstrap] 서비스 {#services}개 시작 완료`)
]]></string>
      </Properties>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">services</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	AdminService — 관리자 명령과 감사 로그.

	Config/Game.ADMIN_USER_IDS 에 들어 있는 UserId 만 쓸 수 있다.
	목록이 비어 있으면 아무도 쓸 수 없다(기본값이 "아무도 안 됨"이어야 안전하다).

	모든 관리자 행동은 print 로 남기고 서버 메모리에도 최근 기록을 보관한다.
	"누가 언제 무엇을 했는지"가 남아야 사고가 났을 때 되짚을 수 있다.

	명령은 채팅으로 쓴다:
	    /관리 도움말
	    /관리 골드 <닉네임> <양>
	    /관리 레벨 <닉네임> <레벨>
	    /관리 방지권 <닉네임> <개수>
	    /관리 차단 <닉네임> <시간>       (시간 단위, 0 이면 해제)
	    /관리 정보 <닉네임>
	    /관리 점검 켜기|끄기
	    /관리 이벤트 <성공확률+%p> <지속분>
	    /관리 이벤트끄기
	    /관리 이상기록
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))
local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("Game"))
local EnhanceTable = require(Shared:WaitForChild("Config"):WaitForChild("EnhanceTable"))

local services = script.Parent
local DataService = require(services:WaitForChild("DataService"))
local EconomyService = require(services:WaitForChild("EconomyService"))
local AnalyticsService = require(services:WaitForChild("AnalyticsService"))
local LiveOpsService = require(services:WaitForChild("LiveOpsService"))
local BattleService = require(services:WaitForChild("BattleService"))

local AdminService = {}
AdminService.Name = "AdminService"

local COMMAND_NAME = "ForgeAdminCommand"
local MAX_AUDIT = 200

local auditLog: { string } = {}
local feedRemote: RemoteEvent? = nil

local function record(admin: Player, action: string)
	local entry = `[{os.date("!%Y-%m-%d %H:%M:%S")}] {admin.Name}({admin.UserId}) {action}`

	print(`[Admin] {entry}`)
	table.insert(auditLog, entry)

	while #auditLog > MAX_AUDIT do
		table.remove(auditLog, 1)
	end
end

local function reply(player: Player, text: string)
	if feedRemote == nil then
		return
	end
	feedRemote:FireClient(player, { kind = "system", text = text })
end

local function findPlayer(name: string): Player?
	return BattleService.findTargetByName(name)
end

--------------------------------------------------------------------------------
-- 개별 명령
--------------------------------------------------------------------------------

type Handler = (admin: Player, arguments: { string }) -> ()

local function requireTarget(admin: Player, arguments: { string }): Player?
	local name = arguments[2]
	if name == nil then
		reply(admin, "대상 닉네임이 필요하다.")
		return nil
	end

	local target = findPlayer(name)
	if target == nil then
		reply(admin, `'{name}' 을(를) 찾지 못했다.`)
		return nil
	end

	return target
end

local function cmdGold(admin: Player, arguments: { string })
	local target = requireTarget(admin, arguments)
	if target == nil then
		return
	end

	local amount = tonumber(arguments[3])
	if amount == nil or amount ~= math.floor(amount) then
		reply(admin, "양은 정수로 적어라.")
		return
	end

	local data = DataService.getActiveData(target)
	if data == nil then
		reply(admin, "그 사람 데이터가 아직 열리지 않았다.")
		return
	end

	if amount >= 0 then
		EconomyService.addGold(target, data, amount, "admin_grant", false)
	else
		-- 회수는 가진 만큼만
		EconomyService.spendGold(target, data, math.min(-amount, data.gold), "admin_revoke")
	end

	DataService.replicate(target)
	reply(admin, `{target.Name} 골드 {Format.comma(amount)} 처리. 현재 {Format.comma(data.gold)}`)
	record(admin, `골드 {amount} → {target.Name}({target.UserId})`)
end

local function cmdLevel(admin: Player, arguments: { string })
	local target = requireTarget(admin, arguments)
	if target == nil then
		return
	end

	local level = tonumber(arguments[3])
	if level == nil or level ~= math.floor(level) or level < 0 or level > EnhanceTable.MAX_LEVEL then
		reply(admin, `레벨은 0 ~ {EnhanceTable.MAX_LEVEL} 사이 정수여야 한다.`)
		return
	end

	local data = DataService.getActiveData(target)
	if data == nil then
		reply(admin, "그 사람 데이터가 아직 열리지 않았다.")
		return
	end

	data.weapon.level = level
	if level > data.stats.highestLevel then
		data.stats.highestLevel = level
	end

	DataService.replicate(target)
	reply(admin, `{target.Name} 레벨을 +{level} 로 설정.`)
	record(admin, `레벨 {level} → {target.Name}({target.UserId})`)
end

local function cmdTickets(admin: Player, arguments: { string })
	local target = requireTarget(admin, arguments)
	if target == nil then
		return
	end

	local count = tonumber(arguments[3])
	if count == nil or count ~= math.floor(count) then
		reply(admin, "개수는 정수로 적어라.")
		return
	end

	local data = DataService.getActiveData(target)
	if data == nil then
		reply(admin, "그 사람 데이터가 아직 열리지 않았다.")
		return
	end

	if count >= 0 then
		EconomyService.addTickets(target, data, count, "admin_grant")
	else
		EconomyService.spendTickets(
			target,
			data,
			math.min(-count, data.protectTickets),
			"admin_revoke"
		)
	end

	DataService.replicate(target)
	reply(admin, `{target.Name} 방지권 {count} 처리. 현재 {data.protectTickets}`)
	record(admin, `방지권 {count} → {target.Name}({target.UserId})`)
end

local function cmdBan(admin: Player, arguments: { string })
	local target = requireTarget(admin, arguments)
	if target == nil then
		return
	end

	local hours = tonumber(arguments[3])
	if hours == nil or hours < 0 then
		reply(admin, "시간은 0 이상 숫자여야 한다. 0 이면 해제.")
		return
	end

	local data = DataService.getActiveData(target)
	if data == nil then
		reply(admin, "그 사람 데이터가 아직 열리지 않았다.")
		return
	end

	if hours == 0 then
		data.bannedUntil = nil
		reply(admin, `{target.Name} 차단 해제.`)
		record(admin, `차단 해제 → {target.Name}({target.UserId})`)
		return
	end

	data.bannedUntil = os.time() + math.floor(hours * 3600)
	reply(admin, `{target.Name} {hours}시간 차단.`)
	record(admin, `차단 {hours}시간 → {target.Name}({target.UserId})`)

	-- 차단은 다음 접속 때 로드 시점에서도 확인되지만, 지금 있으면 바로 내보낸다.
	task.defer(function()
		if target.Parent == Players then
			target:Kick("출입이 금지되었다.")
		end
	end)
end

local function cmdInfo(admin: Player, arguments: { string })
	local target = requireTarget(admin, arguments)
	if target == nil then
		return
	end

	local data = DataService.getData(target)
	if data == nil then
		reply(admin, "그 사람 데이터가 아직 열리지 않았다.")
		return
	end

	reply(
		admin,
		`{target.Name} — +{data.weapon.level} · 골드 {Format.comma(data.gold)}`
			.. ` · 파편 {Format.comma(data.shards)} · 방지권 {data.protectTickets}`
			.. ` · 시도 {data.stats.enhanceTries} · 파괴 {data.stats.destroyed}`
			.. ` · 최고 +{data.stats.highestLevel} · 레이팅 {data.stats.rating}`
			.. ` · 스키마 v{data.schemaVersion}`
	)
	record(admin, `정보 조회 → {target.Name}({target.UserId})`)
end

local function cmdMaintenance(admin: Player, arguments: { string })
	local mode = arguments[2]
	if mode ~= "켜기" and mode ~= "끄기" and mode ~= "on" and mode ~= "off" then
		reply(admin, "/관리 점검 켜기 | 끄기")
		return
	end

	local enabled = mode == "켜기" or mode == "on"

	task.spawn(function()
		local saved = LiveOpsService.setMaintenance(enabled)
		reply(admin, `점검 모드 {if enabled then "켜짐" else "꺼짐"}{if saved then "" else " (저장 실패, 이 서버에만 적용)"}`)
	end)

	record(admin, `점검 {tostring(enabled)}`)
end

local function cmdEvent(admin: Player, arguments: { string })
	local buff = tonumber(arguments[2])
	local minutes = tonumber(arguments[3])

	if buff == nil or minutes == nil or buff <= 0 or minutes <= 0 then
		reply(admin, "/관리 이벤트 <성공확률+%p> <지속분>")
		return
	end

	local event = {
		id = `admin_{os.time()}`,
		nameKey = "event.boost",
		successBuff = math.clamp(buff, 1, 50),
		endsAt = os.time() + math.floor(minutes * 60),
	}

	task.spawn(function()
		local saved = LiveOpsService.setEvent(event)
		reply(
			admin,
			`이벤트 시작: 성공 +{event.successBuff}%p, {minutes}분{if saved then "" else " (저장 실패)"}`
		)
	end)

	record(admin, `이벤트 +{buff}%p / {minutes}분`)
end

local function cmdEventOff(admin: Player, _arguments: { string })
	task.spawn(function()
		LiveOpsService.setEvent(nil)
		reply(admin, "이벤트를 껐다.")
	end)
	record(admin, "이벤트 종료")
end

local function cmdAnomalies(admin: Player, _arguments: { string })
	local entries = AnalyticsService.getAnomalyLog()

	if #entries == 0 then
		reply(admin, "이상 기록이 없다.")
		return
	end

	for index = math.max(1, #entries - 9), #entries do
		reply(admin, entries[index])
	end
end

local function cmdAudit(admin: Player, _arguments: { string })
	if #auditLog == 0 then
		reply(admin, "관리자 기록이 없다.")
		return
	end

	for index = math.max(1, #auditLog - 9), #auditLog do
		reply(admin, auditLog[index])
	end
end

local HANDLERS: { [string]: Handler } = {
	["골드"] = cmdGold,
	["gold"] = cmdGold,
	["레벨"] = cmdLevel,
	["level"] = cmdLevel,
	["방지권"] = cmdTickets,
	["tickets"] = cmdTickets,
	["차단"] = cmdBan,
	["ban"] = cmdBan,
	["정보"] = cmdInfo,
	["info"] = cmdInfo,
	["점검"] = cmdMaintenance,
	["maintenance"] = cmdMaintenance,
	["이벤트"] = cmdEvent,
	["event"] = cmdEvent,
	["이벤트끄기"] = cmdEventOff,
	["eventoff"] = cmdEventOff,
	["이상기록"] = cmdAnomalies,
	["anomalies"] = cmdAnomalies,
	["기록"] = cmdAudit,
	["audit"] = cmdAudit,
}

local HELP = "/관리 골드|레벨|방지권|차단|정보 <닉네임> <값> · 점검 켜기|끄기 · 이벤트 <%p> <분> · 이벤트끄기 · 이상기록 · 기록"

--------------------------------------------------------------------------------

local function onAdminCommand(player: Player, arguments: { string })
	if not GameConfig.isAdmin(player.UserId) then
		-- 관리자가 아니면 명령이 있다는 사실조차 알리지 않는다.
		warn(`[Admin] 권한 없는 시도: {player.Name}({player.UserId})`)
		return
	end

	local subcommand = arguments[1]
	if subcommand == nil or subcommand == "도움말" or subcommand == "help" then
		reply(player, HELP)
		return
	end

	local handler = HANDLERS[string.lower(subcommand)] or HANDLERS[subcommand]
	if handler == nil then
		reply(player, HELP)
		return
	end

	local ok, err = xpcall(handler, debug.traceback, player, arguments)
	if not ok then
		warn(`[Admin] 명령 처리 오류:\n{err}`)
		reply(player, "명령 처리 중 문제가 생겼다.")
	end
end

function AdminService.Init()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	feedRemote = remotesFolder:WaitForChild(Remotes.Events.FeedMessage) :: RemoteEvent
end

function AdminService.Start()
	if #GameConfig.ADMIN_USER_IDS == 0 then
		warn(
			"[Admin] 관리자 UserId 가 비어 있어 관리자 명령을 등록하지 않았습니다. "
				.. "src/shared/Config/Game.luau 의 ADMIN_USER_IDS 를 채워 주세요."
		)
		return
	end

	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		warn("[Admin] 레거시 채팅이라 관리자 명령을 등록하지 않았습니다.")
		return
	end

	local ok, err = pcall(function()
		local existing = TextChatService:FindFirstChild(COMMAND_NAME)
		local command = if existing and existing:IsA("TextChatCommand")
			then existing
			else Instance.new("TextChatCommand")

		command.Name = COMMAND_NAME
		command.PrimaryAlias = "/관리"
		command.SecondaryAlias = "/admin"
		command.AutocompleteVisible = false -- 일반 플레이어에게 노출하지 않는다
		command.Enabled = true
		command.Parent = TextChatService

		command.Triggered:Connect(function(textSource: TextSource, message: string)
			local player = Players:GetPlayerByUserId(textSource.UserId)
			if player == nil then
				return
			end

			local words = string.split(message, " ")
			local arguments: { string } = {}
			for index = 2, #words do
				if words[index] ~= "" then
					table.insert(arguments, words[index])
				end
			end

			onAdminCommand(player, arguments)
		end)
	end)

	if not ok then
		warn(`[Admin] 명령 등록 실패: {err}`)
		return
	end

	print(`[Admin] 관리자 {#GameConfig.ADMIN_USER_IDS}명, 명령 등록 완료`)
end

function AdminService.getAuditLog(): { string }
	return table.clone(auditLog)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">AnalyticsService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	AnalyticsService — 경제 이벤트(골드 source/sink)와 퍼널 이벤트를 기록한다.

	지금은 서버 로그(print)로만 남긴다. 중요한 건 "모든 재화 증감이 반드시
	이 모듈을 거친다"는 구조이고, 실제 전송 대상은 나중에 한 곳만 바꾸면 된다.

	[확인 필요 / Phase 4 이후] Roblox 내장 AnalyticsService 의
	LogEconomyEvent 시그니처를 공식 문서에서 확인한 뒤 sendToRoblox() 안에서 연결할 것.
	문서를 확인하기 전에는 추측해서 호출하지 않는다.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EconomyConfig = require(Shared:WaitForChild("Config"):WaitForChild("EconomyConfig"))

local AnalyticsService = {}
AnalyticsService.Name = "AnalyticsService"

export type Currency = "gold" | "shards" | "tickets"

-- 이상 탐지용 누적 기록: userId → { windowStart, gained }
type AnomalyRecord = { windowStart: number, gained: number }
local anomalyByUser: { [number]: AnomalyRecord } = {}

-- 관리자 확인용으로 서버 메모리에 남겨 두는 최근 이상 기록
local anomalyLog: { string } = {}
local MAX_ANOMALY_LOG = 100

local function sendToRoblox(_eventName: string, _payload: { [string]: any })
	-- [확인 필요] 공식 문서 확인 후 Roblox AnalyticsService 호출을 여기에 추가한다.
end

--[[
	재화 증감 기록. amount 가 양수면 획득(source), 음수면 소비(sink).
	reason 은 "enhance_cost", "enhance_destroy_shards", "daily_login" 같은 고정 문자열.
]]
function AnalyticsService.logCurrency(
	player: Player,
	currency: Currency,
	amount: number,
	reason: string,
	balanceAfter: number
)
	if amount == 0 then
		return
	end

	local direction = if amount > 0 then "source" else "sink"
	print(
		`[Economy] {player.UserId} {currency} {direction} {amount} ({reason}) → {balanceAfter}`
	)

	sendToRoblox("currency", {
		userId = player.UserId,
		currency = currency,
		amount = amount,
		reason = reason,
		balanceAfter = balanceAfter,
	})

	if currency == "gold" and amount > 0 then
		AnalyticsService.trackGoldGain(player, amount)
	end
end

-- 튜토리얼/퍼널 단계 기록
function AnalyticsService.logFunnel(player: Player, step: string, detail: { [string]: any }?)
	print(`[Funnel] {player.UserId} {step}`)
	sendToRoblox("funnel", { userId = player.UserId, step = step, detail = detail })
end

-- 강화 결과 분포 기록 (실제 확률이 설계대로 나오는지 라이브에서 확인하기 위함)
function AnalyticsService.logEnhance(player: Player, level: number, outcome: string, cost: number)
	print(`[Enhance] {player.UserId} +{level} → {outcome} (비용 {cost})`)
	sendToRoblox("enhance", {
		userId = player.UserId,
		level = level,
		outcome = outcome,
		cost = cost,
	})
end

--[[
	짧은 시간에 골드가 비정상적으로 늘면 기록해 둔다.
	치트/버그 탐지용이며, 자동으로 제재하지는 않는다(오탐 위험).
]]
function AnalyticsService.trackGoldGain(player: Player, amount: number)
	local now = os.time()
	local record = anomalyByUser[player.UserId]

	if not record or now - record.windowStart > EconomyConfig.ANOMALY_WINDOW_SECONDS then
		record = { windowStart = now, gained = 0 }
		anomalyByUser[player.UserId] = record
	end

	record.gained += amount

	if record.gained >= EconomyConfig.ANOMALY_GOLD_DELTA then
		local message = string.format(
			"[Anomaly] %d 가 %d초 안에 골드 %d 획득",
			player.UserId,
			EconomyConfig.ANOMALY_WINDOW_SECONDS,
			record.gained
		)
		warn(message)
		table.insert(anomalyLog, message)
		if #anomalyLog > MAX_ANOMALY_LOG then
			table.remove(anomalyLog, 1)
		end

		-- 같은 창에서 반복 경고가 쏟아지지 않도록 초기화
		record.windowStart = now
		record.gained = 0
	end
end

-- AdminService 가 조회한다.
function AnalyticsService.getAnomalyLog(): { string }
	return table.clone(anomalyLog)
end

function AnalyticsService.clearPlayer(userId: number)
	anomalyByUser[userId] = nil
end

function AnalyticsService.Init() end

function AnalyticsService.Start()
	local Players = game:GetService("Players")
	Players.PlayerRemoving:Connect(function(player)
		AnalyticsService.clearPlayer(player.UserId)
	end)
end

return AnalyticsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">BattleService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	BattleService — 도전/수락 흐름과 배틀 결과 처리.

	흐름:
	  1) A 가 같은 서버의 B 에게 도전 신청 (또는 "아무나 매칭")
	  2) B 가 15초 안에 수락/거절. 무응답은 거절
	  3) 서버가 승패를 계산하고 보상·레이팅을 지급
	  4) 양쪽 클라이언트에 결과를 보내 연출

	배틀로 무기가 파괴되거나 레벨이 내려가지 않는다. 걸리는 건 골드와 레이팅뿐.

	어뷰징 방지:
	  - 배틀 쿨다운 10초
	  - 하루 보상 지급 30회 상한 (초과 시 배틀은 되지만 보상 0)
	  - 같은 상대와는 하루 보상 3회까지
	  - 계정 생성 3일 미만이면 보상 50%
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Locale = require(Shared:WaitForChild("Locale"))

local ConfigFolder = Shared:WaitForChild("Config")
local BattleConfig = require(ConfigFolder:WaitForChild("BattleConfig"))

local BattleLogic = require(Shared:WaitForChild("Pure"):WaitForChild("BattleLogic"))

local services = script.Parent
local DataService = require(services:WaitForChild("DataService"))
local EconomyService = require(services:WaitForChild("EconomyService"))
local AnalyticsService = require(services:WaitForChild("AnalyticsService"))
local LiveOpsService = require(services:WaitForChild("LiveOpsService"))
local RateLimiter = require(services:WaitForChild("RateLimiter"))
local CodexService = require(services:WaitForChild("CodexService"))

local BattleService = {}
BattleService.Name = "BattleService"

local rng = Random.new()

-- 도전 신청은 5초에 2번까지
local limiter = RateLimiter.new({ maxRequests = 2, windowSeconds = 5 })

type Invite = {
	challengerUserId: number,
	targetUserId: number,
	expiresAt: number,
}

-- 대상 userId → 받은 도전. 한 사람은 한 번에 하나만 받는다.
local invitesByTarget: { [number]: Invite } = {}
-- 도전자 userId → 보낸 도전. 한 사람은 한 번에 하나만 보낸다.
local invitesByChallenger: { [number]: Invite } = {}

local lastBattleAt: { [number]: number } = {}

local inviteRemote: RemoteEvent? = nil
local resolvedRemote: RemoteEvent? = nil
local feedRemote: RemoteEvent? = nil

local function fail(reason: string): Types.Failure
	return { ok = false, reason = reason }
end

local function languageOf(data: Types.PlayerData?): string
	if data and data.settings and data.settings.language then
		return data.settings.language
	end
	return Locale.DEFAULT_LANGUAGE
end

local function clearInvite(invite: Invite)
	if invitesByTarget[invite.targetUserId] == invite then
		invitesByTarget[invite.targetUserId] = nil
	end
	if invitesByChallenger[invite.challengerUserId] == invite then
		invitesByChallenger[invite.challengerUserId] = nil
	end
end

local function notify(player: Player, key: string, ...: any)
	if feedRemote == nil then
		return
	end
	local data = DataService.getData(player)
	feedRemote:FireClient(player, {
		kind = "system",
		text = Locale.get(languageOf(data), key, ...),
	})
end

-- 신규 계정 보상 배수
local function ageMultiplier(player: Player): number
	if player.AccountAge < BattleConfig.NEW_ACCOUNT_AGE_DAYS then
		return BattleConfig.NEW_ACCOUNT_REWARD_MULTIPLIER
	end
	return 1
end

--[[
	이 상대에게서 보상을 받을 수 있는지.
	하루 총 보상 횟수와 같은 상대 반복 횟수를 함께 본다.
]]
local function rewardAllowed(data: Types.PlayerData, opponentUserId: number): boolean
	if data.daily.battlesToday >= BattleConfig.DAILY_BATTLE_REWARD_CAP then
		return false
	end

	local perOpponent = data.daily.opponentsToday[tostring(opponentUserId)] or 0
	return perOpponent < BattleConfig.PER_OPPONENT_DAILY_CAP
end

local function markRewarded(data: Types.PlayerData, opponentUserId: number)
	data.daily.battlesToday += 1

	local key = tostring(opponentUserId)
	data.daily.opponentsToday[key] = (data.daily.opponentsToday[key] or 0) + 1
end

local function onCooldown(userId: number): boolean
	local last = lastBattleAt[userId]
	return last ~= nil and os.clock() - last < BattleConfig.COOLDOWN_SECONDS
end

--[[
	실제 대결. 여기에는 yield 가 없다.
	두 프로필을 동시에 만지므로 중간에 멈추면 한쪽만 반영되는 사고가 난다.
]]
local function runMatch(challenger: Player, opponent: Player): Types.BattleResponse
	local challengerData = DataService.getActiveData(challenger)
	local opponentData = DataService.getActiveData(opponent)

	if challengerData == nil or opponentData == nil then
		return fail("not_ready")
	end

	EconomyService.rolloverDaily(challengerData)
	EconomyService.rolloverDaily(opponentData)

	local challengerAllowed = rewardAllowed(challengerData, opponent.UserId)
	local opponentAllowed = rewardAllowed(opponentData, challenger.UserId)

	local challengerRatingBefore = challengerData.stats.rating
	local opponentRatingBefore = opponentData.stats.rating

	local result = BattleLogic.playMatch({
		challengerLevel = challengerData.weapon.level,
		opponentLevel = opponentData.weapon.level,
		challengerRating = challengerRatingBefore,
		opponentRating = opponentRatingBefore,
		roll = rng:NextNumber(),
		k = BattleConfig.K,
		eloK = BattleConfig.ELO_K,
		baseReward = BattleConfig.BASE_REWARD,
		levelBonusPerLevel = BattleConfig.LEVEL_BONUS_PER_LEVEL,
		upsetCap = BattleConfig.UPSET_MULTIPLIER_CAP,
		loserReward = BattleConfig.LOSER_REWARD,
		challengerAgeMultiplier = ageMultiplier(challenger),
		opponentAgeMultiplier = ageMultiplier(opponent),
		challengerRewardAllowed = challengerAllowed,
		opponentRewardAllowed = opponentAllowed,
	})

	challengerData.stats.rating = result.challengerRating
	opponentData.stats.rating = result.opponentRating

	if result.challengerWon then
		challengerData.stats.battleWins += 1
		opponentData.stats.battleLosses += 1
	else
		challengerData.stats.battleLosses += 1
		opponentData.stats.battleWins += 1
	end

	if result.challengerGold > 0 then
		EconomyService.addGold(challenger, challengerData, result.challengerGold, "battle", true)
	end
	if result.opponentGold > 0 then
		EconomyService.addGold(opponent, opponentData, result.opponentGold, "battle", true)
	end

	if challengerAllowed then
		markRewarded(challengerData, opponent.UserId)
	end
	if opponentAllowed then
		markRewarded(opponentData, challenger.UserId)
	end

	CodexService.evaluate(challenger, challengerData)
	CodexService.evaluate(opponent, opponentData)

	local now = os.clock()
	lastBattleAt[challenger.UserId] = now
	lastBattleAt[opponent.UserId] = now

	-- 여기부터는 데이터 변경이 끝난 뒤의 전달 작업이다.
	DataService.replicate(challenger)
	DataService.replicate(opponent)

	if resolvedRemote then
		resolvedRemote:FireClient(challenger, {
			won = result.challengerWon,
			goldGained = result.challengerGold,
			ratingBefore = challengerRatingBefore,
			ratingAfter = result.challengerRating,
			opponentName = opponent.DisplayName,
			opponentLevel = opponentData.weapon.level,
			myLevel = challengerData.weapon.level,
			winProbability = result.challengerWinProbability,
			rewardCapped = not challengerAllowed,
		} :: Types.BattleResultPayload)

		resolvedRemote:FireClient(opponent, {
			won = not result.challengerWon,
			goldGained = result.opponentGold,
			ratingBefore = opponentRatingBefore,
			ratingAfter = result.opponentRating,
			opponentName = challenger.DisplayName,
			opponentLevel = challengerData.weapon.level,
			myLevel = opponentData.weapon.level,
			winProbability = 1 - result.challengerWinProbability,
			rewardCapped = not opponentAllowed,
		} :: Types.BattleResultPayload)
	end

	AnalyticsService.logFunnel(challenger, "battle_finished", {
		won = result.challengerWon,
		opponentLevel = opponentData.weapon.level,
	})

	return { ok = true }
end

--[[
	도전할 수 있는 상대인지 확인한다.
	반환값은 실패 사유이며, 문제가 없으면 nil 이다.
]]
local function validateTarget(challenger: Player, target: Player): string?
	if target == challenger then
		return "self_challenge"
	end
	if not DataService.isReady(target) then
		return "opponent_not_ready"
	end
	if invitesByTarget[target.UserId] ~= nil then
		return "opponent_busy"
	end
	if onCooldown(target.UserId) then
		return "opponent_cooldown"
	end
	return nil
end

local function handleChallenge(challenger: Player, targetUserId: any): Types.BattleResponse
	-- 클라이언트가 보내는 값은 상대 userId 하나뿐이고, 숫자인지부터 본다.
	if targetUserId ~= nil and type(targetUserId) ~= "number" then
		return fail("invalid_argument")
	end

	if LiveOpsService.isMaintenance() then
		return fail("maintenance")
	end
	if not limiter:consume(challenger.UserId) then
		return fail("too_fast")
	end
	if not DataService.isReady(challenger) then
		return fail("not_ready")
	end
	if onCooldown(challenger.UserId) then
		return fail("battle_cooldown")
	end
	if invitesByChallenger[challenger.UserId] ~= nil then
		return fail("already_challenging")
	end
	if invitesByTarget[challenger.UserId] ~= nil then
		return fail("answer_first")
	end

	local target: Player? = nil

	if targetUserId == nil then
		-- "아무나 매칭": 조건에 맞는 사람 중 무작위
		local candidates: { Player } = {}
		for _, other in Players:GetPlayers() do
			if validateTarget(challenger, other) == nil then
				table.insert(candidates, other)
			end
		end

		if #candidates == 0 then
			return fail("no_opponent")
		end
		target = candidates[rng:NextInteger(1, #candidates)]
	else
		local found = Players:GetPlayerByUserId(targetUserId :: number)
		if found == nil then
			return fail("opponent_left")
		end

		local problem = validateTarget(challenger, found)
		if problem ~= nil then
			return fail(problem)
		end
		target = found
	end

	local resolvedTarget = target :: Player

	local invite: Invite = {
		challengerUserId = challenger.UserId,
		targetUserId = resolvedTarget.UserId,
		expiresAt = os.time() + BattleConfig.INVITE_TIMEOUT_SECONDS,
	}

	invitesByTarget[resolvedTarget.UserId] = invite
	invitesByChallenger[challenger.UserId] = invite

	local challengerData = DataService.getData(challenger)

	if inviteRemote then
		inviteRemote:FireClient(resolvedTarget, {
			challengerUserId = challenger.UserId,
			challengerName = challenger.DisplayName,
			challengerLevel = if challengerData then challengerData.weapon.level else 0,
			expiresAt = invite.expiresAt,
		} :: Types.BattleInvitePayload)
	end

	notify(challenger, "battle.sent", resolvedTarget.DisplayName)

	-- 무응답은 거절로 처리한다.
	task.delay(BattleConfig.INVITE_TIMEOUT_SECONDS, function()
		if invitesByTarget[resolvedTarget.UserId] ~= invite then
			return -- 이미 응답됨
		end

		clearInvite(invite)

		if challenger.Parent == Players then
			notify(challenger, "battle.timeout", resolvedTarget.DisplayName)
		end
		if resolvedTarget.Parent == Players and inviteRemote then
			inviteRemote:FireClient(resolvedTarget, false) -- 팝업 닫기
		end
	end)

	return { ok = true }
end

local function handleRespond(player: Player, accept: any): Types.BattleResponse
	if type(accept) ~= "boolean" then
		return fail("invalid_argument")
	end

	local invite = invitesByTarget[player.UserId]
	if invite == nil then
		return fail("no_invite")
	end

	local challenger = Players:GetPlayerByUserId(invite.challengerUserId)
	clearInvite(invite)

	if challenger == nil or challenger.Parent ~= Players then
		return fail("opponent_left")
	end

	if not accept then
		notify(challenger, "battle.declined", player.DisplayName)
		return { ok = true }
	end

	local ok, response = xpcall(runMatch, debug.traceback, challenger, player)

	if not ok then
		warn(`[BattleService] 배틀 처리 중 오류:\n{response}`)
		return fail("unknown")
	end

	return response
end

-- 같은 서버에서 도전할 수 있는 상대 목록 (공개해도 되는 정보만 담는다)
local function handleGetTargets(player: Player): { Types.BattleTarget }
	local targets: { Types.BattleTarget } = {}

	for _, other in Players:GetPlayers() do
		if validateTarget(player, other) ~= nil then
			continue
		end

		local data = DataService.getData(other)
		if data == nil then
			continue
		end

		table.insert(targets, {
			userId = other.UserId,
			name = other.DisplayName,
			level = data.weapon.level,
			rating = data.stats.rating,
		})
	end

	table.sort(targets, function(a, b)
		return a.rating > b.rating
	end)

	return targets
end

-- 채팅 명령어(/배틀)가 같은 경로를 타도록 공개한다.
function BattleService.requestChallenge(player: Player, targetUserId: number?): Types.BattleResponse
	return handleChallenge(player, targetUserId)
end

-- 닉네임으로 상대를 찾는다(채팅 명령어용). 부분 일치도 허용한다.
function BattleService.findTargetByName(name: string): Player?
	local lowered = string.lower(name)

	for _, player in Players:GetPlayers() do
		if string.lower(player.Name) == lowered or string.lower(player.DisplayName) == lowered then
			return player
		end
	end

	for _, player in Players:GetPlayers() do
		if
			string.find(string.lower(player.Name), lowered, 1, true)
			or string.find(string.lower(player.DisplayName), lowered, 1, true)
		then
			return player
		end
	end

	return nil
end

function BattleService.Init()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)

	local challengeRemote =
		remotesFolder:WaitForChild(Remotes.Functions.ChallengeBattle) :: RemoteFunction
	challengeRemote.OnServerInvoke = handleChallenge

	local respondRemote =
		remotesFolder:WaitForChild(Remotes.Functions.RespondBattle) :: RemoteFunction
	respondRemote.OnServerInvoke = handleRespond

	local targetsRemote =
		remotesFolder:WaitForChild(Remotes.Functions.GetBattleTargets) :: RemoteFunction
	targetsRemote.OnServerInvoke = handleGetTargets

	inviteRemote = remotesFolder:WaitForChild(Remotes.Events.BattleInvite) :: RemoteEvent
	resolvedRemote = remotesFolder:WaitForChild(Remotes.Events.BattleResolved) :: RemoteEvent
	feedRemote = remotesFolder:WaitForChild(Remotes.Events.FeedMessage) :: RemoteEvent
end

function BattleService.Start()
	Players.PlayerRemoving:Connect(function(player)
		limiter:clear(player.UserId)
		lastBattleAt[player.UserId] = nil

		local incoming = invitesByTarget[player.UserId]
		if incoming then
			clearInvite(incoming)
		end

		local outgoing = invitesByChallenger[player.UserId]
		if outgoing then
			clearInvite(outgoing)

			local target = Players:GetPlayerByUserId(outgoing.targetUserId)
			if target and inviteRemote then
				inviteRemote:FireClient(target, false)
			end
		end
	end)

	-- 하루가 바뀌는 순간에 접속 중인 사람도 기록이 초기화되도록 주기적으로 확인한다.
	task.spawn(function()
		while true do
			task.wait(60)
			for player, data in DataService.getAllActive() do
				if EconomyService.rolloverDaily(data) then
					DataService.replicate(player)
				end
			end
		end
	end)
end

return BattleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">ChatCommandService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ChatCommandService — 채팅 텍스트 명령어.

	버튼과 명령어는 "같은 서버 경로"를 탄다. 명령어 처리기는 직접 데이터를
	건드리지 않고 EnhanceService 의 공개 함수를 호출하므로, 검증·레이트 리밋·락이
	버튼과 똑같이 적용된다.

	확인한 공식 문서 내용:
	- TextChatCommand 는 TextChatService 아래에 있어야 동작한다.
	- Triggered(originTextSource: TextSource, unfilteredText: string) 는
	  서버 Script 에서 연결하는 것이 공식 예제의 방식이고,
	  textSource.UserId 로 Players:GetPlayerByUserId() 해서 플레이어를 얻는다.
	- TextChannel:DisplaySystemMessage() 는 클라이언트에서만 호출할 수 있으므로,
	  명령 결과 안내는 서버가 리모트로 보내고 클라이언트가 채팅에 표시한다.

	[확인 필요] TextChatCommand 인스턴스를 서버에서 런타임에 만들어 붙이는 방식은
	Studio 에서 한 번 확인해 줘. 공식 예제는 Studio 에서 미리 만들어 둔 인스턴스를
	WaitForChild 로 찾는 형태였다. 만약 런타임 생성이 동작하지 않으면
	Studio 의 TextChatService 아래에 TextChatCommand 를 직접 만들고
	아래 COMMANDS 의 이름과 맞추면 된다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))

local services = script.Parent
local DataService = require(services:WaitForChild("DataService"))
local EnhanceService = require(services:WaitForChild("EnhanceService"))
local BattleService = require(services:WaitForChild("BattleService"))

local ChatCommandService = {}
ChatCommandService.Name = "ChatCommandService"

local feedRemote: RemoteEvent? = nil

type CommandSpec = {
	name: string,
	primary: string,
	secondary: string,
	handler: (player: Player, arguments: { string }) -> (),
}

local function languageOf(player: Player): string
	local data = DataService.getData(player)
	if data and data.settings and data.settings.language then
		return data.settings.language
	end
	return Locale.DEFAULT_LANGUAGE
end

-- 명령 결과를 그 플레이어에게만 보낸다. 클라이언트가 채팅창에 표시한다.
local function reply(player: Player, text: string)
	if feedRemote == nil then
		return
	end
	feedRemote:FireClient(player, { kind = "system", text = text })
end

local function replyKey(player: Player, key: string, ...: any)
	reply(player, Locale.get(languageOf(player), key, ...))
end

local function onEnhanceCommand(player: Player, arguments: { string })
	-- "/강화 보호" 처럼 뒤에 보호 옵션을 붙일 수 있다.
	local wantsProtect = false
	for _, argument in arguments do
		local lowered = string.lower(argument)
		if lowered == "보호" or lowered == "protect" then
			wantsProtect = true
		end
	end

	local response = EnhanceService.requestEnhance(player, wantsProtect)

	if not response.ok then
		replyKey(player, `error.{response.reason}`)
		return
	end

	replyKey(player, `chat.result.{response.result}`, response.newLevel)
end

local function onSellCommand(player: Player)
	local response = EnhanceService.requestSell(player)

	if not response.ok then
		replyKey(player, `error.{response.reason}`)
		return
	end

	replyKey(player, "chat.sold", Format.comma(response.goldGained))
end

local function onBattleCommand(player: Player, arguments: { string })
	local targetUserId: number? = nil

	if #arguments > 0 then
		local name = table.concat(arguments, " ")
		local target = BattleService.findTargetByName(name)

		if target == nil then
			replyKey(player, "error.not_found")
			return
		end
		targetUserId = target.UserId
	end

	local response = BattleService.requestChallenge(player, targetUserId)
	if not response.ok then
		replyKey(player, `error.{response.reason}`)
	end
end

local function onOddsCommand(player: Player)
	local data = DataService.getData(player)
	if data == nil then
		replyKey(player, "error.not_ready")
		return
	end

	local odds = EnhanceService.getDisplayOdds(data.weapon.level)

	if odds.cost <= 0 then
		replyKey(player, "ui.maxLevel")
		return
	end

	replyKey(
		player,
		"chat.odds",
		odds.level,
		Format.percent(odds.success),
		Format.percent(odds.keep),
		Format.percent(odds.destroy),
		Format.comma(odds.cost)
	)
end

local function onInfoCommand(player: Player)
	local data = DataService.getData(player)
	if data == nil then
		replyKey(player, "error.not_ready")
		return
	end

	replyKey(
		player,
		"chat.info",
		data.weapon.level,
		Format.comma(data.gold),
		Format.comma(data.shards),
		data.protectTickets,
		data.stats.enhanceTries,
		data.stats.destroyed,
		data.stats.highestLevel
	)
end

local function onHelpCommand(player: Player)
	replyKey(player, "chat.help")
end

local COMMANDS: { CommandSpec } = {
	{
		name = "ForgeEnhanceCommand",
		primary = "/강화",
		secondary = "/enhance",
		handler = onEnhanceCommand,
	},
	{
		name = "ForgeSellCommand",
		primary = "/판매",
		secondary = "/sell",
		handler = function(player, _)
			onSellCommand(player)
		end,
	},
	{
		name = "ForgeBattleCommand",
		primary = "/배틀",
		secondary = "/battle",
		handler = onBattleCommand,
	},
	{
		name = "ForgeOddsCommand",
		primary = "/확률",
		secondary = "/odds",
		handler = function(player, _)
			onOddsCommand(player)
		end,
	},
	{
		name = "ForgeInfoCommand",
		primary = "/정보",
		secondary = "/info",
		handler = function(player, _)
			onInfoCommand(player)
		end,
	},
	{
		name = "ForgeHelpCommand",
		primary = "/도움말",
		secondary = "/forgehelp",
		handler = function(player, _)
			onHelpCommand(player)
		end,
	},
}

local function register(spec: CommandSpec)
	local existing = TextChatService:FindFirstChild(spec.name)
	local command = if existing and existing:IsA("TextChatCommand")
		then existing
		else Instance.new("TextChatCommand")

	command.Name = spec.name
	command.PrimaryAlias = spec.primary
	command.SecondaryAlias = spec.secondary
	command.AutocompleteVisible = true
	command.Enabled = true
	command.Parent = TextChatService

	command.Triggered:Connect(function(textSource: TextSource, message: string)
		local player = Players:GetPlayerByUserId(textSource.UserId)
		if player == nil then
			return
		end

		-- 첫 토큰은 명령어 자체이므로 버린다.
		local words = string.split(message, " ")
		local arguments: { string } = {}
		for index = 2, #words do
			if words[index] ~= "" then
				table.insert(arguments, words[index])
			end
		end

		local ok, err = xpcall(spec.handler, debug.traceback, player, arguments)
		if not ok then
			warn(`[ChatCommandService] {spec.primary} 처리 중 오류:\n{err}`)
			replyKey(player, "error.unknown")
		end
	end)
end

function ChatCommandService.Init()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	feedRemote = remotesFolder:WaitForChild(Remotes.Events.FeedMessage) :: RemoteEvent
end

function ChatCommandService.Start()
	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		warn(
			"[ChatCommandService] TextChatService 가 아닌 레거시 채팅이 켜져 있어 "
				.. "텍스트 명령어를 등록하지 않았습니다. "
				.. "게임 설정에서 ChatVersion 을 TextChatService 로 바꿔 주세요."
		)
		return
	end

	for _, spec in COMMANDS do
		local ok, err = pcall(register, spec)
		if not ok then
			warn(`[ChatCommandService] {spec.primary} 등록 실패: {err}`)
		end
	end

	print(`[ChatCommandService] 명령어 {#COMMANDS}개 등록`)
end

return ChatCommandService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">CodexService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CodexService — 도감과 업적.

	(Roblox 내장 CollectionService 와 이름이 겹치지 않도록 Codex 로 이름을 잡았다.)

	- 도감: 무기 종류 × 레벨 구간(5/10/15/20) 달성 기록. 칸마다 골드 보상.
	- 업적: Config/Achievements 의 판정 함수를 전부 돌려 새로 달성된 것만 보상.

	업적 판정은 순수 함수라 데이터만 보면 되므로, 강화·배틀 직후는 물론
	접속 시점에도 한 번 돌린다. 예전 버전에서 조건을 이미 만족했던 사람도
	접속하면 자연스럽게 보상을 받게 된다(뒤늦게 추가된 업적 대응).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Locale = require(Shared:WaitForChild("Locale"))

local ConfigFolder = Shared:WaitForChild("Config")
local Weapons = require(ConfigFolder:WaitForChild("Weapons"))
local Achievements = require(ConfigFolder:WaitForChild("Achievements"))
local EconomyConfig = require(ConfigFolder:WaitForChild("EconomyConfig"))

local services = script.Parent
local DataService = require(services:WaitForChild("DataService"))
local EconomyService = require(services:WaitForChild("EconomyService"))
local AnalyticsService = require(services:WaitForChild("AnalyticsService"))

local CodexService = {}
CodexService.Name = "CodexService"

local feedRemote: RemoteEvent? = nil

local function notify(player: Player, data: Types.PlayerData, key: string, ...: any)
	if feedRemote == nil then
		return
	end

	feedRemote:FireClient(player, {
		kind = "system",
		text = Locale.get(data.settings.language, key, ...),
	})
end

--[[
	무기가 어떤 레벨에 도달했을 때 도감을 채운다.
	새로 채워진 칸마다 골드를 준다. yield 하지 않는다.
	반환값은 이번에 새로 채운 칸 수.
]]
function CodexService.recordWeaponLevel(
	player: Player,
	data: Types.PlayerData,
	level: number
): number
	local unlocked = 0

	for _, milestone in Weapons.CODEX_MILESTONES do
		if level < milestone then
			continue
		end

		local key = `{data.weapon.id}:{milestone}`
		if data.codex[key] then
			continue
		end

		data.codex[key] = true
		unlocked += 1

		EconomyService.addGold(player, data, EconomyConfig.CODEX_ENTRY_GOLD, "codex_entry", true)
		notify(player, data, "codex.unlocked", milestone)
		AnalyticsService.logFunnel(player, "codex_unlocked", { key = key })
	end

	return unlocked
end

--[[
	업적을 전부 확인하고 새로 달성된 것에 보상을 준다. yield 하지 않는다.
	반환값은 이번에 새로 달성한 업적 수.
]]
function CodexService.evaluate(player: Player, data: Types.PlayerData): number
	local granted = 0

	for _, achievement in Achievements.List do
		if data.achievements[achievement.id] then
			continue
		end

		local ok, reached = pcall(achievement.check, data :: any)
		if not ok then
			warn(`[CodexService] 업적 판정 오류 ({achievement.id}): {reached}`)
			continue
		end

		if reached ~= true then
			continue
		end

		data.achievements[achievement.id] = true
		granted += 1

		EconomyService.addGold(player, data, achievement.gold, `achv_{achievement.id}`, true)
		notify(player, data, "achv.unlocked", Locale.get(data.settings.language, `achv.{achievement.id}.name`))
		AnalyticsService.logFunnel(player, "achievement_unlocked", { id = achievement.id })
	end

	return granted
end

local function handleGetCodex(player: Player): {
	entries: { Types.CodexEntry },
	achievements: { Types.AchievementEntry },
} | Types.Failure
	local data = DataService.getData(player)
	if data == nil then
		return { ok = false, reason = "not_ready" }
	end

	local entries: { Types.CodexEntry } = {}
	for _, weapon in Weapons.List do
		for _, milestone in Weapons.CODEX_MILESTONES do
			table.insert(entries, {
				weaponId = weapon.id,
				milestone = milestone,
				unlocked = data.codex[`{weapon.id}:{milestone}`] == true,
			})
		end
	end

	local achievements: { Types.AchievementEntry } = {}
	for _, achievement in Achievements.List do
		table.insert(achievements, {
			id = achievement.id,
			unlocked = data.achievements[achievement.id] == true,
			gold = achievement.gold,
		})
	end

	return { entries = entries, achievements = achievements }
end

function CodexService.Init()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)

	local codexRemote = remotesFolder:WaitForChild(Remotes.Functions.GetCodex) :: RemoteFunction
	codexRemote.OnServerInvoke = handleGetCodex

	feedRemote = remotesFolder:WaitForChild(Remotes.Events.FeedMessage) :: RemoteEvent
end

function CodexService.Start()
	-- 접속 시 한 번 평가한다. 나중에 추가된 업적도 여기서 소급 지급된다.
	DataService.onLoaded(function(player, data)
		if CodexService.evaluate(player, data) > 0 then
			DataService.replicate(player)
		end
	end)
end

return CodexService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataService — 플레이어 데이터의 단일 진입점.

	ProfileStore 로 세션 락이 걸린 프로필을 열고, 다른 서비스는 전부
	이 모듈을 통해서만 데이터를 읽고 쓴다.

	중요한 규칙:
	- 로드에 실패하면 기본값으로 덮어쓰지 않고 Kick 한다. (데이터 유실 방지)
	- Studio 는 _DEV 스토어, 라이브는 _PROD 스토어를 쓴다. 절대 섞지 않는다.
	- 서버 종료 시 저장 대기는 ProfileStore 가 내부 game:BindToClose 에서
	  모든 활성 프로필의 저장이 끝날 때까지 기다린다. 여기서 따로 BindToClose 를
	  걸면 같은 일을 두 번 하게 되므로 걸지 않는다.
	- getActiveData() 로 받은 테이블은 "yield 하지 않고" 즉시 수정해야 한다.
	  (task.wait, WaitForChild 등을 끼우면 그 사이 세션이 끝날 수 있다)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Locale = require(Shared:WaitForChild("Locale"))

local ConfigFolder = Shared:WaitForChild("Config")
local GameConfig = require(ConfigFolder:WaitForChild("Game"))
local EconomyConfig = require(ConfigFolder:WaitForChild("EconomyConfig"))
local Weapons = require(ConfigFolder:WaitForChild("Weapons"))
local Products = require(ConfigFolder:WaitForChild("Products"))

local DataService = {}
DataService.Name = "DataService"

-- ProfileStore 는 require 로 가져오므로 정적 타입이 붙지 않는다.
type Profile = any

local profiles: { [Player]: Profile } = {}
local loadedListeners: { (player: Player, data: Types.PlayerData) -> () } = {}
local unloadingListeners: { (player: Player, data: Types.PlayerData) -> () } = {}

local playerStore: any = nil
local dataChangedRemote: RemoteEvent? = nil

--[[
	ProfileStore 모듈을 가져온다.

	두 위치를 순서대로 찾는다.
	  1) ServerScriptService/Server/vendor/ProfileStore  (저장소에 포함된 사본)
	  2) ServerStorage/ServerPackages/ProfileStore        (Wally 로 설치한 경우)

	둘 다 없으면 무엇을 해야 하는지 알려 주고 멈춘다.
	(WaitForChild 로 조용히 영원히 기다리면 원인을 찾기 어렵다.)
]]
local function requireProfileStore(): any
	-- 1) 저장소에 포함된 사본. services 폴더의 형제인 vendor 폴더에 있다.
	local serverRoot = script.Parent.Parent
	local vendor = serverRoot and serverRoot:FindFirstChild("vendor")
	local vendored = vendor and vendor:FindFirstChild("ProfileStore")

	if vendored and vendored:IsA("ModuleScript") then
		return require(vendored)
	end

	-- 2) Wally 로 설치한 경우
	local packages = ServerStorage:FindFirstChild("ServerPackages")
	local installed = packages and packages:FindFirstChild("ProfileStore")

	if installed and installed:IsA("ModuleScript") then
		return require(installed)
	end

	error(
		"[DataService] ProfileStore 모듈을 찾을 수 없습니다.\n"
			.. "Rojo 동기화가 제대로 됐는지 확인해 주세요.\n"
			.. "(ServerScriptService/Server/vendor/ProfileStore 에 있어야 합니다)",
		0
	)
end

-- 새 플레이어의 기본 데이터. ProfileStore 가 이 표를 깊은 복사해서 쓴다.
local function buildTemplate(): Types.PlayerData
	return {
		schemaVersion = Types.SCHEMA_VERSION,
		gold = EconomyConfig.STARTING_GOLD,
		shards = EconomyConfig.STARTING_SHARDS,
		weapon = {
			id = Weapons.DEFAULT_ID,
			level = 0,
		},
		protectTickets = EconomyConfig.STARTING_PROTECT_TICKETS,
		stats = {
			enhanceTries = 0,
			enhanceSuccess = 0,
			destroyed = 0,
			highestLevel = 0,
			battleWins = 0,
			battleLosses = 0,
			rating = 1000,
			keepStreak = 0,
			bestKeepStreak = 0,
			ticketsUsed = 0,
		},
		codex = {},
		achievements = {},
		daily = {
			lastLoginDay = 0,
			streak = 0,
			battlesToday = 0,
			opponentsToday = {},
		},
		purchaseHistory = {} :: { string },
		settings = {
			sfx = true,
			language = GameConfig.DEFAULT_LANGUAGE,
		},
	}
end

--[[
	저장된 데이터를 현재 스키마로 올린다.
	Reconcile() 이 "빠진 키 채우기"를 담당하고, 여기서는 "형태가 바뀐 값"을 옮긴다.
	기존 데이터를 절대 버리지 않는다.
]]
local function migrate(data: Types.PlayerData): Types.PlayerData
	if data.schemaVersion == nil then
		data.schemaVersion = 1
	end

	-- 스키마 버전을 올릴 때마다 아래에 단계를 하나씩 추가한다.
	-- 각 단계는 "이전 버전 데이터를 버리지 않고" 새 형태로 옮기기만 한다.

	-- v1 → v2: purchaseHistory 를 딕셔너리에서 배열로 옮긴다.
	-- (배열이어야 오래된 기록부터 버려 크기를 일정하게 유지할 수 있다)
	if data.schemaVersion == 1 then
		local history = data.purchaseHistory :: any
		local migrated: { string } = {}

		if type(history) == "table" then
			for key, value in history do
				if type(key) == "string" and value == true then
					table.insert(migrated, key)
				elseif type(value) == "string" then
					table.insert(migrated, value) -- 이미 배열인 경우
				end
			end
		end

		while #migrated > Products.PURCHASE_HISTORY_LIMIT do
			table.remove(migrated, 1)
		end

		data.purchaseHistory = migrated
		data.schemaVersion = 2
	end

	-- v2 → v3: 업적 판정에 쓰는 통계를 추가한다.
	-- Reconcile() 이 템플릿에서 채워 주지만, 순서에 기대지 않고 여기서도 보정한다.
	if data.schemaVersion == 2 then
		local stats = data.stats :: any
		stats.keepStreak = stats.keepStreak or 0
		stats.bestKeepStreak = stats.bestKeepStreak or 0
		stats.ticketsUsed = stats.ticketsUsed or 0
		data.schemaVersion = 3
	end

	if data.schemaVersion > Types.SCHEMA_VERSION then
		-- 더 새로운 버전으로 저장된 데이터. 덮어쓰면 손실이 나므로 건드리지 않는다.
		warn(
			`[DataService] 저장된 스키마 버전({data.schemaVersion})이 코드 버전({Types.SCHEMA_VERSION})보다 높습니다`
		)
	end

	return data
end

local function fire(listeners: { (Player, Types.PlayerData) -> () }, player: Player, data: Types.PlayerData)
	for _, listener in listeners do
		local ok, err = xpcall(listener, debug.traceback, player, data)
		if not ok then
			warn(`[DataService] 리스너 오류:\n{err}`)
		end
	end
end

--[[
	클라이언트에 현재 데이터를 보낸다.
	RemoteEvent 로 보내는 순간 테이블이 복사되므로 서버 테이블이 노출되지는 않는다.
]]
function DataService.replicate(player: Player)
	local profile = profiles[player]
	if not profile or not dataChangedRemote then
		return
	end
	dataChangedRemote:FireClient(player, profile.Data)
end

-- 세션이 살아 있을 때만 데이터를 준다. 반환값은 yield 없이 즉시 수정할 것.
function DataService.getActiveData(player: Player): Types.PlayerData?
	local profile = profiles[player]
	if not profile or not profile:IsActive() then
		return nil
	end
	return profile.Data
end

-- 읽기 전용 용도(세션이 끝나가는 중일 수도 있음)
function DataService.getData(player: Player): Types.PlayerData?
	local profile = profiles[player]
	return if profile then profile.Data else nil
end

function DataService.isReady(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile:IsActive()
end

function DataService.getProfile(player: Player): Profile
	return profiles[player]
end

-- 구매 등 중요한 변경 직후 즉시 저장하고 싶을 때만 쓴다(DataStore 호출 1회).
function DataService.saveNow(player: Player)
	local profile = profiles[player]
	if profile and profile:IsActive() then
		profile:Save()
	end
end

function DataService.onLoaded(listener: (player: Player, data: Types.PlayerData) -> ())
	table.insert(loadedListeners, listener)

	-- 이미 로드된 플레이어에게도 바로 알려 준다(서비스 등록 순서에 의존하지 않도록).
	for player, profile in profiles do
		task.spawn(listener, player, profile.Data)
	end
end

function DataService.onUnloading(listener: (player: Player, data: Types.PlayerData) -> ())
	table.insert(unloadingListeners, listener)
end

function DataService.getAllActive(): { [Player]: Types.PlayerData }
	local result: { [Player]: Types.PlayerData } = {}
	for player, profile in profiles do
		if profile:IsActive() then
			result[player] = profile.Data
		end
	end
	return result
end

local function onPlayerAdded(player: Player)
	local profile = playerStore:StartSessionAsync(tostring(player.UserId), {
		Cancel = function()
			return player.Parent ~= Players
		end,
	})

	if profile == nil then
		-- 다른 서버가 동시에 같은 프로필 세션을 잡으려 한 드문 경우.
		player:Kick(Locale.get(nil, "error.load_fail"))
		return
	end

	profile:AddUserId(player.UserId) -- GDPR: 데이터 삭제 요청 대응
	profile:Reconcile() -- 템플릿에 새로 생긴 키 채우기
	migrate(profile.Data)

	profile.OnSessionEnd:Connect(function()
		local data = profiles[player] and profiles[player].Data
		profiles[player] = nil
		if data then
			fire(unloadingListeners, player, data)
		end
		player:Kick(Locale.get(nil, "error.session_end"))
	end)

	if player.Parent ~= Players then
		-- 로드되는 사이에 나갔다.
		profile:EndSession()
		return
	end

	local data = profile.Data :: Types.PlayerData

	-- 차단 확인은 로드 직후에 한다.
	if data.bannedUntil ~= nil and data.bannedUntil > os.time() then
		profile:EndSession()
		player:Kick(Locale.get(data.settings and data.settings.language, "error.banned"))
		return
	end

	profiles[player] = profile

	fire(loadedListeners, player, data)
	DataService.replicate(player)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile == nil then
		return
	end

	fire(unloadingListeners, player, profile.Data)
	profile:EndSession()
	profiles[player] = nil
end

function DataService.Init()
	local ProfileStore = requireProfileStore()

	local storeName = if RunService:IsStudio()
		then GameConfig.DATASTORE_DEV
		else GameConfig.DATASTORE_PROD

	playerStore = ProfileStore.New(storeName, buildTemplate())

	ProfileStore.OnError:Connect(function(message: string, storeName_: string, profileKey: string)
		warn(`[DataService] DataStore 오류 (store={storeName_}, key={profileKey}): {message}`)
	end)

	ProfileStore.OnCriticalToggle:Connect(function(isCritical: boolean)
		if isCritical then
			warn("[DataService] DataStore 가 불안정한 상태입니다")
		else
			print("[DataService] DataStore 가 정상으로 돌아왔습니다")
		end
	end)

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	dataChangedRemote = remotesFolder:WaitForChild(Remotes.Events.DataChanged) :: RemoteEvent

	-- 설정 변경 (사운드 on/off, 언어)
	local settingRemote =
		remotesFolder:WaitForChild(Remotes.Functions.SetSetting) :: RemoteFunction
	settingRemote.OnServerInvoke = function(player: Player, key: any, value: any)
		local data = DataService.getActiveData(player)
		if data == nil then
			return { ok = false, reason = "not_ready" }
		end

		if key == "sfx" then
			if type(value) ~= "boolean" then
				return { ok = false, reason = "invalid_argument" }
			end
			data.settings.sfx = value
		elseif key == "language" then
			if not table.find(GameConfig.SUPPORTED_LANGUAGES, value) then
				return { ok = false, reason = "invalid_argument" }
			end
			data.settings.language = value
		else
			return { ok = false, reason = "invalid_argument" }
		end

		DataService.replicate(player)
		return { ok = true }
	end

	print(`[DataService] 스토어 "{storeName}" 사용`)
end

function DataService.Start()
	-- 이 스크립트보다 먼저 들어온 플레이어도 처리한다.
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EconomyService — 재화 증감의 단일 창구.

	골드/파편/방지권이 바뀌는 곳은 전부 여기를 거친다. 그래야
	(1) 모든 증감이 빠짐없이 기록되고 (2) 음수·소수 같은 잘못된 값이 저장되지 않는다.

	모든 함수는 yield 하지 않는다. 호출자는 DataService.getActiveData() 로 받은
	데이터를 그대로 넘기고, 한 요청의 모든 변경을 끝낸 뒤 마지막에
	DataService.replicate(player) 를 한 번만 호출한다.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ConfigFolder = Shared:WaitForChild("Config")
local EconomyConfig = require(ConfigFolder:WaitForChild("EconomyConfig"))
local EnhanceTable = require(ConfigFolder:WaitForChild("EnhanceTable"))

local EnhanceLogic = require(Shared:WaitForChild("Pure"):WaitForChild("EnhanceLogic"))

local AnalyticsService = require(script.Parent:WaitForChild("AnalyticsService"))
local DataService = require(script.Parent:WaitForChild("DataService"))

local EconomyService = {}
EconomyService.Name = "EconomyService"

-- 재화는 항상 0 이상의 정수로 유지한다.
local function sanitize(value: number): number
	if value ~= value then -- NaN
		return 0
	end
	return math.max(0, math.floor(value))
end

--[[
	플레이어가 "벌어들이는" 골드에 곱해지는 배수.
	게임패스(골드 획득 +20%)가 붙으면 ShopService 가 이 값을 채운다.
	구매로 지급하는 골드에는 적용하지 않는다.
]]
local goldMultiplierProvider: ((player: Player) -> number)? = nil

function EconomyService.setGoldMultiplierProvider(provider: (player: Player) -> number)
	goldMultiplierProvider = provider
end

function EconomyService.getGoldMultiplier(player: Player): number
	if goldMultiplierProvider == nil then
		return 1
	end

	local ok, multiplier = pcall(goldMultiplierProvider, player)
	if not ok or type(multiplier) ~= "number" or multiplier <= 0 then
		return 1
	end
	return multiplier
end

function EconomyService.canAfford(data: Types.PlayerData, cost: number): boolean
	return data.gold >= cost
end

--[[
	골드를 지급한다. applyMultiplier 가 true 면 게임패스 배수를 적용한다
	(플레이 보상에는 true, Robux 구매 지급에는 false).
	반환값은 실제로 지급된 양이다.
]]
function EconomyService.addGold(
	player: Player,
	data: Types.PlayerData,
	amount: number,
	reason: string,
	applyMultiplier: boolean?
): number
	if amount <= 0 then
		return 0
	end

	local granted = amount
	if applyMultiplier then
		granted = math.floor(amount * EconomyService.getGoldMultiplier(player))
	end
	granted = sanitize(granted)

	data.gold = sanitize(data.gold + granted)
	AnalyticsService.logCurrency(player, "gold", granted, reason, data.gold)
	return granted
end

-- 골드를 차감한다. 잔액이 모자라면 아무것도 바꾸지 않고 false 를 반환한다.
function EconomyService.spendGold(
	player: Player,
	data: Types.PlayerData,
	amount: number,
	reason: string
): boolean
	local cost = sanitize(amount)
	if cost == 0 then
		return true
	end
	if data.gold < cost then
		return false
	end

	data.gold = sanitize(data.gold - cost)
	AnalyticsService.logCurrency(player, "gold", -cost, reason, data.gold)
	return true
end

function EconomyService.addShards(
	player: Player,
	data: Types.PlayerData,
	amount: number,
	reason: string
): number
	local granted = sanitize(amount)
	if granted == 0 then
		return 0
	end

	data.shards = sanitize(data.shards + granted)
	AnalyticsService.logCurrency(player, "shards", granted, reason, data.shards)
	return granted
end

function EconomyService.spendShards(
	player: Player,
	data: Types.PlayerData,
	amount: number,
	reason: string
): boolean
	local cost = sanitize(amount)
	if data.shards < cost then
		return false
	end

	data.shards = sanitize(data.shards - cost)
	AnalyticsService.logCurrency(player, "shards", -cost, reason, data.shards)
	return true
end

function EconomyService.addTickets(
	player: Player,
	data: Types.PlayerData,
	amount: number,
	reason: string
): number
	local granted = sanitize(amount)
	if granted == 0 then
		return 0
	end

	data.protectTickets = sanitize(data.protectTickets + granted)
	AnalyticsService.logCurrency(player, "tickets", granted, reason, data.protectTickets)
	return granted
end

function EconomyService.spendTickets(
	player: Player,
	data: Types.PlayerData,
	amount: number,
	reason: string
): boolean
	local cost = sanitize(amount)
	if data.protectTickets < cost then
		return false
	end

	data.protectTickets = sanitize(data.protectTickets - cost)
	AnalyticsService.logCurrency(player, "tickets", -cost, reason, data.protectTickets)
	return true
end

--[[
	UTC 기준으로 날짜가 바뀌었으면 하루짜리 기록을 초기화한다.
	배틀 횟수와 오늘 상대 목록이 여기서 비워진다.
	새 날이면 true 를 반환한다(출석 보상 지급 판단에 쓴다).
]]
function EconomyService.rolloverDaily(data: Types.PlayerData, nowSeconds: number?): boolean
	local today = math.floor((nowSeconds or os.time()) / 86400)

	if data.daily.lastLoginDay == today then
		return false
	end

	local isConsecutive = data.daily.lastLoginDay == today - 1
	data.daily.streak = if isConsecutive then data.daily.streak + 1 else 1
	data.daily.lastLoginDay = today
	data.daily.battlesToday = 0
	data.daily.opponentsToday = {}

	return true
end

--[[
	출석 보상. 연속 일수에 따라 금액이 커지고, 표 끝을 넘으면 마지막 값을 계속 준다.
	rolloverDaily 가 true 를 돌려준 직후에만 호출한다.
]]
function EconomyService.grantDailyLogin(player: Player, data: Types.PlayerData): number
	local rewards = EconomyConfig.DAILY_LOGIN_GOLD
	local index = math.clamp(data.daily.streak, 1, #rewards)
	local amount = rewards[index]

	return EconomyService.addGold(player, data, amount, "daily_login", true)
end

--[[
	파편 또는 골드로 파괴 방지권을 산다.
	method: "shards" | "gold"
]]
function EconomyService.buyProtectTickets(
	player: Player,
	method: string,
	count: number
): Types.TicketPurchaseResponse
	if method ~= "shards" and method ~= "gold" then
		return { ok = false, reason = "invalid_argument" }
	end
	if type(count) ~= "number" or count ~= math.floor(count) or count < 1 or count > 100 then
		return { ok = false, reason = "invalid_argument" }
	end

	local data = DataService.getActiveData(player)
	if data == nil then
		return { ok = false, reason = "not_ready" }
	end

	if method == "shards" then
		local price = EnhanceTable.SHARDS_PER_TICKET * count
		if not EconomyService.spendShards(player, data, price, "ticket_exchange") then
			return { ok = false, reason = "not_enough_shards" }
		end
	else
		local price = EconomyConfig.PROTECT_TICKET_GOLD_PRICE * count
		if not EconomyService.spendGold(player, data, price, "ticket_purchase") then
			return { ok = false, reason = "not_enough_gold" }
		end
	end

	EconomyService.addTickets(player, data, count, `ticket_{method}`)
	DataService.replicate(player)

	return { ok = true, tickets = data.protectTickets }
end

-- 파편으로 지금 살 수 있는 방지권 수 (UI 표시용)
function EconomyService.affordableTickets(data: Types.PlayerData): number
	return EnhanceLogic.ticketsAffordable(data.shards, EnhanceTable.SHARDS_PER_TICKET)
end

function EconomyService.Init()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)

	local ticketRemote =
		remotesFolder:WaitForChild(Remotes.Functions.BuyProtectTicket) :: RemoteFunction
	ticketRemote.OnServerInvoke = function(player: Player, method: any, count: any)
		return EconomyService.buyProtectTickets(player, tostring(method), tonumber(count) or 0)
	end
end

function EconomyService.Start()
	-- 접속 시 출석 확인
	DataService.onLoaded(function(player, data)
		if EconomyService.rolloverDaily(data) then
			EconomyService.grantDailyLogin(player, data)
			DataService.replicate(player)
			AnalyticsService.logFunnel(player, "daily_login", { streak = data.daily.streak })
		end
	end)

	-- 플레이 시간 보상
	task.spawn(function()
		while true do
			task.wait(EconomyConfig.PLAYTIME_REWARD_INTERVAL_SECONDS)

			for player, data in DataService.getAllActive() do
				EconomyService.addGold(
					player,
					data,
					EconomyConfig.PLAYTIME_REWARD_GOLD,
					"playtime",
					true
				)
				DataService.replicate(player)
			end
		end
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">EnhanceService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EnhanceService — 강화 요청 처리.

	흐름 (지시서 4절):
	  1) 레이트 리밋 + 동시 요청 락
	  2) 점검 모드 / 프로필 로드 상태 확인
	  3) 레벨 < MAX, 골드 >= 비용 확인
	  4) 골드 차감 → 결과 계산 → 레벨/통계/도감 갱신을 yield 없이 한 번에
	  5) 결과 반환
	  6) 경제/결과 로그

	난수는 서버에서 Random 객체 하나를 만들어 재사용한다.
	클라이언트가 보낸 값은 "방지권을 쓸지" 하나뿐이고, 그것도 boolean 인지 검사한다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ConfigFolder = Shared:WaitForChild("Config")
local EnhanceTable = require(ConfigFolder:WaitForChild("EnhanceTable"))
local Weapons = require(ConfigFolder:WaitForChild("Weapons"))

local EnhanceLogic = require(Shared:WaitForChild("Pure"):WaitForChild("EnhanceLogic"))

local services = script.Parent
local DataService = require(services:WaitForChild("DataService"))
local EconomyService = require(services:WaitForChild("EconomyService"))
local AnalyticsService = require(services:WaitForChild("AnalyticsService"))
local LiveOpsService = require(services:WaitForChild("LiveOpsService"))
local RateLimiter = require(services:WaitForChild("RateLimiter"))
local CodexService = require(services:WaitForChild("CodexService"))

local EnhanceService = {}
EnhanceService.Name = "EnhanceService"

-- 서버 난수. 요청마다 새로 만들지 않는다.
local rng = Random.new()

-- 플레이어당 초당 3회, 동시 처리 1건
local limiter = RateLimiter.new({ maxRequests = 3, windowSeconds = 1 })

-- 이름 변경은 필터링 API 를 부르므로 훨씬 드물게만 허용한다.
local renameLimiter = RateLimiter.new({ maxRequests = 2, windowSeconds = 30 })

local MAX_NAME_LENGTH = 16

local feedRemote: RemoteEvent? = nil

local function fail(reason: string): Types.Failure
	return { ok = false, reason = reason }
end

-- 현재 적용 중인 이벤트까지 반영한 최종 확률
local function finalOddsFor(level: number): EnhanceLogic.Odds?
	local base = EnhanceTable.Odds[level]
	if base == nil then
		return nil
	end
	return EnhanceLogic.applyBuff(base, LiveOpsService.getSuccessBuff())
end

local function buildDisplayOdds(level: number): Types.DisplayOdds
	local odds = finalOddsFor(level)
	local event = LiveOpsService.getActiveEvent()

	if odds == nil then
		-- 최대 레벨: 더 이상 강화할 수 없다.
		return {
			level = level,
			success = 0,
			keep = 0,
			destroy = 0,
			cost = 0,
			eventName = if event then event.nameKey else nil,
		}
	end

	return {
		level = level,
		success = odds.success,
		keep = odds.keep,
		destroy = odds.destroy,
		cost = odds.cost,
		eventName = if event then event.nameKey else nil,
	}
end

local function broadcastIfNotable(player: Player, data: Types.PlayerData, level: number)
	if level < EnhanceTable.BROADCAST_MIN_LEVEL or feedRemote == nil then
		return
	end

	local weapon = Weapons.get(data.weapon.id)
	feedRemote:FireAllClients({
		kind = "broadcast",
		playerName = player.DisplayName,
		weaponKey = if weapon then weapon.nameKey else "",
		level = level,
	})
end

--[[
	실제 처리. 여기에는 yield 가 하나도 없다.
	(task.wait, WaitForChild, :Async 호출을 넣으면 그 사이에 세션이 끝나거나
	 같은 플레이어의 다음 요청이 끼어들어 골드/레벨이 어긋날 수 있다)
]]
local function process(player: Player, wantsProtect: boolean): Types.EnhanceResponse
	if LiveOpsService.isMaintenance() then
		return fail("maintenance")
	end

	local data = DataService.getActiveData(player)
	if data == nil then
		return fail("not_ready")
	end

	local level = data.weapon.level
	if level >= EnhanceTable.MAX_LEVEL then
		return fail("max_level")
	end

	local odds = finalOddsFor(level)
	if odds == nil then
		return fail("max_level")
	end

	if not EconomyService.canAfford(data, odds.cost) then
		return fail("not_enough_gold")
	end

	-- 여기서부터 실제 변경. 실패할 수 있는 조건은 위에서 모두 걸렀다.
	EconomyService.spendGold(player, data, odds.cost, "enhance_cost")

	local result = EnhanceLogic.resolve({
		level = level,
		maxLevel = EnhanceTable.MAX_LEVEL,
		odds = odds,
		roll = rng:NextNumber() * 100,
		useProtect = wantsProtect,
		protectTickets = data.protectTickets,
		shardExponent = EnhanceTable.SHARD_EXPONENT,
	})

	data.weapon.level = result.newLevel
	data.stats.enhanceTries += 1

	-- 연속 "유지" 기록 (업적용)
	if result.outcome == "keep" then
		data.stats.keepStreak += 1
		if data.stats.keepStreak > data.stats.bestKeepStreak then
			data.stats.bestKeepStreak = data.stats.keepStreak
		end
	else
		data.stats.keepStreak = 0
	end

	if result.outcome == "success" then
		data.stats.enhanceSuccess += 1
		if result.newLevel > data.stats.highestLevel then
			data.stats.highestLevel = result.newLevel
		end
		CodexService.recordWeaponLevel(player, data, result.newLevel)
	elseif result.outcome == "destroy" then
		data.stats.destroyed += 1
		if result.shardsGained > 0 then
			EconomyService.addShards(player, data, result.shardsGained, "enhance_destroy")
		end
	elseif result.outcome == "protected" then
		EconomyService.spendTickets(player, data, result.ticketsUsed, "enhance_protect")
		data.stats.ticketsUsed += result.ticketsUsed
	end

	CodexService.evaluate(player, data)

	AnalyticsService.logEnhance(player, level, result.outcome, odds.cost)

	-- 첫 1분 튜토리얼 퍼널: 몇 명이 1/2/3회차까지 오는지 본다.
	if data.stats.enhanceTries <= 3 then
		AnalyticsService.logFunnel(player, `tutorial_enhance_{data.stats.enhanceTries}`)
	end

	if result.outcome == "success" then
		broadcastIfNotable(player, data, result.newLevel)
	end

	return {
		ok = true,
		result = result.outcome,
		newLevel = result.newLevel,
		gold = data.gold,
		shardsGained = result.shardsGained,
		odds = buildDisplayOdds(result.newLevel),
	}
end

--[[
	강화 1회 요청의 입구.
	useProtect: 파괴 방지권을 쓸지 여부. 이것이 클라이언트가 보내는 유일한 값이다.
]]
local function handleEnhance(player: Player, useProtect: any): Types.EnhanceResponse
	-- 1) 입력 타입 검증 (nil 은 "사용 안 함"으로 본다)
	if useProtect ~= nil and type(useProtect) ~= "boolean" then
		return fail("invalid_argument")
	end
	local wantsProtect: boolean = useProtect == true

	-- 2) 레이트 리밋
	if not limiter:consume(player.UserId) then
		return fail("too_fast")
	end

	-- 3) 동시 처리 1건
	if not limiter:tryLock(player.UserId) then
		return fail("busy")
	end

	-- 처리 중 예기치 못한 오류가 나도 락은 반드시 풀어야 한다.
	-- (락이 남으면 그 플레이어는 다시는 강화할 수 없게 된다)
	local ok, response = xpcall(process, debug.traceback, player, wantsProtect)

	limiter:unlock(player.UserId)

	if not ok then
		warn(`[EnhanceService] 처리 중 오류 ({player.UserId}):\n{response}`)
		return fail("unknown")
	end

	if response.ok then
		DataService.replicate(player)
	end

	return response
end

--[[
	무기 판매. 현재 레벨의 판매가만큼 골드를 주고 레벨 0 으로 되돌린다.
	강화와 같은 레이트 리밋/락을 쓴다.
]]
local function processSell(player: Player): Types.SellResponse
	if LiveOpsService.isMaintenance() then
		return fail("maintenance")
	end

	local data = DataService.getActiveData(player)
	if data == nil then
		return fail("not_ready")
	end

	local level = data.weapon.level
	local value = EnhanceTable.SellValue[level]

	if value == nil or value <= 0 then
		return fail("nothing_to_sell")
	end

	local granted = EconomyService.addGold(player, data, value, "weapon_sell", true)
	data.weapon.level = 0

	-- 지어 준 이름은 남겨 둔다.
	-- 무기는 바뀌어도 "그 사람이 부르는 이름"은 이어지는 편이 쓰기 편하다.
	-- (파괴됐을 때도 같은 이유로 지우지 않는다)

	return {
		ok = true,
		goldGained = granted,
		gold = data.gold,
		odds = buildDisplayOdds(0),
	}
end

local function handleSell(player: Player): Types.SellResponse
	if not limiter:consume(player.UserId) then
		return fail("too_fast")
	end
	if not limiter:tryLock(player.UserId) then
		return fail("busy")
	end

	local ok, response = xpcall(processSell, debug.traceback, player)

	limiter:unlock(player.UserId)

	if not ok then
		warn(`[EnhanceService] 판매 처리 중 오류 ({player.UserId}):\n{response}`)
		return fail("unknown")
	end

	if response.ok then
		DataService.replicate(player)
	end

	return response
end

--[[
	무기 이름 짓기.

	필터링(FilterStringAsync)은 yield 하는 웹 요청이라 다른 처리와 성격이 다르다.
	그래서 순서를 이렇게 잡는다.
	  1) 형식 검사 (길이, 빈 문자열, 올바른 UTF-8)
	  2) 필터링 (여기서 yield)
	  3) yield 가 끝난 뒤에 데이터를 "다시" 가져와서 저장
	3번이 중요하다. 필터링을 기다리는 동안 플레이어가 나가거나 세션이 끝났을 수
	있으므로, yield 이전에 잡아 둔 데이터 참조를 그대로 쓰면 안 된다.

	저장하는 값도 표시하는 값도 전부 필터링을 통과한 문자열이다.
]]
local function handleRename(player: Player, rawName: any): Types.RenameResponse
	if type(rawName) ~= "string" then
		return fail("invalid_argument")
	end

	local trimmed = string.match(rawName, "^%s*(.-)%s*$") or ""
	local length = utf8.len(trimmed)

	if length == nil or length == 0 or length > MAX_NAME_LENGTH then
		return fail("invalid_name")
	end

	if not renameLimiter:consume(player.UserId) then
		return fail("too_fast")
	end

	-- 여기서부터 yield 한다.
	local ok, filterResult = pcall(function()
		return TextService:FilterStringAsync(
			trimmed,
			player.UserId,
			Enum.TextFilterContext.PublicChat
		)
	end)

	if not ok then
		warn(`[EnhanceService] 이름 필터링 실패: {filterResult}`)
		return fail("filter_failed")
	end

	-- 다른 사람에게도 보이는 이름이므로 broadcast 용 결과를 쓴다.
	local okBroadcast, filtered = pcall(function()
		return filterResult:GetNonChatStringForBroadcastAsync()
	end)

	if not okBroadcast or type(filtered) ~= "string" or filtered == "" then
		warn(`[EnhanceService] 필터 결과를 얻지 못했습니다: {filtered}`)
		return fail("filter_failed")
	end

	-- yield 가 끝났으니 데이터를 다시 가져온다.
	local data = DataService.getActiveData(player)
	if data == nil then
		return fail("not_ready")
	end

	data.weapon.customName = filtered
	DataService.replicate(player)

	return { ok = true, name = filtered }
end

local function handleGetOdds(player: Player): Types.DisplayOdds | Types.Failure
	local data = DataService.getData(player)
	if data == nil then
		return fail("not_ready")
	end
	return buildDisplayOdds(data.weapon.level)
end

-- 접속 직후 클라이언트가 현재 상태를 한 번에 받아 가는 경로
local function handleGetState(player: Player): { ok: true, data: Types.PlayerData, odds: Types.DisplayOdds } | Types.Failure
	local data = DataService.getData(player)
	if data == nil then
		return fail("not_ready")
	end

	return {
		ok = true,
		data = data,
		odds = buildDisplayOdds(data.weapon.level),
	}
end

function EnhanceService.Init()
	-- 확률표가 깨진 채로 서버가 뜨는 일이 없도록 시작할 때 검사한다.
	local problem = EnhanceTable.validate()
	if problem ~= nil then
		error(`[EnhanceService] 확률표가 잘못되었습니다: {problem}`, 0)
	end

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)

	local enhanceRemote = remotesFolder:WaitForChild(Remotes.Functions.Enhance) :: RemoteFunction
	enhanceRemote.OnServerInvoke = handleEnhance

	local sellRemote = remotesFolder:WaitForChild(Remotes.Functions.SellWeapon) :: RemoteFunction
	sellRemote.OnServerInvoke = handleSell

	local renameRemote =
		remotesFolder:WaitForChild(Remotes.Functions.RenameWeapon) :: RemoteFunction
	renameRemote.OnServerInvoke = handleRename

	local oddsRemote = remotesFolder:WaitForChild(Remotes.Functions.GetOdds) :: RemoteFunction
	oddsRemote.OnServerInvoke = handleGetOdds

	local stateRemote = remotesFolder:WaitForChild(Remotes.Functions.GetState) :: RemoteFunction
	stateRemote.OnServerInvoke = handleGetState

	feedRemote = remotesFolder:WaitForChild(Remotes.Events.FeedMessage) :: RemoteEvent
end

function EnhanceService.Start()
	Players.PlayerRemoving:Connect(function(player)
		limiter:clear(player.UserId)
		renameLimiter:clear(player.UserId)
	end)
end

--[[
	버튼과 채팅 명령이 "같은 서버 경로"를 타도록 공개한다.
	ChatCommandService 는 이 함수를 호출하며, 리모트 핸들러와 완전히 같은
	검증·레이트 리밋·락을 거친다.
]]
function EnhanceService.requestEnhance(player: Player, useProtect: boolean?): Types.EnhanceResponse
	return handleEnhance(player, useProtect)
end

function EnhanceService.requestSell(player: Player): Types.SellResponse
	return handleSell(player)
end

function EnhanceService.getDisplayOdds(level: number): Types.DisplayOdds
	return buildDisplayOdds(level)
end

return EnhanceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	LeaderboardService — 전체 순위 (최고 강화 레벨 / 배틀 레이팅).

	OrderedDataStore 는 호출 예산이 빠듯해서 아무 때나 쓰면 안 된다.
	그래서 쓰기는 두 경우로 제한한다.
	  - 플레이어가 나갈 때 (그 사람 것 1건)
	  - 5분 주기로 접속 중인 사람들 (값이 바뀐 사람만)

	쓰기 전에는 항상 DataStoreService:GetRequestBudgetForRequestType 으로
	남은 예산을 확인하고, 모자라면 이번 차례를 건너뛴다.
	순위표가 조금 늦게 갱신되는 건 괜찮지만, 예산이 바닥나면
	데이터 저장까지 영향을 받기 때문이다.

	읽기는 60초 동안 캐시해서 같은 서버의 여러 사람이 눌러도 한 번만 조회한다.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("Game"))

local DataService = require(script.Parent:WaitForChild("DataService"))

local LeaderboardService = {}
LeaderboardService.Name = "LeaderboardService"

local TOP_COUNT = 50
local WRITE_INTERVAL_SECONDS = 300
local CACHE_SECONDS = 60
local MIN_BUDGET = 10 -- 이만큼은 남겨 둔다

type BoardKind = "level" | "rating"

local stores: { [string]: OrderedDataStore } = {}

-- 마지막으로 써 넣은 값. 바뀌지 않았으면 다시 쓰지 않는다.
local lastWritten: { [string]: { [number]: number } } = {
	level = {},
	rating = {},
}

type Cache = {
	entries: { Types.LeaderboardEntry },
	fetchedAt: number,
}

local caches: { [string]: Cache } = {}
local nameCache: { [number]: string } = {}

local function hasBudget(requestType: Enum.DataStoreRequestType): boolean
	local ok, budget = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(requestType)
	end)
	return ok and budget > MIN_BUDGET
end

local function valueFor(kind: BoardKind, data: Types.PlayerData): number
	if kind == "level" then
		return data.stats.highestLevel
	end
	return data.stats.rating
end

--[[
	한 사람의 점수를 올린다. yield 한다.
	실패해도 게임 진행에는 영향이 없으므로 경고만 남긴다.
]]
local function writeEntry(kind: BoardKind, userId: number, value: number)
	local store = stores[kind]
	if store == nil then
		return
	end

	if lastWritten[kind][userId] == value then
		return -- 바뀐 게 없다
	end

	if not hasBudget(Enum.DataStoreRequestType.SetIncrementSortedAsync) then
		return -- 예산이 모자라면 다음 차례에
	end

	local ok, err = pcall(function()
		store:SetAsync(tostring(userId), value)
	end)

	if ok then
		lastWritten[kind][userId] = value
	else
		warn(`[LeaderboardService] {kind} 순위 기록 실패 ({userId}): {err}`)
	end
end

local function displayName(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end

	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)

	local resolved = if ok and type(name) == "string" then name else `#{userId}`
	nameCache[userId] = resolved
	return resolved
end

-- 상위 목록을 읽는다. yield 한다.
local function fetchTop(kind: BoardKind): { Types.LeaderboardEntry }
	local cache = caches[kind]
	if cache and os.clock() - cache.fetchedAt < CACHE_SECONDS then
		return cache.entries
	end

	local store = stores[kind]
	if store == nil then
		return {}
	end

	if not hasBudget(Enum.DataStoreRequestType.GetSortedAsync) then
		return if cache then cache.entries else {}
	end

	local ok, result = pcall(function()
		local pages = store:GetSortedAsync(false, TOP_COUNT) -- 내림차순
		return pages:GetCurrentPage()
	end)

	if not ok then
		warn(`[LeaderboardService] {kind} 순위 조회 실패: {result}`)
		return if cache then cache.entries else {}
	end

	local entries: { Types.LeaderboardEntry } = {}
	for rank, row in result :: { { key: string, value: number } } do
		local userId = tonumber(row.key) or 0
		table.insert(entries, {
			rank = rank,
			userId = userId,
			name = displayName(userId),
			value = row.value,
		})
	end

	caches[kind] = { entries = entries, fetchedAt = os.clock() }
	return entries
end

local function handleGetLeaderboard(_player: Player, kind: any): { Types.LeaderboardEntry }
	if kind ~= "level" and kind ~= "rating" then
		return {}
	end
	return fetchTop(kind)
end

function LeaderboardService.Init()
	local ok, err = pcall(function()
		stores.level = DataStoreService:GetOrderedDataStore(GameConfig.ORDERED_STORE_LEVEL)
		stores.rating = DataStoreService:GetOrderedDataStore(GameConfig.ORDERED_STORE_RATING)
	end)

	if not ok then
		warn(`[LeaderboardService] 순위 저장소를 열지 못했습니다: {err}`)
	end

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	local boardRemote =
		remotesFolder:WaitForChild(Remotes.Functions.GetLeaderboard) :: RemoteFunction
	boardRemote.OnServerInvoke = handleGetLeaderboard
end

function LeaderboardService.Start()
	-- 나갈 때 그 사람 점수만 기록
	DataService.onUnloading(function(player, data)
		task.spawn(function()
			writeEntry("level", player.UserId, valueFor("level", data))
			writeEntry("rating", player.UserId, valueFor("rating", data))
		end)
	end)

	-- 5분 주기로 접속 중인 사람들 기록
	task.spawn(function()
		while true do
			task.wait(WRITE_INTERVAL_SECONDS)

			for player, data in DataService.getAllActive() do
				writeEntry("level", player.UserId, valueFor("level", data))
				writeEntry("rating", player.UserId, valueFor("rating", data))
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastWritten.level[player.UserId] = nil
		lastWritten.rating[player.UserId] = nil
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">LiveOpsService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	LiveOpsService — 확률 버프 이벤트, 공지, 점검 모드.

	설정은 DataStore 키 하나에 통째로 들어 있고, 모든 서버가 주기적으로 읽는다.
	게임을 다시 올리지 않고도 이벤트를 켜고 끌 수 있다.

	저장 형태:
	    {
	      maintenance = false,
	      notice = "" ,                       -- 비어 있으면 공지 없음
	      event = {                           -- nil 이면 진행 중인 이벤트 없음
	        id = "weekend1",
	        nameKey = "event.weekend",        -- Locale 키 또는 그냥 문구
	        successBuff = 5,                  -- 성공 확률에 더할 %p
	        endsAt = 1790000000,              -- UTC 종료 시각
	      },
	    }

	읽기 실패는 조용히 넘어가고 직전 설정을 유지한다.
	통신이 잠깐 끊겼다고 이벤트가 꺼지거나 점검이 걸리면 안 되기 때문이다.
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("Game"))

local LiveOpsService = {}
LiveOpsService.Name = "LiveOpsService"

local POLL_SECONDS = 60
local CONFIG_KEY = "config"

export type ActiveEvent = {
	id: string,
	nameKey: string,
	successBuff: number,
	endsAt: number,
}

export type LiveConfig = {
	maintenance: boolean,
	notice: string,
	event: ActiveEvent?,
}

local current: LiveConfig = {
	maintenance = false,
	notice = "",
	event = nil,
}

local store: DataStore? = nil
local changedRemote: RemoteEvent? = nil

local function storeName(): string
	local base = if RunService:IsStudio() then GameConfig.DATASTORE_DEV else GameConfig.DATASTORE_PROD
	return `{base}_LiveOps`
end

-- 저장된 값이 우리가 기대하는 모양인지 확인한다. 이상하면 무시한다.
local function sanitize(raw: any): LiveConfig?
	if type(raw) ~= "table" then
		return nil
	end

	local event: ActiveEvent? = nil
	local rawEvent = raw.event

	if type(rawEvent) == "table" then
		local buff = tonumber(rawEvent.successBuff) or 0
		local endsAt = tonumber(rawEvent.endsAt) or 0

		if endsAt > os.time() and buff > 0 then
			event = {
				id = tostring(rawEvent.id or "event"),
				nameKey = tostring(rawEvent.nameKey or "event.default"),
				successBuff = math.clamp(buff, 0, 100),
				endsAt = endsAt,
			}
		end
	end

	return {
		maintenance = raw.maintenance == true,
		notice = if type(raw.notice) == "string" then raw.notice else "",
		event = event,
	}
end

local function broadcast()
	if changedRemote == nil then
		return
	end

	changedRemote:FireAllClients({
		maintenance = current.maintenance,
		notice = current.notice,
		event = current.event,
	})
end

local function apply(config: LiveConfig)
	local changed = config.maintenance ~= current.maintenance
		or config.notice ~= current.notice
		or (config.event ~= nil) ~= (current.event ~= nil)
		or (config.event ~= nil and current.event ~= nil and config.event.id ~= current.event.id)

	current = config

	if changed then
		broadcast()
		print(
			`[LiveOps] 설정 갱신 — 점검 {current.maintenance}, `
				.. `이벤트 {if current.event then current.event.id else "없음"}`
		)
	end
end

local function poll()
	if store == nil then
		return
	end

	local ok, raw = pcall(function()
		return (store :: DataStore):GetAsync(CONFIG_KEY)
	end)

	if not ok then
		warn(`[LiveOps] 설정을 읽지 못했습니다: {raw}`)
		return -- 직전 설정을 그대로 유지한다
	end

	local sanitized = sanitize(raw)
	if sanitized ~= nil then
		apply(sanitized)
	end
end

--------------------------------------------------------------------------------
-- 다른 서비스가 쓰는 조회 함수
--------------------------------------------------------------------------------

function LiveOpsService.getSuccessBuff(): number
	local event = LiveOpsService.getActiveEvent()
	return if event then event.successBuff else 0
end

function LiveOpsService.getActiveEvent(): ActiveEvent?
	local event = current.event
	if event ~= nil and os.time() >= event.endsAt then
		current.event = nil
		broadcast()
		return nil
	end
	return event
end

function LiveOpsService.isMaintenance(): boolean
	return current.maintenance
end

function LiveOpsService.getNotice(): string
	return current.notice
end

function LiveOpsService.getConfig(): LiveConfig
	return current
end

--------------------------------------------------------------------------------
-- AdminService 가 쓰는 변경 함수 (즉시 적용 + DataStore 저장)
--------------------------------------------------------------------------------

-- 이 함수는 yield 한다. 성공 여부를 반환한다.
function LiveOpsService.save(config: LiveConfig): boolean
	apply(config)

	if store == nil then
		return false
	end

	local ok, err = pcall(function()
		(store :: DataStore):SetAsync(CONFIG_KEY, {
			maintenance = config.maintenance,
			notice = config.notice,
			event = config.event,
		})
	end)

	if not ok then
		warn(`[LiveOps] 설정 저장 실패: {err}`)
	end

	return ok
end

function LiveOpsService.setMaintenance(enabled: boolean): boolean
	local config = LiveOpsService.getConfig()
	return LiveOpsService.save({
		maintenance = enabled,
		notice = config.notice,
		event = config.event,
	})
end

function LiveOpsService.setNotice(notice: string): boolean
	local config = LiveOpsService.getConfig()
	return LiveOpsService.save({
		maintenance = config.maintenance,
		notice = notice,
		event = config.event,
	})
end

function LiveOpsService.setEvent(event: ActiveEvent?): boolean
	local config = LiveOpsService.getConfig()
	return LiveOpsService.save({
		maintenance = config.maintenance,
		notice = config.notice,
		event = event,
	})
end

--------------------------------------------------------------------------------

function LiveOpsService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(storeName())
	end)

	if ok then
		store = result
	else
		warn(`[LiveOps] 설정 저장소를 열지 못했습니다: {result}`)
	end

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	changedRemote = remotesFolder:WaitForChild(Remotes.Events.LiveOpsChanged) :: RemoteEvent
end

function LiveOpsService.Start()
	task.spawn(function()
		while true do
			poll()
			task.wait(POLL_SECONDS)
		end
	end)
end

return LiveOpsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RateLimiter — 플레이어별 요청 속도 제한과 동시 요청 락.

	생명주기(Init/Start)가 없는 유틸 모듈이라 부트스트랩 순서 목록에 넣지 않는다.
	Roblox API 를 쓰지 않고 시계 함수를 주입받으므로 Studio 밖에서도 테스트된다.

	사용 예:
		local limiter = RateLimiter.new({ maxRequests = 3, windowSeconds = 1 })

		if not limiter:consume(userId) then
			return { ok = false, reason = "too_fast" }
		end
		if not limiter:tryLock(userId) then
			return { ok = false, reason = "busy" }
		end
		-- ... 처리 ...
		limiter:unlock(userId)
]]

local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type Config = {
	maxRequests: number, -- 창(window) 당 허용 요청 수
	windowSeconds: number,
	clock: (() -> number)?, -- 테스트용 주입. 기본은 os.clock
}

type Self = {
	maxRequests: number,
	windowSeconds: number,
	clock: () -> number,
	history: { [number]: { number } },
	locks: { [number]: true },
}

export type Limiter = typeof(setmetatable({} :: Self, RateLimiter))

function RateLimiter.new(config: Config): Limiter
	assert(config.maxRequests > 0, "maxRequests 는 1 이상이어야 합니다")
	assert(config.windowSeconds > 0, "windowSeconds 는 0 보다 커야 합니다")

	return setmetatable({
		maxRequests = config.maxRequests,
		windowSeconds = config.windowSeconds,
		clock = config.clock or os.clock,
		history = {},
		locks = {},
	} :: Self, RateLimiter)
end

--[[
	요청 1건을 기록하고 허용 여부를 반환한다.
	허용되지 않으면 아무것도 기록하지 않는다(거절된 요청이 다음 요청을 더 막지 않도록).
]]
function RateLimiter.consume(self: Limiter, userId: number): boolean
	local now = self.clock()
	local stamps = self.history[userId]

	if not stamps then
		stamps = {}
		self.history[userId] = stamps
	end

	-- 창 밖으로 나간 기록을 앞에서부터 버린다.
	local cutoff = now - self.windowSeconds
	while #stamps > 0 and stamps[1] <= cutoff do
		table.remove(stamps, 1)
	end

	if #stamps >= self.maxRequests then
		return false
	end

	table.insert(stamps, now)
	return true
end

-- 처리 중인 요청이 있으면 false. 성공하면 반드시 unlock 을 호출해야 한다.
function RateLimiter.tryLock(self: Limiter, userId: number): boolean
	if self.locks[userId] then
		return false
	end
	self.locks[userId] = true
	return true
end

function RateLimiter.unlock(self: Limiter, userId: number)
	self.locks[userId] = nil
end

function RateLimiter.isLocked(self: Limiter, userId: number): boolean
	return self.locks[userId] == true
end

-- 플레이어가 나갈 때 기록을 정리한다(메모리 누수 방지).
function RateLimiter.clear(self: Limiter, userId: number)
	self.history[userId] = nil
	self.locks[userId] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ShopService — 게임패스와 개발자 상품.

	설계 원칙 (지시서 7절):
	- Robux 로 "확률 결과 자체"를 파는 상품은 만들지 않는다.
	  게임패스는 편의/꾸미기, 개발자 상품은 골드 팩과 방지권 묶음까지만.
	- 확률표는 상품 여부와 관계없이 강화 화면에서 항상 볼 수 있다.

	ProcessReceipt 구현은 ProfileStore 공식 문서의 "PurchaseId 캐싱" 방식을 따른다.
	핵심은 "지급했다"가 아니라 "지급한 사실이 DataStore 에 저장됐다"를 확인한 뒤에야
	PurchaseGranted 를 돌려준다는 것이다. 그래야 지급 직후 서버가 죽어도
	플레이어가 산 것을 잃지 않는다.

	  1) 프로필이 아직 안 열렸으면 NotProcessedYet (다음에 다시 물어본다)
	  2) purchaseHistory 에 PurchaseId 가 있으면 이미 지급한 것 → 중복 지급 안 함
	  3) 지급과 기록을 같은 프로필 업데이트 안에서 처리
	  4) LastSavedData 에 그 PurchaseId 가 보일 때까지 기다린 뒤 PurchaseGranted

	ProcessReceipt 콜백은 서버 전체에 딱 하나만 설정할 수 있다. 여기서만 설정한다.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ConfigFolder = Shared:WaitForChild("Config")
local Products = require(ConfigFolder:WaitForChild("Products"))
local EconomyConfig = require(ConfigFolder:WaitForChild("EconomyConfig"))

local services = script.Parent
local DataService = require(services:WaitForChild("DataService"))
local EconomyService = require(services:WaitForChild("EconomyService"))
local AnalyticsService = require(services:WaitForChild("AnalyticsService"))

local ShopService = {}
ShopService.Name = "ShopService"

-- userId → { gamePassKey → 보유 여부 }
local ownership: { [number]: { [string]: boolean } } = {}

local function fail(reason: string): Types.Failure
	return { ok = false, reason = reason }
end

local function ownsPass(player: Player, key: string): boolean
	local owned = ownership[player.UserId]
	return owned ~= nil and owned[key] == true
end

--[[
	게임패스 보유 여부를 조회한다. 이 함수는 yield 한다(웹 요청).
	실패하면 "보유하지 않음"으로 두지 않고 이전 값을 유지한다
	(일시적인 통신 실패로 혜택이 사라지면 안 되므로).
]]
local function refreshOwnership(player: Player)
	local owned = ownership[player.UserId]
	if owned == nil then
		owned = {}
		ownership[player.UserId] = owned
	end

	for key, gamePassId in Products.GamePasses do
		if gamePassId == 0 then
			continue -- 아직 ID 를 넣지 않은 상품
		end

		local ok, result = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamePassId)
		end)

		if ok then
			owned[key] = result
		else
			warn(`[ShopService] 게임패스 조회 실패 ({key}): {result}`)
		end
	end
end

--------------------------------------------------------------------------------
-- 개발자 상품 지급
--------------------------------------------------------------------------------

-- 상품 하나를 지급한다. yield 하지 않는다.
local function grantProduct(player: Player, data: Types.PlayerData, product: Products.DeveloperProduct)
	if product.goldAmount > 0 then
		-- Robux 로 산 골드에는 게임패스 배수를 적용하지 않는다.
		EconomyService.addGold(player, data, product.goldAmount, `purchase_{product.key}`, false)
	end
	if product.ticketAmount > 0 then
		EconomyService.addTickets(player, data, product.ticketAmount, `purchase_{product.key}`)
	end
end

local function historyContains(history: { string }, purchaseId: string): boolean
	return table.find(history, purchaseId) ~= nil
end

--[[
	지급 → 저장 확인까지 기다린다.
	이 함수는 yield 한다. ProcessReceipt 는 결과를 돌려줄 때까지 기다려 주므로 괜찮다.
]]
local function grantAndConfirm(
	player: Player,
	profile: any,
	purchaseId: string,
	product: Products.DeveloperProduct
): Enum.ProductPurchaseDecision
	if not profile:IsActive() then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local data = profile.Data :: Types.PlayerData

	-- 아직 지급하지 않았다면 지급과 기록을 함께 처리한다.
	if not historyContains(data.purchaseHistory, purchaseId) then
		local ok, err = pcall(grantProduct, player, data, product)
		if not ok then
			warn(`[ShopService] 지급 실패 ({product.key}): {err}`)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		-- 기록이 무한히 커지지 않도록 오래된 것부터 버린다.
		while #data.purchaseHistory >= Products.PURCHASE_HISTORY_LIMIT do
			table.remove(data.purchaseHistory, 1)
		end
		table.insert(data.purchaseHistory, purchaseId)

		DataService.replicate(player)
		AnalyticsService.logFunnel(player, "purchase_granted", { product = product.key })
	end

	-- 저장이 확인될 때까지 기다린다.
	local function isSaved(): boolean
		local saved = profile.LastSavedData
		if saved == nil or saved.purchaseHistory == nil then
			return false
		end
		return historyContains(saved.purchaseHistory, purchaseId)
	end

	if isSaved() then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	while profile:IsActive() do
		local before = profile.LastSavedData
		profile:Save()

		if profile.LastSavedData == before then
			profile.OnAfterSave:Wait()
		end

		if isSaved() then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end

		if profile:IsActive() then
			task.wait(10)
		end
	end

	-- 저장을 확인하지 못했다. 다음에 다시 물어보게 둔다.
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if player == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local product = Products.byProductId(receipt.ProductId)
	if product == nil then
		warn(`[ShopService] 모르는 상품 ID: {receipt.ProductId}`)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- 프로필이 열릴 때까지 기다린다(방금 접속한 직후일 수 있다).
	local profile = DataService.getProfile(player)
	while profile == nil and player.Parent == Players do
		task.wait()
		profile = DataService.getProfile(player)
	end

	if profile == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	return grantAndConfirm(player, profile, tostring(receipt.PurchaseId), product)
end

--------------------------------------------------------------------------------
-- 리모트
--------------------------------------------------------------------------------

local function handleGetShopItems(player: Player): { Types.ShopItem }
	local items: { Types.ShopItem } = {}

	for key, gamePassId in Products.GamePasses do
		if gamePassId == 0 then
			continue -- ID 를 넣지 않은 상품은 노출하지 않는다
		end

		table.insert(items, {
			key = key,
			kind = "gamepass",
			owned = ownsPass(player, key),
			goldAmount = 0,
			ticketAmount = 0,
		})
	end

	for key, product in Products.DeveloperProducts do
		if product.productId == 0 then
			continue
		end

		table.insert(items, {
			key = key,
			kind = "product",
			owned = false,
			goldAmount = product.goldAmount,
			ticketAmount = product.ticketAmount,
		})
	end

	table.sort(items, function(a, b)
		if a.kind ~= b.kind then
			return a.kind == "gamepass"
		end
		return a.key < b.key
	end)

	return items
end

local function handlePromptPurchase(player: Player, kind: any, key: any): Types.BattleResponse
	if type(kind) ~= "string" or type(key) ~= "string" then
		return fail("invalid_argument")
	end

	if kind == "gamepass" then
		local gamePassId = Products.GamePasses[key]
		if gamePassId == nil or gamePassId == 0 then
			return fail("not_available")
		end

		MarketplaceService:PromptGamePassPurchase(player, gamePassId)
		return { ok = true }
	elseif kind == "product" then
		local product = Products.DeveloperProducts[key]
		if product == nil or product.productId == 0 then
			return fail("not_available")
		end

		MarketplaceService:PromptProductPurchase(player, product.productId)
		return { ok = true }
	end

	return fail("invalid_argument")
end

--------------------------------------------------------------------------------

function ShopService.Init()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)

	local itemsRemote = remotesFolder:WaitForChild(Remotes.Functions.GetShopItems) :: RemoteFunction
	itemsRemote.OnServerInvoke = handleGetShopItems

	local promptRemote =
		remotesFolder:WaitForChild(Remotes.Functions.PromptPurchase) :: RemoteFunction
	promptRemote.OnServerInvoke = handlePromptPurchase

	-- 골드 획득 배수를 경제 쪽에 연결한다.
	EconomyService.setGoldMultiplierProvider(function(player: Player): number
		if ownsPass(player, "goldBoost") then
			return EconomyConfig.GOLD_BOOST_MULTIPLIER
		end
		return 1
	end)
end

function ShopService.Start()
	-- 콜백은 서버 전체에 딱 한 번만 설정한다.
	MarketplaceService.ProcessReceipt = processReceipt

	DataService.onLoaded(function(player, _data)
		task.spawn(refreshOwnership, player)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(
		function(player: Player, gamePassId: number, wasPurchased: boolean)
			if not wasPurchased then
				return
			end

			for key, id in Products.GamePasses do
				if id == gamePassId then
					local owned = ownership[player.UserId]
					if owned == nil then
						owned = {}
						ownership[player.UserId] = owned
					end
					owned[key] = true

					AnalyticsService.logFunnel(player, "gamepass_purchased", { key = key })
					break
				end
			end
		end
	)

	Players.PlayerRemoving:Connect(function(player)
		ownership[player.UserId] = nil
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="32">
        <Properties>
          <string name="Name">vendor</string>
        </Properties>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">ProfileStore</string>
            <string name="Source">--[[
MAD STUDIO (by loleris)

-[ProfileStore]---------------------------------------

	Periodic DataStore saving solution with session locking
	
	WARNINGS FOR "Profile.Data" VALUES:
	 	! Do not create numeric tables with gaps - attempting to store such tables will result in an error.
		! Do not create mixed tables (some values indexed by number and others by a string key)
			- only numerically indexed  data will be stored.
		! Do not index tables by anything other than numbers and strings.
		! Do not reference Roblox Instances
		! Do not reference userdata (Vector3, Color3, CFrame...) - Serialize userdata before referencing
		! Do not reference functions
		
	Members:
	
		ProfileStore.IsClosing          [bool]
			-- Set to true after a game:BindToClose() trigger
			
		ProfileStore.IsCriticalState    [bool]
			-- Set to true when ProfileStore experiences too many consecutive errors
		
		ProfileStore.OnError            [Signal] (message, store_name, profile_key)
			-- Most ProfileStore errors will be caught and passed to this signal
			
		ProfileStore.OnOverwrite        [Signal] (store_name, profile_key)
			-- Triggered when a DataStore key was likely used to store data that wasn't
			a ProfileStore profile or the ProfileStore structure was invalidly manually
			altered for that DataStore key
			
		ProfileStore.OnCriticalToggle   [Signal] (is_critical)
			-- Triggered when ProfileStore experiences too many consecutive errors
		
		ProfileStore.DataStoreState     [string] ("NotReady", "NoInternet", "NoAccess", "Access")
			-- This value resembles ProfileStore's access to the DataStore; The value starts
			as "NotReady" and will eventually change to one of the other 3 possible values.
	
	Functions:
	
		ProfileStore.New(store_name, template?) --&gt; [ProfileStore]
			store_name   [string] -- DataStore name
			template     [table] or nil -- Profiles will default to given table (hard-copy) when no data was saved previously
			
		ProfileStore.SetConstant(name, value)
			name    [string]
			value   [number]
				
	Members [ProfileStore]:
	
		ProfileStore.Mock   [ProfileStore]
			-- Reflection of ProfileStore methods, but the methods will now query a mock
			DataStore with no relation to the real DataStore
			
		ProfileStore.Name   [string]
		
	Methods [ProfileStore]:
	
		ProfileStore:StartSessionAsync(profile_key, params?) --&gt; [Profile] or nil
			profile_key [string] -- DataStore key
			params      nil or [table]: -- Custom params; E.g. {Steal = true}
				{
					Steal = true, -- Pass this to disregard an existing session lock
					Cancel = fn() -&gt; (boolean), -- Pass this to create a request cancel condition.
						-- If the cancel function returns true, ProfileStore will stop trying to
						-- start the session and return nil
				}
			
		ProfileStore:MessageAsync(profile_key, message) --&gt; is_success [bool]
			profile_key [string] -- DataStore key
			message     [table] -- Data to be messaged to the profile
			
		ProfileStore:GetAsync(profile_key, version?) --&gt; [Profile] or nil
			-- Reads a profile without starting a session - will not autosave
			profile_key   [string] -- DataStore key
			version       nil or [string] -- DataStore key version

		ProfileStore:VersionQuery(profile_key, sort_direction?, min_date?, max_date?) --&gt; [VersionQuery]
			profile_key      [string]
			sort_direction   nil or [Enum.SortDirection]
			min_date         nil or [DateTime]
			max_date         nil or [DateTime]
			
		ProfileStore:RemoveAsync(profile_key) --&gt; is_success [bool]
			-- Completely removes profile data from the DataStore / mock DataStore with no way to recover it.

	Methods [VersionQuery]:

		VersionQuery:NextAsync() --&gt; [Profile] or nil -- (Yields)
			-- Returned profile is similar to profiles returned by ProfileStore:GetAsync()
		
	Members [Profile]:
	
		Profile.Data               [table]
			-- When the profile is active changes to this table are guaranteed to be saved
		Profile.LastSavedData      [table] (Read-only)
			-- Last snapshot of "Profile.Data" that has been successfully saved to the DataStore;
			Useful for proper developer product purchase receipt handling
		
		Profile.FirstSessionTime   [number] (Read-only)
			-- os.time() timestamp of the first profile session
			
		Profile.SessionLoadCount   [number] (Read-only) -- Amount of times a session was started for this profile
			
		Profile.Session            [table] (Read-only) {PlaceId = number, JobId = string} / nil
			-- Set to a table if this profile is in use by a server; nil if released

		Profile.RobloxMetaData     [table] -- Writable table that gets saved automatically and once the profile is released
		Profile.UserIds            [table] -- (Read-only) -- {user_id [number], ...} -- User ids associated with this profile

		Profile.KeyInfo            [DataStoreKeyInfo] -- Changes before OnAfterSave signal
		
		Profile.OnSave             [Signal] ()
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			
		Profile.OnLastSave         [Signal] (reason [string]: "Manual", "External", "Shutdown")
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			for the last time; A reason is provided for the last save:
				- "Manual"   - Profile:EndSession() was called
				- "Shutdown" - The server that has ownership of this profile is shutting down
				- "External" - Another server has started a session for this profile
			Note that this event will not trigger for when a profile session is ended by
			another server trying to take ownership of the session - this is impossible to
			do without compromising on ProfileStore's speed.
			
		Profile.OnSessionEnd       [Signal] ()
			-- Triggered when the profile session is terminated on this server
		
		Profile.OnAfterSave        [Signal] (last_saved_data)
			-- Triggered after a successful save
			last_saved_data [table] -- Profile.LastSavedData
			
		Profile.ProfileStore       [ProfileStore] -- ProfileStore object this profile belongs to
		Profile.Key                [string] -- DataStore key
		
	Methods [Profile]:
	
		Profile:IsActive() --&gt; [bool] -- If "true" is returned, changes to Profile.Data are guaranteed to save;
			This guarantee is only valid until code yields (e.g. task.wait() is used).
			
		Profile:Reconcile() -- Fills in missing (nil) [string_key] = [value] pairs to the Profile.Data structure
			from the "template" argument that was passed to "ProfileStore.New()"
			
		Profile:EndSession() -- Call after the server has finished working with this profile
			e.g., after the player leaves (Profile object will become inactive)

		Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)
			user_id   [number]

		Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)
			user_id   [number]
			
		Profile:MessageHandler(fn) -- Sets a message handler for this profile
			fn [function] (message [table], processed [function]())
			-- The handler function receives a message table and a callback function;
			The callback function is to be called when a message has been processed
			- this will discard the message from the profile message cache; If the
			callback function is not called, other message handlers will also be triggered
			with unprocessed message data.
			
		Profile:Save() -- If the profile session is still active makes an UpdateAsync call
			to the DataStore to immediately save profile data

		Profile:SetAsync() -- Forcefully saves changes to the profile; Only for profiles
			loaded with ProfileStore:GetAsync() or ProfileStore:VersionQuery()
		
--]]

local AUTO_SAVE_PERIOD = 300 -- (Seconds) Time between when changes to a profile are saved to the DataStore
local LOAD_REPEAT_PERIOD = 10 -- (Seconds) Time between successive profile reads when handling a session conflict
local FIRST_LOAD_REPEAT = 5 -- (Seconds) Time between first and second profile read when handling a session conflict
local SESSION_STEAL = 40 -- (Seconds) Time until a session conflict is resolved with the waiting server stealing the session
local ASSUME_DEAD = 630 -- (Seconds) If a profile hasn't had updates for this long, quickly assume an active session belongs to a crashed server
local START_SESSION_TIMEOUT = 120 -- (Seconds) If a session can't be started for a profile for this long, stop repeating calls to the DataStore

local CRITICAL_STATE_ERROR_COUNT = 5 -- Assume critical state if this many issues happen in a short amount of time
local CRITICAL_STATE_ERROR_EXPIRE = 120 -- (Seconds) Individual issue expiration
local CRITICAL_STATE_EXPIRE = 120 -- (Seconds) Critical state expiration

local MAX_MESSAGE_QUEUE = 1000 -- Max messages saved in a profile that were sent using "ProfileStore:MessageAsync()"

----- Dependencies -----

-- local Util = require(game.ReplicatedStorage.Shared.Util)
-- local Signal = Util.Signal

local Signal do

	local FreeRunnerThread

	--[[
		Yield-safe coroutine reusing by stravant;
		Sources:
		https://devforum.roblox.com/t/lua-signal-class-comparison-optimal-goodsignal-class/1387063
		https://gist.github.com/stravant/b75a322e0919d60dde8a0316d1f09d2f
	--]]

	local function AcquireRunnerThreadAndCallEventHandler(fn, ...)
		local acquired_runner_thread = FreeRunnerThread
		FreeRunnerThread = nil
		fn(...)
		-- The handler finished running, this runner thread is free again.
		FreeRunnerThread = acquired_runner_thread
	end

	local function RunEventHandlerInFreeThread(...)
		AcquireRunnerThreadAndCallEventHandler(...)
		while true do
			AcquireRunnerThreadAndCallEventHandler(coroutine.yield())
		end
	end

	local Connection = {}
	Connection.__index = Connection

	local SignalClass = {}
	SignalClass.__index = SignalClass

	function Connection:Disconnect()

		if self.is_connected == false then
			return
		end

		local signal = self.signal
		self.is_connected = false
		signal.listener_count -= 1

		if signal.head == self then
			signal.head = self.next
		else
			local prev = signal.head
			while prev ~= nil and prev.next ~= self do
				prev = prev.next
			end
			if prev ~= nil then
				prev.next = self.next
			end
		end

	end

	function SignalClass.New()

		local self = {
			head = nil,
			listener_count = 0,
		}
		setmetatable(self, SignalClass)

		return self

	end

	function SignalClass:Connect(listener: (...any) -&gt; ())

		if type(listener) ~= "function" then
			error(`[{script.Name}]: \"listener\" must be a function; Received {typeof(listener)}`)
		end

		local connection = {
			listener = listener,
			signal = self,
			next = self.head,
			is_connected = true,
		}
		setmetatable(connection, Connection)

		self.head = connection
		self.listener_count += 1

		return connection

	end

	function SignalClass:GetListenerCount(): number
		return self.listener_count
	end

	function SignalClass:Fire(...)
		local item = self.head
		while item ~= nil do
			if item.is_connected == true then
				if not FreeRunnerThread then
					FreeRunnerThread = coroutine.create(RunEventHandlerInFreeThread)
				end
				task.spawn(FreeRunnerThread, item.listener, ...)
			end
			item = item.next
		end
	end

	function SignalClass:Wait()
		local co = coroutine.running()
		local connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			task.spawn(co, ...)
		end)
		return coroutine.yield()
	end

	Signal = table.freeze({
		New = SignalClass.New,
	})

end

----- Private -----

local ActiveSessionCheck = {} -- {[session_token] = profile, ...}
local AutoSaveList = {} -- {profile, ...} -- Loaded profile table which will be circularly auto-saved
local IssueQueue = {} -- {issue_time, ...}

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local PlaceId = game.PlaceId
local JobId = game.JobId

local AutoSaveIndex = 1 -- Next profile to auto save
local LastAutoSave = os.clock()

local LoadIndex = 0

local ActiveProfileLoadJobs = 0 -- Number of active threads that are loading in profiles
local ActiveProfileSaveJobs = 0 -- Number of active threads that are saving profiles

local CriticalStateStart = 0 -- os.clock()

local IsStudio = RunService:IsStudio()
local DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access" = "NotReady"

local MockStore = {}
local UserMockStore = {}
local MockFlag = false

local OnError = Signal.New() -- (message, store_name, profile_key)
local OnOverwrite = Signal.New() -- (store_name, profile_key)

local UpdateQueue = { -- For stability sake, we won't do UpdateAsync calls for the same key until all previous calls finish
	--[[
		[session_token] = {
			coroutine, ...
		},
		...
	--]]
}

local function WaitInUpdateQueue(session_token) --&gt; next_in_queue()

	local is_first = false

	if UpdateQueue[session_token] == nil then
		is_first = true
		UpdateQueue[session_token] = {}
	end

	local queue = UpdateQueue[session_token]

	if is_first == false then
		table.insert(queue, coroutine.running())
		coroutine.yield()
	end

	return function()
		local next_co = table.remove(queue, 1)
		if next_co ~= nil then
			coroutine.resume(next_co)
		else
			UpdateQueue[session_token] = nil
		end
	end

end

local function SessionToken(store_name, profile_key, is_mock)

	local session_token = "L_" -- Live

	if is_mock == true then
		session_token = "U_" -- User mock
	elseif DataStoreState ~= "Access" then
		session_token = "M_" -- Mock, cause no DataStore access
	end

	session_token ..= store_name .. "\0" .. profile_key

	return session_token

end

local function DeepCopyTable(t)
	local copy = {}
	for key, value in pairs(t) do
		if type(value) == "table" then
			copy[key] = DeepCopyTable(value)
		else
			copy[key] = value
		end
	end
	return copy
end

local function ReconcileTable(target, template)
	for k, v in pairs(template) do
		if type(k) == "string" then -- Only string keys will be reconciled
			if target[k] == nil then
				if type(v) == "table" then
					target[k] = DeepCopyTable(v)
				else
					target[k] = v
				end
			elseif type(target[k]) == "table" and type(v) == "table" then
				ReconcileTable(target[k], v)
			end
		end
	end
end

local function RegisterError(error_message, store_name, profile_key) -- Called when a DataStore API call errors
	warn(`[{script.Name}]: DataStore API error (STORE:{store_name}; KEY:{profile_key}) - {tostring(error_message)}`)
	table.insert(IssueQueue, os.clock()) -- Adding issue time to queue
	OnError:Fire(tostring(error_message), store_name, profile_key)
end

local function RegisterOverwrite(store_name, profile_key) -- Called when a corrupted profile is loaded
	warn(`[{script.Name}]: Invalid profile was overwritten (STORE:{store_name}; KEY:{profile_key})`)
	OnOverwrite:Fire(store_name, profile_key)
end

local function NewMockDataStoreKeyInfo(params)

	local version_id_string = tostring(params.VersionId or 0)
	local meta_data = params.MetaData or {}
	local user_ids = params.UserIds or {}

	return {
		CreatedTime = params.CreatedTime,
		UpdatedTime = params.UpdatedTime,
		Version = string.rep("0", 16) .. "."
			.. string.rep("0", 10 - string.len(version_id_string)) .. version_id_string
			.. "." .. string.rep("0", 16) .. "." .. "01",

		GetMetadata = function()
			return DeepCopyTable(meta_data)
		end,

		GetUserIds = function()
			return DeepCopyTable(user_ids)
		end,
	}

end

local function MockUpdateAsync(mock_data_store, profile_store_name, key, transform_function, is_get_call) --&gt; loaded_data, key_info

	local profile_store = mock_data_store[profile_store_name]

	if profile_store == nil then
		profile_store = {}
		mock_data_store[profile_store_name] = profile_store
	end

	local epoch_time = math.floor(os.time() * 1000)
	local mock_entry = profile_store[key]
	local mock_entry_was_nil = false

	if mock_entry == nil then
		mock_entry_was_nil = true
		if is_get_call ~= true then
			mock_entry = {
				Data = nil,
				CreatedTime = epoch_time,
				UpdatedTime = epoch_time,
				VersionId = 0,
				UserIds = {},
				MetaData = {},
			}
			profile_store[key] = mock_entry
		end
	end

	local mock_key_info = mock_entry_was_nil == false and NewMockDataStoreKeyInfo(mock_entry) or nil

	local transform, user_ids, roblox_meta_data = transform_function(mock_entry and mock_entry.Data, mock_key_info)

	if transform == nil then
		return nil
	else
		if mock_entry ~= nil and is_get_call ~= true then
			mock_entry.Data = DeepCopyTable(transform)
			mock_entry.UserIds = DeepCopyTable(user_ids or {})
			mock_entry.MetaData = DeepCopyTable(roblox_meta_data or {})
			mock_entry.VersionId += 1
			mock_entry.UpdatedTime = epoch_time
		end

		return DeepCopyTable(transform), mock_entry ~= nil and NewMockDataStoreKeyInfo(mock_entry) or nil
	end

end

local function UpdateAsync(profile_store, profile_key, transform_params, is_user_mock, is_get_call, version) --&gt; loaded_data, key_info
	--transform_params = {
	--	ExistingProfileHandle = function(latest_data),
	--	MissingProfileHandle = function(latest_data),
	--	EditProfile = function(latest_data),
	--}

	local loaded_data, key_info
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(profile_store.Name, profile_key, is_user_mock))

	local success = true

	local success, error_message = pcall(function()
		local transform_function = function(latest_data)

			local missing_profile = false
			local overwritten = false
			local global_updates = {0, {}}

			if latest_data == nil then

				missing_profile = true

			elseif type(latest_data) ~= "table" then

				missing_profile = true
				overwritten = true

			else

				if type(latest_data.Data) == "table" and type(latest_data.MetaData) == "table" and type(latest_data.GlobalUpdates) == "table" then

					-- Regular profile structure detected:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates

					if transform_params.ExistingProfileHandle ~= nil then
						transform_params.ExistingProfileHandle(latest_data)
					end

				elseif latest_data.Data == nil and latest_data.MetaData == nil and type(latest_data.GlobalUpdates) == "table" then

					-- Regular structure not detected, but GlobalUpdate data exists:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates or global_updates
					missing_profile = true

				else

					missing_profile = true
					overwritten = true

				end

			end

			-- Profile was not created or corrupted and no GlobalUpdate data exists:
			if missing_profile == true then
				latest_data = {
					-- Data = nil,
					-- MetaData = nil,
					GlobalUpdates = global_updates,
				}
				if transform_params.MissingProfileHandle ~= nil then
					transform_params.MissingProfileHandle(latest_data)
				end
			end

			-- Editing profile:
			if transform_params.EditProfile ~= nil then
				transform_params.EditProfile(latest_data)
			end

			-- Invalid data handling (Silently override with empty profile)
			if overwritten == true then
				latest_data.WasOverwritten = true -- Temporary tag that will be removed on first save
			end

			return latest_data, latest_data.UserIds, latest_data.RobloxMetaData
		end

		if is_user_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

			loaded_data, key_info = MockUpdateAsync(UserMockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		elseif DataStoreState ~= "Access" then -- Used when API access is disabled

			loaded_data, key_info = MockUpdateAsync(MockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		else

			if is_get_call == true then

				if version ~= nil then

					local success, error_message = pcall(function()
						loaded_data, key_info = profile_store.data_store:GetVersionAsync(profile_key, version)
					end)

					if success == false and type(error_message) == "string" and string.find(error_message, "not valid") ~= nil then
						warn(`[{script.Name}]: Passed version argument is not valid; Traceback:\n` .. debug.traceback())
					end

				else

					loaded_data, key_info = profile_store.data_store:GetAsync(profile_key)

				end

				loaded_data = transform_function(loaded_data)

			else

				loaded_data, key_info = profile_store.data_store:UpdateAsync(profile_key, transform_function)

			end

		end

	end)

	next_in_queue()

	if success == true and type(loaded_data) == "table" then
		-- Invalid data handling:
		if loaded_data.WasOverwritten == true and is_get_call ~= true then
			RegisterOverwrite(
				profile_store.Name,
				profile_key
			)
		end
		-- Return loaded_data:
		return loaded_data, key_info
	else
		-- Error handling:
		RegisterError(
			error_message or "Undefined error",
			profile_store.Name,
			profile_key
		)
		-- Return nothing:
		return nil
	end

end

local function IsThisSession(session_tag)
	return session_tag[1] == PlaceId and session_tag[2] == JobId
end

local function ReadMockFlag(): boolean
	local is_mock = MockFlag
	MockFlag = false
	return is_mock
end

local function WaitForStoreReady(profile_store)
	while profile_store.is_ready == false do
		task.wait()
	end
end

local function AddProfileToAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = profile

	-- Add at AutoSaveIndex and move AutoSaveIndex right:

	table.insert(AutoSaveList, AutoSaveIndex, profile)

	if #AutoSaveList &gt; 1 then
		AutoSaveIndex = AutoSaveIndex + 1
	elseif #AutoSaveList == 1 then
		-- First profile created - make sure it doesn't get immediately auto saved:
		LastAutoSave = os.clock()
	end

end

local function RemoveProfileFromAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = nil

	local auto_save_index = table.find(AutoSaveList, profile)

	if auto_save_index ~= nil then
		table.remove(AutoSaveList, auto_save_index)
		if auto_save_index &lt; AutoSaveIndex then
			AutoSaveIndex = AutoSaveIndex - 1 -- Table contents were moved left before AutoSaveIndex so move AutoSaveIndex left as well
		end
		if AutoSaveList[AutoSaveIndex] == nil then -- AutoSaveIndex was at the end of the AutoSaveList - reset to 1
			AutoSaveIndex = 1
		end
	end

end

local function SaveProfileAsync(profile, is_ending_session, is_overwriting, last_save_reason)

	if type(profile.Data) ~= "table" then
		error(`[{script.Name}]: Developer code likely set "Profile.Data" to a non-table value! (STORE:{profile.ProfileStore.Name}; KEY:{profile.Key})`)
	end

	profile.OnSave:Fire()
	if is_ending_session == true then
		profile.OnLastSave:Fire(last_save_reason or "Manual")
	end

	if is_ending_session == true and is_overwriting ~= true then
		if profile.roblox_message_subscription ~= nil then
			profile.roblox_message_subscription:Disconnect()
		end
		RemoveProfileFromAutoSave(profile)
		profile.OnSessionEnd:Fire()
	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs + 1

	-- Compare "SessionLoadCount" when writing to profile to prevent a rare case of repeat last save when the profile is loaded on the same server again

	local repeat_save_flag = true -- Released Profile save calls have to repeat until they succeed
	local exp_backoff = 1

	while repeat_save_flag == true do

		if is_ending_session ~= true then
			repeat_save_flag = false
		end

		local loaded_data, key_info = UpdateAsync(
			profile.ProfileStore,
			profile.Key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)
					
					-- Check if this session still owns the profile:

					local session_owns_profile = false

					if is_overwriting ~= true then

						local active_session = latest_data.MetaData.ActiveSession
						local session_load_count = latest_data.MetaData.SessionLoadCount

						if type(active_session) == "table" then
							session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
						end

					else
						session_owns_profile = true
					end

					-- We may only edit the profile if this server has ownership of the profile:

					if session_owns_profile == true then

						-- Clear processed updates (messages):

						local locked_updates = profile.locked_global_updates -- [index] = true, ...
						local active_updates = latest_data.GlobalUpdates[2]
						-- ProfileService module format: {{update_id, version_id, update_locked, update_data}, ...}
						-- ProfileStore module format: {{update_id, update_data}, ...}

						if next(locked_updates) ~= nil then
							local i = 1
							while i &lt;= #active_updates do
								local update = active_updates[i]
								if locked_updates[update[1]] == true then
									table.remove(active_updates, i)
								else
									i += 1
								end
							end
						end

						-- Save profile data:

						latest_data.Data = profile.Data
						latest_data.RobloxMetaData = profile.RobloxMetaData
						latest_data.UserIds = profile.UserIds

						if is_overwriting ~= true then

							latest_data.MetaData.LastUpdate = os.time()

							if is_ending_session == true then
								latest_data.MetaData.ActiveSession = nil
							end

						else

							latest_data.MetaData.ActiveSession = nil
							latest_data.MetaData.ForceLoadSession = nil

						end

					end

				end,
			},
			profile.is_mock
		)

		if loaded_data ~= nil and key_info ~= nil then

			if is_overwriting == true then
				break
			end
			
			repeat_save_flag = false
			
			local active_session = loaded_data.MetaData.ActiveSession
			local session_load_count = loaded_data.MetaData.SessionLoadCount
			local session_owns_profile = false

			if type(active_session) == "table" then
				session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
			end
			
			local force_load_session = loaded_data.MetaData.ForceLoadSession
			local force_load_pending = false
			if type(force_load_session) == "table" then
				force_load_pending = not IsThisSession(force_load_session)
			end
			
			local is_active = profile:IsActive()
			
			-- If another server is trying to start a session for this profile - end the session:

			if force_load_pending == true and session_owns_profile == true then
				if is_active == true then
					SaveProfileAsync(profile, true, false, "External")
				end
				break
			end
			
			-- Clearing processed update list / Detecting new updates:

			local locked_updates = profile.locked_global_updates -- [index] = true, ...
			local received_updates = profile.received_global_updates -- [index] = true, ...
			local active_updates = loaded_data.GlobalUpdates[2]

			local new_updates = {} -- {}, ...
			local still_pending = {} -- [index] = true, ...

			for _, update in ipairs(active_updates) do
				if locked_updates[update[1]] == true then
					still_pending[update[1]] = true
				elseif received_updates[update[1]] ~= true then
					received_updates[update[1]] = true
					table.insert(new_updates, update)
				end
			end

			for index in pairs(locked_updates) do
				if still_pending[index] ~= true then
					locked_updates[index] = nil
				end
			end

			-- Updating profile values:

			profile.KeyInfo = key_info
			profile.LastSavedData = loaded_data.Data
			profile.global_updates = loaded_data.GlobalUpdates and loaded_data.GlobalUpdates[2] or {}

			if session_owns_profile == true then
				if is_active == true and is_ending_session ~= true then

					-- Processing new global updates (messages):

					for _, update in ipairs(new_updates) do

						local index = update[1]
						local update_data = update[#update] -- Backwards compatibility with ProfileService

						for _, handler in ipairs(profile.message_handlers) do

							local is_processed = false
							local processed_callback = function()
								is_processed = true
								locked_updates[index] = true
							end
							
							local send_update_data = DeepCopyTable(update_data)

							task.spawn(handler, send_update_data, processed_callback)

							if is_processed == true then
								break
							end

						end

					end

				end
			else
				
				if profile.roblox_message_subscription ~= nil then
					profile.roblox_message_subscription:Disconnect()
				end

				if is_active == true then
					RemoveProfileFromAutoSave(profile)
					profile.OnSessionEnd:Fire()
				end

			end

			profile.OnAfterSave:Fire(profile.LastSavedData)

		elseif repeat_save_flag == true then
			
			-- DataStore call likely resulted in an error; Repeat the DataStore call shortly
			task.wait(exp_backoff)
			exp_backoff = math.min(if last_save_reason == "Shutdown" then 8 else 20, exp_backoff * 2)

		end

	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs - 1

end

----- Public -----

--[[
	Saved profile structure:
	
	{
		Data = {},
		
		MetaData = {
			ProfileCreateTime = 0,
			SessionLoadCount = 0,
			ActiveSession = {place_id, game_job_id, unique_session_id} / nil,
			ForceLoadSession = {place_id, game_job_id} / nil,
			LastUpdate = 0, -- os.time()
			MetaTags = {}, -- Backwards compatibility with ProfileService
		},
		
		RobloxMetaData = {},
		UserIds = {},
		
		GlobalUpdates = {
			update_index,
			{
				{update_index, data}, ...
			},
		},
	}

--]]

export type JSONAcceptable = { JSONAcceptable } | { [string]: JSONAcceptable } | number | string | boolean | buffer

export type Profile&lt;T&gt; = {
	Data: T &amp; JSONAcceptable,
	LastSavedData: T &amp; JSONAcceptable,
	FirstSessionTime: number,
	SessionLoadCount: number,
	Session: {PlaceId: number, JobId: string}?,
	RobloxMetaData: JSONAcceptable,
	UserIds: {number},
	KeyInfo: DataStoreKeyInfo,
	OnSave: {Connect: (self: any, listener: () -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnLastSave: {Connect: (self: any, listener: (reason: "Manual" | "External" | "Shutdown") -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnSessionEnd: {Connect: (self: any, listener: () -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnAfterSave: {Connect: (self: any, listener: (last_saved_data: T &amp; JSONAcceptable) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	ProfileStore: JSONAcceptable,
	Key: string,

	IsActive: (self: any) -&gt; (boolean),
	Reconcile: (self: any) -&gt; (),
	EndSession: (self: any) -&gt; (),
	AddUserId: (self: any, user_id: number) -&gt; (),
	RemoveUserId: (self: any, user_id: number) -&gt; (),
	MessageHandler: (self: any, fn: (message: JSONAcceptable, processed: () -&gt; ()) -&gt; ()) -&gt; (),
	Save: (self: any) -&gt; (),
	SetAsync: (self: any) -&gt; (),
}

export type VersionQuery&lt;T&gt; = {
	NextAsync: (self: any) -&gt; (Profile&lt;T&gt;?),
}

type ProfileStoreStandard&lt;T&gt; = {
	Name: string,
	StartSessionAsync: (self: any, profile_key: string, params: {Steal: boolean?}) -&gt; (Profile&lt;T&gt;?),
	MessageAsync: (self: any, profile_key: string, message: JSONAcceptable) -&gt; (boolean),
	GetAsync: (self: any, profile_key: string, version: string?) -&gt; (Profile&lt;T&gt;?),
	VersionQuery: (self: any, profile_key: string, sort_direction: Enum.SortDirection?, min_date: DateTime | number | nil, max_date: DateTime | number | nil) -&gt; (VersionQuery&lt;T&gt;),
	RemoveAsync: (self: any, profile_key: string) -&gt; (boolean),
}

export type ProfileStore&lt;T&gt; = {
	Mock: ProfileStoreStandard&lt;T&gt;,
} &amp; ProfileStoreStandard&lt;T&gt;

type ConstantName = "AUTO_SAVE_PERIOD" | "LOAD_REPEAT_PERIOD" | "FIRST_LOAD_REPEAT" | "SESSION_STEAL"
| "ASSUME_DEAD" | "START_SESSION_TIMEOUT" | "CRITICAL_STATE_ERROR_COUNT" | "CRITICAL_STATE_ERROR_EXPIRE"
| "CRITICAL_STATE_EXPIRE" | "MAX_MESSAGE_QUEUE"

export type ProfileStoreModule = {
	IsClosing: boolean,
	IsCriticalState: boolean,
	OnError: {Connect: (self: any, listener: (message: string, store_name: string, profile_key: string) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnOverwrite: {Connect: (self: any, listener: (store_name: string, profile_key: string) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnCriticalToggle: {Connect: (self: any, listener: (is_critical: boolean) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access",
	New: &lt;T&gt;(store_name: string, template: (T &amp; JSONAcceptable)?) -&gt; (ProfileStore&lt;T&gt;),
	SetConstant: (name: ConstantName, value: number) -&gt; ()
}

local Profile = {}
Profile.__index = Profile

function Profile.New(raw_data, key_info, profile_store, key, is_mock, session_token)

	local data = raw_data.Data or {}
	local session = raw_data.MetaData and raw_data.MetaData.ActiveSession or nil

	local global_updates = raw_data.GlobalUpdates and raw_data.GlobalUpdates[2] or {}
	local received_global_updates = {}

	for _, update in ipairs(global_updates) do
		received_global_updates[update[1]] = true
	end

	local self = {

		Data = data,
		LastSavedData = DeepCopyTable(data),

		FirstSessionTime = raw_data.MetaData and raw_data.MetaData.ProfileCreateTime or 0,
		SessionLoadCount = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		Session = session and {PlaceId = session[1], JobId = session[2]},

		RobloxMetaData = raw_data.RobloxMetaData or {},
		UserIds = raw_data.UserIds or {},
		KeyInfo = key_info,

		OnAfterSave = Signal.New(),
		OnSave = Signal.New(),
		OnLastSave = Signal.New(),
		OnSessionEnd = Signal.New(),

		ProfileStore = profile_store,
		Key = key,

		load_timestamp = os.clock(),
		is_mock = is_mock,
		session_token = session_token or "",
		load_index = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		locked_global_updates = {},
		received_global_updates = received_global_updates,
		message_handlers = {},
		global_updates = global_updates,

	}
	setmetatable(self, Profile)

	return self

end

function Profile:IsActive()
	return ActiveSessionCheck[self.session_token] == self
end

function Profile:Reconcile()
	ReconcileTable(self.Data, self.ProfileStore.template)
end

function Profile:EndSession()
	if self:IsActive() == true then
		task.spawn(SaveProfileAsync, self, true, nil, "Manual") -- Call save function in a new thread with release_from_session = true
	end
end

function Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :AddUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	if user_id &lt; 0 and self.is_mock ~= true and DataStoreState == "Access" then
		return -- Avoid giving real Roblox APIs negative UserId's
	end

	if table.find(self.UserIds, user_id) == nil then
		table.insert(self.UserIds, user_id)
	end

end

function Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :RemoveUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	local index = table.find(self.UserIds, user_id)

	if index ~= nil then
		table.remove(self.UserIds, index)
	end

end

function Profile:SetAsync() -- Saves the profile to the DataStore and removes the session lock

	if self.view_mode ~= true then
		error(`[{script.Name}]: :SetAsync() can only be used in view mode`)
	end

	SaveProfileAsync(self, nil, true)

end

function Profile:MessageHandler(fn)

	if type(fn) ~= "function" then
		error(`[{script.Name}]: fn argument is not a function`)
	end

	if self.view_mode ~= true and self:IsActive() ~= true then
		return -- Don't process messages if the profile session was ended
	end

	local locked_updates = self.locked_global_updates
	table.insert(self.message_handlers, fn)

	for _, update in ipairs(self.global_updates) do

		local index = update[1]
		local update_data = update[#update] -- Backwards compatibility with ProfileService

		if locked_updates[index] ~= true then

			local processed_callback = function()
				locked_updates[index] = true
			end
			
			local send_update_data = DeepCopyTable(update_data)

			task.spawn(fn, send_update_data, processed_callback)

		end

	end

end

function Profile:Save()
	
	if self.view_mode == true then
		error(`[{script.Name}]: Can't save profile in view mode; Should you be calling :SetAsync() instead?`)
	end
	
	if self:IsActive() == false then
		warn(`[{script.Name}]: Attempted saving an inactive profile (STORE:{self.ProfileStore.Name}; KEY:{self.Key});`
			.. ` Traceback:\n` .. debug.traceback())
		return
	end
	
	-- Move the profile right behind the auto save index to delay the next auto save for it:
	RemoveProfileFromAutoSave(self)
	AddProfileToAutoSave(self)
	
	-- Perform save in new thread:
	task.spawn(SaveProfileAsync, self)

end

local ProfileStore: ProfileStoreModule = {

	IsClosing = false,
	IsCriticalState = false,
	OnError = OnError, -- (message, store_name, profile_key)
	OnOverwrite = OnOverwrite, -- (store_name, profile_key)
	OnCriticalToggle = Signal.New(), -- (is_critical)
	DataStoreState = "NotReady", -- ("NotReady", "NoInternet", "NoAccess", "Access")

}
ProfileStore.__index = ProfileStore

function ProfileStore.SetConstant(name, value)

	if type(value) ~= "number" then
		error(`[{script.Name}]: Invalid value type`)
	end

	if name == "AUTO_SAVE_PERIOD" then
		AUTO_SAVE_PERIOD = value
	elseif name == "LOAD_REPEAT_PERIOD" then
		LOAD_REPEAT_PERIOD = value
	elseif name == "FIRST_LOAD_REPEAT" then
		FIRST_LOAD_REPEAT = value
	elseif name == "SESSION_STEAL" then
		SESSION_STEAL = value
	elseif name == "ASSUME_DEAD" then
		ASSUME_DEAD = value
	elseif name == "START_SESSION_TIMEOUT" then
		START_SESSION_TIMEOUT = value
	elseif name == "CRITICAL_STATE_ERROR_COUNT" then
		CRITICAL_STATE_ERROR_COUNT = value
	elseif name == "CRITICAL_STATE_ERROR_EXPIRE" then
		CRITICAL_STATE_ERROR_EXPIRE = value
	elseif name == "CRITICAL_STATE_EXPIRE" then
		CRITICAL_STATE_EXPIRE = value
	elseif name == "MAX_MESSAGE_QUEUE" then
		MAX_MESSAGE_QUEUE = value
	else
		error(`[{script.Name}]: Invalid constant name was provided`)
	end

end

function ProfileStore.Test()
	return {
		ActiveSessionCheck = ActiveSessionCheck,
		AutoSaveList = AutoSaveList,
		ActiveProfileLoadJobs = ActiveProfileLoadJobs,
		ActiveProfileSaveJobs = ActiveProfileSaveJobs,
		MockStore = MockStore,
		UserMockStore = UserMockStore,
		UpdateQueue = UpdateQueue,
	}
end

function ProfileStore.New(store_name, template)

	template = template or {}

	if type(store_name) ~= "string" then
		error(`[{script.Name}]: Invalid or missing "store_name"`)
	elseif string.len(store_name) == 0 then
		error(`[{script.Name}]: store_name cannot be an empty string`)
	elseif string.len(store_name) &gt; 50 then
		error(`[{script.Name}]: store_name is too long`)
	end

	if type(template) ~= "table" then
		error(`[{script.Name}]: Invalid template argument`)
	end

	local self
	self = {

		Mock = {

			Name = store_name,

			StartSessionAsync = function(_, profile_key)
				MockFlag = true
				return self:StartSessionAsync(profile_key)
			end,
			MessageAsync = function(_, profile_key, message)
				MockFlag = true
				return self:MessageAsync(profile_key, message)
			end,
			GetAsync = function(_, profile_key, version)
				MockFlag = true
				return self:GetAsync(profile_key, version)
			end,
			VersionQuery = function(_, profile_key, sort_direction, min_date, max_date)
				MockFlag = true
				return self:VersionQuery(profile_key, sort_direction, min_date, max_date)
			end,
			RemoveAsync = function(_, profile_key)
				MockFlag = true
				return self:RemoveAsync(profile_key)
			end
		},

		Name = store_name,

		template = template,
		data_store = nil,
		load_jobs = {},
		mock_load_jobs = {},
		is_ready = true,

	}
	setmetatable(self, ProfileStore)

	local options = Instance.new("DataStoreOptions")
	options:SetExperimentalFeatures({v2 = true})

	if DataStoreState == "NotReady" then

		-- The module is not sure whether DataStores are accessible yet:

		self.is_ready = false

		task.spawn(function()

			repeat task.wait() until DataStoreState ~= "NotReady"

			if DataStoreState == "Access" then
				self.data_store = DataStoreService:GetDataStore(store_name, nil, options)
			end

			self.is_ready = true

		end)

	elseif DataStoreState == "Access" then

		self.data_store = DataStoreService:GetDataStore(store_name, nil, options)

	end

	return self

end

local function RobloxMessageSubscription(profile, unique_session_id)

	local last_roblox_message = 0
	
	local roblox_message_subscription = MessagingService:SubscribeAsync("PS_" .. unique_session_id, function(message)
		if type(message.Data) == "table" and message.Data.LoadCount == profile.SessionLoadCount then
			-- High reaction rate, based on numPlayers × 10 DataStore budget as of writing
			if os.clock() - last_roblox_message &gt; 6 then 
				last_roblox_message = os.clock()
				if profile:IsActive() == true then
					if message.Data.EndSession == true then
						SaveProfileAsync(profile, true, false, "External")
					else
						profile:Save()
					end
				end
			end
		end
	end)

	if profile:IsActive() == true then
		profile.roblox_message_subscription = roblox_message_subscription
	else
		roblox_message_subscription:Disconnect()
	end

end

function ProfileStore:StartSessionAsync(profile_key, params)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end
	
	if params ~= nil and type(params) ~= "table" then
		error(`[{script.Name}]: Invalid params`)
	end
	
	params = params or {}

	if ProfileStore.IsClosing == true then
		return nil
	end
	
	WaitForStoreReady(self)

	local session_token = SessionToken(self.Name, profile_key, is_mock)

	if ActiveSessionCheck[session_token] ~= nil then
		error(`[{script.Name}]: Profile (STORE:{self.Name}; KEY:{profile_key}) is already loaded in this session`)
	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs + 1
	
	local is_user_cancel = false
	
	local function cancel_condition()
		if is_user_cancel == false then
			if params.Cancel ~= nil then
				is_user_cancel = params.Cancel() == true
			end
			return is_user_cancel
		end
		return true
	end
	
	local user_steal = params.Steal == true

	local force_load_steps = 0 -- Session conflict handling values
	local request_force_load = true
	local steal_session = false

	local start = os.clock()
	local exp_backoff = 1

	while ProfileStore.IsClosing == false and cancel_condition() == false do

		-- Load profile:

		-- SPECIAL CASE - If StartSessionAsync is called for the same key again before another StartSessionAsync finishes,
		-- grab the DataStore return for the new call. The early call will return nil. This is supposed to retain
		-- expected and efficient behavior in cases where a player would quickly rejoin the same server.

		LoadIndex += 1
		local load_id = LoadIndex
		local profile_load_jobs = is_mock == true and self.mock_load_jobs or self.load_jobs
		local profile_load_job = profile_load_jobs[profile_key] -- {load_id, {loaded_data, key_info} or nil}

		local loaded_data, key_info
		local unique_session_id = HttpService:GenerateGUID(false)

		if profile_load_job ~= nil then

			profile_load_job[1] = load_id -- Steal load job
			while profile_load_job[2] == nil do -- Wait for job to finish
				task.wait()
			end
			if profile_load_job[1] == load_id then -- Load job hasn't been double-stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end

		else

			profile_load_job = {load_id, nil}
			profile_load_jobs[profile_key] = profile_load_job

			profile_load_job[2] = table.pack(UpdateAsync(
				self,
				profile_key,
				{
					ExistingProfileHandle = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						local force_load_session = latest_data.MetaData.ForceLoadSession

						if active_session == nil then
							latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
							latest_data.MetaData.ForceLoadSession = nil
						elseif type(active_session) == "table" then
							if IsThisSession(active_session) == false then
								local last_update = latest_data.MetaData.LastUpdate
								if last_update ~= nil then
									if os.time() - last_update &gt; ASSUME_DEAD then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
										return
									end
								end
								if steal_session == true or user_steal == true then
									local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true
									if force_load_interrupted == false or user_steal == true then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
									end
								elseif request_force_load == true then
									latest_data.MetaData.ForceLoadSession = {PlaceId, JobId}
								end
							else
								latest_data.MetaData.ForceLoadSession = nil
							end
						end

					end,
					MissingProfileHandle = function(latest_data)
						
						local is_cancel = ProfileStore.IsClosing == true or cancel_condition() == true

						latest_data.Data = DeepCopyTable(self.template)
						latest_data.MetaData = {
							ProfileCreateTime = os.time(),
							SessionLoadCount = 0,
							ActiveSession = if is_cancel == false then {PlaceId, JobId, unique_session_id} else nil,
							ForceLoadSession = nil,
							MetaTags = {}, -- Backwards compatibility with ProfileService
						}

					end,
					EditProfile = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						if active_session ~= nil and IsThisSession(active_session) == true then
							latest_data.MetaData.SessionLoadCount = latest_data.MetaData.SessionLoadCount + 1
							latest_data.MetaData.LastUpdate = os.time()
						end

					end,
				},
				is_mock
				))
			if profile_load_job[1] == load_id then -- Load job hasn't been stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- Load job stolen
			end
		end

		-- Handle load_data:

		if loaded_data ~= nil and key_info ~= nil then
			local active_session = loaded_data.MetaData.ActiveSession
			if type(active_session) == "table" then

				if IsThisSession(active_session) == true then

					-- Profile is now taken by this session:

					local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock, session_token)
					AddProfileToAutoSave(profile)
					
					if is_mock ~= true and DataStoreState == "Access" then
						
						-- Use MessagingService to quickly detect session conflicts and resolve them quickly:
						task.spawn(RobloxMessageSubscription, profile, unique_session_id) -- Blocking prevention
						
					end

					if ProfileStore.IsClosing == true or cancel_condition() == true then
						-- The server has initiated a shutdown by the time this profile was loaded
						SaveProfileAsync(profile, true) -- Release profile and yield until the DataStore call is finished
						profile = nil -- Don't return the profile object
					end

					ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
					return profile

				else
					
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					-- Profile is taken by some other session:

					local force_load_session = loaded_data.MetaData.ForceLoadSession
					local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true

					if force_load_interrupted == false then

						if request_force_load == false then
							force_load_steps = force_load_steps + 1
							if force_load_steps &gt;= math.ceil(SESSION_STEAL / LOAD_REPEAT_PERIOD) then
								steal_session = true
							end
						end
						
						-- Request the remote server to end its session:
						if type(active_session[3]) == "string" then
							local session_load_count = loaded_data.MetaData.SessionLoadCount or 0
							task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count, EndSession = true})
						end
						
						-- Attempt to load the profile again after a delay
						local wait_until = os.clock() + if request_force_load == true then FIRST_LOAD_REPEAT else LOAD_REPEAT_PERIOD
						repeat task.wait() until os.clock() &gt;= wait_until or ProfileStore.IsClosing == true

					else
						-- Another session tried to load this profile:
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					request_force_load = false -- Only request a force load once

				end

			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- In this scenario it is likely that this server started shutting down
			end
		else
			
			-- A DataStore call has likely ended in an error:

			local default_timeout = false

			if params.Cancel == nil then
				default_timeout = os.clock() - start &gt;= START_SESSION_TIMEOUT
			end
			
			if default_timeout == true or ProfileStore.IsClosing == true or cancel_condition() == true then
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end
			
			task.wait(exp_backoff)  -- Repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
			
		end

	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
	return nil -- Game started shutting down or the request was cancelled - don't return the profile

end

function ProfileStore:MessageAsync(profile_key, message)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if type(message) ~= "table" then
		error(`[{script.Name}]: message must be a table`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Updating profile:

		local loaded_data = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)

					local global_updates = latest_data.GlobalUpdates
					local update_list = global_updates[2]
					--{
					--	update_index,
					--	{
					--		{update_index, data}, ...
					--	},
					--},

					global_updates[1] += 1
					table.insert(update_list, {global_updates[1], message})

					-- Clearing queue if above limit:

					while #update_list &gt; MAX_MESSAGE_QUEUE do
						table.remove(update_list, 1)
					end

				end,
			},
			is_mock
		)

		if loaded_data ~= nil then
			
			local session_token = SessionToken(self.Name, profile_key, is_mock)
			
			local profile = ActiveSessionCheck[session_token]
			
			if profile ~= nil then
				
				-- The message was sent to a profile that is active in this server:
				profile:Save()
				
			else
				
				local meta_data = loaded_data.MetaData or {}
				local active_session = meta_data.ActiveSession
				local session_load_count = meta_data.SessionLoadCount or 0
				
				if type(active_session) == "table" and type(active_session[3]) == "string" then
					-- Request the remote server to auto-save sooner and receive the message:
					task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count})
				end
				
			end

			return true

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return false

end

function ProfileStore:GetAsync(profile_key, version)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if ProfileStore.IsClosing == true then
		return nil
	end

	WaitForStoreReady(self)

	if version ~= nil and (is_mock or DataStoreState ~= "Access") then
		return nil -- No version support in mock mode
	end

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Load profile:

		local loaded_data, key_info = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = function(latest_data)

					latest_data.Data = DeepCopyTable(self.template)
					latest_data.MetaData = {
						ProfileCreateTime = os.time(),
						SessionLoadCount = 0,
						ActiveSession = nil,
						ForceLoadSession = nil,
						MetaTags = {}, -- Backwards compatibility with ProfileService
					}

				end,
				EditProfile = nil,
			},
			is_mock,
			true, -- Use :GetAsync()
			version -- DataStore key version
		)

		-- Handle load_data:

		if loaded_data ~= nil then

			if key_info == nil then
				return nil -- Load was successful, but the key was empty - return no profile object
			end

			local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock)
			profile.view_mode = true

			return profile

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return nil -- Game started shutting down - don't return the profile

end

function ProfileStore:RemoveAsync(profile_key)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local wipe_status = false
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(self.Name, profile_key, is_mock))

	if is_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

		local mock_data_store = UserMockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				UserMockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	elseif DataStoreState ~= "Access" then -- Used when API access is disabled

		local mock_data_store = MockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				MockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	else -- Live DataStore

		wipe_status = pcall(function()
			self.data_store:RemoveAsync(profile_key)
		end)

	end
	
	next_in_queue()

	return wipe_status

end

local ProfileVersionQuery = {}
ProfileVersionQuery.__index = ProfileVersionQuery

function ProfileVersionQuery.New(profile_store, profile_key, sort_direction, min_date, max_date, is_mock)

	local self = {
		profile_store = profile_store,
		profile_key = profile_key,
		sort_direction = sort_direction,
		min_date = min_date,
		max_date = max_date,

		query_pages = nil,
		query_index = 0,
		query_failure = false,

		is_query_yielded = false,
		query_queue = {},

		is_mock = is_mock,
	}
	setmetatable(self, ProfileVersionQuery)

	return self

end

function MoveVersionQueryQueue(self) -- Hidden ProfileVersionQuery method
	while #self.query_queue &gt; 0 do

		local queue_entry = table.remove(self.query_queue, 1)

		task.spawn(queue_entry)

		if self.is_query_yielded == true then
			break
		end

	end
end

local VersionQueryNextAsyncStackingFlag = false
local WarnAboutVersionQueryOnce = false

function ProfileVersionQuery:NextAsync()

	local is_stacking = VersionQueryNextAsyncStackingFlag == true
	VersionQueryNextAsyncStackingFlag = false

	WaitForStoreReady(self.profile_store)

	if ProfileStore.IsClosing == true then
		return nil -- Silently fail :NextAsync() requests
	end

	if self.is_mock == true or DataStoreState ~= "Access" then
		if IsStudio == true and WarnAboutVersionQueryOnce == false then
			WarnAboutVersionQueryOnce = true
			warn(`[{script.Name}]: :VersionQuery() is not supported in mock mode!`)
		end
		return nil -- Silently fail :NextAsync() requests
	end

	local profile
	local is_finished = false

	local function query_job()

		if self.query_failure == true then
			is_finished = true
			return
		end

		-- First "next" call loads version pages:

		if self.query_pages == nil then

			self.is_query_yielded = true

			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local list_success, error_message = pcall(function()
				self.query_pages = self.profile_store.data_store:ListVersionsAsync(
					self.profile_key,
					self.sort_direction,
					self.min_date,
					self.max_date
				)
				self.query_index = 0
			end)

			if list_success == false or self.query_pages == nil then
				warn(`[{script.Name}]: Version query fail - {tostring(error_message)}`)
				self.query_failure = true
			end

			self.is_query_yielded = false

			MoveVersionQueryQueue(self)

			return

		end

		local current_page = self.query_pages:GetCurrentPage()
		local next_item = current_page[self.query_index + 1]

		-- No more entries:

		if self.query_pages.IsFinished == true and next_item == nil then
			is_finished = true
			return
		end

		-- Load next page when this page is over:

		if next_item == nil then

			self.is_query_yielded = true
			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local success, error_message = pcall(function()
				self.query_pages:AdvanceToNextPageAsync()
				self.query_index = 0
			end)

			if success == false or #self.query_pages:GetCurrentPage() == 0 then
				self.query_failure = true
			end

			self.is_query_yielded = false
			MoveVersionQueryQueue(self)

			return

		end

		-- Next page item:

		self.query_index += 1
		profile = self.profile_store:GetAsync(self.profile_key, next_item.Version)
		is_finished = true

	end

	if self.is_query_yielded == false then
		query_job()
	else
		if is_stacking == true then
			table.insert(self.query_queue, 1, query_job)
		else
			table.insert(self.query_queue, query_job)
		end
	end

	while is_finished == false do
		task.wait()
	end

	return profile

end

function ProfileStore:VersionQuery(profile_key, sort_direction, min_date, max_date)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	-- Type check:

	if sort_direction ~= nil and (typeof(sort_direction) ~= "EnumItem"
		or sort_direction.EnumType ~= Enum.SortDirection) then
		error(`[{script.Name}]: Invalid sort_direction ({tostring(sort_direction)})`)
	end

	if min_date ~= nil and typeof(min_date) ~= "DateTime" and typeof(min_date) ~= "number" then
		error(`[{script.Name}]: Invalid min_date ({tostring(min_date)})`)
	end

	if max_date ~= nil and typeof(max_date) ~= "DateTime" and typeof(max_date) ~= "number" then
		error(`[{script.Name}]: Invalid max_date ({tostring(max_date)})`)
	end

	min_date = typeof(min_date) == "DateTime" and min_date.UnixTimestampMillis or min_date
	max_date = typeof(max_date) == "DateTime" and max_date.UnixTimestampMillis or max_date

	return ProfileVersionQuery.New(self, profile_key, sort_direction, min_date, max_date, is_mock)

end

-- DataStore API access check:

if IsStudio == true then

	task.spawn(function()

		local new_state = "NoAccess"

		local status, message = pcall(function()
			-- This will error if current instance has no Studio API access:
			DataStoreService:GetDataStore("____PS"):SetAsync("____PS", os.time())
		end)

		local no_internet_access = status == false and string.find(message, "ConnectFail", 1, true) ~= nil

		if no_internet_access == true then
			warn(`[{script.Name}]: No internet access - check your network connection`)
		end

		if status == false and
			(string.find(message, "403", 1, true) ~= nil or -- Cannot write to DataStore from studio if API access is not enabled
				string.find(message, "must publish", 1, true) ~= nil or -- Game must be published to access live keys
				no_internet_access == true) then -- No internet access

			new_state = if no_internet_access == true then "NoInternet" else "NoAccess"
			print(`[{script.Name}]: Roblox API services unavailable - data will not be saved`)
		else
			new_state = "Access"
			print(`[{script.Name}]: Roblox API services available - data will be saved`)
		end

		DataStoreState = new_state
		ProfileStore.DataStoreState = new_state

	end)

else
	
	DataStoreState = "Access"
	ProfileStore.DataStoreState = "Access"
	
end

-- Update loop:

RunService.Heartbeat:Connect(function()

	-- Auto saving:

	local auto_save_list_length = #AutoSaveList
	if auto_save_list_length &gt; 0 then
		local auto_save_index_speed = AUTO_SAVE_PERIOD / auto_save_list_length
		local os_clock = os.clock()
		while os_clock - LastAutoSave &gt; auto_save_index_speed do
			LastAutoSave = LastAutoSave + auto_save_index_speed
			local profile = AutoSaveList[AutoSaveIndex]
			if os_clock - profile.load_timestamp &lt; AUTO_SAVE_PERIOD / 2 then
				-- This profile is freshly loaded - auto saving immediately is not necessary:
				profile = nil
				for _ = 1, auto_save_list_length - 1 do
					-- Move auto save index to the right:
					AutoSaveIndex = AutoSaveIndex + 1
					if AutoSaveIndex &gt; auto_save_list_length then
						AutoSaveIndex = 1
					end
					profile = AutoSaveList[AutoSaveIndex]
					if os_clock - profile.load_timestamp &gt;= AUTO_SAVE_PERIOD / 2 then
						break
					else
						profile = nil
					end
				end
			end
			-- Move auto save index to the right:
			AutoSaveIndex = AutoSaveIndex + 1
			if AutoSaveIndex &gt; auto_save_list_length then
				AutoSaveIndex = 1
			end
			-- Perform save call:
			if profile ~= nil then
				task.spawn(SaveProfileAsync, profile) -- Auto save profile in new thread
			end
		end
	end

	-- Critical state handling:

	if ProfileStore.IsCriticalState == false then
		if #IssueQueue &gt;= CRITICAL_STATE_ERROR_COUNT then
			ProfileStore.IsCriticalState = true
			ProfileStore.OnCriticalToggle:Fire(true)
			CriticalStateStart = os.clock()
			warn(`[{script.Name}]: Entered critical state`)
		end
	else
		if #IssueQueue &gt;= CRITICAL_STATE_ERROR_COUNT then
			CriticalStateStart = os.clock()
		elseif os.clock() - CriticalStateStart &gt; CRITICAL_STATE_EXPIRE then
			ProfileStore.IsCriticalState = false
			ProfileStore.OnCriticalToggle:Fire(false)
			warn(`[{script.Name}]: Critical state ended`)
		end
	end

	-- Issue queue:

	while true do
		local issue_time = IssueQueue[1]
		if issue_time == nil then
			break
		elseif os.clock() - issue_time &gt; CRITICAL_STATE_ERROR_EXPIRE then
			table.remove(IssueQueue, 1)
		else
			break
		end
	end

end)

-- Release all loaded profiles when the server is shutting down:

task.spawn(function()

	while DataStoreState == "NotReady" do
		task.wait()
	end

	if DataStoreState ~= "Access" then

		game:BindToClose(function()
			ProfileStore.IsClosing = true
			task.wait() -- Mock shutdown delay
		end)

		return -- Don't wait for profiles to properly save in mock mode so studio could end the simulation faster

	end

	game:BindToClose(function()

		ProfileStore.IsClosing = true

		-- Release all active profiles:
		-- (Clone AutoSaveList to a new table because AutoSaveList changes when profiles are released)

		local on_close_save_job_count = 0
		local active_profiles = {}
		for index, profile in ipairs(AutoSaveList) do
			active_profiles[index] = profile
		end

		-- Release the profiles; Releasing profiles can trigger listeners that release other profiles, so check active state:
		for _, profile in ipairs(active_profiles) do
			if profile:IsActive() == true then
				on_close_save_job_count = on_close_save_job_count + 1
				task.spawn(function() -- Save profile on new thread
					SaveProfileAsync(profile, true, nil, "Shutdown")
					on_close_save_job_count = on_close_save_job_count - 1
				end)
			end
		end

		-- Yield until all active profile jobs are finished:
		while on_close_save_job_count &gt; 0 or ActiveProfileLoadJobs &gt; 0 or ActiveProfileSaveJobs &gt; 0 do
			task.wait()
		end

		return -- We're done!

	end)

end)

return ProfileStore</string>
