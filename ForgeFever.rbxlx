        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="37">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
--[[
	클라이언트 부트스트랩.
	controllers 폴더의 모듈을 정해진 순서대로 require → Init() → Start() 한다.

	클라이언트는 "요청"과 "표시"만 한다.
	확률 계산, 골드 증감, 레벨 변경은 전부 서버가 결정한다.
	서버 응답을 받기 전에는 어떤 결과 연출도 시작하지 않는다.
]]

type Controller = {
	Name: string?,
	Init: (() -> ())?,
	Start: (() -> ())?,
}

local CONTROLLER_ORDER = {
	"SoundController",
	"EffectsController",
	"FeedController",
	"OddsTableController",
	"ShopController",
	"SwordController",
	"CollectionController",
	"UIController",
}

local controllersFolder = script:WaitForChild("controllers")

local function loadController(name: string): Controller
	local module = controllersFolder:WaitForChild(name)
	assert(module:IsA("ModuleScript"), `[Client] 컨트롤러 모듈이 아닙니다: {name}`)
	return require(module) :: Controller
end

local function runStage(stage: "Init" | "Start", controllers: { Controller })
	for _, controller in controllers do
		local fn = if stage == "Init" then controller.Init else controller.Start
		if not fn then
			continue
		end

		local ok, err = xpcall(fn, debug.traceback)
		if not ok then
			warn(`[Client] {controller.Name or "?"}.{stage} 실패:\n{err}`)
		end
	end
end

local controllers: { Controller } = {}
for _, name in CONTROLLER_ORDER do
	local controller = loadController(name)
	controller.Name = controller.Name or name
	table.insert(controllers, controller)
end

runStage("Init", controllers)
runStage("Start", controllers)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ClientState — 서버가 보내 준 내 데이터의 로컬 사본.

	클라이언트는 이 값을 "표시"에만 쓴다. 여기 있는 숫자를 고쳐도 게임에는
	아무 영향이 없다(서버가 진짜 값을 들고 있다).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Locale = require(Shared:WaitForChild("Locale"))

local ClientState = {}

local data: Types.PlayerData? = nil
local odds: Types.DisplayOdds? = nil
local liveOps: { maintenance: boolean, notice: string, event: any } = {
	maintenance = false,
	notice = "",
	event = nil,
}
-- "방지권 사용" 스위치. 강화 요청에 실어 보내고, 화면의 확률 표시도 이 값에 따라 바뀐다.
local useProtect = false
local listeners: { () -> () } = {}

local function notify()
	for _, listener in listeners do
		local ok, err = pcall(listener)
		if not ok then
			warn(`[ClientState] 리스너 오류: {err}`)
		end
	end
end

function ClientState.setData(newData: Types.PlayerData)
	data = newData
	notify()
end

function ClientState.setOdds(newOdds: Types.DisplayOdds)
	odds = newOdds
	notify()
end

function ClientState.getData(): Types.PlayerData?
	return data
end

function ClientState.getOdds(): Types.DisplayOdds?
	return odds
end

-- 착용 중인 검 (데이터가 아직 없으면 nil)
function ClientState.getEquipped(): Types.SwordState?
	if data == nil or type(data.swords) ~= "table" then
		return nil
	end
	return data.swords[data.equippedId]
end

-- 가진 검 수 (데이터가 아직 없으면 1)
function ClientState.getSwordCount(): number
	if data == nil or type(data.swords) ~= "table" then
		return 1
	end

	local count = 0
	for _ in data.swords do
		count += 1
	end
	return math.max(1, count)
end

function ClientState.getUseProtect(): boolean
	return useProtect
end

function ClientState.setUseProtect(value: boolean)
	useProtect = value
	notify()
end

-- 방지권이 실제로 효과를 내는 상태인지 (스위치가 켜져 있고 방지권이 1개 이상)
function ClientState.isProtectActive(): boolean
	return useProtect and data ~= nil and data.protectTickets > 0
end

function ClientState.getLanguage(): string
	if data and data.settings and data.settings.language then
		return data.settings.language
	end
	return Locale.DEFAULT_LANGUAGE
end

function ClientState.setLiveOps(config: any)
	liveOps = {
		maintenance = config.maintenance == true,
		notice = if type(config.notice) == "string" then config.notice else "",
		event = config.event,
	}
	notify()
end

function ClientState.getLiveOps()
	return liveOps
end

function ClientState.onChanged(listener: () -> ())
	table.insert(listeners, listener)
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="39">
          <Properties>
            <string name="Name">controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">CollectionController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CollectionController — 도감 / 랭킹 / 설정을 탭 하나로 묶은 화면.

	세 화면을 따로 만들면 코드가 세 배가 되고 모바일에서 버튼도 자리를 잃는다.
	한 패널 안에서 탭으로 바꾸는 편이 화면도 코드도 단순하다.

	랭킹은 지금 "최고 강화" 하나뿐이다. 배틀 레이팅 순위는 1:1 배틀과 함께 없앴고,
	그 자리를 채울 순위는 아직 정해지지 않았다(통합 기획서 9절 D7).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))
local Weapons = require(Shared:WaitForChild("Config"):WaitForChild("Weapons"))

local ClientState = require(script.Parent.Parent:WaitForChild("ClientState"))

local CollectionController = {}
CollectionController.Name = "CollectionController"

local COLOR_PANEL = Color3.fromRGB(34, 30, 38)
local COLOR_ROW = Color3.fromRGB(44, 39, 50)
local COLOR_TEXT = Color3.fromRGB(240, 236, 230)
local COLOR_MUTED = Color3.fromRGB(120, 114, 126)
local COLOR_ACCENT = Color3.fromRGB(226, 142, 58)

local TOUCH_MIN = 44

type Tab = "codex" | "rank" | "settings"

local TABS: { Tab } = { "codex", "rank", "settings" }

local gui: ScreenGui
local panel: Frame
local scroller: ScrollingFrame
local tabButtons: { [string]: TextButton } = {}
local rankTitle: TextLabel
local closeButton: TextButton

local boardRemote: RemoteFunction
local settingRemote: RemoteFunction
local settingsRow: Frame
local sfxButton: TextButton
local languageButton: TextButton

local activeTab: Tab = "codex"

-- 서버에 요청하는 순위 종류. 지금은 최고 강화 레벨 하나뿐이다.
local RANK_KIND = "level"

local function makeRow(text: string, color: Color3, order: number)
	local label = Instance.new("TextLabel")
	label.BackgroundColor3 = COLOR_ROW
	label.BackgroundTransparency = 0.4
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 14
	label.TextColor3 = color
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Size = UDim2.new(1, 0, 0, 26)
	label.Text = "  " .. text
	label.LayoutOrder = order
	label.Parent = scroller

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = label
end

local function clearRows()
	for _, child in scroller:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
end

--[[
	도감: 검 1종 = 1칸. 가진 검은 역대 최고 레벨과 달성한 기념 구간(5·10·15·20강)을 보여 준다.
	서버에 따로 묻지 않고 복제받은 데이터(swords, codex)로 그린다.
]]
local function renderCodex()
	local language = ClientState.getLanguage()
	local data = ClientState.getData()

	clearRows()

	if data == nil then
		makeRow(Locale.get(language, "error.not_ready"), COLOR_MUTED, 1)
		return
	end

	for index, weaponId in Weapons.Order do
		local weapon = Weapons.get(weaponId)
		if weapon == nil then
			continue
		end

		local name = Locale.get(language, weapon.nameKey)
		local rarity = Locale.get(language, `rarity.{weapon.rarity}`)
		local sword = data.swords[weaponId]

		if sword == nil then
			makeRow(Locale.get(language, "ui.codexMissing", name, rarity), COLOR_MUTED, index)
			continue
		end

		local text = Locale.get(language, "ui.codexOwned", name, rarity, sword.bestLevel)

		local reached: { string } = {}
		for _, milestone in Weapons.CODEX_MILESTONES do
			if data.codex[`{weaponId}:{milestone}`] then
				table.insert(reached, Format.level(milestone))
			end
		end
		if #reached > 0 then
			text ..= "  ·  " .. Locale.get(
				language,
				"ui.codexMilestones",
				table.concat(reached, " ")
			)
		end

		makeRow(text, COLOR_TEXT, index)
	end
end

local function renderRanking()
	local language = ClientState.getLanguage()

	rankTitle.Text = Locale.get(language, `ui.rank.{RANK_KIND}`)

	local ok, entries = pcall(function()
		return boardRemote:InvokeServer(RANK_KIND)
	end)

	clearRows()

	if not ok or type(entries) ~= "table" or #entries == 0 then
		makeRow(Locale.get(language, "ui.rank.empty"), COLOR_MUTED, 1)
		return
	end

	local myUserId = Players.LocalPlayer.UserId

	for index, entry in entries do
		makeRow(
			Locale.get(language, "ui.rank.row", entry.rank, entry.name, Format.level(entry.value)),
			if entry.userId == myUserId then COLOR_ACCENT else COLOR_TEXT,
			index
		)
	end
end

local function applySetting(key: string, value: any)
	task.spawn(function()
		pcall(function()
			settingRemote:InvokeServer(key, value)
		end)
	end)
end

local function renderSettings()
	local language = ClientState.getLanguage()
	local data = ClientState.getData()

	clearRows()

	if data == nil then
		makeRow(Locale.get(language, "error.not_ready"), COLOR_MUTED, 1)
		return
	end

	sfxButton.Text = Locale.get(language, if data.settings.sfx then "ui.sfxOn" else "ui.sfxOff")
	sfxButton.TextColor3 = if data.settings.sfx then COLOR_ACCENT else COLOR_MUTED
	languageButton.Text = Locale.get(language, "ui.language")
end

local function refresh()
	local language = ClientState.getLanguage()

	for key, button in tabButtons do
		button.Text = Locale.get(language, `ui.tab.{key}`)
		button.TextColor3 = if key == activeTab then COLOR_ACCENT else COLOR_MUTED
	end

	closeButton.Text = Locale.get(language, "ui.close")
	rankTitle.Visible = activeTab == "rank"
	settingsRow.Visible = activeTab == "settings"

	if activeTab == "settings" then
		renderSettings()
		return
	end

	clearRows()
	makeRow("...", COLOR_MUTED, 0)

	task.spawn(function()
		if activeTab == "codex" then
			renderCodex()
		else
			renderRanking()
		end
	end)
end

local function makeButton(parent: Instance, props: { [string]: any }): TextButton
	local button = Instance.new("TextButton")
	button.BackgroundColor3 = COLOR_ROW
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamBold
	button.TextColor3 = COLOR_TEXT
	button.TextSize = 15
	button.Size = UDim2.new(1, 0, 0, TOUCH_MIN)
	button.Text = ""
	for key, value in props do
		(button :: any)[key] = value
	end
	button.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = button

	return button
end

local function build()
	local player = Players.LocalPlayer

	gui = Instance.new("ScreenGui")
	gui.Name = "ForgeRecords"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 12
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local dim = Instance.new("TextButton")
	dim.BackgroundColor3 = Color3.new(0, 0, 0)
	dim.BackgroundTransparency = 0.45
	dim.BorderSizePixel = 0
	dim.Size = UDim2.fromScale(1, 1)
	dim.Text = ""
	dim.AutoButtonColor = false
	dim.Parent = gui

	panel = Instance.new("Frame")
	panel.BackgroundColor3 = COLOR_PANEL
	panel.BorderSizePixel = 0
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.new(0.92, 0, 0.8, 0)
	panel.Parent = gui

	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MaxSize = Vector2.new(520, 640)
	sizeConstraint.Parent = panel

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = panel

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 14)
	padding.PaddingBottom = UDim.new(0, 14)
	padding.PaddingLeft = UDim.new(0, 14)
	padding.PaddingRight = UDim.new(0, 14)
	padding.Parent = panel

	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 8)
	list.Parent = panel

	-- 탭 줄
	local tabRow = Instance.new("Frame")
	tabRow.BackgroundTransparency = 1
	tabRow.Size = UDim2.new(1, 0, 0, TOUCH_MIN)
	tabRow.LayoutOrder = 1
	tabRow.Parent = panel

	local tabList = Instance.new("UIListLayout")
	tabList.FillDirection = Enum.FillDirection.Horizontal
	tabList.SortOrder = Enum.SortOrder.LayoutOrder
	tabList.Padding = UDim.new(0, 6)
	tabList.Parent = tabRow

	for order, key in TABS do
		local button = makeButton(tabRow, {
			Size = UDim2.new(1 / #TABS, -4, 1, 0),
			TextSize = 13,
			LayoutOrder = order,
		})
		button.Activated:Connect(function()
			activeTab = key
			refresh()
		end)
		tabButtons[key] = button
	end

	-- 랭킹 탭에서만 보이는 제목 (어떤 순위인지)
	rankTitle = Instance.new("TextLabel")
	rankTitle.BackgroundTransparency = 1
	rankTitle.Font = Enum.Font.GothamMedium
	rankTitle.TextSize = 14
	rankTitle.TextColor3 = COLOR_ACCENT
	rankTitle.Size = UDim2.new(1, 0, 0, 34)
	rankTitle.Text = ""
	rankTitle.Visible = false
	rankTitle.LayoutOrder = 2
	rankTitle.Parent = panel

	-- 설정 탭에서만 보이는 줄
	settingsRow = Instance.new("Frame")
	settingsRow.BackgroundTransparency = 1
	settingsRow.Size = UDim2.new(1, 0, 0, TOUCH_MIN)
	settingsRow.Visible = false
	settingsRow.LayoutOrder = 2
	settingsRow.Parent = panel

	local settingsList = Instance.new("UIListLayout")
	settingsList.FillDirection = Enum.FillDirection.Horizontal
	settingsList.SortOrder = Enum.SortOrder.LayoutOrder
	settingsList.Padding = UDim.new(0, 8)
	settingsList.Parent = settingsRow

	sfxButton = makeButton(settingsRow, {
		Size = UDim2.new(0.5, -4, 1, 0),
		TextSize = 14,
		Font = Enum.Font.GothamMedium,
		LayoutOrder = 1,
	})
	languageButton = makeButton(settingsRow, {
		Size = UDim2.new(0.5, -4, 1, 0),
		TextSize = 14,
		Font = Enum.Font.GothamMedium,
		LayoutOrder = 2,
	})

	sfxButton.Activated:Connect(function()
		local data = ClientState.getData()
		if data then
			applySetting("sfx", not data.settings.sfx)
		end
	end)

	languageButton.Activated:Connect(function()
		local next_ = if ClientState.getLanguage() == "ko" then "en" else "ko"
		applySetting("language", next_)
	end)

	scroller = Instance.new("ScrollingFrame")
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.Size = UDim2.new(1, 0, 1, -150)
	scroller.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroller.ScrollBarThickness = 4
	scroller.LayoutOrder = 3
	scroller.Parent = panel

	local scrollList = Instance.new("UIListLayout")
	scrollList.FillDirection = Enum.FillDirection.Vertical
	scrollList.SortOrder = Enum.SortOrder.LayoutOrder
	scrollList.Padding = UDim.new(0, 3)
	scrollList.Parent = scroller

	closeButton = makeButton(panel, { LayoutOrder = 4 })
	closeButton.Activated:Connect(function()
		gui.Enabled = false
	end)
	dim.Activated:Connect(function()
		gui.Enabled = false
	end)
end

function CollectionController.toggle()
	if gui.Enabled then
		gui.Enabled = false
		return
	end

	gui.Enabled = true
	refresh()
end

function CollectionController.Init()
	build()

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	boardRemote = remotesFolder:WaitForChild(Remotes.Functions.GetLeaderboard) :: RemoteFunction
	settingRemote = remotesFolder:WaitForChild(Remotes.Functions.SetSetting) :: RemoteFunction
end

function CollectionController.Start()
	-- 설정을 바꾸면 서버가 데이터를 다시 내려 주므로, 그때 화면을 갱신한다.
	ClientState.onChanged(function()
		if not gui.Enabled then
			return
		end

		if activeTab == "settings" then
			renderSettings()
		elseif activeTab == "codex" then
			renderCodex()
		end
	end)
end

return CollectionController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	EffectsController — 강화 결과 연출.

	모든 연출은 서버 응답을 받은 뒤 UIController 가 호출해서 시작한다.
	외부 에셋 없이 UI 요소의 움직임만으로 만든다(나중에 파티클/사운드를 얹기 쉬움).

	- 성공: 글자가 커지며 밝게 번쩍 + 위로 솟는 느낌
	- 유지: 짧은 좌우 흔들림
	- 실패(10강 복귀): 붉은 화면 번쩍 + 조각이 흩어지는 연출 + 화면 흔들림
	- 보호: 푸른 방패 펄스
]]

local TweenService = game:GetService("TweenService")

local EffectsController = {}
EffectsController.Name = "EffectsController"

local centerFrame: Frame? = nil
local levelLabel: TextLabel? = nil
local flash: Frame? = nil

local BASE_TEXT_SIZE = 72

-- UIController 가 자기 UI 요소를 넘겨 준다.
function EffectsController.bind(targetGui: ScreenGui, center: Frame, label: TextLabel)
	centerFrame = center
	levelLabel = label
	BASE_TEXT_SIZE = label.TextSize

	local overlay = Instance.new("Frame")
	overlay.Name = "Flash"
	overlay.BackgroundColor3 = Color3.new(1, 1, 1)
	overlay.BackgroundTransparency = 1
	overlay.BorderSizePixel = 0
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.ZIndex = 50
	overlay.Active = false
	overlay.Parent = targetGui
	flash = overlay
end

local function flashScreen(color: Color3, strength: number)
	local overlay = flash
	if overlay == nil then
		return
	end

	overlay.BackgroundColor3 = color
	overlay.BackgroundTransparency = 1 - strength
	TweenService:Create(
		overlay,
		TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 1 }
	):Play()
end

local function shake(intensity: number, duration: number)
	local frame = centerFrame
	if frame == nil then
		return
	end

	local origin = frame.Position
	local steps = math.max(2, math.floor(duration / 0.04))

	task.spawn(function()
		for step = 1, steps do
			local decay = 1 - step / steps
			local offsetX = (math.random() - 0.5) * 2 * intensity * decay
			local offsetY = (math.random() - 0.5) * 2 * intensity * decay
			frame.Position = origin + UDim2.fromOffset(offsetX, offsetY)
			task.wait(0.04)
		end
		frame.Position = origin
	end)
end

local function pulseLabel(targetSize: number, color: Color3)
	local label = levelLabel
	if label == nil then
		return
	end

	local originalColor = label.TextColor3
	label.TextSize = targetSize
	label.TextColor3 = color

	TweenService:Create(
		label,
		TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ TextSize = BASE_TEXT_SIZE, TextColor3 = originalColor }
	):Play()
end

-- 파괴될 때 조각이 흩어지는 연출
local function burst(count: number, color: Color3)
	local frame = centerFrame
	if frame == nil then
		return
	end

	for _ = 1, count do
		local piece = Instance.new("Frame")
		piece.BackgroundColor3 = color
		piece.BorderSizePixel = 0
		piece.AnchorPoint = Vector2.new(0.5, 0.5)
		piece.Position = UDim2.fromScale(0.5, 0.5)
		piece.Size = UDim2.fromOffset(math.random(4, 10), math.random(4, 10))
		piece.Rotation = math.random(0, 360)
		piece.ZIndex = 20
		piece.Parent = frame

		local angle = math.random() * math.pi * 2
		local distance = math.random(60, 180)

		local tween = TweenService:Create(
			piece,
			TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{
				Position = UDim2.new(
					0.5,
					math.cos(angle) * distance,
					0.5,
					math.sin(angle) * distance
				),
				BackgroundTransparency = 1,
				Rotation = piece.Rotation + math.random(-180, 180),
			}
		)

		tween.Completed:Connect(function()
			piece:Destroy()
		end)
		tween:Play()
	end
end

--[[
	결과에 맞는 연출을 재생한다.
	outcome: "success" | "keep" | "fail" | "protected"
]]
function EffectsController.play(outcome: string)
	if outcome == "success" then
		pulseLabel(BASE_TEXT_SIZE * 1.4, Color3.fromRGB(255, 240, 200))
		flashScreen(Color3.fromRGB(255, 220, 150), 0.25)
	elseif outcome == "keep" then
		shake(6, 0.2)
	elseif outcome == "fail" then
		pulseLabel(BASE_TEXT_SIZE * 0.7, Color3.fromRGB(255, 120, 108))
		flashScreen(Color3.fromRGB(255, 80, 70), 0.4)
		burst(14, Color3.fromRGB(200, 190, 180))
		shake(14, 0.45)
	elseif outcome == "protected" then
		pulseLabel(BASE_TEXT_SIZE * 1.15, Color3.fromRGB(150, 215, 255))
		flashScreen(Color3.fromRGB(120, 190, 255), 0.25)
	end
end

-- 최대 레벨 도달 시의 특수 연출
function EffectsController.playMaxLevel()
	pulseLabel(BASE_TEXT_SIZE * 1.6, Color3.fromRGB(255, 255, 255))
	flashScreen(Color3.fromRGB(255, 240, 200), 0.5)
	burst(24, Color3.fromRGB(255, 215, 140))
end

function EffectsController.Init() end

function EffectsController.Start() end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">FeedController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	FeedController — 결과 피드.
	채팅 로그처럼 최근 결과가 한 줄씩 쌓인다. 모루 영감의 대사로 출력한다.

	Phase 2 에서 연출(페이드, 강조색, 접이식 모바일 레이아웃)을 다듬는다.
	지금은 "서버 응답을 받은 뒤에만 한 줄 추가된다"는 흐름을 먼저 세운다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ClientState = require(script.Parent.Parent:WaitForChild("ClientState"))

local FeedController = {}
FeedController.Name = "FeedController"

local MAX_LINES = 7
local NARROW_WIDTH = 700

local OUTCOME_COLOR: { [string]: Color3 } = {
	system = Color3.fromRGB(230, 226, 220),
	success = Color3.fromRGB(255, 208, 112),
	keep = Color3.fromRGB(198, 198, 198),
	fail = Color3.fromRGB(255, 120, 108),
	protected = Color3.fromRGB(140, 210, 255),
	broadcast = Color3.fromRGB(180, 255, 190),
}

local container: Frame? = nil
local toggleButton: TextButton? = nil
local lineCount = 0
local collapsed = false

local function layout()
	local frame = container
	if frame == nil then
		return
	end

	local viewport = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize
	local isNarrow = viewport ~= nil and viewport.X < NARROW_WIDTH

	local button = toggleButton

	if isNarrow then
		-- 모바일: 화면 위쪽에 가로로 넓게, 접을 수 있게
		frame.AnchorPoint = Vector2.new(0.5, 0)
		frame.Position = UDim2.new(0.5, 0, 0, 64)
		frame.Size = UDim2.new(1, -24, 0, if collapsed then 0 else 132)
		frame.Visible = not collapsed

		if button then
			button.Visible = true
			button.AnchorPoint = Vector2.new(0.5, 0)
			button.Position = UDim2.new(0.5, 0, 0, if collapsed then 64 else 200)
		end
	else
		-- 데스크톱: 우측 세로 (항상 펼침)
		frame.AnchorPoint = Vector2.new(1, 0)
		frame.Position = UDim2.new(1, -16, 0, 72)
		frame.Size = UDim2.new(0, 320, 0, 220)
		frame.Visible = true

		if button then
			button.Visible = false
		end
	end
end

local function build()
	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name = "ForgeFeed"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	local frame = Instance.new("Frame")
	frame.Name = "Lines"
	frame.BackgroundColor3 = Color3.fromRGB(18, 16, 20)
	frame.BackgroundTransparency = 0.35
	frame.BorderSizePixel = 0
	frame.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 8)
	padding.PaddingBottom = UDim.new(0, 8)
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 10)
	padding.Parent = frame

	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.VerticalAlignment = Enum.VerticalAlignment.Bottom
	list.Padding = UDim.new(0, 2)
	list.Parent = frame

	-- 모바일에서 피드를 접었다 펼치는 버튼 (최소 터치 영역 44px)
	local toggle = Instance.new("TextButton")
	toggle.Name = "FeedToggle"
	toggle.BackgroundColor3 = Color3.fromRGB(52, 46, 58)
	toggle.BorderSizePixel = 0
	toggle.Font = Enum.Font.GothamMedium
	toggle.TextSize = 13
	toggle.TextColor3 = Color3.fromRGB(230, 226, 220)
	toggle.Size = UDim2.fromOffset(84, 44)
	toggle.Visible = false
	toggle.Parent = gui

	local toggleCorner = Instance.new("UICorner")
	toggleCorner.CornerRadius = UDim.new(0, 10)
	toggleCorner.Parent = toggle

	toggle.Activated:Connect(function()
		collapsed = not collapsed
		layout()
	end)

	container = frame
	toggleButton = toggle
	layout()

	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(layout)
	end
end

--[[
	기본 채팅창에도 같은 내용을 띄운다.
	TextChannel:DisplaySystemMessage() 는 공식 문서상 클라이언트에서만 호출할 수 있고,
	그 메시지는 이 플레이어에게만 보인다. 그래서 전체 공지는 서버가 리모트로
	모든 클라이언트에 보내고, 각자 자기 채팅창에 띄우는 구조를 쓴다.
]]
local function displayInChat(text: string)
	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		return
	end

	local channels = TextChatService:FindFirstChild("TextChannels")
	local general = channels and channels:FindFirstChild("RBXGeneral")

	if general and general:IsA("TextChannel") then
		local ok, err = pcall(function()
			general:DisplaySystemMessage(text)
		end)
		if not ok then
			warn(`[FeedController] 채팅 표시 실패: {err}`)
		end
	end
end

local function push(text: string, color: Color3)
	local frame = container
	if frame == nil then
		return
	end

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, 18)
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 14
	label.TextColor3 = color
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Text = text
	lineCount += 1
	label.LayoutOrder = lineCount
	label.Parent = frame

	-- 오래된 줄부터 지운다.
	local labels: { TextLabel } = {}
	for _, child in frame:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(labels, child)
		end
	end

	if #labels > MAX_LINES then
		table.sort(labels, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for index = 1, #labels - MAX_LINES do
			labels[index]:Destroy()
		end
	end
end

-- 강화 결과 한 줄. 서버 응답을 받은 뒤에만 호출한다.
function FeedController.pushOutcome(outcome: string)
	local language = ClientState.getLanguage()
	local npc = Locale.get(language, "npc.anvilElder.name")

	local variants = Locale.variantCount(language, `feed.{outcome}`)
	local key = if variants > 0
		then `feed.{outcome}.{math.random(1, variants)}`
		else `feed.{outcome}.1`

	push(`{npc}: {Locale.get(language, key)}`, OUTCOME_COLOR[outcome] or Color3.new(1, 1, 1))
end

function FeedController.pushRaw(text: string, color: Color3?)
	push(text, color or Color3.new(1, 1, 1))
end

function FeedController.Init()
	build()

	local button = toggleButton
	if button then
		button.Text = Locale.get(ClientState.getLanguage(), "ui.feedToggle")
	end
end

function FeedController.Start()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	local feedRemote = remotesFolder:WaitForChild(Remotes.Events.FeedMessage) :: RemoteEvent

	feedRemote.OnClientEvent:Connect(function(payload: any)
		if type(payload) ~= "table" then
			return
		end

		if payload.kind == "broadcast" then
			local language = ClientState.getLanguage()
			local text = Locale.get(
				language,
				"feed.broadcast",
				tostring(payload.playerName),
				Locale.get(language, tostring(payload.weaponKey)),
				tonumber(payload.level) or 0
			)
			push(text, OUTCOME_COLOR.broadcast)
			displayInChat(text)
		elseif payload.kind == "system" and type(payload.text) == "string" then
			-- 채팅 명령어의 응답. 채팅창과 피드 양쪽에 남긴다.
			push(payload.text, OUTCOME_COLOR.system)
			displayInChat(payload.text)
		end
	end)
end

return FeedController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">OddsTableController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	OddsTableController — 확률표 화면.

	강화 화면에서 언제든 열 수 있어야 한다(확률표는 상품 여부와 관계없이 항상 열람 가능).

	표에 보이는 값은 "지금 실제로 적용되는" 최종 확률과 비용이다.
	  - 기본값: shared/Config/EnhanceTable
	  - 확률 버프 이벤트가 있으면 성공 + / 유지 - (실패는 그대로)
	  - 방지권을 켜 두었고 방지권이 있으면 실패 0%, 그만큼 유지
	  - 비용에는 가진 검 수 할증이 들어간다
	서버가 쓰는 것과 같은 Pure/EnhanceLogic 함수로 계산하므로 실제 판정과 어긋나지 않는다.
]]

local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))
local EnhanceTable = require(Shared:WaitForChild("Config"):WaitForChild("EnhanceTable"))
local EnhanceLogic = require(Shared:WaitForChild("Pure"):WaitForChild("EnhanceLogic"))

local ClientState = require(script.Parent.Parent:WaitForChild("ClientState"))

local OddsTableController = {}
OddsTableController.Name = "OddsTableController"

local COLOR_PANEL = Color3.fromRGB(34, 30, 38)
local COLOR_ROW = Color3.fromRGB(44, 39, 50)
local COLOR_ROW_CURRENT = Color3.fromRGB(78, 58, 34)
local COLOR_TEXT = Color3.fromRGB(240, 236, 230)
local COLOR_MUTED = Color3.fromRGB(168, 160, 172)
local COLOR_ACCENT = Color3.fromRGB(226, 142, 58)

local ROW_HEIGHT = 26
local HEADER_TOP = 86 -- 제목, 이벤트 줄, 방지권 안내 아래
local COLUMN_WIDTHS = { 0.16, 0.2, 0.2, 0.2, 0.24 }

local gui: ScreenGui
local panel: Frame
local scroller: ScrollingFrame
local titleLabel: TextLabel
local eventLabel: TextLabel
local noteLabel: TextLabel
local closeButton: TextButton
local rows: { [number]: Frame } = {}

local function makeCell(parent: Instance, index: number, text: string, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 13
	label.TextColor3 = color
	label.Text = text
	label.Size = UDim2.new(COLUMN_WIDTHS[index], 0, 1, 0)
	label.LayoutOrder = index
	label.Parent = parent
	return label
end

local function makeRow(parent: Instance, order: number): Frame
	local row = Instance.new("Frame")
	row.BackgroundColor3 = COLOR_ROW
	row.BackgroundTransparency = 0.4
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 0, ROW_HEIGHT)
	row.LayoutOrder = order
	row.Parent = parent

	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Horizontal
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.Parent = row

	return row
end

local function build()
	local player = Players.LocalPlayer

	gui = Instance.new("ScreenGui")
	gui.Name = "ForgeOddsTable"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 10
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local dim = Instance.new("TextButton")
	dim.Name = "Dim"
	dim.BackgroundColor3 = Color3.new(0, 0, 0)
	dim.BackgroundTransparency = 0.45
	dim.BorderSizePixel = 0
	dim.Size = UDim2.fromScale(1, 1)
	dim.Text = ""
	dim.AutoButtonColor = false
	dim.Parent = gui

	panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.BackgroundColor3 = COLOR_PANEL
	panel.BorderSizePixel = 0
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.new(0.92, 0, 0.8, 0)
	panel.Parent = gui

	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MaxSize = Vector2.new(520, 640)
	sizeConstraint.Parent = panel

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = panel

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 14)
	padding.PaddingBottom = UDim.new(0, 14)
	padding.PaddingLeft = UDim.new(0, 14)
	padding.PaddingRight = UDim.new(0, 14)
	padding.Parent = panel

	titleLabel = Instance.new("TextLabel")
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextSize = 20
	titleLabel.TextColor3 = COLOR_TEXT
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Size = UDim2.new(1, -80, 0, 28)
	titleLabel.Position = UDim2.fromOffset(0, 0)
	titleLabel.Parent = panel

	closeButton = Instance.new("TextButton")
	closeButton.BackgroundColor3 = COLOR_ROW
	closeButton.BorderSizePixel = 0
	closeButton.Font = Enum.Font.GothamBold
	closeButton.TextSize = 14
	closeButton.TextColor3 = COLOR_TEXT
	closeButton.AnchorPoint = Vector2.new(1, 0)
	closeButton.Position = UDim2.new(1, 0, 0, 0)
	closeButton.Size = UDim2.fromOffset(72, 44) -- 최소 터치 영역 확보
	closeButton.Parent = panel

	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 8)
	closeCorner.Parent = closeButton

	eventLabel = Instance.new("TextLabel")
	eventLabel.BackgroundTransparency = 1
	eventLabel.Font = Enum.Font.GothamMedium
	eventLabel.TextSize = 13
	eventLabel.TextColor3 = Color3.fromRGB(140, 210, 255)
	eventLabel.TextXAlignment = Enum.TextXAlignment.Left
	eventLabel.Size = UDim2.new(1, 0, 0, 18)
	eventLabel.Position = UDim2.fromOffset(0, 32)
	eventLabel.Visible = false
	eventLabel.Parent = panel

	-- 방지권이 확률을 어떻게 바꾸는지 숫자로 적어 둔다.
	noteLabel = Instance.new("TextLabel")
	noteLabel.BackgroundTransparency = 1
	noteLabel.Font = Enum.Font.GothamMedium
	noteLabel.TextSize = 12
	noteLabel.TextColor3 = COLOR_MUTED
	noteLabel.TextXAlignment = Enum.TextXAlignment.Left
	noteLabel.TextWrapped = true
	noteLabel.Size = UDim2.new(1, 0, 0, 30)
	noteLabel.Position = UDim2.fromOffset(0, 52)
	noteLabel.Text = ""
	noteLabel.Parent = panel

	-- 헤더
	local header = Instance.new("Frame")
	header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0, ROW_HEIGHT)
	header.Position = UDim2.fromOffset(0, HEADER_TOP)
	header.Parent = panel

	local headerList = Instance.new("UIListLayout")
	headerList.FillDirection = Enum.FillDirection.Horizontal
	headerList.SortOrder = Enum.SortOrder.LayoutOrder
	headerList.VerticalAlignment = Enum.VerticalAlignment.Center
	headerList.Parent = header

	scroller = Instance.new("ScrollingFrame")
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.Position = UDim2.fromOffset(0, HEADER_TOP + ROW_HEIGHT + 4)
	scroller.Size = UDim2.new(1, 0, 1, -(HEADER_TOP + ROW_HEIGHT + 4))
	scroller.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroller.ScrollBarThickness = 4
	scroller.Parent = panel

	local scrollList = Instance.new("UIListLayout")
	scrollList.FillDirection = Enum.FillDirection.Vertical
	scrollList.SortOrder = Enum.SortOrder.LayoutOrder
	scrollList.Padding = UDim.new(0, 2)
	scrollList.Parent = scroller

	closeButton.Activated:Connect(function()
		OddsTableController.close()
	end)
	dim.Activated:Connect(function()
		OddsTableController.close()
	end)

	-- 행은 한 번만 만들고 이후에는 텍스트만 갱신한다.
	local language = Locale.DEFAULT_LANGUAGE
	local headers = {
		"ui.column.level",
		"ui.column.success",
		"ui.column.keep",
		"ui.column.fail",
		"ui.column.cost",
	}
	for index, key in headers do
		makeCell(header, index, Locale.get(language, key), COLOR_MUTED)
	end

	for level = 0, EnhanceTable.MAX_LEVEL do
		rows[level] = makeRow(scroller, level + 1)
	end
end

local function refresh()
	local language = ClientState.getLanguage()
	local sword = ClientState.getEquipped()
	local currentLevel = if sword then sword.level else -1
	local swordCount = ClientState.getSwordCount()

	titleLabel.Text = Locale.get(language, "ui.oddsTableTitle")
	closeButton.Text = Locale.get(language, "ui.close")
	noteLabel.Text = Locale.get(language, "ui.protectNote")

	-- 진행 중인 확률 버프 이벤트 (성공 +, 그만큼 유지 -, 실패는 그대로)
	local event = ClientState.getLiveOps().event
	local buff = 0
	if type(event) == "table" and type(event.successBuff) == "number" then
		buff = event.successBuff
		eventLabel.Visible = true
		eventLabel.Text =
			Locale.get(language, "ui.eventActive", Locale.get(language, tostring(event.nameKey)))
	else
		eventLabel.Visible = false
	end

	local protectActive = ClientState.isProtectActive()

	for level = 0, EnhanceTable.MAX_LEVEL do
		local row = rows[level]
		row:ClearAllChildren()

		local list = Instance.new("UIListLayout")
		list.FillDirection = Enum.FillDirection.Horizontal
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.VerticalAlignment = Enum.VerticalAlignment.Center
		list.Parent = row

		local isCurrent = level == currentLevel
		row.BackgroundColor3 = if isCurrent then COLOR_ROW_CURRENT else COLOR_ROW
		local textColor = if isCurrent then COLOR_ACCENT else COLOR_TEXT

		local base = EnhanceTable.Odds[level]
		makeCell(row, 1, Format.level(level), textColor)

		if base then
			-- 화면에 보이는 값은 "지금 실제로 적용되는" 최종 확률이다.
			local entry = EnhanceLogic.applyBuff(base, buff)
			if protectActive then
				entry = EnhanceLogic.applyProtect(entry)
			end

			local cost = EnhanceLogic.cost(
				level,
				swordCount,
				EnhanceTable.COST_BASE,
				EnhanceTable.SWORD_COUNT_EXPONENT
			)

			makeCell(row, 2, Format.percent(entry.success), textColor)
			makeCell(row, 3, Format.percent(entry.keep), COLOR_MUTED)
			makeCell(
				row,
				4,
				Format.percent(entry.fail),
				if entry.fail > 0 then Color3.fromRGB(255, 130, 118) else COLOR_MUTED
			)
			makeCell(row, 5, Format.comma(cost), COLOR_MUTED)
		else
			makeCell(row, 2, "-", COLOR_MUTED)
			makeCell(row, 3, "-", COLOR_MUTED)
			makeCell(row, 4, "-", COLOR_MUTED)
			makeCell(row, 5, "-", COLOR_MUTED)
		end
	end
end

function OddsTableController.open()
	refresh()
	gui.Enabled = true
end

function OddsTableController.close()
	gui.Enabled = false
end

function OddsTableController.toggle()
	if gui.Enabled then
		OddsTableController.close()
	else
		OddsTableController.open()
	end
end

function OddsTableController.Init()
	build()
end

function OddsTableController.Start()
	ClientState.onChanged(function()
		if gui.Enabled then
			refresh()
		end
	end)
end

return OddsTableController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ShopController — 상점 화면.

	클라이언트는 상품 ID 를 알지 못한다. "이 항목을 사고 싶다"는 키만 서버에 보내고,
	실제 구매창은 서버가 띄운다. 지급도 전부 서버가 한다.

	상품이 아직 등록되지 않았으면(ID 가 0) 서버가 목록에서 빼기 때문에
	여기서는 빈 목록 안내만 띄운다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local controllers = script.Parent
local ClientState = require(controllers.Parent:WaitForChild("ClientState"))
local FeedController = require(controllers:WaitForChild("FeedController"))

local ShopController = {}
ShopController.Name = "ShopController"

local COLOR_PANEL = Color3.fromRGB(34, 30, 38)
local COLOR_SUB = Color3.fromRGB(52, 46, 58)
local COLOR_TEXT = Color3.fromRGB(240, 236, 230)
local COLOR_MUTED = Color3.fromRGB(168, 160, 172)
local COLOR_ACCENT = Color3.fromRGB(226, 142, 58)

local TOUCH_MIN = 44

local gui: ScreenGui
local panel: Frame
local titleLabel: TextLabel
local noticeLabel: TextLabel
local scroller: ScrollingFrame
local closeButton: TextButton

local itemsRemote: RemoteFunction
local promptRemote: RemoteFunction

local function makeButton(parent: Instance, props: { [string]: any }): TextButton
	local button = Instance.new("TextButton")
	button.BackgroundColor3 = COLOR_SUB
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamMedium
	button.TextColor3 = COLOR_TEXT
	button.TextSize = 15
	button.Size = UDim2.new(1, 0, 0, TOUCH_MIN)
	button.Text = ""
	for key, value in props do
		(button :: any)[key] = value
	end
	button.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = button

	return button
end

-- 상품 한 줄에 쓸 이름. 방지권 개수를 함께 보여 준다.
local function itemLabel(language: string, item: any): string
	return Locale.get(language, `shop.{item.key}`, tonumber(item.ticketAmount) or 0)
end

local function refresh()
	local language = ClientState.getLanguage()

	titleLabel.Text = Locale.get(language, "ui.shopTitle")
	noticeLabel.Text = Locale.get(language, "shop.notice")
	closeButton.Text = Locale.get(language, "ui.close")

	for _, child in scroller:GetChildren() do
		if child:IsA("TextButton") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	local ok, items = pcall(function()
		return itemsRemote:InvokeServer()
	end)

	if not ok or type(items) ~= "table" or #items == 0 then
		local empty = Instance.new("TextLabel")
		empty.BackgroundTransparency = 1
		empty.Font = Enum.Font.GothamMedium
		empty.TextSize = 15
		empty.TextColor3 = COLOR_MUTED
		empty.TextWrapped = true
		empty.Size = UDim2.new(1, 0, 0, 40)
		empty.Text = Locale.get(language, "ui.shopEmpty")
		empty.Parent = scroller
		return
	end

	for index, item in items do
		local row = makeButton(scroller, {
			Text = itemLabel(language, item),
			LayoutOrder = index,
		})

		row.Activated:Connect(function()
			task.spawn(function()
				local success, response = pcall(function()
					return promptRemote:InvokeServer(item.key)
				end)

				if success and type(response) == "table" and response.ok ~= true then
					FeedController.pushRaw(
						Locale.get(language, `error.{tostring(response.reason)}`),
						COLOR_ACCENT
					)
				end
			end)
		end)
	end
end

local function build()
	local player = Players.LocalPlayer

	gui = Instance.new("ScreenGui")
	gui.Name = "ForgeShop"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 15
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local dim = Instance.new("TextButton")
	dim.BackgroundColor3 = Color3.new(0, 0, 0)
	dim.BackgroundTransparency = 0.45
	dim.BorderSizePixel = 0
	dim.Size = UDim2.fromScale(1, 1)
	dim.Text = ""
	dim.AutoButtonColor = false
	dim.Parent = gui

	panel = Instance.new("Frame")
	panel.BackgroundColor3 = COLOR_PANEL
	panel.BorderSizePixel = 0
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.new(0.9, 0, 0.72, 0)
	panel.Parent = gui

	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MaxSize = Vector2.new(460, 560)
	sizeConstraint.Parent = panel

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = panel

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 16)
	padding.PaddingBottom = UDim.new(0, 16)
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 16)
	padding.Parent = panel

	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 8)
	list.Parent = panel

	titleLabel = Instance.new("TextLabel")
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextSize = 20
	titleLabel.TextColor3 = COLOR_TEXT
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Size = UDim2.new(1, 0, 0, 28)
	titleLabel.LayoutOrder = 1
	titleLabel.Parent = panel

	scroller = Instance.new("ScrollingFrame")
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.Size = UDim2.new(1, 0, 1, -140)
	scroller.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroller.ScrollBarThickness = 4
	scroller.LayoutOrder = 2
	scroller.Parent = panel

	local scrollList = Instance.new("UIListLayout")
	scrollList.FillDirection = Enum.FillDirection.Vertical
	scrollList.SortOrder = Enum.SortOrder.LayoutOrder
	scrollList.Padding = UDim.new(0, 6)
	scrollList.Parent = scroller

	noticeLabel = Instance.new("TextLabel")
	noticeLabel.BackgroundTransparency = 1
	noticeLabel.Font = Enum.Font.GothamMedium
	noticeLabel.TextSize = 12
	noticeLabel.TextColor3 = COLOR_MUTED
	noticeLabel.TextWrapped = true
	noticeLabel.TextXAlignment = Enum.TextXAlignment.Left
	noticeLabel.Size = UDim2.new(1, 0, 0, 36)
	noticeLabel.LayoutOrder = 3
	noticeLabel.Parent = panel

	closeButton = makeButton(panel, { LayoutOrder = 4 })
	closeButton.Activated:Connect(function()
		gui.Enabled = false
	end)
	dim.Activated:Connect(function()
		gui.Enabled = false
	end)
end

function ShopController.toggle()
	if gui.Enabled then
		gui.Enabled = false
		return
	end

	gui.Enabled = true
	task.spawn(refresh)
end

function ShopController.Init()
	build()

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	itemsRemote = remotesFolder:WaitForChild(Remotes.Functions.GetShopItems) :: RemoteFunction
	promptRemote = remotesFolder:WaitForChild(Remotes.Functions.PromptPurchase) :: RemoteFunction
end

function ShopController.Start() end

return ShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">SoundController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	SoundController — 결과 연출 사운드.

	Phase 2 에서 실제 음원을 붙인다. 지금은 설정(sfx)을 존중하는 재생 창구만 있고
	음원이 없으면 아무 일도 하지 않는다. 다른 컨트롤러는 이미 이 함수만 호출한다.
]]

local SoundService = game:GetService("SoundService")

local ClientState = require(script.Parent.Parent:WaitForChild("ClientState"))

local SoundController = {}
SoundController.Name = "SoundController"

-- [Phase 2] 사운드 에셋 ID 를 채운다. 비어 있으면 재생하지 않는다.
local SOUND_IDS: { [string]: string } = {
	success = "",
	keep = "",
	fail = "",
	protected = "",
	click = "",
}

local cache: { [string]: Sound } = {}

function SoundController.play(key: string)
	local data = ClientState.getData()
	if data and data.settings and data.settings.sfx == false then
		return
	end

	local assetId = SOUND_IDS[key]
	if assetId == nil or assetId == "" then
		return
	end

	local sound = cache[key]
	if sound == nil then
		sound = Instance.new("Sound")
		sound.SoundId = assetId
		sound.Parent = SoundService
		cache[key] = sound
	end

	sound:Play()
end

function SoundController.Init() end

function SoundController.Start() end

return SoundController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">SwordController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	SwordController — 검 보관함 화면 (통합 기획서 5절).

	위쪽: 가진 검 목록. 눌러서 착용 검을 바꾼다.
	아래쪽: 새 검 뽑기. 가격과 "지금 내 기준" 확률표(등급별·검별 %)를 항상 보여 주고,
	        버튼을 두 번 눌러야 골드를 쓴다(한 번 누르면 확인 문구로 바뀐다).

	확률표는 서버가 실제 뽑기에 쓰는 것과 같은 Pure/SwordLogic 함수로 만든다.
	클라이언트는 "착용할 검 id" 와 "뽑기 요청"만 보낸다. 가격·결과는 서버가 정한다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Pure = Shared:WaitForChild("Pure")
local Format = require(Pure:WaitForChild("Format"))
local EnhanceLogic = require(Pure:WaitForChild("EnhanceLogic"))
local SwordLogic = require(Pure:WaitForChild("SwordLogic"))

local ConfigFolder = Shared:WaitForChild("Config")
local Weapons = require(ConfigFolder:WaitForChild("Weapons"))
local EnhanceTable = require(ConfigFolder:WaitForChild("EnhanceTable"))

local controllers = script.Parent
local ClientState = require(controllers.Parent:WaitForChild("ClientState"))
local FeedController = require(controllers:WaitForChild("FeedController"))
local SoundController = require(controllers:WaitForChild("SoundController"))

local SwordController = {}
SwordController.Name = "SwordController"

local COLOR_PANEL = Color3.fromRGB(34, 30, 38)
local COLOR_SUB = Color3.fromRGB(52, 46, 58)
local COLOR_TEXT = Color3.fromRGB(240, 236, 230)
local COLOR_MUTED = Color3.fromRGB(168, 160, 172)
local COLOR_ACCENT = Color3.fromRGB(226, 142, 58)
local COLOR_DISABLED = Color3.fromRGB(72, 68, 76)

local TOUCH_MIN = 44

local RARITY_OF = Weapons.rarityMap()

local gui: ScreenGui
local titleLabel: TextLabel
local scroller: ScrollingFrame
local closeButton: TextButton

local equipRemote: RemoteFunction
local drawRemote: RemoteFunction

local busy = false
-- 뽑기 버튼을 한 번 누른 상태인지 (두 번째에 실제로 요청한다)
local confirming = false

local function makeLabel(text: string, color: Color3, order: number, height: number?): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 14
	label.TextColor3 = color
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextWrapped = true
	label.Size = UDim2.new(1, 0, 0, height or 22)
	label.Text = text
	label.LayoutOrder = order
	label.Parent = scroller
	return label
end

local function makeButton(text: string, order: number): TextButton
	local button = Instance.new("TextButton")
	button.BackgroundColor3 = COLOR_SUB
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamMedium
	button.TextSize = 15
	button.TextColor3 = COLOR_TEXT
	button.Size = UDim2.new(1, 0, 0, TOUCH_MIN)
	button.Text = text
	button.LayoutOrder = order
	button.Parent = scroller

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = button

	return button
end

local function showError(reason: string)
	FeedController.pushRaw(
		Locale.get(ClientState.getLanguage(), `error.{reason}`),
		Color3.fromRGB(255, 140, 130)
	)
end

local refresh: () -> ()

local function requestEquip(swordId: string)
	if busy then
		return
	end
	busy = true

	local ok, response = pcall(function()
		return equipRemote:InvokeServer(swordId)
	end)

	busy = false

	if not ok or type(response) ~= "table" then
		showError("unknown")
		return
	end
	if response.ok ~= true then
		showError(tostring(response.reason))
		return
	end

	ClientState.setOdds(response.odds)
	SoundController.play("click")
end

local function requestDraw()
	if busy then
		return
	end
	busy = true
	confirming = false
	refresh()

	local ok, response = pcall(function()
		return drawRemote:InvokeServer()
	end)

	busy = false

	if not ok or type(response) ~= "table" then
		showError("unknown")
		refresh()
		return
	end
	if response.ok ~= true then
		showError(tostring(response.reason))
		refresh()
		return
	end

	-- 서버 응답을 받은 뒤에만 결과를 알린다.
	local language = ClientState.getLanguage()
	local info = Weapons.get(tostring(response.swordId))
	if info then
		FeedController.pushRaw(
			Locale.get(
				language,
				"ui.drawResult",
				Locale.get(language, info.nameKey),
				Locale.get(language, `rarity.{info.rarity}`)
			),
			COLOR_ACCENT
		)
	end

	ClientState.setOdds(response.odds)
	SoundController.play("success")
	refresh()
end

function refresh()
	if not gui.Enabled then
		return
	end

	local language = ClientState.getLanguage()
	local data = ClientState.getData()

	titleLabel.Text = Locale.get(language, "ui.swordsTitle")
	closeButton.Text = Locale.get(language, "ui.close")

	for _, child in scroller:GetChildren() do
		if child:IsA("TextLabel") or child:IsA("TextButton") then
			child:Destroy()
		end
	end

	if data == nil then
		makeLabel(Locale.get(language, "error.not_ready"), COLOR_MUTED, 1)
		return
	end

	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	-- 가진 검 목록 (눌러서 착용)
	local swordCount = 0
	for _, weaponId in Weapons.Order do
		local sword = data.swords[weaponId]
		local info = Weapons.get(weaponId)
		if sword == nil or info == nil then
			continue
		end
		swordCount += 1

		local name = if sword.customName and sword.customName ~= ""
			then sword.customName
			else Locale.get(language, info.nameKey)
		local text = Locale.get(
			language,
			"ui.swordRow",
			name,
			Locale.get(language, `rarity.{info.rarity}`),
			sword.level
		)

		local isEquipped = data.equippedId == weaponId
		if isEquipped then
			text = Locale.get(language, "ui.equipped") .. " " .. text
		end

		local button = makeButton(text, nextOrder())
		button.TextColor3 = if isEquipped then COLOR_ACCENT else COLOR_TEXT

		if not isEquipped then
			button.Activated:Connect(function()
				task.spawn(requestEquip, weaponId)
			end)
		end
	end

	-- 새 검 뽑기
	makeLabel(Locale.get(language, "ui.drawTitle"), COLOR_ACCENT, nextOrder(), 26)
	makeLabel(Locale.get(language, "ui.drawDesc"), COLOR_MUTED, nextOrder(), 54)

	local drawTable =
		SwordLogic.buildDrawTable(Weapons.Order, RARITY_OF, Weapons.DRAW_WEIGHTS, data.swords)

	if #drawTable.entries == 0 then
		makeLabel(Locale.get(language, "ui.drawNone"), COLOR_MUTED, nextOrder())
		return
	end

	local price = SwordLogic.slotPrice(
		EnhanceLogic.cost(
			Weapons.SLOT_PRICE_LEVEL,
			math.max(1, swordCount),
			EnhanceTable.COST_BASE,
			EnhanceTable.SWORD_COUNT_EXPONENT
		),
		Weapons.SLOT_PRICE_MULTIPLIER
	)

	makeLabel(Locale.get(language, "ui.drawPrice", Format.comma(price)), COLOR_TEXT, nextOrder())

	-- 확률표: 등급별 합계 다음에 검별. 전부 합치면 100%.
	makeLabel(Locale.get(language, "ui.drawOddsTitle"), COLOR_MUTED, nextOrder())

	for _, share in drawTable.rarities do
		makeLabel(
			Locale.get(
				language,
				"ui.drawRarityRow",
				Locale.get(language, `rarity.{share.rarity}`),
				Format.percent(share.percent, SwordLogic.PERCENT_DECIMALS)
			),
			COLOR_TEXT,
			nextOrder()
		)
	end

	for _, entry in drawTable.entries do
		local info = Weapons.get(entry.id)
		makeLabel(
			Locale.get(
				language,
				"ui.drawSwordRow",
				if info then Locale.get(language, info.nameKey) else entry.id,
				Locale.get(language, `rarity.{entry.rarity}`),
				Format.percent(entry.percent, SwordLogic.PERCENT_DECIMALS)
			),
			COLOR_MUTED,
			nextOrder()
		)
	end

	local affordable = data.gold >= price
	local buyButton = makeButton(
		if confirming
			then Locale.get(language, "ui.drawConfirm", Format.comma(price))
			else Locale.get(language, "ui.drawBuy"),
		nextOrder()
	)
	buyButton.Font = Enum.Font.GothamBold
	buyButton.BackgroundColor3 = if affordable and not busy then COLOR_ACCENT else COLOR_DISABLED
	buyButton.TextColor3 = Color3.fromRGB(24, 18, 10)

	buyButton.Activated:Connect(function()
		if busy then
			return
		end
		if not affordable then
			showError("not_enough_gold")
			return
		end

		if confirming then
			task.spawn(requestDraw)
		else
			confirming = true
			refresh()
		end
	end)
end

local function build()
	local player = Players.LocalPlayer

	gui = Instance.new("ScreenGui")
	gui.Name = "ForgeSwords"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 13
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local dim = Instance.new("TextButton")
	dim.BackgroundColor3 = Color3.new(0, 0, 0)
	dim.BackgroundTransparency = 0.45
	dim.BorderSizePixel = 0
	dim.Size = UDim2.fromScale(1, 1)
	dim.Text = ""
	dim.AutoButtonColor = false
	dim.Parent = gui

	local panel = Instance.new("Frame")
	panel.BackgroundColor3 = COLOR_PANEL
	panel.BorderSizePixel = 0
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.new(0.92, 0, 0.8, 0)
	panel.Parent = gui

	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MaxSize = Vector2.new(520, 640)
	sizeConstraint.Parent = panel

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = panel

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 14)
	padding.PaddingBottom = UDim.new(0, 14)
	padding.PaddingLeft = UDim.new(0, 14)
	padding.PaddingRight = UDim.new(0, 14)
	padding.Parent = panel

	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 8)
	list.Parent = panel

	titleLabel = Instance.new("TextLabel")
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextSize = 20
	titleLabel.TextColor3 = COLOR_TEXT
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Size = UDim2.new(1, 0, 0, 28)
	titleLabel.Text = ""
	titleLabel.LayoutOrder = 1
	titleLabel.Parent = panel

	scroller = Instance.new("ScrollingFrame")
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.Size = UDim2.new(1, 0, 1, -96)
	scroller.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroller.ScrollBarThickness = 4
	scroller.LayoutOrder = 2
	scroller.Parent = panel

	local scrollList = Instance.new("UIListLayout")
	scrollList.FillDirection = Enum.FillDirection.Vertical
	scrollList.SortOrder = Enum.SortOrder.LayoutOrder
	scrollList.Padding = UDim.new(0, 4)
	scrollList.Parent = scroller

	closeButton = Instance.new("TextButton")
	closeButton.BackgroundColor3 = COLOR_SUB
	closeButton.BorderSizePixel = 0
	closeButton.Font = Enum.Font.GothamBold
	closeButton.TextSize = 15
	closeButton.TextColor3 = COLOR_TEXT
	closeButton.Size = UDim2.new(1, 0, 0, TOUCH_MIN)
	closeButton.Text = ""
	closeButton.LayoutOrder = 3
	closeButton.Parent = panel

	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 10)
	closeCorner.Parent = closeButton

	local function close()
		gui.Enabled = false
		confirming = false
	end

	closeButton.Activated:Connect(close)
	dim.Activated:Connect(close)
end

function SwordController.toggle()
	if gui.Enabled then
		gui.Enabled = false
		confirming = false
		return
	end

	gui.Enabled = true
	refresh()
end

function SwordController.Init()
	build()

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	equipRemote = remotesFolder:WaitForChild(Remotes.Functions.EquipSword) :: RemoteFunction
	drawRemote = remotesFolder:WaitForChild(Remotes.Functions.BuySwordSlot) :: RemoteFunction
end

function SwordController.Start()
	-- 착용·뽑기·강화로 데이터가 바뀌면 열려 있는 화면을 다시 그린다.
	ClientState.onChanged(refresh)
end

return SwordController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	UIController — 강화 화면.

	규칙:
	- 여기 있는 숫자는 전부 서버가 보내 준 값이다. 클라이언트가 계산하지 않는다.
	- 요청 중에는 버튼을 잠근다(중복 입력 방지).
	- 결과 연출은 서버 응답을 받은 뒤에만 시작한다.
	- 표시 문자열은 전부 Locale 키를 거친다.
	- 터치 영역은 44px 이상, 배율은 UIScale 로 화면 크기에 맞춘다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))

local ConfigFolder = Shared:WaitForChild("Config")
local Weapons = require(ConfigFolder:WaitForChild("Weapons"))
local EnhanceTable = require(ConfigFolder:WaitForChild("EnhanceTable"))
local EnhanceLogic = require(Shared:WaitForChild("Pure"):WaitForChild("EnhanceLogic"))

local controllers = script.Parent
local ClientState = require(controllers.Parent:WaitForChild("ClientState"))
local FeedController = require(controllers:WaitForChild("FeedController"))
local SoundController = require(controllers:WaitForChild("SoundController"))
local EffectsController = require(controllers:WaitForChild("EffectsController"))
local OddsTableController = require(controllers:WaitForChild("OddsTableController"))
local ShopController = require(controllers:WaitForChild("ShopController"))
local SwordController = require(controllers:WaitForChild("SwordController"))
local CollectionController = require(controllers:WaitForChild("CollectionController"))

local UIController = {}
UIController.Name = "UIController"

local COLOR_BG = Color3.fromRGB(24, 21, 26)
local COLOR_PANEL = Color3.fromRGB(34, 30, 38)
local COLOR_SUB = Color3.fromRGB(52, 46, 58)
local COLOR_TEXT = Color3.fromRGB(240, 236, 230)
local COLOR_MUTED = Color3.fromRGB(168, 160, 172)
local COLOR_ACCENT = Color3.fromRGB(226, 142, 58)
local COLOR_DISABLED = Color3.fromRGB(72, 68, 76)

local TOUCH_MIN = 44 -- 최소 터치 영역(px)
local NARROW_WIDTH = 700

local busy = false

local gui: ScreenGui
local uiScale: UIScale
local goldLabel: TextLabel
local shardLabel: TextLabel
local ticketLabel: TextLabel
local centerFrame: Frame
local weaponButton: TextButton
local renamePanel: Frame
local renameBox: TextBox
local renameConfirm: TextButton
local renameCancel: TextButton
local levelLabel: TextLabel
local eventLabel: TextLabel
local bottomPanel: Frame
local oddsLabel: TextLabel
local costLabel: TextLabel
local statusLabel: TextLabel
local bannerLabel: TextLabel
local hintLabel: TextLabel
local protectButton: TextButton
local oddsTableButton: TextButton
local swordsButton: TextButton
local shopButton: TextButton
local recordsButton: TextButton
local enhanceButton: TextButton

local enhanceRemote: RemoteFunction
local renameRemote: RemoteFunction

local function corner(parent: Instance, radius: number)
	local instance = Instance.new("UICorner")
	instance.CornerRadius = UDim.new(0, radius)
	instance.Parent = parent
end

local function makeLabel(parent: Instance, props: { [string]: any }): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextColor3 = COLOR_TEXT
	label.TextSize = 16
	label.Size = UDim2.new(1, 0, 0, 20)
	label.Text = ""
	for key, value in props do
		(label :: any)[key] = value
	end
	label.Parent = parent
	return label
end

local function makeButton(parent: Instance, props: { [string]: any }): TextButton
	local button = Instance.new("TextButton")
	button.BackgroundColor3 = COLOR_SUB
	button.BorderSizePixel = 0
	button.AutoButtonColor = true
	button.Font = Enum.Font.GothamBold
	button.TextColor3 = COLOR_TEXT
	button.TextSize = 16
	button.Text = ""
	for key, value in props do
		(button :: any)[key] = value
	end
	button.Parent = parent
	corner(button, 10)
	return button
end

-- 화면 크기에 따라 전체 UI 배율과 세로/가로 배치를 조정한다(모바일 우선).
local function applyLayout()
	local camera = Workspace.CurrentCamera
	if camera == nil or uiScale == nil then
		return
	end

	local viewport = camera.ViewportSize
	uiScale.Scale = math.clamp(math.min(viewport.X / 900, viewport.Y / 760), 0.7, 1.25)

	local isNarrow = viewport.X < NARROW_WIDTH
	-- 좁은 화면에서는 피드가 위쪽을 차지하므로 무기를 조금 아래로 내린다.
	centerFrame.Position = UDim2.new(0.5, 0, if isNarrow then 0.44 else 0.36, 0)
end

local function build()
	local player = Players.LocalPlayer

	gui = Instance.new("ScreenGui")
	gui.Name = "ForgeMain"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	uiScale = Instance.new("UIScale")
	uiScale.Parent = gui

	-- 상단 재화 바
	local topBar = Instance.new("Frame")
	topBar.Name = "TopBar"
	topBar.BackgroundColor3 = COLOR_BG
	topBar.BackgroundTransparency = 0.25
	topBar.BorderSizePixel = 0
	topBar.Size = UDim2.new(1, 0, 0, 48)
	topBar.Parent = gui

	local topList = Instance.new("UIListLayout")
	topList.FillDirection = Enum.FillDirection.Horizontal
	topList.VerticalAlignment = Enum.VerticalAlignment.Center
	topList.Padding = UDim.new(0, 14)
	topList.Parent = topBar

	local topPadding = Instance.new("UIPadding")
	topPadding.PaddingLeft = UDim.new(0, 16)
	topPadding.PaddingRight = UDim.new(0, 16)
	topPadding.Parent = topBar

	goldLabel = makeLabel(topBar, {
		Size = UDim2.new(0, 150, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = COLOR_ACCENT,
		Font = Enum.Font.GothamBold,
		LayoutOrder = 1,
	})
	shardLabel = makeLabel(topBar, {
		Size = UDim2.new(0, 120, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = COLOR_MUTED,
		LayoutOrder = 2,
	})
	ticketLabel = makeLabel(topBar, {
		Size = UDim2.new(0, 150, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = COLOR_MUTED,
		LayoutOrder = 3,
	})

	-- 공지 / 점검 배너 (내용이 있을 때만 보인다)
	bannerLabel = makeLabel(gui, {
		BackgroundColor3 = Color3.fromRGB(64, 48, 24),
		BackgroundTransparency = 0.15,
		Size = UDim2.new(1, -24, 0, 30),
		Position = UDim2.new(0.5, 0, 0, 56),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 14,
		TextWrapped = true,
		Visible = false,
	})
	corner(bannerLabel, 8)

	-- 중앙: 무기와 강화 레벨
	centerFrame = Instance.new("Frame")
	centerFrame.Name = "Center"
	centerFrame.BackgroundTransparency = 1
	centerFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	centerFrame.Position = UDim2.new(0.5, 0, 0.36, 0)
