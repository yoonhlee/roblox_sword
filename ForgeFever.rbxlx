	})
	swordsButton = makeButton(actionRow, {
		Size = UDim2.new(0.25, -6, 1, 0),
		TextSize = 15,
		Font = Enum.Font.GothamMedium,
		LayoutOrder = 2,
	})
	recordsButton = makeButton(actionRow, {
		Size = UDim2.new(0.25, -6, 1, 0),
		TextSize = 15,
