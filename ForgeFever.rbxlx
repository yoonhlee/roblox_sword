        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">EconomyConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EconomyConfig — 골드 획득처 수치.
	수치 변경은 개발자 승인을 받은 뒤에만.

	[주의] 시작 골드, 출석, 플레이 시간 보상은 프로토타입 때 임의로 넣은 값이다.
	승인된 값이 아니며 새 경제(통합 기획서 6절)에 맞춰 다시 정해야 한다.
]]

local EconomyConfig = {}

EconomyConfig.STARTING_GOLD = 100
EconomyConfig.STARTING_SHARDS = 0
EconomyConfig.STARTING_PROTECT_TICKETS = 0

-- 출석: 연속 일수에 따른 골드. 상한을 넘으면 마지막 값을 계속 지급한다.
EconomyConfig.DAILY_LOGIN_GOLD = { 100, 150, 200, 300, 400, 600, 1000 }

-- 플레이 시간 보상
EconomyConfig.PLAYTIME_REWARD_INTERVAL_SECONDS = 15 * 60
EconomyConfig.PLAYTIME_REWARD_GOLD = 120

--[[
	로비 트레드밀 (통합 기획서 6절). 발판 위에 있으면 intervalSeconds 마다 gold 를 받는다.
	[확정] 1단계: 20초당 100골드. 무료만(유료 트레드밀 없음). 자리 비움 제한 없음.
	[미정 D18] 2단계 이상의 단계 수·수입·해금 방법은 아직 정해지지 않았다.
	정해지면 여기에 줄을 추가하고 Config/World 의 TREADMILL_PADS 에 발판 위치를 넣으면 된다.
]]
export type TreadmillTier = {
	id: string,
	intervalSeconds: number,
	gold: number,
}

EconomyConfig.TREADMILL_TIERS = {
	{ id = "tier1", intervalSeconds = 20, gold = 100 },
} :: { TreadmillTier }

function EconomyConfig.treadmillTier(id: string): TreadmillTier?
	for _, tier in EconomyConfig.TREADMILL_TIERS do
		if tier.id == id then
			return tier
		end
	end
	return nil
end

-- 이상 탐지: 이 시간 안에 이만큼 이상 골드가 늘면 로그를 남긴다.
EconomyConfig.ANOMALY_WINDOW_SECONDS = 60
EconomyConfig.ANOMALY_GOLD_DELTA = 200000

--[[
	이상 탐지에서 빼는 획득 사유.
	경주 보상은 서버가 거리와 레벨로 계산한 값이고 한 판에 수억 골드까지 정상적으로 나온다.
	탐지에 넣으면 고레벨 유저마다 경고가 울려서 진짜 이상을 가린다.
]]
EconomyConfig.ANOMALY_EXEMPT_REASONS = {
	race_reward = true,
} :: { [string]: boolean }

return EconomyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">EnhanceTable</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EnhanceTable — 강화 확률/비용 데이터 (통합 기획서 3절).
	밸런스 수치는 전부 여기에 두고, 로직(Pure/EnhanceLogic)은 이 데이터를 읽기만 한다.

	Odds[L] = 레벨 L 에서 L+1 로 올리는 1회 시도의 확률(퍼센트).
	  - 1구간 (L = 0~9): 실패 없음. 성공 아니면 유지.
	  - 2구간 (L = 10~19): 실패하면 SAFE_LEVEL(10강)로 돌아간다.
	표의 값이 정본이다. 만든 공식(기획서 3-1)은 테스트가 표와 맞는지 확인한다.

	비용은 표가 아니라 공식이다: COST_BASE × (1 + 2^L) × (가진 검 수)^SWORD_COUNT_EXPONENT
	계산은 Pure/EnhanceLogic.cost 가 한다.
]]

export type LevelOdds = {
	success: number,
	keep: number,
	fail: number,
}

local EnhanceTable = {}

EnhanceTable.MAX_LEVEL = 20

-- 2구간이 시작되는 레벨이자, 2구간에서 실패했을 때 돌아가는 레벨
EnhanceTable.SAFE_LEVEL = 10

EnhanceTable.COST_BASE = 100
EnhanceTable.SWORD_COUNT_EXPONENT = 1.1

-- [미정 D12] 2구간 실패 시 주는 파편 양은 아직 정해지지 않았다.
-- 임시로 프로토타입 공식 floor(실패한 레벨 ^ SHARD_EXPONENT) 을 그대로 쓴다.
EnhanceTable.SHARD_EXPONENT = 1.5

EnhanceTable.Odds = {
	[0] = { success = 100, keep = 0, fail = 0 },
	[1] = { success = 97, keep = 3, fail = 0 },
	[2] = { success = 94, keep = 6, fail = 0 },
	[3] = { success = 89, keep = 11, fail = 0 },
	[4] = { success = 84, keep = 16, fail = 0 },
	[5] = { success = 76, keep = 24, fail = 0 },
	[6] = { success = 66, keep = 34, fail = 0 },
	[7] = { success = 53, keep = 47, fail = 0 },
	[8] = { success = 37, keep = 63, fail = 0 },
	[9] = { success = 15, keep = 85, fail = 0 },
	[10] = { success = 66, keep = 29, fail = 5 },
	[11] = { success = 53, keep = 40, fail = 7 },
	[12] = { success = 43, keep = 49, fail = 8 },
	[13] = { success = 35, keep = 55, fail = 10 },
	[14] = { success = 27, keep = 61, fail = 12 },
	[15] = { success = 21, keep = 66, fail = 13 },
	[16] = { success = 16, keep = 69, fail = 15 },
	[17] = { success = 11, keep = 72, fail = 17 },
	[18] = { success = 6, keep = 76, fail = 18 },
	[19] = { success = 2, keep = 78, fail = 20 },
} :: { [number]: LevelOdds }

-- 서버 채팅 전체 공지를 띄우는 최소 레벨
EnhanceTable.BROADCAST_MIN_LEVEL = 15

--[[
	확률표가 스스로 일관된지 검사한다.
	서버 시작 시점(EnhanceService.Init)과 테스트 양쪽에서 호출한다.
	실패 사유 문자열을 반환하고, 문제가 없으면 nil 을 반환한다.
]]
function EnhanceTable.validate(): string?
	for level = 0, EnhanceTable.MAX_LEVEL - 1 do
		local odds = EnhanceTable.Odds[level]
		if not odds then
			return `Odds[{level}] 항목이 없습니다`
		end

		local sum = odds.success + odds.keep + odds.fail
		if sum ~= 100 then
			return `Odds[{level}] 의 성공+유지+실패 합이 {sum} 입니다 (100 이어야 함)`
		end

		for key, value in { success = odds.success, keep = odds.keep, fail = odds.fail } do
			if value < 0 or value ~= math.floor(value) then
				return `Odds[{level}].{key} 값이 잘못되었습니다: {value}`
			end
		end

		if level < EnhanceTable.SAFE_LEVEL and odds.fail ~= 0 then
			return `Odds[{level}] 는 1구간인데 실패 확률이 있습니다`
		end
	end

	if EnhanceTable.Odds[EnhanceTable.MAX_LEVEL] ~= nil then
		return `최대 레벨({EnhanceTable.MAX_LEVEL})에는 강화 확률이 있으면 안 됩니다`
	end

	return nil
end

return EnhanceTable
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Game</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Game — 게임 정체성과 운영에 필요한 전역 상수.
]]

local Game = {}

Game.NAME = "강화의 대장간" -- 표시용 이름은 LocalizationTable 의 "game.title" 을 우선 사용
Game.ID = "ForgeFever" -- 코드/스토어 키에 쓰는 내부 식별자

-- DataStore 이름. Studio 플레이테스트와 라이브 데이터를 절대 섞지 않는다.
Game.DATASTORE_DEV = "ForgeFever_DEV"
Game.DATASTORE_PROD = "ForgeFever_PROD"

-- 랭킹용 OrderedDataStore
Game.ORDERED_STORE_LEVEL = "ForgeFever_Level_v1"
-- "ForgeFever_Rating_v1" 은 폐지된 1:1 배틀 레이팅 순위가 쓰던 이름이다.
-- 예전 기록이 남아 있을 수 있으니 다른 용도로 다시 쓰지 말 것.

-- 관리자 UserId 목록. [개발자 입력 필요] 본인 UserId 를 넣을 것.
Game.ADMIN_USER_IDS = {} :: { number }

-- 결과 피드를 말하는 오리지널 NPC (대사는 LocalizationTable 의 "npc.*" 키)
Game.NPC_NAME_KEY = "npc.anvilElder.name" -- 모루 영감

Game.DEFAULT_LANGUAGE = "ko"
Game.SUPPORTED_LANGUAGES = { "ko", "en" }

function Game.isAdmin(userId: number): boolean
	for _, id in Game.ADMIN_USER_IDS do
		if id == userId then
			return true
		end
	end
	return false
end

return Game
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Palette</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Palette — 화면(UI)과 세계(로비·코스·검)가 함께 쓰는 색 (통합 기획서 8-1·8-2절).

	숫자(0~255)로만 둔다. Roblox 의 Color3 로 바꾸는 일은 쓰는 쪽이 한다
	(그래서 Studio 밖 테스트에서도 읽을 수 있다).
	값은 추천치(Claude 초기값)이고 Studio 에서 다듬는다. 방향은 확정이다.
]]

export type RGB = { number }

local Palette = {}

-- 화면 기본색
Palette.UI = {
	bg = { 24, 21, 26 }, -- 바탕
	panel = { 34, 30, 38 }, -- 창
	sub = { 52, 46, 58 }, -- 보조 칸
	line = { 70, 62, 78 }, -- 구분선
	text = { 240, 236, 230 },
	muted = { 168, 160, 172 },
	ember = { 226, 142, 58 }, -- 불꽃 주황 (강조)
	emberDark = { 150, 84, 28 }, -- 강조 버튼 아래 띠
	ink = { 24, 18, 10 }, -- 밝은 버튼 위 글자
	outline = { 12, 10, 14 }, -- 굵은 글자 테두리
	disabled = { 72, 68, 76 },
	danger = { 220, 64, 56 }, -- 닫기 X
	gold = { 255, 208, 112 },
	shard = { 140, 210, 255 },
	ticket = { 120, 220, 150 },
	success = { 226, 142, 58 },
	keep = { 198, 198, 198 },
	fail = { 255, 120, 108 },
	protect = { 140, 210, 255 },
	event = { 140, 210, 255 },
}

-- 검 등급 색 (관례: 일반 회색, 희귀 파랑, 영웅 보라, 전설 금색)
Palette.RARITY = {
	common = { 180, 180, 180 },
	rare = { 79, 163, 255 },
	epic = { 181, 101, 255 },
	legend = { 255, 200, 61 },
} :: { [string]: RGB }

--[[
	레벨 색: 쇠를 달구는 색. minLevel 이상이면 그 단계다(위에서부터 차례로 확인한다).
	glow: 칼날 주위로 빛이 번지는 정도(0 없음 ~ 1 최대), sparks: 불티를 날리는지.
	nameKey: 단계 이름 Locale 키.
]]
export type HeatTier = {
	minLevel: number,
	rgb: RGB,
	glow: number,
	sparks: boolean,
	nameKey: string,
}

Palette.HEAT_TIERS = {
	{ minLevel = 0, rgb = { 154, 160, 168 }, glow = 0, sparks = false, nameKey = "heat.cold" },
	{ minLevel = 5, rgb = { 224, 80, 58 }, glow = 0.2, sparks = false, nameKey = "heat.red" },
	{ minLevel = 10, rgb = { 255, 138, 42 }, glow = 0.4, sparks = false, nameKey = "heat.orange" },
	{ minLevel = 15, rgb = { 255, 224, 112 }, glow = 0.7, sparks = true, nameKey = "heat.yellow" },
	{ minLevel = 20, rgb = { 255, 255, 255 }, glow = 1, sparks = true, nameKey = "heat.white" },
} :: { HeatTier }

-- 세계(블록) 재료 색
Palette.WORLD = {
	stone = { 74, 66, 80 }, -- 검은 돌: 바닥·담·관문
	stoneDark = { 52, 46, 58 },
	cobble = { 110, 98, 104 }, -- 돌길
	wood = { 106, 70, 48 }, -- 그을린 나무
	iron = { 58, 60, 66 }, -- 무쇠
	steel = { 91, 95, 102 }, -- 칼날 바탕
	roof = { 91, 47, 42 }, -- 지붕
	brick = { 77, 58, 63 }, -- 화덕·굴뚝
	leather = { 138, 96, 68 }, -- 풀무
	beard = { 232, 226, 216 },
	skin = { 217, 180, 140 },
	apron = { 90, 58, 38 },
	ember = { 226, 142, 58 },
	molten = { 255, 90, 30 },
	moltenHot = { 255, 160, 64 },
	gold = { 255, 208, 112 },
	mountain = { 59, 35, 53 },
	glass = { 140, 210, 255 },
}

return Palette
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Products</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Products — 방지권 상품과 방지권 뽑기 설정 (통합 기획서 3-4절, 7절).

	[개발자 입력 필요] Roblox 크리에이터 대시보드에서 "개발자 상품"을 만든 뒤 productId 를 채운다.
	[미정 D12] 묶음 개수, 확률형 결과·확률, 파편 뽑기 확률은 아직 정해지지 않았다. 그래서 비워 두었다.
	**ID 나 내용이 비어 있는 상품은 상점에 보이지 않고 살 수도 없다** (isSellable / isDrawReady).

	지킬 것 (통합 기획서 6·7절):
	- 유료 상품은 방지권뿐이다. 골드·파편을 주거나 골드 획득량을 늘리는 상품은 만들지 않는다.
	  (Robux 로 살 수 있는 화폐로 하는 강화는 로블록스 정책상 유료 확률형 아이템이 된다.)
	- 유료 확률형은 "방지권 확률형" 1종만 승인됐다. 다른 확률형 상품은 추가하지 않는다.
	- 가격은 대시보드에서 정한다. 정할 때 **확률형 3회 가격 > 확정 1개 가격** 이어야 한다
	  (아니면 꽝만 3번 나와도 확정 1개보다 싸게 방지권을 얻는다).
	- 확률을 채우면 상점이 모든 결과를 %(합계 100%)로 보여 준다. 실제 추첨은 weight 그대로 한다.

	결과 목록(outcomes) 쓰는 법: { tickets = 방지권 개수, weight = 비중 }
	  tickets = 0 인 줄이 "꽝"이다. weight 는 합이 100 일 필요가 없다(비율만 맞으면 된다).
	  예) { { tickets = 3, weight = 10 }, { tickets = 1, weight = 30 }, { tickets = 0, weight = 60 } }
]]

local Products = {}

export type TicketOutcome = {
	tickets: number, -- 받는 방지권 수. 0 이면 꽝
	weight: number, -- 뽑힐 비중 (0 보다 커야 한다)
}

export type DeveloperProduct = {
	key: string,
	productId: number, -- 0 이면 아직 등록하지 않은 상품
	kind: "fixed" | "random",
	ticketAmount: number, -- fixed: 주는 방지권 수. random 은 0
	outcomes: { TicketOutcome }, -- random: 결과 목록. fixed 는 빈 표
}

Products.DeveloperProducts = {
	-- [확정] 확정 1개: 방지권 1개. 1개당 가격이 가장 비싼 상품.
	ticketSingle = {
		key = "ticketSingle",
		productId = 0,
		kind = "fixed",
		ticketAmount = 1,
		outcomes = {},
	},

	-- 확정 묶음: 방지권 여러 개. [미정 D12] 개수가 정해지면 ticketAmount 를 채운다.
	ticketBundle = {
		key = "ticketBundle",
		productId = 0,
		kind = "fixed",
		ticketAmount = 0,
		outcomes = {},
	},

	-- 확률형: 방지권 여러 개 중 확률. [미정 D12] 결과와 확률이 정해지면 outcomes 를 채운다.
	ticketRandom = {
		key = "ticketRandom",
		productId = 0,
		kind = "random",
		ticketAmount = 0,
		outcomes = {},
	},
} :: { [string]: DeveloperProduct }

-- 상점에 보여 주는 순서
Products.ORDER = { "ticketSingle", "ticketBundle", "ticketRandom" }

--[[
	[확정] 천장 포인트 (통합 기획서 7절).
	확률형에서 꽝이 나오면 +PITY_PER_MISS 점, PITY_THRESHOLD 점이 되면 그 자리에서
	방지권 PITY_TICKETS 개를 주고 0 점으로 돌아간다. 확률형 꽝에서만 생기고 다른 용도는 없다.
]]
Products.PITY_PER_MISS = 1
Products.PITY_THRESHOLD = 3
Products.PITY_TICKETS = 1

--[[
	파편 뽑기 (통합 기획서 3-4절). Robux 가 닿지 않는 무과금 경로다.
	[확정] 파편 50개 = 뽑기 1회.
	[미정 D12] 뽑기 확률. 정해지면 outcomes 를 채운다. 비어 있는 동안은 상점에 보이지 않는다.
	천장 포인트는 여기서는 쌓이지 않는다(유료 확률형 꽝에서만 생긴다).
]]
Products.SHARD_DRAW = {
	cost = 50,
	outcomes = {} :: { TicketOutcome },
}

-- purchaseHistory 가 무한히 커지지 않도록 유지할 최근 기록 수
Products.PURCHASE_HISTORY_LIMIT = 200

-- 결과 목록이 뽑기에 쓸 수 있게 채워져 있는지
function Products.isDrawReady(outcomes: { TicketOutcome }): boolean
	if #outcomes == 0 then
		return false
	end

	for _, outcome in outcomes do
		local tickets = outcome.tickets
		local weight = outcome.weight

		if type(tickets) ~= "number" or tickets < 0 or tickets ~= math.floor(tickets) then
			return false
		end
		if type(weight) ~= "number" or weight ~= weight or weight <= 0 or weight == math.huge then
			return false
		end
	end

	return true
end

-- 팔 수 있는 상품인지 (ID 가 있고 내용이 채워져 있다)
function Products.isSellable(product: DeveloperProduct): boolean
	if product.productId == 0 then
		return false
	end

	if product.kind == "fixed" then
		return product.ticketAmount > 0 and product.ticketAmount == math.floor(product.ticketAmount)
	end

	return Products.isDrawReady(product.outcomes)
end

-- productId → 상품 정의 역인덱스 (ProcessReceipt 에서 사용)
function Products.byProductId(productId: number): DeveloperProduct?
	for _, product in Products.DeveloperProducts do
		if product.productId ~= 0 and product.productId == productId then
			return product
		end
	end
	return nil
end

--[[
	설정이 스스로 일관된지 검사한다. 문제가 있으면 사유 문자열, 없으면 nil.
	"아직 비어 있는 것"은 문제가 아니다(미정이라 비워 둔 것). 채웠는데 틀린 것만 잡는다.
]]
function Products.validate(): string?
	local seenIds: { [number]: string } = {}

	for key, product in Products.DeveloperProducts do
		if product.key ~= key then
			return `{key} 의 key 값이 "{product.key}" 입니다`
		end
		if table.find(Products.ORDER, key) == nil then
			return `{key} 가 ORDER 에 없습니다`
		end

		if product.productId ~= 0 then
			local other = seenIds[product.productId]
			if other ~= nil then
				return `{key} 와 {other} 의 productId 가 같습니다`
			end
			seenIds[product.productId] = key
		end

		if product.kind == "fixed" then
			if #product.outcomes > 0 then
				return `{key} 는 확정형인데 결과 목록이 있습니다`
			end
			if
				product.ticketAmount < 0
				or product.ticketAmount ~= math.floor(product.ticketAmount)
			then
				return `{key} 의 ticketAmount 가 잘못되었습니다`
			end
		elseif product.kind == "random" then
			if #product.outcomes > 0 and not Products.isDrawReady(product.outcomes) then
				return `{key} 의 결과 목록이 잘못되었습니다`
			end
		else
			return `{key} 의 kind 가 잘못되었습니다`
		end
	end

	for _, key in Products.ORDER do
		if Products.DeveloperProducts[key] == nil then
			return `ORDER 에 없는 상품이 있습니다: {key}`
		end
	end

	local shard = Products.SHARD_DRAW
	if shard.cost <= 0 or shard.cost ~= math.floor(shard.cost) then
		return "SHARD_DRAW.cost 가 잘못되었습니다"
	end
	if #shard.outcomes > 0 and not Products.isDrawReady(shard.outcomes) then
		return "SHARD_DRAW 의 결과 목록이 잘못되었습니다"
	end

	if Products.PITY_THRESHOLD < 1 or Products.PITY_TICKETS < 1 or Products.PITY_PER_MISS < 1 then
		return "천장 포인트 설정이 잘못되었습니다"
	end

	return nil
end

return Products
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">RaceConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RaceConfig — 추격 생존 경주 수치 (통합 기획서 4절).
	계산은 Pure/RaceLogic 이 하고, 여기에는 숫자만 둔다.

	표시:
	  [확정]   승인된 기획. 개발자 승인 없이 바꾸지 않는다.
	  [추천치] Claude 가 채운 초기값. 다른 값이 정해지면 바꾼다.
	  [기술]   기획 수치가 아니라 구현에 필요한 값(검증 여유, 코스 모양 등).
	  [미정]   결정 대기. 값이 없고 넣을 자리만 있다.
]]

local RaceConfig = {}

-- [확정] 방해 없이 쉬지 않고 달렸을 때 잡히는 시간(초). 0~1강 20초 → 20강 90초, 그 사이는 일정하게.
RaceConfig.MIN_TIME_SECONDS = 20
RaceConfig.MAX_TIME_SECONDS = 90

-- [추천치] 추격자 속도 = c0 × e^(CHASER_ACCEL × t). c0 는 아래 두 값에서 계산된다.
RaceConfig.CHASER_ACCEL = 0.02
-- [추천치] 출발할 때 추격자가 출발선보다 이만큼 뒤에 있다(칸).
RaceConfig.HEAD_START = 30
-- [추천치] 0~1강의 이동 속도 (로블록스 기본 걷기 속도)
RaceConfig.BASE_SPEED = 16

--[[
	[확정] 보상 배율 m(L) (통합 기획서 4-3절)
	  1구간 (L < tier2Start): tier1Base + tier1Span × (100 − 그 레벨의 성공 확률) / tier1Divisor
	  2구간 (L ≥ tier2Start): tier2Base × tier2Growth ^ ((L − tier2Start) / tier2Span)
]]
RaceConfig.Multiplier = {
	tier1Base = 2,
	tier1Span = 3,
	tier1Divisor = 85,
	tier2Start = 10,
	tier2Base = 5,
	tier2Growth = 2,
	tier2Span = 10,
}

-- [확정] "매칭"을 누르면 이 시간 안에 출발한다(초).
RaceConfig.MATCH_WINDOW_SECONDS = 10
-- [확정 P43, 추후 조절] 대기열이 이 인원이 되면 기다리지 않고 바로 출발 준비에 들어간다.
RaceConfig.MATCH_FULL_COUNT = 20
-- [기술] 출발선에 세운 뒤 출발 신호까지의 카운트다운(초). MATCH_WINDOW_SECONDS 안에 포함된다.
-- (대기열은 10 − 3 = 7초에 닫히고, 출발선에서 3초를 센 뒤 달린다.)
RaceConfig.LINEUP_SECONDS = 3

--[[
	[기술] 서버 거리 검증 (통합 기획서 4-5절).
	서버는 매 순간 "허용 최대 속도 × 지난 시간 × SPEED_TOLERANCE + DISTANCE_SLACK" 까지만 거리를 인정한다.
	그보다 앞에 있는 캐릭터(속도 조작)는 그 한계 위치에 있는 것으로 보고 추격자에게 잡힌다.
]]
RaceConfig.SPEED_TOLERANCE = 1.1
RaceConfig.DISTANCE_SLACK = 6
-- [기술] 이 거리 미만은 0 으로 본다. 출발선에 가만히 서 있을 때 생기는 미세한 흔들림을 보상하지 않기 위함.
RaceConfig.DEAD_ZONE = 1

-- [기술] 모두 탈락한 뒤 결과를 보여 주는 시간(초). 지나면 남아 있는 사람을 로비로 돌려보낸다.
RaceConfig.RESULT_SECONDS = 8

--[[
	[기술] 코스 모양. 코스는 판마다 새로 만든다(장애물 위치가 매번 다르다).
	길이 = max(minLength, 그 판 최고 레벨의 최대 거리 × lengthMargin + extraLength)
	20강이 끼면 약 4,600칸이 된다(기획서: 20강 기준 4,000칸 이상).

	장애물 세 가지: block(옆으로 피한다) · hurdle(뛰어넘는다) · gate(틈으로 지나간다).
	어느 줄이든 반드시 지나갈 길이 있다.
]]
RaceConfig.Course = {
	trackWidth = 48,
	lengthMargin = 1.25,
	extraLength = 150,
	minLength = 500,

	firstObstacleAt = 60, -- 출발선에서 첫 장애물까지
	minSpacing = 50, -- 장애물 줄 사이 간격(칸)
	maxSpacing = 90,
	endMargin = 40, -- 코스 끝 이만큼 앞부터는 장애물을 두지 않는다

	blockMinWidth = 8,
	blockMaxWidth = 18,
	gateGap = 16,

	-- 장애물 종류가 뽑히는 비중 (합은 아무 값이어도 된다)
	weightBlock = 5,
	weightHurdle = 3,
	weightGate = 2,

	-- 출발선에 서는 자리
	lineupWidth = 40,
	lineupMaxSpacing = 4,
}

--[[
	[미정] 아직 값이 없는 것. 서버(RaceService)에 넣을 자리만 만들어 두었다.
	  D6  1~3위 보너스: 크기, 지급 최소 인원 → RaceService 의 rankBonusFor
	  D16 특수 능력·도감 기념 업그레이드 → RaceService 의 allowedSpeedFor / rewardBonusFor
	  D17 신규 유저 보호 (처음 몇 판 방해 금지) → 방해 능력이 생길 때 함께 만든다
]]

return RaceConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">SwordShapes</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SwordShapes — 블록으로 짓는 3D 검 모양 (통합 기획서 8-2절).

	숫자 데이터만 둔다. 실제 파트는 shared/SwordModel 이 만든다.
	좌표(스터드): 손잡이 가운데가 원점, 칼날은 +Y 로 뻗는다. 두께는 Z.
	부위(role)마다 색이 정해진다.
	  blade  칼날 바탕 (강철색)
	  edge   칼날 테두리 (레벨 색 = 쇠 달구는 색, 5강부터 빛남)
	  core   늘 빛나는 속심 (accent 색, 네온)
	  guard  손잡이 위 가드 (등급 색)
	  grip   손잡이 (나무·가죽)
	  pommel 손잡이 끝 (등급 색)
	  accent 장식 (accent 색)
	shape: "Block" | "Wedge" | "Ball" | "Cylinder". rot 은 도(°) 단위 X·Y·Z 회전.

	새 검을 추가하면 여기에 모양을 넣는다. 없으면 DEFAULT(무쇠 검 모양)로 보인다.
]]

export type PartSpec = {
	role: string,
	shape: string,
	size: { number },
	pos: { number },
	rot: { number }?,
}

export type Shape = {
	accent: { number }?, -- core·accent 부위 색 (없으면 레벨 색)
	parts: { PartSpec },
}

local SwordShapes = {}

-- 공통 손잡이 (가드는 검마다 다르다)
local function grip(length: number): { PartSpec }
	return {
		{
			role = "grip",
			shape = "Cylinder",
			size = { length, 0.32, 0.32 },
			pos = { 0, 0, 0 },
			rot = { 0, 0, 90 },
		},
		{
			role = "pommel",
			shape = "Ball",
			size = { 0.5, 0.5, 0.5 },
			pos = { 0, -length / 2 - 0.15, 0 },
		},
	}
end

local function concat(...: { PartSpec }): { PartSpec }
	local result: { PartSpec } = {}
	for _, list in { ... } do
		for _, part in list do
			table.insert(result, part)
		end
	end
	return result
end

SwordShapes.List = {
	-- 무쇠 검: 곧은 외날, 장식 없음
	ironBlade = {
		parts = concat(grip(1.1), {
			{ role = "guard", shape = "Block", size = { 1.5, 0.22, 0.4 }, pos = { 0, 0.66, 0 } },
			{ role = "blade", shape = "Block", size = { 0.42, 3.1, 0.1 }, pos = { 0, 2.32, 0 } },
			{ role = "edge", shape = "Block", size = { 0.06, 3.1, 0.12 }, pos = { 0.24, 2.32, 0 } },
			{
				role = "edge",
				shape = "Block",
				size = { 0.06, 3.1, 0.12 },
				pos = { -0.24, 2.32, 0 },
			},
			{
				role = "blade",
				shape = "Wedge",
				size = { 0.1, 0.5, 0.42 },
				pos = { 0, 4.12, 0 },
				rot = { 0, 90, 0 },
			},
		}),
	},

	-- 잉걸불 검: 톱니 같은 숯 모서리, 속심이 늘 주황
	emberEdge = {
		accent = { 255, 138, 42 },
		parts = concat(grip(1.1), {
			{ role = "guard", shape = "Block", size = { 1.4, 0.26, 0.42 }, pos = { 0, 0.66, 0 } },
			{ role = "blade", shape = "Block", size = { 0.5, 3.0, 0.12 }, pos = { 0, 2.28, 0 } },
			{ role = "core", shape = "Block", size = { 0.1, 2.8, 0.14 }, pos = { 0, 2.28, 0 } },
			{
				role = "edge",
				shape = "Wedge",
				size = { 0.12, 0.5, 0.22 },
				pos = { 0.34, 1.4, 0 },
				rot = { 0, 90, 0 },
			},
			{
				role = "edge",
				shape = "Wedge",
				size = { 0.12, 0.5, 0.22 },
				pos = { 0.34, 2.1, 0 },
				rot = { 0, 90, 0 },
			},
			{
				role = "edge",
				shape = "Wedge",
				size = { 0.12, 0.5, 0.22 },
				pos = { 0.34, 2.8, 0 },
				rot = { 0, 90, 0 },
			},
			{
				role = "edge",
				shape = "Wedge",
				size = { 0.12, 0.5, 0.22 },
				pos = { -0.34, 1.75, 0 },
				rot = { 0, -90, 0 },
			},
			{
				role = "edge",
				shape = "Wedge",
				size = { 0.12, 0.5, 0.22 },
				pos = { -0.34, 2.45, 0 },
				rot = { 0, -90, 0 },
			},
			{
				role = "blade",
				shape = "Wedge",
				size = { 0.12, 0.6, 0.5 },
				pos = { 0, 4.08, 0 },
				rot = { 0, 90, 0 },
			},
		}),
	},

	-- 물결 송곳니: 물결처럼 휜 날(세 마디), 끝이 송곳니
	tideFang = {
		accent = { 140, 210, 255 },
		parts = concat(grip(1.1), {
			{ role = "guard", shape = "Block", size = { 1.3, 0.22, 0.4 }, pos = { 0, 0.66, 0 } },
			{
				role = "blade",
				shape = "Block",
				size = { 0.44, 1.1, 0.1 },
				pos = { 0.04, 1.3, 0 },
				rot = { 0, 0, -6 },
			},
			{
				role = "blade",
				shape = "Block",
				size = { 0.44, 1.1, 0.1 },
				pos = { -0.02, 2.3, 0 },
				rot = { 0, 0, 8 },
			},
			{
				role = "blade",
				shape = "Block",
				size = { 0.42, 1.1, 0.1 },
				pos = { 0.05, 3.28, 0 },
				rot = { 0, 0, -8 },
			},
			{ role = "edge", shape = "Block", size = { 0.06, 3.2, 0.12 }, pos = { 0.27, 2.3, 0 } },
			{
				role = "accent",
				shape = "Block",
				size = { 0.08, 2.6, 0.12 },
				pos = { -0.18, 2.3, 0 },
			},
			{
				role = "blade",
				shape = "Wedge",
				size = { 0.1, 0.7, 0.42 },
				pos = { 0.1, 4.18, 0 },
				rot = { 0, 90, -12 },
			},
		}),
	},

	-- 폭풍 바늘: 아주 가는 찌르기 검, 둥근 가드, 잔 번개 무늬
	stormNeedle = {
		accent = { 201, 162, 255 },
		parts = concat(grip(1.2), {
			{
				role = "guard",
				shape = "Cylinder",
				size = { 0.16, 1.1, 1.1 },
				pos = { 0, 0.7, 0 },
				rot = { 0, 0, 90 },
			},
			{ role = "blade", shape = "Block", size = { 0.12, 3.6, 0.12 }, pos = { 0, 2.6, 0 } },
			{ role = "edge", shape = "Block", size = { 0.04, 3.6, 0.14 }, pos = { 0.07, 2.6, 0 } },
			{
				role = "accent",
				shape = "Block",
				size = { 0.05, 0.6, 0.15 },
				pos = { 0, 1.6, 0 },
				rot = { 0, 0, 25 },
			},
			{
				role = "accent",
				shape = "Block",
				size = { 0.05, 0.6, 0.15 },
				pos = { 0, 2.6, 0 },
				rot = { 0, 0, -25 },
			},
			{
				role = "accent",
				shape = "Block",
				size = { 0.05, 0.6, 0.15 },
				pos = { 0, 3.6, 0 },
				rot = { 0, 0, 25 },
			},
			{
				role = "blade",
				shape = "Wedge",
				size = { 0.12, 0.5, 0.12 },
				pos = { 0, 4.65, 0 },
				rot = { 0, 90, 0 },
			},
		}),
	},

	-- 새벽가르기: 넓은 대검, 금빛 날개 가드
	dawnbreaker = {
		accent = { 255, 244, 200 },
		parts = concat(grip(1.4), {
			{ role = "guard", shape = "Block", size = { 1.1, 0.3, 0.46 }, pos = { 0, 0.82, 0 } },
			{
				role = "guard",
				shape = "Wedge",
				size = { 0.46, 0.7, 0.6 },
				pos = { 0.85, 0.95, 0 },
				rot = { 0, 90, -30 },
			},
			{
				role = "guard",
				shape = "Wedge",
				size = { 0.46, 0.7, 0.6 },
				pos = { -0.85, 0.95, 0 },
				rot = { 0, -90, 30 },
			},
			{ role = "blade", shape = "Block", size = { 0.9, 3.4, 0.14 }, pos = { 0, 2.67, 0 } },
			{ role = "edge", shape = "Block", size = { 0.08, 3.4, 0.16 }, pos = { 0.47, 2.67, 0 } },
			{
				role = "edge",
				shape = "Block",
				size = { 0.08, 3.4, 0.16 },
				pos = { -0.47, 2.67, 0 },
			},
			{ role = "core", shape = "Block", size = { 0.14, 3.0, 0.18 }, pos = { 0, 2.6, 0 } },
			{
				role = "blade",
				shape = "Wedge",
				size = { 0.14, 0.9, 0.9 },
				pos = { 0, 4.82, 0 },
				rot = { 0, 90, 0 },
			},
			{ role = "accent", shape = "Ball", size = { 0.4, 0.4, 0.4 }, pos = { 0, -0.95, 0 } },
		}),
	},
} :: { [string]: Shape }

SwordShapes.DEFAULT = SwordShapes.List.ironBlade

SwordShapes.ROLES = { "blade", "edge", "core", "guard", "grip", "pommel", "accent" }
SwordShapes.SHAPES = { "Block", "Wedge", "Ball", "Cylinder" }

function SwordShapes.get(id: string): Shape
	return SwordShapes.List[id] or SwordShapes.DEFAULT
end

-- 손에 쥐는 위치(원점)에서 칼끝까지 대략 길이 (미리보기 카메라 거리 계산용)
function SwordShapes.length(shape: Shape): number
	local top, bottom = 0, 0
	for _, part in shape.parts do
		top = math.max(top, part.pos[2] + part.size[2] / 2)
		bottom = math.min(bottom, part.pos[2] - part.size[2] / 2)
	end
	return top - bottom
end

return SwordShapes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">VisualConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	VisualConfig — 화면 배치와 연출 시간 (통합 기획서 8-1절). 전부 추천치·기술 값이다.

	배치 단위: "디자인 칸". 실제 화면 크기에 맞춰 배율(scale)을 곱한다.
	기준 화면(REFERENCE)은 휴대폰 가로에서 로블록스 위쪽 메뉴 줄을 뺀 크기쯤이다.
]]

local VisualConfig = {}

VisualConfig.Layout = {
	referenceWidth = 860,
	referenceHeight = 360,
	minScale = 0.74, -- 이보다 작게 줄이지 않는다 (버튼 60칸 × 0.74 ≈ 44px)
	maxScale = 1.5,

	margin = 12, -- 화면 가장자리 여백
	gap = 8,

	chipHeight = 36,
	chipWidth = 116,
	chipCount = 3, -- 골드 · 파편 · 방지권

	menuButton = 60, -- 메뉴 버튼 한 변
	menuCount = 4, -- 대장간 · 검 · 도감 · 상점

	raceButtonWidth = 180,
	raceButtonHeight = 60,
	raceStatusHeight = 44,

	lobbyStatusWidth = 220, -- 트레드밀 진행 막대
	lobbyStatusHeight = 44,
	feedLineHeight = 36,

	modalMaxWidth = 720,
	forgeMaxWidth = 900,

	raceHudWidth = 520,
	raceHudHeight = 76,
	abilitySize = 72, -- 특수 능력 버튼 자리 (D16, 지금은 숨김)
	resultWidth = 420,
	resultHeight = 232,

	-- 휴대폰 이동 컨트롤 자리 (실제 화면 px). 로비·경주 중에는 이 자리를 비운다.
	joystickWidth = 280,
	joystickHeight = 180,
	jumpWidth = 200,
	jumpHeight = 190,

	minTouchPx = 44, -- 가장 작은 버튼의 실제 크기
}

-- 강화 결과 연출 길이 (초). 레벨이 높을수록 길다. 화면을 한 번 더 누르면 건너뛴다.
VisualConfig.Reveal = {
	{ minLevel = 0, seconds = 0.5, strikes = 1 },
	{ minLevel = 10, seconds = 1.0, strikes = 2 },
	{ minLevel = 15, seconds = 2.0, strikes = 3 },
}

-- 글자 크기 단계 (디자인 칸). 가장 작은 단계 × minScale 이 12px 밑으로 내려가지 않게 17 이상 (17 × 0.74 ≈ 12.6).
VisualConfig.Text = {
	small = 17,
	body = 18,
	label = 20,
	title = 26,
	big = 34,
	huge = 96,
}

return VisualConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Weapons</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Weapons — 무기 종류 데이터. 전부 오리지널 명칭이며, 표시 문자열은
	Locale 키로만 참조한다(코드에 표시용 한국어를 박지 않는다).

	assetId 는 Studio 에서 만든 모델의 키. 모델 연결 전에는 빈 문자열로 두고
	클라이언트는 기본 외형으로 대체한다.

	[미정 D22] 기본 검(ironBlade)이 common 인 것만 확정이다. 나머지 4종의 등급은
	프로토타입 때 넣은 값이고, 검 20종 목록과 함께 다시 정한다.
]]

export type WeaponInfo = {
	id: string,
	nameKey: string, -- Locale 키
	rarity: "common" | "rare" | "epic" | "legend",
	assetId: string, -- ReplicatedStorage 내 모델 이름 (비어 있으면 기본 외형)
}

local Weapons = {}

Weapons.DEFAULT_ID = "ironBlade"

Weapons.List = {
	ironBlade = {
		id = "ironBlade",
		nameKey = "weapon.ironBlade.name",
		rarity = "common",
		assetId = "",
	},
	emberEdge = {
		id = "emberEdge",
		nameKey = "weapon.emberEdge.name",
		rarity = "rare",
		assetId = "",
	},
	tideFang = {
		id = "tideFang",
		nameKey = "weapon.tideFang.name",
		rarity = "rare",
		assetId = "",
	},
	stormNeedle = {
		id = "stormNeedle",
		nameKey = "weapon.stormNeedle.name",
		rarity = "epic",
		assetId = "",
	},
	dawnbreaker = {
		id = "dawnbreaker",
		nameKey = "weapon.dawnbreaker.name",
		rarity = "legend",
		assetId = "",
	},
} :: { [string]: WeaponInfo }

--[[
	보여 주는 순서(보관함, 도감, 뽑기 확률표). 검을 추가하면 여기에도 넣는다.
	[미정 D22] 기본 20종 중 지금은 5종만 있다. 나머지 15종은 List 와 Order 에 추가만 하면 된다.
]]
Weapons.Order = { "ironBlade", "emberEdge", "tideFang", "stormNeedle", "dawnbreaker" }

Weapons.RARITY_ORDER = { "common", "rare", "epic", "legend" }

-- 새 검 뽑기에서 검 1개당 가중치 (통합 기획서 5-2절). 이미 가진 검은 뽑기에서 빠진다.
Weapons.DRAW_WEIGHTS = {
	common = 10,
	rare = 5,
	epic = 2,
	legend = 0.5,
} :: { [string]: number }

-- 소지 상한 1칸 가격 = SLOT_PRICE_MULTIPLIER × (SLOT_PRICE_LEVEL 강의 강화 비용, 검 수 할증 포함)
Weapons.SLOT_PRICE_LEVEL = 15
Weapons.SLOT_PRICE_MULTIPLIER = 150

--[[
	도감이 기록하는 레벨 구간. 검마다 이 레벨을 처음 달성하면 기록한다.
	[미정 D16] 기념으로 주는 영구 업그레이드의 종류·크기·상한은 아직 정해지지 않았다.
	지금은 달성 기록만 남긴다(codex["검id:구간"]). 수치가 정해지면 그 기록을 읽어 효과를 준다.
]]
Weapons.CODEX_MILESTONES = { 5, 10, 15, 20 }

-- 검 id → 등급 (SwordLogic.buildDrawTable 에 넘기는 모양)
function Weapons.rarityMap(): { [string]: string }
	local map: { [string]: string } = {}
	for id, info in Weapons.List do
		map[id] = info.rarity
	end
	return map
end

function Weapons.get(id: string): WeaponInfo?
	return Weapons.List[id]
end

return Weapons
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[--!strict
--[[
	World — 불씨 광장(로비)과 쇳물 수로(코스)를 블록으로 지을 때 쓰는 위치·크기 (통합 기획서 8-2절).

	밸런스 수치가 아니라 [기술]·[추천치] 값이다. 미술 에셋 없이 기본 블록·재질·효과로 짓는다.
	좌표: 로비 바닥 윗면이 y = 0, 원점이 광장 가운데. 북쪽(+Z)이 코스 방향.
	코스는 로비 북쪽 멀리(+Z)에서 시작해 +Z 로 달린다.
	Roblox 타입(Vector3 등)을 쓰지 않고 숫자만 둔다(Studio 밖 테스트에서도 읽을 수 있게).
	색은 Config/Palette 의 WORLD 에 있다.
]]

local World = {}

World.LOBBY = {
	sizeX = 120,
	sizeZ = 120,
	floorThickness = 2,
	wallHeight = 24, -- 보이지 않는 벽 높이 (밖으로 떨어지지 않게)
	stoneWallHeight = 2.5, -- 보이는 낮은 돌담
	spawnX = 0,
	spawnZ = -30,
	spawnSize = 22, -- 스폰 원판 지름
	spawnScatter = 5,
}

-- 경주에서 돌아오는 자리: 관문 앞 (스폰이 아니라 다시 참가하기 쉬운 곳)
World.RETURN_POINT = { x = 12, z = 28, scatter = 4 }

-- 모루 영감의 대장간 (앞이 트인 건물, 남쪽을 향함)
World.FORGE = {
	x = 0,
	z = 8,
	sizeX = 32,
	sizeZ = 20,
	postHeight = 13,
	furnace = { x = 9, z = 14, sizeX = 8, sizeY = 6, sizeZ = 6 },
	chimney = { x = 9, z = 15, size = 3, height = 22 },
	anvil = { x = -1, z = 2 },
	npc = { x = -6, z = 3 },
	promptDistance = 10, -- 모루에서 이 거리 안이면 "강화하기" 버튼
}

-- 쇳물 관문 (경주 참가)
World.GATE = {
	x = 0,
	z = 54, -- 기둥이 서는 줄
	width = 22, -- 기둥 사이 바깥 폭
	pillarSize = 4,
	pillarHeight = 18,
	ringX = 0,
	ringZ = 42, -- 바닥 원 가운데
	ringRadius = 8,
	ringSegments = 12,
	ringReach = 10, -- 원 위로 이 높이 안이면 "올라섰다"
}

--[[
	풀무 러닝머신 발판. 수입(몇 초에 몇 골드)은 EconomyConfig.TREADMILL_TIERS 에 있다.
	tierId 가 같은 발판은 같은 수입을 준다. 한 발판에 여러 명이 올라가도 된다.
	[미정 D18] 2단계 이상은 이 줄 북쪽에 자리만 비워 둔다.
]]
World.TREADMILL_PADS = {
	{ tierId = "tier1", x = -51, z = -36 },
	{ tierId = "tier1", x = -51, z = -14 },
	{ tierId = "tier1", x = -51, z = 8 },
	{ tierId = "tier1", x = -51, z = 30 },
}
World.TREADMILL_PAD = {
	sizeX = 10,
	sizeZ = 16,
	height = 1.2, -- 받침 높이 (바닥 위로 올라온 높이)
	reach = 12, -- 발판 윗면에서 이 높이까지 "올라가 있다"로 본다 (점프 포함)
	bellowsOffsetX = 8, -- 풀무는 발판 동쪽에
	stripes = 8, -- 벨트 줄무늬 수
}

World.RANKING_WALL = { x = 56, z = 0, width = 20, height = 12 } -- 동쪽 담, 서쪽을 바라봄
World.SHOWCASE = { x = 41, z = -39 }

-- 담 위 횃불 (모서리 4 + 남북 담 4)
World.TORCHES = {
	{ x = -58, z = -58 },
	{ x = 58, z = -58 },
	{ x = -58, z = 58 },
	{ x = 58, z = 58 },
	{ x = -20, z = -58 },
	{ x = 20, z = -58 },
	{ x = -28, z = 58 },
	{ x = 28, z = 58 },
}

-- 돌길 (가운데 선 x1,z1 → x2,z2, 폭)
World.PATHS = {
	{ x1 = 0, z1 = -30, x2 = 0, z2 = 36, width = 6 }, -- 스폰 → 관문
	{ x1 = 0, z1 = -14, x2 = -44, z2 = -14, width = 5 }, -- → 러닝머신
	{ x1 = 0, z1 = -14, x2 = 50, z2 = -14, width = 5 }, -- → 명예의 벽
	{ x1 = 30, z1 = -14, x2 = 41, z2 = -33, width = 4 }, -- → 진열대
}

-- 길 끝 표지판 (글자는 각자 언어로 클라이언트가 붙인다)
-- facing: 표지판 앞면이 바라보는 방향(도). 0 = 남쪽(스폰 쪽), -90 = 동쪽, 90 = 서쪽
World.SIGNS = {
	{ x = 6, z = 30, key = "world.sign.gate", facing = 0 },
	{ x = -38, z = -9, key = "world.sign.treadmill", facing = -90 },
	{ x = 44, z = -9, key = "world.sign.honor", facing = 90 },
}

-- 풀무에서 대장간 화덕까지 이어지는 쇠 관이 지나는 줄
World.PIPE = {
	mainX = -30, -- 러닝머신 줄 옆을 남북으로 지나는 관
	feedZ = 14, -- 이 줄에서 동쪽으로 꺾어 대장간 서쪽 벽까지
	height = 0.4,
	diameter = 0.6,
}

--[[
	padIndex 번째 러닝머신의 풀무에서 화덕까지 관이 지나는 점들 (x, z). 불씨 구슬이 이 길을 따라 굴러간다.
	서버(관 짓기)와 클라이언트(불씨 연출)가 같은 함수를 쓴다.
]]
function World.pipePath(padIndex: number): { { number } }
	local pad = World.TREADMILL_PADS[padIndex]
	if pad == nil then
		return {}
	end
	local startX = pad.x + World.TREADMILL_PAD.bellowsOffsetX
	local forgeWest = World.FORGE.x - World.FORGE.sizeX / 2
	return {
		{ startX, pad.z },
		{ World.PIPE.mainX, pad.z },
		{ World.PIPE.mainX, World.PIPE.feedZ },
		{ forgeWest, World.PIPE.feedZ },
	}
end

-- 담 밖 산 실루엣 (부딪히지 않는다)
World.MOUNTAINS = {
	{ x = -170, z = 210, width = 160, height = 90 },
	{ x = 40, z = 260, width = 220, height = 120 },
	{ x = 230, z = 180, width = 160, height = 80 },
	{ x = -240, z = -60, width = 180, height = 70 },
	{ x = 240, z = -90, width = 170, height = 75 },
}

World.COURSE = {
	startZ = 300, -- 출발선의 Z (로비는 Z = ±60 안쪽이다)
	slotSpacing = 90, -- 동시에 열리는 경주끼리 옆으로 떨어진 거리
	floorThickness = 2,
	segmentLength = 200, -- 바닥을 이 길이로 끊어서 만든다
	wallHeight = 18, -- 보이지 않는 벽 포함 높이
	solidWallHeight = 6, -- 보이는 돌벽 높이
	wallThickness = 2,
	backExtra = 30, -- 추격자 출발 위치보다 뒤로 더 까는 바닥
	markerEvery = 100, -- 이 간격마다 거리 문양 띠와 숫자판
	archEvery = 500, -- 이 간격마다 화로 아치
	blockHeight = 9,
	blockDepth = 4,
	hurdleHeight = 3, -- 걸어서는 못 넘고 점프(기본 약 7칸)로 넘는 높이
	hurdleDepth = 1.5,
	gateHeight = 11,
	gateDepth = 3,
	chaserHeight = 40,
	chaserDepth = 6,
	spawnHeight = 3, -- 캐릭터를 놓을 때 바닥에서 띄우는 높이
	startBars = 9, -- 출발선 쇠창살 수
}

-- 캐릭터끼리 부딪치지 않게 하는 충돌 그룹 이름
World.CHARACTER_COLLISION_GROUP = "ForgeCharacters"

-- Workspace 아래 이름 (클라이언트도 이 이름으로 찾는다)
World.LOBBY_FOLDER = "Lobby"
World.TREADMILL_FOLDER = "Treadmills"
World.RACES_FOLDER = "Races"
World.RACE_FOLDER_PREFIX = "Race_"
World.CHASER_NAME = "Chaser"
World.TREADMILL_TIER_ATTRIBUTE = "TreadmillTier"

-- 서버가 세계 물체에 다는 속성 이름 (클라이언트가 이것을 보고 연출한다)
World.ATTR = {
	treadmillUsers = "TreadmillUsers", -- Lobby 폴더: 러닝머신 위 인원
	occupied = "Occupied", -- 발판: 누가 올라서 있는지
	paidAt = "PaidAt", -- 발판: 마지막 지급 시각 (서버 시간)
	queueCount = "QueueCount", -- 관문: 대기 인원
	departAt = "DepartAt", -- 관문: 출발 예정 시각 (서버 시간, 대기 없으면 0)
	launchAt = "LaunchAt", -- 관문: 마지막 출발 시각
	signKey = "SignKey", -- 표지판: Locale 키
	ownerName = "OwnerName", -- 진열대
	swordId = "SwordId",
	swordLevel = "SwordLevel",
}

return World
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Locale</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Locale — 화면에 보이는 모든 문자열을 키로 관리한다.
	코드 어디에도 표시용 문장을 직접 쓰지 않는다.

	[확인 필요 / Phase 7] 출시 전에는 이 테이블을 Roblox LocalizationTable 로 옮겨
	자동 번역·번역가 워크플로를 쓸 수 있게 한다. 지금은 외부 의존 없이 동작하도록
	순수 Luau 테이블로 둔다. 키 이름은 그대로 유지할 예정이라 이전 비용이 작다.

	치환은 string.format 규칙을 따른다(%s, %d). 언어별로 인자 순서는 같아야 한다.
]]

local Locale = {}

Locale.DEFAULT_LANGUAGE = "ko"

Locale.Strings = {
	ko = {
		["game.title"] = "강화의 대장간",
		["npc.anvilElder.name"] = "모루 영감",

		-- 무기 이름
		["weapon.ironBlade.name"] = "무쇠 검",
		["weapon.emberEdge.name"] = "잉걸불 검",
		["weapon.tideFang.name"] = "물결 송곳니",
		["weapon.stormNeedle.name"] = "폭풍 바늘",
		["weapon.dawnbreaker.name"] = "새벽가르기",
		["rarity.common"] = "일반",
		["rarity.rare"] = "희귀",
		["rarity.epic"] = "영웅",
		["rarity.legend"] = "전설",
		["heat.cold"] = "식은 쇠",
		["heat.red"] = "붉게 달굼",
		["heat.orange"] = "주황 불꽃",
		["heat.yellow"] = "노란 불꽃",
		["heat.white"] = "흰 불꽃",

		-- UI
		["ui.enhance"] = "강화하기",
		["ui.enhancing"] = "두드리는 중...",
		["ui.level"] = "+%d",
		["ui.protectNote"] = "방지권을 켜면 실패 확률이 0%% 가 되고 그만큼 유지가 늘어난다. 실패가 나왔을 때만 1개 쓴다.",
		["ui.odds"] = "성공 %s · 유지 %s · 실패 %s",
		["ui.maxLevel"] = "더 올릴 수 없다. 이게 끝이야.",
		["ui.loading"] = "대장간 문을 여는 중...",
		["ui.cancel"] = "그만둔다",
		["ui.oddsTable"] = "확률표",
		["ui.oddsTableTitle"] = "강화 확률표",
		["ui.column.level"] = "레벨",
		["ui.column.success"] = "성공",
		["ui.column.keep"] = "유지",
		["ui.column.fail"] = "실패",
		["ui.column.cost"] = "비용",
		["ui.eventActive"] = "이벤트 적용 중: %s",
		["ui.tab.settings"] = "설정",
		["ui.sfxOn"] = "소리 켜짐",
		["ui.sfxOff"] = "소리 꺼짐",
		["ui.language"] = "언어: 한국어",
		["ui.maintenance"] = "점검 중이다. 곧 돌아오마.",
		["event.boost"] = "성공 확률 상승 이벤트",
		["event.default"] = "진행 중인 이벤트",
		["tutorial.step1"] = "아래 버튼을 눌러 한 번 두드려 봐라.",
		["tutorial.step2"] = "좋아. 한 번 더.",
		["tutorial.step3"] = "마지막으로 한 번 더 해 보자.",
		["tutorial.done"] = "이제 감을 잡았군. 마음대로 해라.",
		["ui.rename"] = "이름 짓기",
		["ui.renamePrompt"] = "검 이름을 지어라 (최대 16자)",
		["ui.renamed"] = "이제 '%s' 라 부르자.",
		["error.invalid_name"] = "그런 이름은 쓸 수 없다.",
		["error.filter_failed"] = "이름을 확인하지 못했다. 잠시 뒤에 다시.",
		["ui.records"] = "기록",
		["ui.tab.codex"] = "도감",
		["ui.tab.rank"] = "랭킹",
		["ui.rank.level"] = "최고 강화",
		["ui.rank.row"] = "%d위  %s  %s",
		["ui.rank.empty"] = "아직 기록이 없다.",
		["codex.unlocked"] = "도감: %s +%d 달성.",
		["ui.swords"] = "검",
		["ui.swordsTitle"] = "검 보관함",
