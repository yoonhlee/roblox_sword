      <Item class="LocalScript" referent="38">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
--[[
	클라이언트 부트스트랩.
	controllers 폴더의 모듈을 정해진 순서대로 require → Init() → Start() 한다.

	클라이언트는 "요청"과 "표시"만 한다.
	확률 계산, 골드 증감, 레벨 변경, 배틀 결과는 전부 서버가 결정한다.
	서버 응답을 받기 전에는 어떤 결과 연출도 시작하지 않는다.
]]

type Controller = {
	Name: string?,
	Init: (() -> ())?,
	Start: (() -> ())?,
}

local CONTROLLER_ORDER = {
	"SoundController",
	"EffectsController",
	"FeedController",
	"OddsTableController",
	"BattleController",
	"ShopController",
	"CollectionController",
	"UIController",
}

local controllersFolder = script:WaitForChild("controllers")

local function loadController(name: string): Controller
	local module = controllersFolder:WaitForChild(name)
	assert(module:IsA("ModuleScript"), `[Client] 컨트롤러 모듈이 아닙니다: {name}`)
	return require(module) :: Controller
end

local function runStage(stage: "Init" | "Start", controllers: { Controller })
	for _, controller in controllers do
		local fn = if stage == "Init" then controller.Init else controller.Start
		if not fn then
			continue
		end

		local ok, err = xpcall(fn, debug.traceback)
		if not ok then
			warn(`[Client] {controller.Name or "?"}.{stage} 실패:\n{err}`)
		end
	end
end

local controllers: { Controller } = {}
for _, name in CONTROLLER_ORDER do
	local controller = loadController(name)
	controller.Name = controller.Name or name
	table.insert(controllers, controller)
end

runStage("Init", controllers)
runStage("Start", controllers)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ClientState — 서버가 보내 준 내 데이터의 로컬 사본.

	클라이언트는 이 값을 "표시"에만 쓴다. 여기 있는 숫자를 고쳐도 게임에는
	아무 영향이 없다(서버가 진짜 값을 들고 있다).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Locale = require(Shared:WaitForChild("Locale"))

local ClientState = {}

local data: Types.PlayerData? = nil
local odds: Types.DisplayOdds? = nil
local liveOps: { maintenance: boolean, notice: string, event: any } = {
	maintenance = false,
	notice = "",
	event = nil,
}
local listeners: { () -> () } = {}

local function notify()
	for _, listener in listeners do
		local ok, err = pcall(listener)
		if not ok then
			warn(`[ClientState] 리스너 오류: {err}`)
		end
	end
end

function ClientState.setData(newData: Types.PlayerData)
	data = newData
	notify()
end

function ClientState.setOdds(newOdds: Types.DisplayOdds)
	odds = newOdds
	notify()
end

function ClientState.getData(): Types.PlayerData?
	return data
end

function ClientState.getOdds(): Types.DisplayOdds?
	return odds
end

function ClientState.getLanguage(): string
	if data and data.settings and data.settings.language then
		return data.settings.language
	end
	return Locale.DEFAULT_LANGUAGE
end

function ClientState.setLiveOps(config: any)
	liveOps = {
		maintenance = config.maintenance == true,
		notice = if type(config.notice) == "string" then config.notice else "",
		event = config.event,
	}
	notify()
end

function ClientState.getLiveOps()
	return liveOps
end

function ClientState.onChanged(listener: () -> ())
	table.insert(listeners, listener)
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="40">
          <Properties>
            <string name="Name">controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">BattleController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	BattleController — 도전 상대 고르기, 도전장 받기, 결과 보기.

	클라이언트는 "누구에게 도전할지"와 "수락/거절"만 보낸다.
	승패·보상·레이팅은 전부 서버가 정한 값을 그대로 보여 준다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))

local controllers = script.Parent
local ClientState = require(controllers.Parent:WaitForChild("ClientState"))
local FeedController = require(controllers:WaitForChild("FeedController"))
local SoundController = require(controllers:WaitForChild("SoundController"))

local BattleController = {}
BattleController.Name = "BattleController"

local COLOR_PANEL = Color3.fromRGB(34, 30, 38)
local COLOR_SUB = Color3.fromRGB(52, 46, 58)
local COLOR_TEXT = Color3.fromRGB(240, 236, 230)
local COLOR_MUTED = Color3.fromRGB(168, 160, 172)
local COLOR_ACCENT = Color3.fromRGB(226, 142, 58)
local COLOR_WIN = Color3.fromRGB(150, 230, 160)
local COLOR_LOSS = Color3.fromRGB(255, 130, 118)

local TOUCH_MIN = 44

local gui: ScreenGui
local listPanel: Frame
local listTitle: TextLabel
local listScroller: ScrollingFrame
local randomButton: TextButton
local listClose: TextButton

local invitePanel: Frame
local inviteLabel: TextLabel
local inviteTimer: TextLabel
local acceptButton: TextButton
local declineButton: TextButton

local resultPanel: Frame
local resultTitle: TextLabel
local resultDetail: TextLabel
local resultClose: TextButton

local challengeRemote: RemoteFunction
local respondRemote: RemoteFunction
local targetsRemote: RemoteFunction

local inviteExpiresAt = 0
local busy = false

local function corner(parent: Instance, radius: number)
	local instance = Instance.new("UICorner")
	instance.CornerRadius = UDim.new(0, radius)
	instance.Parent = parent
end

local function makePanel(name: string, height: number): Frame
	local panel = Instance.new("Frame")
	panel.Name = name
	panel.BackgroundColor3 = COLOR_PANEL
	panel.BorderSizePixel = 0
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.new(0.9, 0, 0, height)
	panel.Visible = false
	panel.Parent = gui
	corner(panel, 14)

	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MaxSize = Vector2.new(460, 620)
	sizeConstraint.Parent = panel

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 16)
	padding.PaddingBottom = UDim.new(0, 16)
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 16)
	padding.Parent = panel

	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 8)
	list.Parent = panel

	return panel
end

local function makeLabel(parent: Instance, props: { [string]: any }): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextColor3 = COLOR_TEXT
	label.TextSize = 16
	label.Size = UDim2.new(1, 0, 0, 22)
	label.Text = ""
	for key, value in props do
		(label :: any)[key] = value
	end
	label.Parent = parent
	return label
end

local function makeButton(parent: Instance, props: { [string]: any }): TextButton
	local button = Instance.new("TextButton")
	button.BackgroundColor3 = COLOR_SUB
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamBold
	button.TextColor3 = COLOR_TEXT
	button.TextSize = 16
	button.Size = UDim2.new(1, 0, 0, TOUCH_MIN)
	button.Text = ""
	for key, value in props do
		(button :: any)[key] = value
	end
	button.Parent = parent
	corner(button, 10)
	return button
end

local function closeAll()
	listPanel.Visible = false
	invitePanel.Visible = false
end

local function sendChallenge(targetUserId: number?)
	if busy then
		return
	end
	busy = true
	listPanel.Visible = false

	local ok, response = pcall(function()
		return challengeRemote:InvokeServer(targetUserId)
	end)

	busy = false

	if not ok or type(response) ~= "table" then
		FeedController.pushRaw(Locale.get(ClientState.getLanguage(), "error.unknown"), COLOR_LOSS)
		return
	end

	if response.ok ~= true then
		FeedController.pushRaw(
			Locale.get(ClientState.getLanguage(), `error.{tostring(response.reason)}`),
			COLOR_LOSS
		)
	end
end

local function refreshTargets()
	local language = ClientState.getLanguage()

	listTitle.Text = Locale.get(language, "ui.battleTitle")
	randomButton.Text = Locale.get(language, "ui.battleRandom")
	listClose.Text = Locale.get(language, "ui.close")

	for _, child in listScroller:GetChildren() do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local ok, targets = pcall(function()
		return targetsRemote:InvokeServer()
	end)

	if not ok or type(targets) ~= "table" or #targets == 0 then
		local empty = makeLabel(listScroller, {
			Text = Locale.get(language, "ui.noOpponent"),
			TextColor3 = COLOR_MUTED,
			LayoutOrder = 1,
		})
		empty.Size = UDim2.new(1, 0, 0, 30)
		return
	end

	for index, target in targets do
		local row = makeButton(listScroller, {
			Text = Locale.get(language, "ui.battleRow", target.name, target.level, target.rating),
			TextSize = 15,
			Font = Enum.Font.GothamMedium,
			LayoutOrder = index,
		})
		row.Activated:Connect(function()
			sendChallenge(target.userId)
		end)
	end
end

local function showInvite(payload: any)
	local language = ClientState.getLanguage()

	inviteExpiresAt = tonumber(payload.expiresAt) or 0
	inviteLabel.Text = Locale.get(
		language,
		"battle.invite",
		tostring(payload.challengerName),
		tonumber(payload.challengerLevel) or 0
	)
	acceptButton.Text = Locale.get(language, "ui.accept")
	declineButton.Text = Locale.get(language, "ui.decline")

	listPanel.Visible = false
	invitePanel.Visible = true
	SoundController.play("click")
end

local function respond(accept: boolean)
	invitePanel.Visible = false

	task.spawn(function()
		local ok, response = pcall(function()
			return respondRemote:InvokeServer(accept)
		end)

		if ok and type(response) == "table" and response.ok ~= true then
			FeedController.pushRaw(
				Locale.get(ClientState.getLanguage(), `error.{tostring(response.reason)}`),
				COLOR_LOSS
			)
		end
	end)
end

local function showResult(payload: any)
	local language = ClientState.getLanguage()
	local won = payload.won == true

	resultTitle.Text = Locale.get(language, if won then "battle.win" else "battle.loss")
	resultTitle.TextColor3 = if won then COLOR_WIN else COLOR_LOSS

	local lines = {
		Locale.get(language, "battle.reward", Format.comma(payload.goldGained or 0)),
		Locale.get(
			language,
			"battle.rating",
			math.floor(payload.ratingBefore or 0),
			math.floor(payload.ratingAfter or 0)
		),
		Locale.get(language, "battle.odds", Format.ratio(payload.winProbability or 0)),
	}

	if payload.rewardCapped then
		table.insert(lines, Locale.get(language, "battle.capped"))
	end

	resultDetail.Text = table.concat(lines, "\n")
	resultClose.Text = Locale.get(language, "ui.close")
	resultPanel.Visible = true

	FeedController.pushRaw(
		Locale.get(
			language,
			if won then "battle.feedWin" else "battle.feedLoss",
			tostring(payload.opponentName)
		),
		if won then COLOR_WIN else COLOR_LOSS
	)
	SoundController.play(if won then "success" else "keep")
end

local function build()
	local player = Players.LocalPlayer

	gui = Instance.new("ScreenGui")
	gui.Name = "ForgeBattle"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 20
	gui.Parent = player:WaitForChild("PlayerGui")

	-- 상대 목록
	listPanel = makePanel("TargetList", 380)
	listTitle = makeLabel(listPanel, {
		TextSize = 20,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 28),
		LayoutOrder = 1,
	})

	listScroller = Instance.new("ScrollingFrame")
	listScroller.BackgroundTransparency = 1
	listScroller.BorderSizePixel = 0
	listScroller.Size = UDim2.new(1, 0, 0, 220)
	listScroller.CanvasSize = UDim2.new(0, 0, 0, 0)
	listScroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	listScroller.ScrollBarThickness = 4
	listScroller.LayoutOrder = 2
	listScroller.Parent = listPanel

	local scrollList = Instance.new("UIListLayout")
	scrollList.FillDirection = Enum.FillDirection.Vertical
	scrollList.SortOrder = Enum.SortOrder.LayoutOrder
	scrollList.Padding = UDim.new(0, 6)
	scrollList.Parent = listScroller

	randomButton = makeButton(listPanel, {
		BackgroundColor3 = COLOR_ACCENT,
		TextColor3 = Color3.fromRGB(24, 18, 10),
		LayoutOrder = 3,
	})
	listClose = makeButton(listPanel, { LayoutOrder = 4 })

	-- 받은 도전
	invitePanel = makePanel("Invite", 210)
	inviteLabel = makeLabel(invitePanel, {
		TextSize = 17,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 44),
		LayoutOrder = 1,
	})
	inviteTimer = makeLabel(invitePanel, {
		TextSize = 14,
		TextColor3 = COLOR_MUTED,
		LayoutOrder = 2,
	})
	acceptButton = makeButton(invitePanel, {
		BackgroundColor3 = COLOR_ACCENT,
		TextColor3 = Color3.fromRGB(24, 18, 10),
		LayoutOrder = 3,
	})
	declineButton = makeButton(invitePanel, { LayoutOrder = 4 })

	-- 결과
	resultPanel = makePanel("Result", 230)
	resultTitle = makeLabel(resultPanel, {
		TextSize = 26,
		Font = Enum.Font.GothamBold,
		Size = UDim2.new(1, 0, 0, 34),
		LayoutOrder = 1,
	})
	resultDetail = makeLabel(resultPanel, {
		TextSize = 15,
		TextColor3 = COLOR_MUTED,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 84),
		LayoutOrder = 2,
	})
	resultClose = makeButton(resultPanel, { LayoutOrder = 3 })

	randomButton.Activated:Connect(function()
		sendChallenge(nil)
	end)
	listClose.Activated:Connect(function()
		listPanel.Visible = false
	end)
	acceptButton.Activated:Connect(function()
		respond(true)
	end)
	declineButton.Activated:Connect(function()
		respond(false)
	end)
	resultClose.Activated:Connect(function()
		resultPanel.Visible = false
	end)
end

function BattleController.openTargetList()
	if listPanel.Visible then
		listPanel.Visible = false
		return
	end

	listPanel.Visible = true
	task.spawn(refreshTargets)
end

function BattleController.Init()
	build()

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	challengeRemote =
		remotesFolder:WaitForChild(Remotes.Functions.ChallengeBattle) :: RemoteFunction
	respondRemote = remotesFolder:WaitForChild(Remotes.Functions.RespondBattle) :: RemoteFunction
	targetsRemote =
		remotesFolder:WaitForChild(Remotes.Functions.GetBattleTargets) :: RemoteFunction

	local inviteRemote = remotesFolder:WaitForChild(Remotes.Events.BattleInvite) :: RemoteEvent
	inviteRemote.OnClientEvent:Connect(function(payload: any)
		if payload == false then
			invitePanel.Visible = false -- 시간 초과 또는 취소
		elseif type(payload) == "table" then
			showInvite(payload)
		end
	end)

	local resolvedRemote = remotesFolder:WaitForChild(Remotes.Events.BattleResolved) :: RemoteEvent
	resolvedRemote.OnClientEvent:Connect(function(payload: any)
		if type(payload) == "table" then
			closeAll()
			showResult(payload)
		end
	end)
end

function BattleController.Start()
	-- 남은 응답 시간을 1초마다 갱신한다.
	task.spawn(function()
		while true do
			task.wait(1)
			if invitePanel.Visible then
				local remaining = math.max(0, inviteExpiresAt - os.time())
				inviteTimer.Text = Format.duration(remaining)

				if remaining <= 0 then
					invitePanel.Visible = false
				end
			end
		end
	end)
end

return BattleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">CollectionController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CollectionController — 도감 / 업적 / 랭킹을 탭 하나로 묶은 화면.

	세 화면을 따로 만들면 코드가 세 배가 되고 모바일에서 버튼도 자리를 잃는다.
	한 패널 안에서 탭으로 바꾸는 편이 화면도 코드도 단순하다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))
local Weapons = require(Shared:WaitForChild("Config"):WaitForChild("Weapons"))

local ClientState = require(script.Parent.Parent:WaitForChild("ClientState"))

local CollectionController = {}
CollectionController.Name = "CollectionController"

local COLOR_PANEL = Color3.fromRGB(34, 30, 38)
local COLOR_ROW = Color3.fromRGB(44, 39, 50)
local COLOR_TEXT = Color3.fromRGB(240, 236, 230)
local COLOR_MUTED = Color3.fromRGB(120, 114, 126)
local COLOR_ACCENT = Color3.fromRGB(226, 142, 58)

local TOUCH_MIN = 44

type Tab = "codex" | "achv" | "rank" | "settings"

local gui: ScreenGui
local panel: Frame
local scroller: ScrollingFrame
local tabButtons: { [string]: TextButton } = {}
local rankToggle: TextButton
local closeButton: TextButton

local codexRemote: RemoteFunction
local boardRemote: RemoteFunction
local settingRemote: RemoteFunction
local settingsRow: Frame
local sfxButton: TextButton
local languageButton: TextButton

local activeTab: Tab = "codex"
local rankKind = "level"

local function makeRow(text: string, color: Color3, order: number)
	local label = Instance.new("TextLabel")
	label.BackgroundColor3 = COLOR_ROW
	label.BackgroundTransparency = 0.4
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 14
	label.TextColor3 = color
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Size = UDim2.new(1, 0, 0, 26)
	label.Text = "  " .. text
	label.LayoutOrder = order
	label.Parent = scroller

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = label
end

local function clearRows()
	for _, child in scroller:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
end

local function renderCodex()
	local language = ClientState.getLanguage()

	local ok, response = pcall(function()
		return codexRemote:InvokeServer()
	end)

	clearRows()

	if not ok or type(response) ~= "table" or response.entries == nil then
		makeRow(Locale.get(language, "error.not_ready"), COLOR_MUTED, 1)
		return
	end

	for index, entry in response.entries do
		local weapon = Weapons.get(entry.weaponId)
		local name = if weapon then Locale.get(language, weapon.nameKey) else entry.weaponId

		local text = Locale.get(language, "ui.codexRow", name, entry.milestone)
		if not entry.unlocked then
			text ..= `  ({Locale.get(language, "ui.locked")})`
		end

		makeRow(text, if entry.unlocked then COLOR_TEXT else COLOR_MUTED, index)
	end
end

local function renderAchievements()
	local language = ClientState.getLanguage()

	local ok, response = pcall(function()
		return codexRemote:InvokeServer()
	end)

	clearRows()

	if not ok or type(response) ~= "table" or response.achievements == nil then
		makeRow(Locale.get(language, "error.not_ready"), COLOR_MUTED, 1)
		return
	end

	for index, entry in response.achievements do
		local text = Locale.get(language, `achv.{entry.id}.name`)
			.. "  ·  "
			.. Locale.get(language, "ui.reward", Format.comma(entry.gold))

		if not entry.unlocked then
			text ..= `  ({Locale.get(language, "ui.locked")})`
		end

		makeRow(text, if entry.unlocked then COLOR_ACCENT else COLOR_MUTED, index)
	end
end

local function renderRanking()
	local language = ClientState.getLanguage()

	rankToggle.Text = Locale.get(language, `ui.rank.{rankKind}`)

	local ok, entries = pcall(function()
		return boardRemote:InvokeServer(rankKind)
	end)

	clearRows()

	if not ok or type(entries) ~= "table" or #entries == 0 then
		makeRow(Locale.get(language, "ui.rank.empty"), COLOR_MUTED, 1)
		return
	end

	local myUserId = Players.LocalPlayer.UserId

	for index, entry in entries do
		local value = if rankKind == "level"
			then Format.level(entry.value)
			else tostring(entry.value)

		makeRow(
			Locale.get(language, "ui.rank.row", entry.rank, entry.name, value),
			if entry.userId == myUserId then COLOR_ACCENT else COLOR_TEXT,
			index
		)
	end
end

local function applySetting(key: string, value: any)
	task.spawn(function()
		pcall(function()
			settingRemote:InvokeServer(key, value)
		end)
	end)
end

local function renderSettings()
	local language = ClientState.getLanguage()
	local data = ClientState.getData()

	clearRows()

	if data == nil then
		makeRow(Locale.get(language, "error.not_ready"), COLOR_MUTED, 1)
		return
	end

	sfxButton.Text = Locale.get(language, if data.settings.sfx then "ui.sfxOn" else "ui.sfxOff")
	sfxButton.TextColor3 = if data.settings.sfx then COLOR_ACCENT else COLOR_MUTED
	languageButton.Text = Locale.get(language, "ui.language")
end

local function refresh()
	local language = ClientState.getLanguage()

	for key, button in tabButtons do
		button.Text = Locale.get(language, `ui.tab.{key}`)
		button.TextColor3 = if key == activeTab then COLOR_ACCENT else COLOR_MUTED
	end

	closeButton.Text = Locale.get(language, "ui.close")
	rankToggle.Visible = activeTab == "rank"
	settingsRow.Visible = activeTab == "settings"

	if activeTab == "settings" then
		renderSettings()
		return
	end

	clearRows()
	makeRow("...", COLOR_MUTED, 0)

	task.spawn(function()
		if activeTab == "codex" then
			renderCodex()
		elseif activeTab == "achv" then
			renderAchievements()
		else
			renderRanking()
		end
	end)
end

local function makeButton(parent: Instance, props: { [string]: any }): TextButton
	local button = Instance.new("TextButton")
	button.BackgroundColor3 = COLOR_ROW
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamBold
	button.TextColor3 = COLOR_TEXT
	button.TextSize = 15
	button.Size = UDim2.new(1, 0, 0, TOUCH_MIN)
	button.Text = ""
	for key, value in props do
		(button :: any)[key] = value
	end
	button.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = button

	return button
end

local function build()
	local player = Players.LocalPlayer

	gui = Instance.new("ScreenGui")
	gui.Name = "ForgeRecords"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 12
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local dim = Instance.new("TextButton")
	dim.BackgroundColor3 = Color3.new(0, 0, 0)
	dim.BackgroundTransparency = 0.45
	dim.BorderSizePixel = 0
	dim.Size = UDim2.fromScale(1, 1)
	dim.Text = ""
	dim.AutoButtonColor = false
	dim.Parent = gui

	panel = Instance.new("Frame")
	panel.BackgroundColor3 = COLOR_PANEL
	panel.BorderSizePixel = 0
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.new(0.92, 0, 0.8, 0)
	panel.Parent = gui

	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MaxSize = Vector2.new(520, 640)
	sizeConstraint.Parent = panel

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = panel

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 14)
	padding.PaddingBottom = UDim.new(0, 14)
	padding.PaddingLeft = UDim.new(0, 14)
	padding.PaddingRight = UDim.new(0, 14)
	padding.Parent = panel

	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 8)
	list.Parent = panel

	-- 탭 줄
	local tabRow = Instance.new("Frame")
	tabRow.BackgroundTransparency = 1
	tabRow.Size = UDim2.new(1, 0, 0, TOUCH_MIN)
	tabRow.LayoutOrder = 1
	tabRow.Parent = panel

	local tabList = Instance.new("UIListLayout")
	tabList.FillDirection = Enum.FillDirection.Horizontal
	tabList.SortOrder = Enum.SortOrder.LayoutOrder
	tabList.Padding = UDim.new(0, 6)
	tabList.Parent = tabRow

	local order = 0
	for _, key in { "codex", "achv", "rank", "settings" } do
		order += 1
		local button = makeButton(tabRow, {
			Size = UDim2.new(0.25, -5, 1, 0),
			TextSize = 13,
			LayoutOrder = order,
		})
		button.Activated:Connect(function()
			activeTab = key :: Tab
			refresh()
		end)
		tabButtons[key] = button
	end

	rankToggle = makeButton(panel, {
		Size = UDim2.new(1, 0, 0, 34),
		TextSize = 14,
		Font = Enum.Font.GothamMedium,
		Visible = false,
		LayoutOrder = 2,
	})
	rankToggle.Activated:Connect(function()
		rankKind = if rankKind == "level" then "rating" else "level"
		refresh()
	end)

	-- 설정 탭에서만 보이는 줄
	settingsRow = Instance.new("Frame")
	settingsRow.BackgroundTransparency = 1
	settingsRow.Size = UDim2.new(1, 0, 0, TOUCH_MIN)
	settingsRow.Visible = false
	settingsRow.LayoutOrder = 2
	settingsRow.Parent = panel

	local settingsList = Instance.new("UIListLayout")
	settingsList.FillDirection = Enum.FillDirection.Horizontal
	settingsList.SortOrder = Enum.SortOrder.LayoutOrder
	settingsList.Padding = UDim.new(0, 8)
	settingsList.Parent = settingsRow

	sfxButton = makeButton(settingsRow, {
		Size = UDim2.new(0.5, -4, 1, 0),
		TextSize = 14,
		Font = Enum.Font.GothamMedium,
		LayoutOrder = 1,
	})
	languageButton = makeButton(settingsRow, {
		Size = UDim2.new(0.5, -4, 1, 0),
		TextSize = 14,
		Font = Enum.Font.GothamMedium,
		LayoutOrder = 2,
	})

	sfxButton.Activated:Connect(function()
		local data = ClientState.getData()
		if data then
			applySetting("sfx", not data.settings.sfx)
		end
	end)

	languageButton.Activated:Connect(function()
		local next_ = if ClientState.getLanguage() == "ko" then "en" else "ko"
		applySetting("language", next_)
	end)

	scroller = Instance.new("ScrollingFrame")
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.Size = UDim2.new(1, 0, 1, -150)
	scroller.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroller.ScrollBarThickness = 4
	scroller.LayoutOrder = 3
	scroller.Parent = panel

	local scrollList = Instance.new("UIListLayout")
	scrollList.FillDirection = Enum.FillDirection.Vertical
	scrollList.SortOrder = Enum.SortOrder.LayoutOrder
	scrollList.Padding = UDim.new(0, 3)
	scrollList.Parent = scroller

	closeButton = makeButton(panel, { LayoutOrder = 4 })
	closeButton.Activated:Connect(function()
		gui.Enabled = false
	end)
	dim.Activated:Connect(function()
		gui.Enabled = false
	end)
end

function CollectionController.toggle()
	if gui.Enabled then
		gui.Enabled = false
		return
	end

	gui.Enabled = true
	refresh()
end

function CollectionController.Init()
	build()

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	codexRemote = remotesFolder:WaitForChild(Remotes.Functions.GetCodex) :: RemoteFunction
	boardRemote = remotesFolder:WaitForChild(Remotes.Functions.GetLeaderboard) :: RemoteFunction
	settingRemote = remotesFolder:WaitForChild(Remotes.Functions.SetSetting) :: RemoteFunction
end

function CollectionController.Start()
	-- 설정을 바꾸면 서버가 데이터를 다시 내려 주므로, 그때 화면을 갱신한다.
	ClientState.onChanged(function()
		if gui.Enabled and activeTab == "settings" then
			renderSettings()
		end
	end)
end

return CollectionController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	EffectsController — 강화 결과 연출.

	모든 연출은 서버 응답을 받은 뒤 UIController 가 호출해서 시작한다.
	외부 에셋 없이 UI 요소의 움직임만으로 만든다(나중에 파티클/사운드를 얹기 쉬움).

	- 성공: 글자가 커지며 밝게 번쩍 + 위로 솟는 느낌
	- 유지: 짧은 좌우 흔들림
	- 파괴: 붉은 화면 번쩍 + 조각이 흩어지는 연출 + 화면 흔들림
	- 보호: 푸른 방패 펄스
]]

local TweenService = game:GetService("TweenService")

local EffectsController = {}
EffectsController.Name = "EffectsController"

local centerFrame: Frame? = nil
local levelLabel: TextLabel? = nil
local flash: Frame? = nil

local BASE_TEXT_SIZE = 72

-- UIController 가 자기 UI 요소를 넘겨 준다.
function EffectsController.bind(targetGui: ScreenGui, center: Frame, label: TextLabel)
	centerFrame = center
	levelLabel = label
	BASE_TEXT_SIZE = label.TextSize

	local overlay = Instance.new("Frame")
	overlay.Name = "Flash"
	overlay.BackgroundColor3 = Color3.new(1, 1, 1)
	overlay.BackgroundTransparency = 1
	overlay.BorderSizePixel = 0
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.ZIndex = 50
	overlay.Active = false
	overlay.Parent = targetGui
	flash = overlay
end

local function flashScreen(color: Color3, strength: number)
	local overlay = flash
	if overlay == nil then
		return
	end

	overlay.BackgroundColor3 = color
	overlay.BackgroundTransparency = 1 - strength
	TweenService:Create(
		overlay,
		TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 1 }
	):Play()
end

local function shake(intensity: number, duration: number)
	local frame = centerFrame
	if frame == nil then
		return
	end

	local origin = frame.Position
	local steps = math.max(2, math.floor(duration / 0.04))

	task.spawn(function()
		for step = 1, steps do
			local decay = 1 - step / steps
			local offsetX = (math.random() - 0.5) * 2 * intensity * decay
			local offsetY = (math.random() - 0.5) * 2 * intensity * decay
			frame.Position = origin + UDim2.fromOffset(offsetX, offsetY)
			task.wait(0.04)
		end
		frame.Position = origin
	end)
end

local function pulseLabel(targetSize: number, color: Color3)
	local label = levelLabel
	if label == nil then
		return
	end

	local originalColor = label.TextColor3
	label.TextSize = targetSize
	label.TextColor3 = color

	TweenService:Create(
		label,
		TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ TextSize = BASE_TEXT_SIZE, TextColor3 = originalColor }
	):Play()
end

-- 파괴될 때 조각이 흩어지는 연출
local function burst(count: number, color: Color3)
	local frame = centerFrame
	if frame == nil then
		return
	end

	for _ = 1, count do
		local piece = Instance.new("Frame")
		piece.BackgroundColor3 = color
		piece.BorderSizePixel = 0
		piece.AnchorPoint = Vector2.new(0.5, 0.5)
		piece.Position = UDim2.fromScale(0.5, 0.5)
		piece.Size = UDim2.fromOffset(math.random(4, 10), math.random(4, 10))
		piece.Rotation = math.random(0, 360)
		piece.ZIndex = 20
		piece.Parent = frame

		local angle = math.random() * math.pi * 2
		local distance = math.random(60, 180)

		local tween = TweenService:Create(
			piece,
			TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{
				Position = UDim2.new(
					0.5,
					math.cos(angle) * distance,
					0.5,
					math.sin(angle) * distance
				),
				BackgroundTransparency = 1,
				Rotation = piece.Rotation + math.random(-180, 180),
			}
		)

		tween.Completed:Connect(function()
			piece:Destroy()
		end)
		tween:Play()
	end
end

--[[
	결과에 맞는 연출을 재생한다.
	outcome: "success" | "keep" | "destroy" | "protected"
]]
function EffectsController.play(outcome: string)
	if outcome == "success" then
		pulseLabel(BASE_TEXT_SIZE * 1.4, Color3.fromRGB(255, 240, 200))
		flashScreen(Color3.fromRGB(255, 220, 150), 0.25)
	elseif outcome == "keep" then
		shake(6, 0.2)
	elseif outcome == "destroy" then
		pulseLabel(BASE_TEXT_SIZE * 0.7, Color3.fromRGB(255, 120, 108))
		flashScreen(Color3.fromRGB(255, 80, 70), 0.4)
		burst(14, Color3.fromRGB(200, 190, 180))
		shake(14, 0.45)
	elseif outcome == "protected" then
		pulseLabel(BASE_TEXT_SIZE * 1.15, Color3.fromRGB(150, 215, 255))
		flashScreen(Color3.fromRGB(120, 190, 255), 0.25)
	end
end

-- 최대 레벨 도달 시의 특수 연출
function EffectsController.playMaxLevel()
	pulseLabel(BASE_TEXT_SIZE * 1.6, Color3.fromRGB(255, 255, 255))
	flashScreen(Color3.fromRGB(255, 240, 200), 0.5)
	burst(24, Color3.fromRGB(255, 215, 140))
end

function EffectsController.Init() end

function EffectsController.Start() end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">FeedController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	FeedController — 결과 피드.
	채팅 로그처럼 최근 결과가 한 줄씩 쌓인다. 모루 영감의 대사로 출력한다.

	Phase 2 에서 연출(페이드, 강조색, 접이식 모바일 레이아웃)을 다듬는다.
	지금은 "서버 응답을 받은 뒤에만 한 줄 추가된다"는 흐름을 먼저 세운다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ClientState = require(script.Parent.Parent:WaitForChild("ClientState"))

local FeedController = {}
FeedController.Name = "FeedController"

local MAX_LINES = 7
local NARROW_WIDTH = 700

local OUTCOME_COLOR: { [string]: Color3 } = {
	system = Color3.fromRGB(230, 226, 220),
	success = Color3.fromRGB(255, 208, 112),
	keep = Color3.fromRGB(198, 198, 198),
	destroy = Color3.fromRGB(255, 120, 108),
	protected = Color3.fromRGB(140, 210, 255),
	broadcast = Color3.fromRGB(180, 255, 190),
}

local container: Frame? = nil
local toggleButton: TextButton? = nil
local lineCount = 0
local collapsed = false

local function layout()
	local frame = container
	if frame == nil then
		return
	end

	local viewport = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize
	local isNarrow = viewport ~= nil and viewport.X < NARROW_WIDTH

	local button = toggleButton

	if isNarrow then
		-- 모바일: 화면 위쪽에 가로로 넓게, 접을 수 있게
		frame.AnchorPoint = Vector2.new(0.5, 0)
		frame.Position = UDim2.new(0.5, 0, 0, 64)
		frame.Size = UDim2.new(1, -24, 0, if collapsed then 0 else 132)
		frame.Visible = not collapsed

		if button then
			button.Visible = true
			button.AnchorPoint = Vector2.new(0.5, 0)
			button.Position = UDim2.new(0.5, 0, 0, if collapsed then 64 else 200)
		end
	else
		-- 데스크톱: 우측 세로 (항상 펼침)
		frame.AnchorPoint = Vector2.new(1, 0)
		frame.Position = UDim2.new(1, -16, 0, 72)
		frame.Size = UDim2.new(0, 320, 0, 220)
		frame.Visible = true

		if button then
			button.Visible = false
		end
	end
end

local function build()
	local player = Players.LocalPlayer
	local gui = Instance.new("ScreenGui")
	gui.Name = "ForgeFeed"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	local frame = Instance.new("Frame")
	frame.Name = "Lines"
	frame.BackgroundColor3 = Color3.fromRGB(18, 16, 20)
	frame.BackgroundTransparency = 0.35
	frame.BorderSizePixel = 0
	frame.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 8)
	padding.PaddingBottom = UDim.new(0, 8)
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 10)
	padding.Parent = frame

	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.VerticalAlignment = Enum.VerticalAlignment.Bottom
	list.Padding = UDim.new(0, 2)
	list.Parent = frame

	-- 모바일에서 피드를 접었다 펼치는 버튼 (최소 터치 영역 44px)
	local toggle = Instance.new("TextButton")
	toggle.Name = "FeedToggle"
	toggle.BackgroundColor3 = Color3.fromRGB(52, 46, 58)
	toggle.BorderSizePixel = 0
	toggle.Font = Enum.Font.GothamMedium
	toggle.TextSize = 13
	toggle.TextColor3 = Color3.fromRGB(230, 226, 220)
	toggle.Size = UDim2.fromOffset(84, 44)
	toggle.Visible = false
	toggle.Parent = gui

	local toggleCorner = Instance.new("UICorner")
	toggleCorner.CornerRadius = UDim.new(0, 10)
	toggleCorner.Parent = toggle

	toggle.Activated:Connect(function()
		collapsed = not collapsed
		layout()
	end)

	container = frame
	toggleButton = toggle
	layout()

	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(layout)
	end
end

--[[
	기본 채팅창에도 같은 내용을 띄운다.
	TextChannel:DisplaySystemMessage() 는 공식 문서상 클라이언트에서만 호출할 수 있고,
	그 메시지는 이 플레이어에게만 보인다. 그래서 전체 공지는 서버가 리모트로
	모든 클라이언트에 보내고, 각자 자기 채팅창에 띄우는 구조를 쓴다.
]]
local function displayInChat(text: string)
	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		return
	end

	local channels = TextChatService:FindFirstChild("TextChannels")
	local general = channels and channels:FindFirstChild("RBXGeneral")

	if general and general:IsA("TextChannel") then
		local ok, err = pcall(function()
			general:DisplaySystemMessage(text)
		end)
		if not ok then
			warn(`[FeedController] 채팅 표시 실패: {err}`)
		end
	end
end

local function push(text: string, color: Color3)
	local frame = container
	if frame == nil then
		return
	end

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, 18)
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 14
	label.TextColor3 = color
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Text = text
	lineCount += 1
	label.LayoutOrder = lineCount
	label.Parent = frame

	-- 오래된 줄부터 지운다.
	local labels: { TextLabel } = {}
	for _, child in frame:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(labels, child)
		end
	end

	if #labels > MAX_LINES then
		table.sort(labels, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for index = 1, #labels - MAX_LINES do
			labels[index]:Destroy()
		end
	end
end

-- 강화 결과 한 줄. 서버 응답을 받은 뒤에만 호출한다.
function FeedController.pushOutcome(outcome: string)
	local language = ClientState.getLanguage()
	local npc = Locale.get(language, "npc.anvilElder.name")

	local variants = Locale.variantCount(language, `feed.{outcome}`)
	local key = if variants > 0
		then `feed.{outcome}.{math.random(1, variants)}`
		else `feed.{outcome}.1`

	push(`{npc}: {Locale.get(language, key)}`, OUTCOME_COLOR[outcome] or Color3.new(1, 1, 1))
end

function FeedController.pushRaw(text: string, color: Color3?)
	push(text, color or Color3.new(1, 1, 1))
end

function FeedController.Init()
	build()

	local button = toggleButton
	if button then
		button.Text = Locale.get(ClientState.getLanguage(), "ui.feedToggle")
	end
end

function FeedController.Start()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	local feedRemote = remotesFolder:WaitForChild(Remotes.Events.FeedMessage) :: RemoteEvent

	feedRemote.OnClientEvent:Connect(function(payload: any)
		if type(payload) ~= "table" then
			return
		end

		if payload.kind == "broadcast" then
			local language = ClientState.getLanguage()
			local text = Locale.get(
				language,
				"feed.broadcast",
				tostring(payload.playerName),
				Locale.get(language, tostring(payload.weaponKey)),
				tonumber(payload.level) or 0
			)
			push(text, OUTCOME_COLOR.broadcast)
			displayInChat(text)
		elseif payload.kind == "system" and type(payload.text) == "string" then
			-- 채팅 명령어의 응답. 채팅창과 피드 양쪽에 남긴다.
			push(payload.text, OUTCOME_COLOR.system)
			displayInChat(payload.text)
		end
	end)
end

return FeedController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">OddsTableController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	OddsTableController — 확률표 화면.

	강화 화면에서 언제든 열 수 있어야 한다(지시서 7절: 확률표는 상품 여부와
	관계없이 항상 열람 가능). 표시하는 값은 shared/Config/EnhanceTable 그대로다.

	이벤트 버프가 적용 중이면 상단에 배너로 알려 주고, 실제 적용된 최종 확률은
	강화 화면(서버가 내려 준 값)에서 확인하도록 안내한다.
]]

local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))
local EnhanceTable = require(Shared:WaitForChild("Config"):WaitForChild("EnhanceTable"))

local ClientState = require(script.Parent.Parent:WaitForChild("ClientState"))

local OddsTableController = {}
OddsTableController.Name = "OddsTableController"

local COLOR_PANEL = Color3.fromRGB(34, 30, 38)
local COLOR_ROW = Color3.fromRGB(44, 39, 50)
local COLOR_ROW_CURRENT = Color3.fromRGB(78, 58, 34)
local COLOR_TEXT = Color3.fromRGB(240, 236, 230)
local COLOR_MUTED = Color3.fromRGB(168, 160, 172)
local COLOR_ACCENT = Color3.fromRGB(226, 142, 58)

local ROW_HEIGHT = 26
local COLUMN_WIDTHS = { 0.13, 0.17, 0.17, 0.17, 0.18, 0.18 }

local gui: ScreenGui
local panel: Frame
local scroller: ScrollingFrame
local titleLabel: TextLabel
local eventLabel: TextLabel
local closeButton: TextButton
local rows: { [number]: Frame } = {}

local function makeCell(parent: Instance, index: number, text: string, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 13
	label.TextColor3 = color
	label.Text = text
	label.Size = UDim2.new(COLUMN_WIDTHS[index], 0, 1, 0)
	label.LayoutOrder = index
	label.Parent = parent
	return label
end

local function makeRow(parent: Instance, order: number): Frame
	local row = Instance.new("Frame")
	row.BackgroundColor3 = COLOR_ROW
	row.BackgroundTransparency = 0.4
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 0, ROW_HEIGHT)
	row.LayoutOrder = order
	row.Parent = parent

	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Horizontal
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.Parent = row

	return row
end

local function build()
	local player = Players.LocalPlayer

	gui = Instance.new("ScreenGui")
	gui.Name = "ForgeOddsTable"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 10
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local dim = Instance.new("TextButton")
	dim.Name = "Dim"
	dim.BackgroundColor3 = Color3.new(0, 0, 0)
	dim.BackgroundTransparency = 0.45
	dim.BorderSizePixel = 0
	dim.Size = UDim2.fromScale(1, 1)
	dim.Text = ""
	dim.AutoButtonColor = false
	dim.Parent = gui

	panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.BackgroundColor3 = COLOR_PANEL
	panel.BorderSizePixel = 0
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.new(0.92, 0, 0.8, 0)
	panel.Parent = gui

	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MaxSize = Vector2.new(520, 640)
	sizeConstraint.Parent = panel

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = panel

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 14)
	padding.PaddingBottom = UDim.new(0, 14)
	padding.PaddingLeft = UDim.new(0, 14)
	padding.PaddingRight = UDim.new(0, 14)
	padding.Parent = panel

	titleLabel = Instance.new("TextLabel")
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextSize = 20
	titleLabel.TextColor3 = COLOR_TEXT
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Size = UDim2.new(1, -80, 0, 28)
	titleLabel.Position = UDim2.fromOffset(0, 0)
	titleLabel.Parent = panel

	closeButton = Instance.new("TextButton")
	closeButton.BackgroundColor3 = COLOR_ROW
	closeButton.BorderSizePixel = 0
	closeButton.Font = Enum.Font.GothamBold
	closeButton.TextSize = 14
	closeButton.TextColor3 = COLOR_TEXT
	closeButton.AnchorPoint = Vector2.new(1, 0)
	closeButton.Position = UDim2.new(1, 0, 0, 0)
	closeButton.Size = UDim2.fromOffset(72, 44) -- 최소 터치 영역 확보
	closeButton.Parent = panel

	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 8)
	closeCorner.Parent = closeButton

	eventLabel = Instance.new("TextLabel")
	eventLabel.BackgroundTransparency = 1
	eventLabel.Font = Enum.Font.GothamMedium
	eventLabel.TextSize = 13
	eventLabel.TextColor3 = Color3.fromRGB(140, 210, 255)
	eventLabel.TextXAlignment = Enum.TextXAlignment.Left
	eventLabel.Size = UDim2.new(1, 0, 0, 18)
	eventLabel.Position = UDim2.fromOffset(0, 32)
	eventLabel.Visible = false
	eventLabel.Parent = panel

	-- 헤더
	local header = Instance.new("Frame")
	header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0, ROW_HEIGHT)
	header.Position = UDim2.fromOffset(0, 54)
	header.Parent = panel

	local headerList = Instance.new("UIListLayout")
	headerList.FillDirection = Enum.FillDirection.Horizontal
	headerList.SortOrder = Enum.SortOrder.LayoutOrder
	headerList.VerticalAlignment = Enum.VerticalAlignment.Center
	headerList.Parent = header

	scroller = Instance.new("ScrollingFrame")
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.Position = UDim2.fromOffset(0, 54 + ROW_HEIGHT + 4)
	scroller.Size = UDim2.new(1, 0, 1, -(54 + ROW_HEIGHT + 4))
	scroller.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroller.ScrollBarThickness = 4
	scroller.Parent = panel

	local scrollList = Instance.new("UIListLayout")
	scrollList.FillDirection = Enum.FillDirection.Vertical
	scrollList.SortOrder = Enum.SortOrder.LayoutOrder
	scrollList.Padding = UDim.new(0, 2)
	scrollList.Parent = scroller

	closeButton.Activated:Connect(function()
		OddsTableController.close()
	end)
	dim.Activated:Connect(function()
		OddsTableController.close()
	end)

	-- 행은 한 번만 만들고 이후에는 텍스트만 갱신한다.
	local language = Locale.DEFAULT_LANGUAGE
	local headers = {
		"ui.column.level",
		"ui.column.success",
		"ui.column.keep",
		"ui.column.destroy",
		"ui.column.cost",
		"ui.column.sell",
	}
	for index, key in headers do
		makeCell(header, index, Locale.get(language, key), COLOR_MUTED)
	end

	for level = 0, EnhanceTable.MAX_LEVEL do
		rows[level] = makeRow(scroller, level + 1)
	end
end

local function refresh()
	local language = ClientState.getLanguage()
	local data = ClientState.getData()
	local currentLevel = if data then data.weapon.level else -1

	titleLabel.Text = Locale.get(language, "ui.oddsTableTitle")
	closeButton.Text = Locale.get(language, "ui.close")

	local odds = ClientState.getOdds()
	if odds and odds.eventName then
		eventLabel.Visible = true
		eventLabel.Text = Locale.get(language, "ui.eventActive", Locale.get(language, odds.eventName))
	else
		eventLabel.Visible = false
	end

	for level = 0, EnhanceTable.MAX_LEVEL do
		local row = rows[level]
		row:ClearAllChildren()

		local list = Instance.new("UIListLayout")
		list.FillDirection = Enum.FillDirection.Horizontal
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.VerticalAlignment = Enum.VerticalAlignment.Center
		list.Parent = row

		local isCurrent = level == currentLevel
		row.BackgroundColor3 = if isCurrent then COLOR_ROW_CURRENT else COLOR_ROW
		local textColor = if isCurrent then COLOR_ACCENT else COLOR_TEXT

		local entry = EnhanceTable.Odds[level]
		makeCell(row, 1, Format.level(level), textColor)

		if entry then
			makeCell(row, 2, Format.percent(entry.success), textColor)
			makeCell(row, 3, Format.percent(entry.keep), COLOR_MUTED)
			makeCell(
				row,
				4,
				Format.percent(entry.destroy),
				if entry.destroy > 0 then Color3.fromRGB(255, 130, 118) else COLOR_MUTED
			)
			makeCell(row, 5, Format.comma(entry.cost), COLOR_MUTED)
		else
			makeCell(row, 2, "-", COLOR_MUTED)
			makeCell(row, 3, "-", COLOR_MUTED)
			makeCell(row, 4, "-", COLOR_MUTED)
			makeCell(row, 5, "-", COLOR_MUTED)
		end

		makeCell(row, 6, Format.comma(EnhanceTable.SellValue[level] or 0), COLOR_MUTED)
	end
end

function OddsTableController.open()
	refresh()
	gui.Enabled = true
end

function OddsTableController.close()
	gui.Enabled = false
end

function OddsTableController.toggle()
	if gui.Enabled then
		OddsTableController.close()
	else
		OddsTableController.open()
	end
end

function OddsTableController.Init()
	build()
end

function OddsTableController.Start()
	ClientState.onChanged(function()
		if gui.Enabled then
			refresh()
		end
	end)
end

return OddsTableController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ShopController — 상점 화면.

	클라이언트는 상품 ID 를 알지 못한다. "이 항목을 사고 싶다"는 키만 서버에 보내고,
	실제 구매창은 서버가 띄운다. 지급도 전부 서버가 한다.

	상품이 아직 등록되지 않았으면(ID 가 0) 서버가 목록에서 빼기 때문에
	여기서는 빈 목록 안내만 띄운다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))

local controllers = script.Parent
local ClientState = require(controllers.Parent:WaitForChild("ClientState"))
local FeedController = require(controllers:WaitForChild("FeedController"))

local ShopController = {}
ShopController.Name = "ShopController"

local COLOR_PANEL = Color3.fromRGB(34, 30, 38)
local COLOR_SUB = Color3.fromRGB(52, 46, 58)
local COLOR_TEXT = Color3.fromRGB(240, 236, 230)
local COLOR_MUTED = Color3.fromRGB(168, 160, 172)
local COLOR_ACCENT = Color3.fromRGB(226, 142, 58)

local TOUCH_MIN = 44

local gui: ScreenGui
local panel: Frame
local titleLabel: TextLabel
local noticeLabel: TextLabel
local scroller: ScrollingFrame
local closeButton: TextButton

local itemsRemote: RemoteFunction
local promptRemote: RemoteFunction

local function makeButton(parent: Instance, props: { [string]: any }): TextButton
	local button = Instance.new("TextButton")
	button.BackgroundColor3 = COLOR_SUB
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamMedium
	button.TextColor3 = COLOR_TEXT
	button.TextSize = 15
	button.Size = UDim2.new(1, 0, 0, TOUCH_MIN)
	button.Text = ""
	for key, value in props do
		(button :: any)[key] = value
	end
	button.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = button

	return button
end

-- 상품 한 줄에 쓸 이름. 지급량이 있는 상품은 수량을 함께 보여 준다.
local function itemLabel(language: string, item: any): string
	if item.goldAmount > 0 then
		return Locale.get(language, `shop.{item.key}`, Format.comma(item.goldAmount))
	end
	if item.ticketAmount > 0 then
		return Locale.get(language, `shop.{item.key}`, item.ticketAmount)
	end
	return Locale.get(language, `shop.{item.key}`)
end

local function refresh()
	local language = ClientState.getLanguage()

	titleLabel.Text = Locale.get(language, "ui.shopTitle")
	noticeLabel.Text = Locale.get(language, "shop.notice")
	closeButton.Text = Locale.get(language, "ui.close")

	for _, child in scroller:GetChildren() do
		if child:IsA("TextButton") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	local ok, items = pcall(function()
		return itemsRemote:InvokeServer()
	end)

	if not ok or type(items) ~= "table" or #items == 0 then
		local empty = Instance.new("TextLabel")
		empty.BackgroundTransparency = 1
		empty.Font = Enum.Font.GothamMedium
		empty.TextSize = 15
		empty.TextColor3 = COLOR_MUTED
		empty.TextWrapped = true
		empty.Size = UDim2.new(1, 0, 0, 40)
		empty.Text = Locale.get(language, "ui.shopEmpty")
		empty.Parent = scroller
		return
	end

	for index, item in items do
		local text = itemLabel(language, item)
		if item.owned then
			text ..= `  ({Locale.get(language, "ui.owned")})`
		end

		local row = makeButton(scroller, {
			Text = text,
			LayoutOrder = index,
			TextColor3 = if item.owned then COLOR_MUTED else COLOR_TEXT,
		})

		if not item.owned then
			row.Activated:Connect(function()
				task.spawn(function()
					local success, response = pcall(function()
						return promptRemote:InvokeServer(item.kind, item.key)
					end)

					if success and type(response) == "table" and response.ok ~= true then
						FeedController.pushRaw(
							Locale.get(language, `error.{tostring(response.reason)}`),
							COLOR_ACCENT
						)
					end
				end)
			end)
		end
	end
end

local function build()
	local player = Players.LocalPlayer

	gui = Instance.new("ScreenGui")
	gui.Name = "ForgeShop"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 15
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local dim = Instance.new("TextButton")
	dim.BackgroundColor3 = Color3.new(0, 0, 0)
	dim.BackgroundTransparency = 0.45
	dim.BorderSizePixel = 0
	dim.Size = UDim2.fromScale(1, 1)
	dim.Text = ""
	dim.AutoButtonColor = false
	dim.Parent = gui

	panel = Instance.new("Frame")
	panel.BackgroundColor3 = COLOR_PANEL
	panel.BorderSizePixel = 0
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.new(0.9, 0, 0.72, 0)
	panel.Parent = gui

	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MaxSize = Vector2.new(460, 560)
	sizeConstraint.Parent = panel

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = panel

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 16)
	padding.PaddingBottom = UDim.new(0, 16)
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 16)
	padding.Parent = panel

	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 8)
	list.Parent = panel

	titleLabel = Instance.new("TextLabel")
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextSize = 20
	titleLabel.TextColor3 = COLOR_TEXT
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Size = UDim2.new(1, 0, 0, 28)
	titleLabel.LayoutOrder = 1
	titleLabel.Parent = panel

	scroller = Instance.new("ScrollingFrame")
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.Size = UDim2.new(1, 0, 1, -140)
	scroller.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroller.ScrollBarThickness = 4
	scroller.LayoutOrder = 2
	scroller.Parent = panel

	local scrollList = Instance.new("UIListLayout")
	scrollList.FillDirection = Enum.FillDirection.Vertical
	scrollList.SortOrder = Enum.SortOrder.LayoutOrder
	scrollList.Padding = UDim.new(0, 6)
	scrollList.Parent = scroller

	noticeLabel = Instance.new("TextLabel")
	noticeLabel.BackgroundTransparency = 1
	noticeLabel.Font = Enum.Font.GothamMedium
	noticeLabel.TextSize = 12
	noticeLabel.TextColor3 = COLOR_MUTED
	noticeLabel.TextWrapped = true
	noticeLabel.TextXAlignment = Enum.TextXAlignment.Left
	noticeLabel.Size = UDim2.new(1, 0, 0, 36)
	noticeLabel.LayoutOrder = 3
	noticeLabel.Parent = panel

	closeButton = makeButton(panel, { LayoutOrder = 4 })
	closeButton.Activated:Connect(function()
		gui.Enabled = false
	end)
	dim.Activated:Connect(function()
		gui.Enabled = false
	end)
end

function ShopController.toggle()
	if gui.Enabled then
		gui.Enabled = false
		return
	end

	gui.Enabled = true
	task.spawn(refresh)
end

function ShopController.Init()
	build()

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	itemsRemote = remotesFolder:WaitForChild(Remotes.Functions.GetShopItems) :: RemoteFunction
	promptRemote = remotesFolder:WaitForChild(Remotes.Functions.PromptPurchase) :: RemoteFunction
end

function ShopController.Start() end

return ShopController
]]></string>
