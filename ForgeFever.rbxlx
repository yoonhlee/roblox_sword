		["error.unknown"] = "Something went wrong.",
		["error.load_fail"] = "Could not load your data. Please rejoin.",
		["error.session_end"] = "Your data was opened on another server. Please rejoin.",
	},
} :: { [string]: { [string]: string } }

--[[
	키를 해당 언어의 문자열로 바꾼다.
	해당 언어에 키가 없으면 기본 언어로, 그것도 없으면 키 자체를 돌려준다
	(빈 화면 대신 무엇이 빠졌는지 보이도록).
]]
function Locale.get(language: string?, key: string, ...: any): string
	local lang = language or Locale.DEFAULT_LANGUAGE
	local table_ = Locale.Strings[lang] or Locale.Strings[Locale.DEFAULT_LANGUAGE]
	local template = table_[key] or Locale.Strings[Locale.DEFAULT_LANGUAGE][key]

	if not template then
		return key
	end

	if select("#", ...) == 0 then
		return template
	end

	local ok, formatted = pcall(string.format, template, ...)
	return if ok then formatted else template
end

-- 같은 접두사를 가진 변형 중 하나를 고른다. (예: "feed.success" → feed.success.1~3)
-- 연출용 문구 선택이라 클라이언트에서 뽑아도 되는 값이다.
function Locale.variantCount(language: string?, prefix: string): number
	local lang = language or Locale.DEFAULT_LANGUAGE
	local table_ = Locale.Strings[lang] or Locale.Strings[Locale.DEFAULT_LANGUAGE]

	local count = 0
	while table_[`{prefix}.{count + 1}`] ~= nil do
		count += 1
	end
	return count
end

return Locale
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Pure</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">DataMigration</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataMigration — 저장된 플레이어 데이터를 현재 스키마로 올리는 순수 함수.

	Roblox API 와 require 가 없어서 Studio 밖에서 테스트할 수 있다.
	필요한 상수는 options 로 받는다.

	규칙: 기존 데이터를 절대 버리지 않는다. 형태가 바뀐 값은 "옮기기"만 하고,
	기획에서 빠진 필드(배틀·업적 기록, 옛 weapon)는 그대로 둔다.

	ProfileStore 의 Reconcile() 이 먼저 돌아서 템플릿의 새 키는 이미 채워져 있다고
	보지만, 순서에 기대지 않도록 여기서도 없는 값은 채운다.
]]

local DataMigration = {}

export type Options = {
	schemaVersion: number, -- 코드가 아는 최신 버전
	purchaseHistoryLimit: number,
	defaultWeaponId: string,
	maxLevel: number,
	isKnownWeapon: (id: string) -> boolean,
}

local function toLevel(value: any, maxLevel: number): number
	local number = tonumber(value) or 0
	if number ~= number then -- NaN
		number = 0
	end
	return math.clamp(math.floor(number), 0, maxLevel)
end

--[[
	데이터가 게임이 기대하는 최소 조건을 만족하게 고친다. 여러 번 불러도 결과가 같다.
	  - 검이 하나도 없으면 기본 검을 준다
	  - 검마다 레벨·최고 레벨이 올바른 범위의 정수다
	  - 착용 검은 반드시 가진 검이다
	  - 소지 상한은 가진 검 수보다 작지 않다
]]
function DataMigration.repair(data: any, options: Options)
	if type(data.swords) ~= "table" then
		data.swords = {}
	end

	local count = 0
	for id, sword in data.swords do
		if type(id) ~= "string" or type(sword) ~= "table" then
			continue
		end

		sword.id = id
		sword.level = toLevel(sword.level, options.maxLevel)
		sword.bestLevel = math.max(toLevel(sword.bestLevel, options.maxLevel), sword.level)
		if sword.customName ~= nil and type(sword.customName) ~= "string" then
			sword.customName = nil
		end
		count += 1
	end

	if count == 0 then
		data.swords[options.defaultWeaponId] = {
			id = options.defaultWeaponId,
			level = 0,
			bestLevel = 0,
		}
		count = 1
	end

	if type(data.equippedId) ~= "string" or data.swords[data.equippedId] == nil then
		if data.swords[options.defaultWeaponId] ~= nil then
			data.equippedId = options.defaultWeaponId
		else
			-- 기본 검이 없는 드문 경우: 이름순으로 첫 검
			local ids: { string } = {}
			for id in data.swords do
				table.insert(ids, id)
			end
			table.sort(ids)
			data.equippedId = ids[1]
		end
	end

	local capacity = tonumber(data.swordCapacity) or 0
	data.swordCapacity = math.max(math.floor(capacity), count)

	local pity = tonumber(data.pityPoints) or 0
	data.pityPoints = math.max(0, math.floor(pity))
end

--[[
	저장된 데이터를 현재 스키마로 올린다. data 를 직접 고치고 그대로 돌려준다.
	두 번째 반환값은 "코드보다 새 버전으로 저장된 데이터"일 때 true 다(건드리지 않는다).
]]
function DataMigration.migrate(data: any, options: Options): (any, boolean)
	if data.schemaVersion == nil then
		data.schemaVersion = 1
	end

	if data.schemaVersion > options.schemaVersion then
		-- 더 새로운 버전으로 저장된 데이터. 덮어쓰면 손실이 나므로 건드리지 않는다.
		return data, true
	end

	-- v1 → v2: purchaseHistory 를 딕셔너리에서 배열로 옮긴다.
	-- (배열이어야 오래된 기록부터 버려 크기를 일정하게 유지할 수 있다)
	if data.schemaVersion == 1 then
		local history = data.purchaseHistory
		local migrated: { string } = {}

		if type(history) == "table" then
			for key, value in history do
				if type(key) == "string" and value == true then
					table.insert(migrated, key)
				elseif type(value) == "string" then
					table.insert(migrated, value) -- 이미 배열인 경우
				end
			end
		end

		while #migrated > options.purchaseHistoryLimit do
			table.remove(migrated, 1)
		end

		data.purchaseHistory = migrated
		data.schemaVersion = 2
	end

	-- v2 → v3: 업적 판정에 쓰던 통계를 추가했다. (업적은 지금 쓰지 않지만 필드는 남긴다)
	if data.schemaVersion == 2 then
		if type(data.stats) ~= "table" then
			data.stats = {}
		end
		data.stats.keepStreak = data.stats.keepStreak or 0
		data.stats.bestKeepStreak = data.stats.bestKeepStreak or 0
		data.stats.ticketsUsed = data.stats.ticketsUsed or 0
		data.schemaVersion = 3
	end

	-- v3 → v4: 무기 하나(weapon) → 검 여러 개(swords).
	-- 기존 weapon 을 첫 번째 검으로 옮기고 그 검을 착용한다. weapon 필드는 지우지 않는다.
	if data.schemaVersion == 3 then
		local old = data.weapon
		local swords: { [string]: any } = {}

		if type(old) == "table" then
			local id = options.defaultWeaponId
			if type(old.id) == "string" and options.isKnownWeapon(old.id) then
				id = old.id
			end

			local level = toLevel(old.level, options.maxLevel)
			-- v3 까지는 무기가 하나뿐이었으므로 "역대 최고 레벨"이 곧 이 검의 최고 레벨이다.
			local highest = if type(data.stats) == "table" then data.stats.highestLevel else 0

			swords[id] = {
				id = id,
				level = level,
				bestLevel = math.max(level, toLevel(highest, options.maxLevel)),
				customName = if type(old.customName) == "string" then old.customName else nil,
			}
			data.equippedId = id
		end

		data.swords = swords
		data.swordCapacity = 1
		data.pityPoints = 0
		data.schemaVersion = 4
	end

	DataMigration.repair(data, options)

	return data, false
end

return DataMigration
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">DrawLogic</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DrawLogic — 방지권 뽑기의 순수 함수 (통합 기획서 3-4절, 7절).

	두 가지 뽑기가 같은 함수를 쓴다.
	  - 확률형 상품 (Robux): 꽝이면 천장 포인트 +1, 다 차면 방지권을 주고 0 으로 → resolvePaid
	  - 파편 뽑기 (무과금): 천장 포인트 없음 → resolveFree

	Roblox API 와 require 가 없다. 결과 목록과 천장 규칙은 인자로 받는다(Config/Products).
	난수는 서버가 만든 [0, 1) 값을 넘겨받는다. 이 모듈은 난수를 만들지 않는다.

	화면에 보여 주는 %는 Pure/SwordLogic.exactPercents(DrawLogic.weights(결과 목록), 자릿수) 로 만든다
	(합이 정확히 100 이 된다). 실제 추첨은 반올림한 %가 아니라 원래 weight 로 한다.
]]

local DrawLogic = {}

export type Outcome = {
	tickets: number, -- 0 이면 꽝
	weight: number,
}

export type FreeResult = {
	index: number, -- 뽑힌 결과의 순번
	tickets: number,
}

export type PaidResult = {
	index: number,
	rolledTickets: number, -- 뽑기 자체로 나온 방지권 수 (꽝이면 0)
	isMiss: boolean,
	pityTickets: number, -- 천장 포인트가 차서 받은 방지권 수 (없으면 0)
	totalTickets: number, -- 실제로 지급할 방지권 수
	pityAfter: number, -- 처리 후 천장 포인트
}

-- 결과 목록의 비중만 뽑아낸다 (% 계산에 넘기는 모양).
function DrawLogic.weights(outcomes: { Outcome }): { number }
	local list: { number } = {}
	for index, outcome in outcomes do
		list[index] = math.max(0, outcome.weight)
	end
	return list
end

--[[
	뽑기 1회. unitRoll 은 [0, 1) 난수. 뽑을 것이 없으면 nil.
	구간은 목록 순서대로 붙어 있다.
]]
function DrawLogic.pick(outcomes: { Outcome }, unitRoll: number): number?
	local total = 0
	for _, outcome in outcomes do
		total += math.max(0, outcome.weight)
	end

	if #outcomes == 0 or total <= 0 then
		return nil
	end

	local target = math.clamp(unitRoll, 0, 1) * total
	local running = 0
	local last = 0

	for index, outcome in outcomes do
		local weight = math.max(0, outcome.weight)
		if weight > 0 then
			running += weight
			last = index
			if target < running then
				return index
			end
		end
	end

	return last
end

--[[
	꽝 한 번을 천장 포인트에 반영한다.
	반환: (처리 후 포인트, 이번에 받는 방지권 수)
	포인트가 threshold 에 닿으면 그 자리에서 방지권을 주고 0 으로 돌아간다.
]]
function DrawLogic.applyMiss(
	pityPoints: number,
	perMiss: number,
	threshold: number,
	pityTickets: number
): (number, number)
	local points = math.max(0, math.floor(pityPoints)) + perMiss

	if threshold > 0 and points >= threshold then
		return 0, pityTickets
	end
	return points, 0
end

-- 다음 꽝에서 천장이 차는 상태인지 (상점이 꽝 줄의 설명을 바꿔 보여 주는 데 쓴다)
function DrawLogic.isPityNext(pityPoints: number, perMiss: number, threshold: number): boolean
	return threshold > 0 and math.max(0, math.floor(pityPoints)) + perMiss >= threshold
end

-- 파편 뽑기 1회 (천장 포인트 없음)
function DrawLogic.resolveFree(outcomes: { Outcome }, unitRoll: number): FreeResult?
	local index = DrawLogic.pick(outcomes, unitRoll)
	if index == nil then
		return nil
	end

	return {
		index = index,
		tickets = math.max(0, math.floor(outcomes[index].tickets)),
	}
end

-- 확률형 상품 1회 (꽝이면 천장 포인트)
function DrawLogic.resolvePaid(
	outcomes: { Outcome },
	unitRoll: number,
	pityPoints: number,
	perMiss: number,
	threshold: number,
	pityTickets: number
): PaidResult?
	local index = DrawLogic.pick(outcomes, unitRoll)
	if index == nil then
		return nil
	end

	local rolled = math.max(0, math.floor(outcomes[index].tickets))
	local isMiss = rolled == 0

	local pityAfter = math.max(0, math.floor(pityPoints))
	local bonus = 0
	if isMiss then
		pityAfter, bonus = DrawLogic.applyMiss(pityPoints, perMiss, threshold, pityTickets)
	end

	return {
		index = index,
		rolledTickets = rolled,
		isMiss = isMiss,
		pityTickets = bonus,
		totalTickets = rolled + bonus,
		pityAfter = pityAfter,
	}
end

return DrawLogic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">EnhanceLogic</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EnhanceLogic — 강화 결과 계산의 순수 함수.

	원칙:
	- Roblox API, 전역 상태, 다른 모듈에 대한 require 가 전혀 없다.
	  (그래서 Studio 밖에서 그대로 테스트할 수 있다)
	- 난수는 서버가 만든 Random 객체에서 뽑아 숫자로 넘겨받는다.
	  이 모듈은 난수를 직접 만들지 않는다 → 테스트에서 모든 분기를 재현할 수 있다.
	- 확률표와 비용 상수도 인자로 받는다. 밸런스 데이터는 Config/EnhanceTable 에만 있다.

	결과 네 가지:
	  success    레벨 +1
	  keep       그대로
	  fail       2구간에서만. 안전 레벨(10강)로 돌아가고 파편을 받는다
	  protected  실패가 나왔지만 방지권이 막았다. 그대로, 방지권 1개 소모
]]

local EnhanceLogic = {}

export type Odds = {
	success: number, -- 퍼센트
	keep: number,
	fail: number,
}

export type Outcome = "success" | "keep" | "fail" | "protected"

export type ResolveParams = {
	level: number, -- 현재 강화 레벨 (호출 전에 level < maxLevel 임을 보장할 것)
	maxLevel: number,
	safeLevel: number, -- 실패했을 때 돌아가는 레벨
	odds: Odds, -- 버프까지 반영된 최종 확률 (방지권 표시용 변환은 넣지 않는다)
	roll: number, -- [0, 100) 구간의 난수
	useProtect: boolean, -- 플레이어가 방지권 사용을 켜 두었는지
	protectTickets: number, -- 보유 방지권 수
	shardsOnFail: number, -- 실패했을 때 줄 파편 수
}

export type ResolveResult = {
	outcome: Outcome,
	newLevel: number,
	shardsGained: number,
	ticketsUsed: number,
}

--[[
	레벨 level 에서 level+1 로 강화하는 1회 비용 (정수 골드, 소수는 반올림).
	    base × (1 + 2^level) × swordCount^exponent
	검이 1개면 정확히 base × (1 + 2^level) 이다.
]]
function EnhanceLogic.cost(
	level: number,
	swordCount: number,
	base: number,
	exponent: number
): number
	local count = math.max(1, swordCount)
	return math.floor(base * (1 + 2 ^ level) * count ^ exponent + 0.5)
end

--[[
	확률 버프 이벤트를 적용한다.
	성공 확률에 +bonus %p 를 더하고 그만큼 유지 확률에서만 뺀다.
	실패 확률은 절대 건드리지 않는다. 유지가 모자라면 더할 수 있는 만큼만 더한다.
]]
function EnhanceLogic.applyBuff(base: Odds, bonus: number): Odds
	local add = math.clamp(bonus, 0, base.keep)

	return {
		success = base.success + add,
		keep = base.keep - add,
		fail = base.fail,
	}
end

--[[
	방지권이 켜져 있을 때 화면에 보여 줄 확률.
	실패가 유지로 바뀌므로 실패 0, 유지 = 유지 + 실패 가 된다.
	(실제 판정은 resolve 가 한다. 이 함수는 같은 결과를 숫자로 보여 주기 위한 것이다.)
]]
function EnhanceLogic.applyProtect(odds: Odds): Odds
	return {
		success = odds.success,
		keep = odds.keep + odds.fail,
		fail = 0,
	}
end

--[[
	난수 하나를 결과로 바꾼다.
	roll 은 [0, 100) 이어야 한다. 구간은 [성공)[유지)[실패) 순서로 붙어 있다.
]]
function EnhanceLogic.roll(odds: Odds, roll: number): "success" | "keep" | "fail"
	if roll < odds.success then
		return "success"
	elseif roll < odds.success + odds.keep then
		return "keep"
	end
	return "fail"
end

-- 실패 시 지급되는 파편 수 = floor(실패한 레벨 ^ exponent)
function EnhanceLogic.shardsFor(level: number, exponent: number): number
	if level <= 0 then
		return 0
	end
	return math.floor(level ^ exponent)
end

--[[
	강화 1회의 최종 결과.

	방지권은 "실패가 실제로 나왔을 때"만 소모된다.
	실패 확률이 0인 1구간에서는 실패가 나올 수 없으므로 방지권도 소모되지 않는다.
]]
function EnhanceLogic.resolve(params: ResolveParams): ResolveResult
	local raw = EnhanceLogic.roll(params.odds, params.roll)

	if raw == "success" then
		return {
			outcome = "success",
			newLevel = math.min(params.level + 1, params.maxLevel),
			shardsGained = 0,
			ticketsUsed = 0,
		}
	elseif raw == "keep" then
		return {
			outcome = "keep",
			newLevel = params.level,
			shardsGained = 0,
			ticketsUsed = 0,
		}
	end

	-- 실패가 나왔다. 방지권이 있고 사용 설정이 켜져 있으면 유지로 바꾼다.
	if params.useProtect and params.protectTickets > 0 then
		return {
			outcome = "protected",
			newLevel = params.level,
			shardsGained = 0,
			ticketsUsed = 1,
		}
	end

	return {
		outcome = "fail",
		-- 안전 레벨 아래에서 실패가 나오는 표는 없지만, 그래도 레벨이 오르는 일은 없게 한다.
		newLevel = math.min(params.level, params.safeLevel),
		shardsGained = math.max(0, math.floor(params.shardsOnFail)),
		ticketsUsed = 0,
	}
end

return EnhanceLogic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Format — 표시용 문자열 포맷터. Roblox API 를 전혀 쓰지 않으므로
	Lune(또는 순수 Luau)에서 그대로 테스트할 수 있다.

	여기 있는 함수는 숫자/기호만 다룬다. 사람이 읽는 문장은
	LocalizationTable 이 담당한다.
]]

local Format = {}

-- 1234567 → "1,234,567" (소수는 반올림, 음수는 부호 유지)
function Format.comma(value: number): string
	local negative = value < 0
	local whole = tostring(math.floor(math.abs(value) + 0.5))

	local chunked = (whole:reverse():gsub("(%d%d%d)", "%1,")):reverse()
	if chunked:sub(1, 1) == "," then
		chunked = chunked:sub(2)
	end

	if negative and chunked ~= "0" then
		return "-" .. chunked
	end
	return chunked
end

-- 12.5 → "12.5%" / 20 → "20%"  (decimals 기본 1자리, 정수면 소수점 생략)
function Format.percent(value: number, decimals: number?): string
	local places = decimals or 1
	local rounded = math.floor(value * 10 ^ places + 0.5) / 10 ^ places

	if rounded == math.floor(rounded) then
		return string.format("%d%%", rounded)
	end
	return string.format("%." .. places .. "f%%", rounded)
end

-- 7 → "+7" / 0 → "+0"  (강화 레벨 표기)
function Format.level(level: number): string
	return string.format("+%d", level)
end

-- 65 → "1:05", 3725 → "1:02:05"
function Format.duration(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	local hours = total // 3600
	local minutes = (total % 3600) // 60
	local secs = total % 60

	if hours > 0 then
		return string.format("%d:%02d:%02d", hours, minutes, secs)
	end
	return string.format("%d:%02d", minutes, secs)
end

--[[
	큰 숫자를 줄여 쓴다 (화면 공간이 좁은 곳: 재화 칩, 보상 표시).
	  한국어: 9,999 까지 그대로, 1.2만 · 123만 · 1.2억 · 4.9억 · 1.2조
	  영어:   999 까지 그대로, 1.2K · 120K · 1.2M · 1.05B · 1.2T
	소수는 한 자리(영어 B·T 는 두 자리까지), 끝의 0 은 뗀다. 음수는 부호를 붙인다.
]]
local KO_UNITS = { { 1e12, "조" }, { 1e8, "억" }, { 1e4, "만" } }
local EN_UNITS = { { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }

local function trimNumber(value: number, decimals: number): string
	local scale = 10 ^ decimals
	local rounded = math.floor(value * scale + 0.5) / scale
	local text = string.format("%." .. decimals .. "f", rounded)
	if string.find(text, "%.") then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return text
end

function Format.short(value: number, language: string?): string
	local negative = value < 0
	local amount = math.abs(value)
	local isEnglish = language == "en"
	local units = if isEnglish then EN_UNITS else KO_UNITS
	local step = if isEnglish then 1e3 else 1e4 -- 한 단위가 다음 단위가 되는 배수

	local text: string? = nil
	for index, unit in units do
		local size, suffix = unit[1], unit[2]
		if amount < size then
			continue
		end

		local scaled = amount / size
		local decimals = if scaled >= 100 then 0 elseif isEnglish and size >= 1e9 then 2 else 1
		local shown = trimNumber(scaled, decimals)

		-- 반올림해서 한 단위가 꽉 차면(예: 9,999.99만 → 10000만) 바로 위 단위로 쓴다.
		local larger = units[index - 1]
		if larger ~= nil and (tonumber(shown) or 0) >= step then
			shown = trimNumber(amount / larger[1], 1)
			suffix = larger[2]
		end

		text = shown .. suffix
		break
	end

	local result = text or Format.comma(amount)
	if negative and result ~= "0" then
		return "-" .. result
	end
	return result
end

-- 확률 막대나 로그에 쓰는 짧은 비율 표기. 0.25 → "25%"
function Format.ratio(ratio: number, decimals: number?): string
	return Format.percent(ratio * 100, decimals)
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">RaceLogic</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RaceLogic — 추격 생존 경주의 순수 함수 (통합 기획서 4절).

	Roblox API 와 require 가 없다. 수치는 전부 인자로 받는다(Config/RaceConfig).
	서버(RaceService)가 실제 판정에 쓰고, 클라이언트는 같은 함수로 "최대 거리·최대 보상"을 보여 준다.

	기호 (기획서와 같다):
	  T(L)    그 레벨이 방해 없이 쉬지 않고 달렸을 때 잡히는 시간
	  C(t)    추격자가 t 초 동안 움직인 거리 = c0 / k × (e^(k·t) − 1)
	  H       출발할 때 추격자가 뒤처진 거리
	  Dmax(L) = C(T(L)) − H   그 레벨의 최대 거리
	  v(L)    = Dmax(L) / T(L) 그 레벨의 이동 속도
	위치는 전부 "출발선에서 앞쪽으로 몇 칸"이다. 추격자는 −H 에서 출발한다.
]]

local RaceLogic = {}

export type Curve = {
	minTime: number, -- T(0) = T(1)
	maxTime: number, -- T(maxLevel)
	maxLevel: number,
	accel: number, -- k
	headStart: number, -- H
	baseSpeed: number, -- v(1)
}

export type MultiplierConfig = {
	tier1Base: number,
	tier1Span: number,
	tier1Divisor: number,
	tier2Start: number,
	tier2Base: number,
	tier2Growth: number,
	tier2Span: number,
}

export type CourseConfig = {
	trackWidth: number,
	lengthMargin: number,
	extraLength: number,
	minLength: number,
	firstObstacleAt: number,
	minSpacing: number,
	maxSpacing: number,
	endMargin: number,
	blockMinWidth: number,
	blockMaxWidth: number,
	gateGap: number,
	weightBlock: number,
	weightHurdle: number,
	weightGate: number,
	lineupWidth: number,
	lineupMaxSpacing: number,
}

--[[
	장애물 한 줄.
	  block   폭 width 의 기둥. x 는 기둥의 중심. 옆으로 피한다.
	  hurdle  트랙 전체를 가로지르는 낮은 턱. 뛰어넘는다. (x = 0, width = 트랙 폭)
	  gate    트랙을 막는 벽에 폭 width 의 틈. x 는 틈의 중심.
	x 는 트랙 중심 기준 좌우 위치, z 는 출발선에서 앞쪽 거리.
]]
export type Obstacle = {
	kind: "block" | "hurdle" | "gate",
	z: number,
	x: number,
	width: number,
}

--------------------------------------------------------------------------------
-- 시간 · 거리 · 속도
--------------------------------------------------------------------------------

-- T(L) = minTime + (maxTime − minTime) × (max(L, 1) − 1) / (maxLevel − 1)
function RaceLogic.baseTime(level: number, curve: Curve): number
	if curve.maxLevel <= 1 then
		return curve.minTime
	end

	local effective = math.clamp(level, 1, curve.maxLevel)
	return curve.minTime + (curve.maxTime - curve.minTime) * (effective - 1) / (curve.maxLevel - 1)
end

-- c0: 1강(속도 baseSpeed)이 정확히 minTime 초에 잡히도록 맞춘 추격자의 처음 속도
function RaceLogic.chaserStartSpeed(curve: Curve): number
	local k = curve.accel
	local t1 = curve.minTime
	return (curve.baseSpeed * t1 + curve.headStart) * k / (math.exp(k * t1) - 1)
end

-- C(t): 추격자가 출발 후 elapsed 초 동안 움직인 거리
function RaceLogic.chaserTravel(elapsed: number, curve: Curve): number
	local t = math.max(0, elapsed)
	return RaceLogic.chaserStartSpeed(curve) / curve.accel * (math.exp(curve.accel * t) - 1)
end

-- 추격자의 지금 속도 (화면 표시용)
function RaceLogic.chaserSpeed(elapsed: number, curve: Curve): number
	return RaceLogic.chaserStartSpeed(curve) * math.exp(curve.accel * math.max(0, elapsed))
end

-- 추격자 앞면의 위치 (출발선 기준). 출발 순간 −H.
function RaceLogic.chaserFront(elapsed: number, curve: Curve): number
	return RaceLogic.chaserTravel(elapsed, curve) - curve.headStart
end

-- Dmax(L)
function RaceLogic.maxDistance(level: number, curve: Curve): number
	return RaceLogic.chaserTravel(RaceLogic.baseTime(level, curve), curve) - curve.headStart
end

-- v(L). 모든 검의 기본 능력치는 같으므로 착용 검 레벨로만 정해진다.
function RaceLogic.runSpeed(level: number, curve: Curve): number
	return RaceLogic.maxDistance(level, curve) / RaceLogic.baseTime(level, curve)
end

--------------------------------------------------------------------------------
-- 보상
--------------------------------------------------------------------------------

--[[
	보상 배율 m(L).
	successPercent 는 그 레벨의 "표에 적힌" 강화 성공 확률이다(이벤트 버프를 넣지 않은 값).
	2구간에서는 쓰지 않으므로 아무 값이나 넘겨도 된다.
]]
function RaceLogic.rewardMultiplier(
	level: number,
	successPercent: number,
	config: MultiplierConfig
): number
	if level >= config.tier2Start then
		return config.tier2Base
			* config.tier2Growth ^ ((level - config.tier2Start) / config.tier2Span)
	end
	return config.tier1Base + config.tier1Span * (100 - successPercent) / config.tier1Divisor
end

--[[
	보상 = 그 레벨의 강화 비용(검 1개 기준) × 배율 × min(1, 거리 / 최대 거리). 정수 골드로 반올림.
	costAtLevel 에는 검 수 할증을 넣지 않은 값을 넘긴다(기획서 4-3: 보상에는 할증이 없다).
	거리가 0 이면 보상도 0 이다.
]]
function RaceLogic.reward(
	costAtLevel: number,
	multiplier: number,
	distance: number,
	maxDistance: number
): number
	if maxDistance <= 0 or distance <= 0 or distance ~= distance then
		return 0
	end

	local ratio = math.min(1, distance / maxDistance)
	return math.floor(costAtLevel * multiplier * ratio + 0.5)
end

--------------------------------------------------------------------------------
-- 서버 거리 검증
--------------------------------------------------------------------------------

--[[
	서버가 인정하는 위치.
	observed 는 서버가 본 캐릭터의 위치(출발선 기준)다. 캐릭터 이동은 플레이어 기기가 계산하므로
	속도를 조작하면 이 값이 터무니없이 커질 수 있다. 그래서
	    허용 최대 속도 × 지난 시간 × tolerance + slack
	보다 앞은 인정하지 않는다. 뒤로 가는 것은 그대로 인정한다(추격자에게 잡히는 판정에 쓴다).
	값이 숫자가 아니면(NaN) 가장 뒤에 있는 것으로 본다.
]]
function RaceLogic.effectivePosition(
	observed: number,
	elapsed: number,
	allowedSpeed: number,
	tolerance: number,
	slack: number
): number
	if observed ~= observed then
		return -math.huge
	end

	local cap = math.max(0, elapsed) * math.max(0, allowedSpeed) * tolerance + slack
	return math.min(observed, cap)
end

-- 보상에 쓰는 거리. deadZone 미만은 0 (가만히 서 있으면 0 이어야 한다).
function RaceLogic.creditedDistance(bestPosition: number, deadZone: number): number
	if bestPosition ~= bestPosition or bestPosition < deadZone then
		return 0
	end
	return bestPosition
end

--------------------------------------------------------------------------------
-- 매칭
--------------------------------------------------------------------------------

--[[
	대기열을 닫고 출발선에 세울 때인지.
	  - 대기 인원이 fullCount 이상이면 바로
	  - 아니면 첫 사람이 누른 뒤 (window − lineup) 초가 지났을 때
	    (출발선 카운트다운 lineup 초까지 더해 "누른 뒤 window 초 안에 출발"이 된다)
]]
function RaceLogic.shouldDepart(
	queueCount: number,
	waited: number,
	window: number,
	lineup: number,
	fullCount: number
): boolean
	if queueCount <= 0 then
		return false
	end
	if queueCount >= fullCount then
		return true
	end
	return waited >= window - lineup
end

-- 출발 신호까지 남은 시간(초). 화면 표시용.
function RaceLogic.secondsUntilStart(waited: number, window: number): number
	return math.max(0, window - waited)
end

--[[
	출발선에 설 자리(트랙 중심 기준 좌우 위치). 모두 같은 줄(출발선 위)에 선다.
	간격은 maxSpacing 을 넘지 않고, 사람이 많으면 usableWidth 안에 들어가도록 좁힌다.
]]
function RaceLogic.lineupOffsets(count: number, usableWidth: number, maxSpacing: number): { number }
	local offsets: { number } = {}
	if count <= 0 then
		return offsets
	end
	if count == 1 then
		return { 0 }
	end

	local spacing = math.min(maxSpacing, usableWidth / (count - 1))
	local first = -spacing * (count - 1) / 2

	for index = 1, count do
		offsets[index] = first + spacing * (index - 1)
	end
	return offsets
end

--------------------------------------------------------------------------------
-- 코스
--------------------------------------------------------------------------------

-- 그 판에서 가장 멀리 갈 수 있는 사람의 최대 거리로 코스 길이를 정한다.
function RaceLogic.courseLength(topMaxDistance: number, config: CourseConfig): number
	local wanted = math.ceil(topMaxDistance * config.lengthMargin + config.extraLength)
	return math.max(config.minLength, wanted)
end

--[[
	장애물 줄을 만든다. nextNumber 는 [0, 1) 난수를 주는 함수(서버가 Random 으로 만들어 넘긴다).
	같은 난수 순서를 넣으면 같은 코스가 나온다 → 테스트할 수 있다.
	z 오름차순으로 돌려준다.
]]
function RaceLogic.generateObstacles(
	length: number,
	config: CourseConfig,
	nextNumber: () -> number
): { Obstacle }
	local obstacles: { Obstacle } = {}
	local half = config.trackWidth / 2
	local limit = length - config.endMargin
	local totalWeight = config.weightBlock + config.weightHurdle + config.weightGate

	local function unit(): number
		return math.clamp(nextNumber(), 0, 0.999999)
	end

	local z = config.firstObstacleAt

	while z < limit do
		local pick = unit() * totalWeight

		if totalWeight <= 0 or pick < config.weightBlock then
			local width = config.blockMinWidth
				+ (config.blockMaxWidth - config.blockMinWidth) * unit()
			local range = half - width / 2 -- 중심이 움직일 수 있는 범위
			table.insert(obstacles, {
				kind = "block" :: "block",
				z = z,
				x = (unit() * 2 - 1) * range,
				width = width,
			})
		elseif pick < config.weightBlock + config.weightHurdle then
			table.insert(obstacles, {
				kind = "hurdle" :: "hurdle",
				z = z,
				x = 0,
				width = config.trackWidth,
			})
		else
			local range = half - config.gateGap / 2
			table.insert(obstacles, {
				kind = "gate" :: "gate",
				z = z,
				x = (unit() * 2 - 1) * range,
				width = config.gateGap,
			})
		end

		z += config.minSpacing + (config.maxSpacing - config.minSpacing) * unit()
	end

	return obstacles
end

return RaceLogic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">SwordLogic</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SwordLogic — 검 보관함과 새 검 뽑기의 순수 함수 (통합 기획서 5절).

	Roblox API 와 require 가 없다. 검 목록·등급·가중치는 전부 인자로 받는다.
	서버는 이 함수로 실제 뽑기를 하고, 클라이언트는 같은 함수로 확률표를 그린다.
	(같은 데이터 + 같은 함수라서 화면의 확률과 실제 확률이 어긋날 수 없다.)
]]

local SwordLogic = {}

export type SwordState = {
	id: string,
	level: number,
	bestLevel: number,
	customName: string?,
}

export type DrawEntry = {
	id: string,
	rarity: string,
	weight: number,
	percent: number, -- 화면에 보여 주는 값. 모든 항목의 합이 정확히 100
}

export type RarityShare = {
	rarity: string,
	percent: number,
}

export type DrawTable = {
	entries: { DrawEntry }, -- 아직 안 가진 검만, 주어진 순서대로
	rarities: { RarityShare }, -- 등급별 합계 (항목이 있는 등급만)
	totalWeight: number,
}

-- 확률을 소수 몇째 자리까지 보여 줄지
SwordLogic.PERCENT_DECIMALS = 2

function SwordLogic.count(swords: { [string]: any }): number
	local count = 0
	for _ in swords do
		count += 1
	end
	return count
end

-- 착용 중인 검. 데이터가 깨져 있으면 nil.
function SwordLogic.equipped(swords: { [string]: SwordState }, equippedId: string): SwordState?
	return swords[equippedId]
end

--[[
	소지 상한 1칸 가격 = multiplier × (기준 레벨의 강화 비용, 검 수 할증 포함).
	costAtBaseLevel 에는 EnhanceLogic.cost(15, 지금 가진 검 수, ...) 를 넘긴다.
]]
function SwordLogic.slotPrice(costAtBaseLevel: number, multiplier: number): number
	return math.floor(costAtBaseLevel * multiplier + 0.5)
end

--[[
	가중치를 "합이 정확히 100 인 퍼센트"로 바꾼다.
	그냥 반올림하면 합이 99.99 나 100.01 이 될 수 있어서, 내림한 뒤 남은 몫을
	소수 부분이 큰 순서대로 한 칸씩 나눠 준다.
]]
function SwordLogic.exactPercents(weights: { number }, decimals: number): { number }
	local total = 0
	for _, weight in weights do
		total += weight
	end

	local result: { number } = {}
	if total <= 0 then
		for index in weights do
			result[index] = 0
		end
		return result
	end

	local scale = 10 ^ decimals
	local units = 100 * scale -- 나눠 줄 전체 칸 수

	local floors: { number } = {}
	local order: { number } = {}
	local remainders: { number } = {}
	local used = 0

	for index, weight in weights do
		local exact = weight / total * units
		local whole = math.floor(exact + 1e-9)
		floors[index] = whole
		remainders[index] = exact - whole
		order[index] = index
		used += whole
	end

	table.sort(order, function(a, b)
		if remainders[a] ~= remainders[b] then
			return remainders[a] > remainders[b]
		end
		return a < b
	end)

	local left = math.floor(units - used + 0.5)
	for position = 1, left do
		local index = order[(position - 1) % #order + 1]
		floors[index] += 1
	end

	for index, whole in floors do
		result[index] = whole / scale
	end
	return result
end

--[[
	그 플레이어 기준 뽑기 표를 만든다. 이미 가진 검은 빠진다.
	order: 검 id 를 보여 줄 순서대로. rarityOf: 검 id → 등급. weights: 등급 → 가중치.
]]
function SwordLogic.buildDrawTable(
	order: { string },
	rarityOf: { [string]: string },
	weights: { [string]: number },
	owned: { [string]: any }
): DrawTable
	local entries: { DrawEntry } = {}
	local rawWeights: { number } = {}
	local totalWeight = 0

	for _, id in order do
		if owned[id] == nil then
			local rarity = rarityOf[id]
			local weight = weights[rarity] or 0
			if weight > 0 then
				table.insert(entries, { id = id, rarity = rarity, weight = weight, percent = 0 })
				table.insert(rawWeights, weight)
				totalWeight += weight
			end
		end
	end

	local percents = SwordLogic.exactPercents(rawWeights, SwordLogic.PERCENT_DECIMALS)
	local scale = 10 ^ SwordLogic.PERCENT_DECIMALS

	local rarities: { RarityShare } = {}
	local shareIndex: { [string]: number } = {}

	for index, entry in entries do
		entry.percent = percents[index]

		local position = shareIndex[entry.rarity]
		if position == nil then
			table.insert(rarities, { rarity = entry.rarity, percent = 0 })
			position = #rarities
			shareIndex[entry.rarity] = position
		end

		-- 소수 오차가 쌓이지 않게 정수 칸으로 더한 뒤 되돌린다.
		local share = rarities[position]
		share.percent = math.floor(share.percent * scale + entry.percent * scale + 0.5) / scale
	end

	return { entries = entries, rarities = rarities, totalWeight = totalWeight }
end

--[[
	뽑기 1회. unitRoll 은 [0, 1) 난수. 뽑을 검이 없으면 nil.
	실제 추첨은 반올림한 퍼센트가 아니라 원래 가중치로 한다.
]]
function SwordLogic.pick(drawTable: DrawTable, unitRoll: number): string?
	local entries = drawTable.entries
	if #entries == 0 or drawTable.totalWeight <= 0 then
		return nil
	end

	local target = math.clamp(unitRoll, 0, 1) * drawTable.totalWeight
	local running = 0

	for _, entry in entries do
		running += entry.weight
		if target < running then
			return entry.id
		end
	end

	return entries[#entries].id
end

return SwordLogic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">TreadmillLogic</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TreadmillLogic — 로비 트레드밀의 순수 함수 (통합 기획서 6절).
	Roblox API 와 require 가 없다.
]]

local TreadmillLogic = {}

-- 발판 하나의 자리. 좌표는 발판 중심, topY 는 발판 윗면의 높이.
export type Pad = {
	x: number,
	z: number,
	sizeX: number,
	sizeZ: number,
	topY: number,
	reach: number, -- 윗면에서 이 높이까지 "올라가 있다"로 본다
}

--[[
	발판 위에 있던 시간을 더한다.
	반환: (남은 진행 시간, 이번에 지급할 횟수)
	interval 초를 채울 때마다 1회 지급이다. 한 번에 여러 번 채웠으면 그만큼 준다.
]]
function TreadmillLogic.advance(progress: number, dt: number, interval: number): (number, number)
	if interval <= 0 then
		return 0, 0
	end

	local total = math.max(0, progress) + math.max(0, dt)
	local payouts = math.floor(total / interval + 1e-9)
	local rest = math.max(0, total - payouts * interval)

	return rest, payouts
end

-- 위치 (px, py, pz) 가 발판 위인지. py 는 캐릭터 중심의 높이.
function TreadmillLogic.isOnPad(px: number, py: number, pz: number, pad: Pad): boolean
	if math.abs(px - pad.x) > pad.sizeX / 2 then
		return false
	end
	if math.abs(pz - pad.z) > pad.sizeZ / 2 then
		return false
	end
	return py >= pad.topY and py <= pad.topY + pad.reach
end

return TreadmillLogic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">UILayout</string>
            <string name="Source"><![CDATA[--!strict
--[[
	UILayout — 화면 구역 배치 계산 (순수 함수, 통합 기획서 8-1절).

	입력: 화면에서 쓸 수 있는 영역의 실제 크기(px). 로블록스 위쪽 메뉴 줄과 노치는 이미 빠진 크기다
	(모든 ScreenGui 가 ScreenInsets = CoreUISafeInsets 를 쓴다). touch 는 휴대폰처럼 이동 컨트롤이 있는지.

	출력: 배율(scale)과 "디자인 칸" 단위의 구역 사각형. 화면 코드는 모든 ScreenGui 에 UIScale = scale 을 걸고,
	이 사각형 그대로 Position/Size 를 정한다. 그래서 구역끼리 겹치지 않는다는 것을 여기 테스트로 보장할 수 있다.

	화면 상태별로 동시에 보이는 구역:
	  로비   chips, menu, raceCluster, feedLobby, lobbyStatus  (+ 비워 둘 자리 joystick, jump)
	  대장간 chips, forgePanel   (이동 컨트롤은 숨긴다)
	  창     modal               (어둡게 덮고 맨 위)
	  경주   raceHud, raceAbility (+ joystick, jump) / 탈락 후 raceResult (이동 컨트롤 숨김)
]]

local UILayout = {}

export type Rect = { x: number, y: number, w: number, h: number }

export type Config = {
	referenceWidth: number,
	referenceHeight: number,
	minScale: number,
	maxScale: number,
	margin: number,
	gap: number,
	chipHeight: number,
	chipWidth: number,
	chipCount: number,
	menuButton: number,
	menuCount: number,
	raceButtonWidth: number,
	raceButtonHeight: number,
	raceStatusHeight: number,
	lobbyStatusWidth: number,
	lobbyStatusHeight: number,
	feedLineHeight: number,
	modalMaxWidth: number,
	forgeMaxWidth: number,
	raceHudWidth: number,
	raceHudHeight: number,
	abilitySize: number,
	resultWidth: number,
	resultHeight: number,
	joystickWidth: number,
	joystickHeight: number,
	jumpWidth: number,
	jumpHeight: number,
	minTouchPx: number,
}

export type Layout = {
	scale: number,
	width: number, -- 디자인 칸 단위 화면 크기
	height: number,
	touch: boolean,

	chips: Rect,
	menu: Rect,
	menuColumns: number, -- 1 = 세로 한 줄, 2 = 두 줄, 4 = 가로 한 줄
	raceCluster: Rect,
	feedLobby: Rect,
	lobbyStatus: Rect,
	forgePanel: Rect,
	modal: Rect,
	raceHud: Rect,
	raceAbility: Rect,
	raceResult: Rect,

	joystick: Rect, -- touch 가 false 면 크기 0
	jump: Rect,
}

local function rect(x: number, y: number, w: number, h: number): Rect
	return { x = x, y = y, w = math.max(0, w), h = math.max(0, h) }
end

function UILayout.overlaps(a: Rect, b: Rect): boolean
	if a.w <= 0 or a.h <= 0 or b.w <= 0 or b.h <= 0 then
		return false
	end
	return a.x < b.x + b.w and b.x < a.x + a.w and a.y < b.y + b.h and b.y < a.y + a.h
end

function UILayout.inside(inner: Rect, width: number, height: number): boolean
	local eps = 1e-6
	return inner.x >= -eps
		and inner.y >= -eps
		and inner.x + inner.w <= width + eps
		and inner.y + inner.h <= height + eps
end

function UILayout.compute(realWidth: number, realHeight: number, touch: boolean, c: Config): Layout
	local scale = math.clamp(
		math.min(realWidth / c.referenceWidth, realHeight / c.referenceHeight),
		c.minScale,
		c.maxScale
	)
	local W = realWidth / scale
	local H = realHeight / scale
	local m = c.margin
	local g = c.gap

	-- 이동 컨트롤 자리 (실제 px → 디자인 칸)
	local joystick = if touch
		then rect(
			0,
			H - c.joystickHeight / scale,
			c.joystickWidth / scale,
			c.joystickHeight / scale
		)
		else rect(0, H, 0, 0)
	local jump = if touch
		then rect(
			W - c.jumpWidth / scale,
			H - c.jumpHeight / scale,
			c.jumpWidth / scale,
			c.jumpHeight / scale
		)
		else rect(W, H, 0, 0)

	-- 위쪽 왼쪽: 재화 칩 한 줄
	local chipsWidth = c.chipCount * c.chipWidth + (c.chipCount - 1) * g
	local chips = rect(m, m, chipsWidth, c.chipHeight)

	-- 왼쪽 메뉴: 칩 아래. 세로 한 줄 → 두 줄 → 가로 한 줄 순서로 들어가는 모양을 고른다.
	local menuTop = chips.y + chips.h + g
	local menuBottomLimit = (if touch then joystick.y else H) - g
	local b = c.menuButton
	local count = c.menuCount

	local function menuRect(columns: number): Rect
		local rows = math.ceil(count / columns)
		return rect(m, menuTop, columns * b + (columns - 1) * g, rows * b + (rows - 1) * g)
	end

	local menuColumns = 1
	local menu = menuRect(1)
	if menu.y + menu.h > menuBottomLimit then
		menuColumns = 2
		menu = menuRect(2)
		if menu.y + menu.h > menuBottomLimit then
			menuColumns = count
			menu = menuRect(count)
		end
	end

	-- 오른쪽 위: 경주 버튼 + 상태 한 줄
	local raceCluster = rect(
		W - m - c.raceButtonWidth,
		m,
		c.raceButtonWidth,
		c.raceButtonHeight + g + c.raceStatusHeight
	)

	-- 위쪽 가운데: 피드 한 줄 (왼쪽 칩·메뉴와 오른쪽 경주 버튼 사이)
	-- (메뉴는 어떤 모양이든 칩 줄보다 아래에서 시작하므로 칩 오른쪽이 기준이다.)
	local feedLeft = chips.x + chips.w + g
	local feedRight = raceCluster.x - g
	local feedLobby = rect(feedLeft, m, feedRight - feedLeft, c.feedLineHeight)

	-- 아래 가운데: 트레드밀 진행 막대 (조이스틱과 점프 버튼 사이)
	local bottomLeft = joystick.x + joystick.w + g
	local bottomRight = jump.x - g
	local statusWidth = math.min(c.lobbyStatusWidth, bottomRight - bottomLeft)
	local lobbyStatus = rect(
		bottomLeft + ((bottomRight - bottomLeft) - statusWidth) / 2,
		H - m - c.lobbyStatusHeight,
		statusWidth,
		c.lobbyStatusHeight
	)
	if not touch then
		lobbyStatus = rect(
			(W - c.lobbyStatusWidth) / 2,
			H - m - c.lobbyStatusHeight,
			c.lobbyStatusWidth,
			c.lobbyStatusHeight
		)
	end

	-- 대장간: 칩 아래 화면 대부분 (이동 컨트롤은 숨기므로 신경 쓰지 않는다)
	local forgeTop = chips.y + chips.h + g
	local forgeWidth = math.min(c.forgeMaxWidth, W - 2 * m)
	local forgePanel = rect((W - forgeWidth) / 2, forgeTop, forgeWidth, H - forgeTop - m)

	-- 큰 창 (확률표·검·기록·상점)
	local modalWidth = math.min(c.modalMaxWidth, W - 2 * m)
	local modal = rect((W - modalWidth) / 2, m, modalWidth, H - 2 * m)

	-- 경주
	local hudWidth = math.min(c.raceHudWidth, W - 2 * m)
	local raceHud = rect((W - hudWidth) / 2, m, hudWidth, c.raceHudHeight)
	local abilityRight = (if touch then jump.x else W - m) - g
	local raceAbility =
		rect(abilityRight - c.abilitySize, H - m - c.abilitySize, c.abilitySize, c.abilitySize)
	local resultWidth = math.min(c.resultWidth, W - 2 * m)
	local resultHeight = math.min(c.resultHeight, H - raceHud.y - raceHud.h - g - m)
	local raceResult = rect((W - resultWidth) / 2, H - m - resultHeight, resultWidth, resultHeight)

	return {
		scale = scale,
		width = W,
		height = H,
		touch = touch,
		chips = chips,
		menu = menu,
		menuColumns = menuColumns,
		raceCluster = raceCluster,
		feedLobby = feedLobby,
		lobbyStatus = lobbyStatus,
		forgePanel = forgePanel,
		modal = modal,
		raceHud = raceHud,
		raceAbility = raceAbility,
		raceResult = raceResult,
		joystick = joystick,
		jump = jump,
	}
end

-- 화면 상태별로 함께 보이는 구역 이름 (테스트와 ScreenManager 가 같은 목록을 쓴다)
UILayout.MODE_ZONES = {
	lobby = { "chips", "menu", "raceCluster", "feedLobby", "lobbyStatus", "joystick", "jump" },
	forge = { "chips", "forgePanel" },
	modal = { "modal" },
	race = { "raceHud", "raceAbility", "joystick", "jump" },
	raceOut = { "raceHud", "raceResult" },
} :: { [string]: { string } }

return UILayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">VisualLogic</string>
            <string name="Source"><![CDATA[--!strict
--[[
	VisualLogic — 레벨 색·연출 길이를 고르는 순수 함수 (통합 기획서 8-1절).
	Roblox API 와 require 가 없다. 색표·시간표는 인자로 받는다(Config/Palette, Config/VisualConfig).
]]

local VisualLogic = {}

export type HeatTier = {
	minLevel: number,
	rgb: { number },
	glow: number,
	sparks: boolean,
	nameKey: string,
}

export type RevealStep = {
	minLevel: number,
	seconds: number,
	strikes: number,
}

-- minLevel 오름차순 표에서 level 에 해당하는 마지막 줄의 번호. 표가 비어 있으면 0.
local function stepIndex(list: { any }, level: number): number
	local found = 0
	for index, entry in list do
		if level >= entry.minLevel then
			found = index
		end
	end
	if found == 0 and #list > 0 then
		return 1
	end
	return found
end

-- 레벨의 달구는 색 단계
function VisualLogic.heatTier(level: number, tiers: { HeatTier }): HeatTier
	return tiers[stepIndex(tiers, level)]
end

-- 강화 결과 연출 단계 (강화하기 "전" 레벨 기준: 높은 곳에서 두드릴수록 긴장감이 길다)
function VisualLogic.reveal(level: number, steps: { RevealStep }): RevealStep
	return steps[stepIndex(steps, level)]
end

--[[
	화면 배율. 기준 크기에 맞춰 줄이거나 키우되 [minScale, maxScale] 안에서.
	가로·세로 중 더 빡빡한 쪽에 맞춘다.
]]
function VisualLogic.scaleFor(
	width: number,
	height: number,
	referenceWidth: number,
	referenceHeight: number,
	minScale: number,
	maxScale: number
): number
	local scale = math.min(width / referenceWidth, height / referenceHeight)
	return math.clamp(scale, minScale, maxScale)
end

return VisualLogic
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Remotes — 리모트 이름을 한 곳에서 관리한다.
	서버는 Build() 로 인스턴스를 만들고, 클라이언트는 Get() 으로 가져온다.
	문자열 리터럴을 코드 여기저기에 흩뿌리지 말 것.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

Remotes.FOLDER_NAME = "Remotes"

-- RemoteFunction: 클라이언트가 요청하고 결과를 기다리는 것
Remotes.Functions = {
	Enhance = "Enhance", -- 강화 1회 요청 → Types.EnhanceResponse
	RenameWeapon = "RenameWeapon", -- 착용 검 이름 변경(필터링 후 저장)
	EquipSword = "EquipSword", -- 착용 검 바꾸기 → Types.EquipResponse
	BuySwordSlot = "BuySwordSlot", -- 소지 상한 1칸 구매 + 새 검 뽑기 1회 → Types.DrawResponse
	GetState = "GetState", -- 접속 직후 현재 데이터 + 확률 조회 (복제 이벤트를 놓쳤을 때의 보정)
	GetOdds = "GetOdds", -- 착용 검 기준 최종 확률 조회
	GetLeaderboard = "GetLeaderboard", -- 랭킹 상위 목록
	GetShopItems = "GetShopItems", -- 상점 목록 조회 → Types.ShopState
	PromptPurchase = "PromptPurchase", -- 구매창 띄우기 요청
	ShardDraw = "ShardDraw", -- 파편으로 방지권 뽑기 1회 → Types.ShardDrawResponse
	SetSetting = "SetSetting", -- 사운드/언어 설정 변경
	JoinRace = "JoinRace", -- 경주 매칭 대기열에 들어가기
	LeaveRaceQueue = "LeaveRaceQueue", -- 매칭 대기 취소
	ReturnToLobby = "ReturnToLobby", -- 탈락 후 관전을 끝내고 로비로
}

-- RemoteEvent: 서버가 밀어 주는 것 (클라이언트→서버 방향은 원칙적으로 쓰지 않음)
Remotes.Events = {
	DataChanged = "DataChanged", -- 프로필 변경분 복제
	FeedMessage = "FeedMessage", -- 결과 피드 한 줄
	LiveOpsChanged = "LiveOpsChanged", -- 이벤트/점검 상태 변경
	RaceUpdate = "RaceUpdate", -- 경주 진행 알림 (Types.RaceUpdate)
	TreadmillUpdate = "TreadmillUpdate", -- 트레드밀 진행 상태 (Types.TreadmillUpdate)
	WorldEvent = "WorldEvent", -- 세계에서 일어난 일 (예: 모루 근접 버튼 → 대장간 열기)
}

-- 서버 전용: 리모트 폴더와 인스턴스를 생성한다.
function Remotes.Build(): Folder
	local existing = ReplicatedStorage:FindFirstChild(Remotes.FOLDER_NAME)
	if existing then
		return existing :: Folder
	end

	local folder = Instance.new("Folder")
	folder.Name = Remotes.FOLDER_NAME

	for _, name in Remotes.Functions do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
	end

	for _, name in Remotes.Events do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end

	folder.Parent = ReplicatedStorage
	return folder
end

-- 클라이언트 전용: 이름으로 리모트를 가져온다(없으면 대기).
function Remotes.Get(name: string): Instance
	local folder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	return folder:WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">SwordModel</string>
          <string name="Source"><![CDATA[--!strict
--[[
	SwordModel — 블록으로 3D 검을 짓는다 (통합 기획서 8-2절).

	모양은 Config/SwordShapes(숫자 데이터), 색은 Config/Palette 에서 온다.
	  칼날 바탕 = 강철색 금속 / 테두리 = 레벨 색(쇠 달구는 색, 5강부터 네온으로 빛남) /
	  가드·손잡이 끝 = 등급 색 / 속심·장식 = 검마다 정한 색(네온)
	  레벨이 높을수록 칼날 주위 빛이 커지고, 15강부터 불티, 20강은 하얀 불꽃.
	서버(손에 든 검, 진열대)와 클라이언트(대장간 화면 미리보기)가 같은 함수를 쓴다.
	보기만 하는 장식이라 부딪히지도, 무게도, 클릭 판정도 없다.
]]

local Config = script.Parent:WaitForChild("Config")
local Palette = require(Config:WaitForChild("Palette"))
local SwordShapes = require(Config:WaitForChild("SwordShapes"))
local Weapons = require(Config:WaitForChild("Weapons"))
local VisualLogic = require(script.Parent:WaitForChild("Pure"):WaitForChild("VisualLogic"))

local SwordModel = {}

SwordModel.MODEL_NAME = "ForgeSword"
SwordModel.HANDLE_NAME = "Handle"

local function rgb(values: { number }): Color3
	return Color3.fromRGB(values[1], values[2], values[3])
end

local SHAPE_TYPES: { [string]: Enum.PartType } = {
	Block = Enum.PartType.Block,
	Wedge = Enum.PartType.Wedge,
	Ball = Enum.PartType.Ball,
	Cylinder = Enum.PartType.Cylinder,
}

export type Options = {
	cframe: CFrame, -- 손잡이 가운데가 놓일 자리 (칼날은 이 CFrame 의 +Y 쪽)
	scale: number?, -- 크기 배율 (손에 들 때는 작게)
	anchored: boolean?, -- true 면 고정(진열대·미리보기), false 면 손잡이에 용접(손에 들 때)
	effects: boolean?, -- 빛·불티·불꽃을 붙일지 (미리보기 화면에서는 빛이 안 보이므로 끈다)
}

--[[
	검 모델을 만든다. 부모는 정하지 않는다(호출한 쪽이 붙인다).
	PrimaryPart 는 손잡이(Handle).
]]
function SwordModel.build(swordId: string, level: number, options: Options): Model
	local shape = SwordShapes.get(swordId)
	local info = Weapons.get(swordId)
	local rarityColor =
		rgb(Palette.RARITY[if info then info.rarity else "common"] or Palette.RARITY.common)
	local tier = VisualLogic.heatTier(level, Palette.HEAT_TIERS)
	local heatColor = rgb(tier.rgb)
	local accentColor = if shape.accent then rgb(shape.accent) else heatColor
	local scale = options.scale or 1
	local anchored = options.anchored == true

	local model = Instance.new("Model")
	model.Name = SwordModel.MODEL_NAME
	model:SetAttribute("SwordId", swordId)
	model:SetAttribute("SwordLevel", level)

	local handle: BasePart? = nil
	local glowPart: BasePart? = nil

	for index, spec in shape.parts do
		local part = Instance.new("Part")
		part.Name = if spec.role == "grip" and handle == nil
			then SwordModel.HANDLE_NAME
			else `{spec.role}{index}`
		part.Shape = SHAPE_TYPES[spec.shape] or Enum.PartType.Block
		part.Size = Vector3.new(spec.size[1], spec.size[2], spec.size[3]) * scale
		part.Anchored = anchored
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.CastShadow = false
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth

		local role = spec.role
		if role == "blade" then
			part.Color = rgb(Palette.WORLD.steel)
			part.Material = Enum.Material.Metal
			if glowPart == nil then
				glowPart = part
			end
		elseif role == "edge" then
			part.Color = heatColor
			part.Material = if tier.glow > 0 then Enum.Material.Neon else Enum.Material.Metal
		elseif role == "core" or role == "accent" then
			part.Color = accentColor
			part.Material = Enum.Material.Neon
		elseif role == "guard" or role == "pommel" then
			part.Color = rarityColor
			part.Material = Enum.Material.Metal
		else -- grip
			part.Color = rgb(Palette.WORLD.wood)
			part.Material = Enum.Material.Wood
		end

		local rot = spec.rot or { 0, 0, 0 }
		part.CFrame = options.cframe
			* CFrame.new(spec.pos[1] * scale, spec.pos[2] * scale, spec.pos[3] * scale)
			* CFrame.Angles(math.rad(rot[1]), math.rad(rot[2]), math.rad(rot[3]))
		part.Parent = model

		if part.Name == SwordModel.HANDLE_NAME then
			handle = part
		end
	end

	local primary = handle or model:FindFirstChildWhichIsA("BasePart")
	model.PrimaryPart = primary

	-- 손에 들 때: 모든 조각을 손잡이에 붙인다
	if not anchored and primary then
		for _, child in model:GetChildren() do
			if child:IsA("BasePart") and child ~= primary then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = primary
				weld.Part1 = child
				weld.Parent = child
			end
		end
	end

	-- 레벨이 높을수록 빛, 15강부터 불티, 20강은 하얀 불꽃
	local glow = glowPart
	if options.effects ~= false and glow and tier.glow > 0 then
		local light = Instance.new("PointLight")
		light.Color = heatColor
		light.Range = (4 + 8 * tier.glow) * scale
		light.Brightness = 0.6 + 1.6 * tier.glow
		light.Parent = glow

		if tier.sparks then
			local sparks = Instance.new("ParticleEmitter")
			sparks.Name = "Sparks"
			sparks.Color = ColorSequence.new(heatColor)
			sparks.LightEmission = 1
			sparks.Rate = 6
			sparks.Lifetime = NumberRange.new(0.4, 0.8)
			sparks.Speed = NumberRange.new(1, 3)
			sparks.SpreadAngle = Vector2.new(60, 60)
			sparks.Size = NumberSequence.new(0.12 * scale, 0)
			sparks.Parent = glow
		end

		local whiteTier = Palette.HEAT_TIERS[#Palette.HEAT_TIERS]
		if level >= whiteTier.minLevel then
			local fire = Instance.new("Fire")
			fire.Color = Color3.new(1, 1, 1)
			fire.SecondaryColor = rgb(Palette.WORLD.gold)
			fire.Size = 2 * scale
			fire.Heat = 3
			fire.Parent = glow
		end
	end

	return model
end

-- 모양 길이 (미리보기 카메라 거리용)
function SwordModel.length(swordId: string): number
	return SwordShapes.length(SwordShapes.get(swordId))
end

return SwordModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Types — 서버/클라이언트가 공유하는 데이터 타입 정의.
	여기 있는 타입은 저장 스키마(ProfileStore)와 리모트 페이로드의 계약이다.
	스키마를 바꾸면 SCHEMA_VERSION 을 올리고 Pure/DataMigration 에 단계를 추가할 것.

	"사용 안 함" 이라고 적힌 필드는 기획에서 빠진 기능(1:1 배틀, 업적)이나 옛 구조가
	쓰던 것이다. 저장된 데이터를 지우지 않기 위해 남겨 두고, 코드는 읽지도 쓰지도 않는다.
]]

local Types = {}

-- 현재 저장 스키마 버전. PlayerData.schemaVersion 의 기준값.
-- v4: 무기 하나(weapon) → 검 여러 개(swords, equippedId, swordCapacity), 천장 포인트 추가
Types.SCHEMA_VERSION = 4

-- 가진 검 하나의 상태
export type SwordState = {
	id: string, -- Config/Weapons 의 키 (swords 표의 키와 같다)
	level: number, -- 0 ~ EnhanceTable.MAX_LEVEL
	bestLevel: number, -- 이 검의 역대 최고 레벨 (10강으로 돌아가도 유지, 도감에 표시)
	customName: string?, -- 필터링을 통과한 이름만 저장
}

-- v3 까지 쓰던 "무기 하나" 구조
export type LegacyWeaponState = {
	id: string,
	level: number,
	customName: string?,
}

export type PlayerStats = {
	enhanceTries: number,
	enhanceSuccess: number,
	destroyed: number, -- 2구간 실패 횟수 (이름은 옛 "파괴" 시절 것을 그대로 쓴다)
	highestLevel: number, -- 모든 검을 통틀어 역대 최고 레벨 (랭킹)
	battleWins: number, -- 사용 안 함 (1:1 배틀 폐지)
	battleLosses: number, -- 사용 안 함 (1:1 배틀 폐지)
	rating: number, -- 사용 안 함 (1:1 배틀 폐지)
	keepStreak: number, -- 사용 안 함 (업적 삭제)
	bestKeepStreak: number, -- 사용 안 함 (업적 삭제)
	ticketsUsed: number, -- 사용 안 함 (업적 삭제)
}

export type DailyState = {
	lastLoginDay: number, -- UTC 기준 일자 (os.time() // 86400)
	streak: number,
	battlesToday: number, -- 사용 안 함 (1:1 배틀 폐지)
	opponentsToday: { [string]: number }, -- 사용 안 함 (1:1 배틀 폐지)
}

export type PlayerSettings = {
	sfx: boolean,
	language: string,
}

export type PlayerData = {
	schemaVersion: number,
	gold: number,
	shards: number, -- 2구간 실패 시 얻는 보조 재화
	swords: { [string]: SwordState }, -- 검 id → 상태. 같은 검을 두 개 가질 수 없다
	equippedId: string, -- 착용 중인 검의 id (반드시 swords 에 있다)
	swordCapacity: number, -- 소지 상한 (골드로 1칸씩 산다)
	pityPoints: number, -- 방지권 확률형 상품의 천장 포인트 (꽝 1점, 3점이면 방지권 1개 후 0)
	weapon: LegacyWeaponState?, -- 사용 안 함 (v3 까지의 무기. v4 에서 swords 로 옮겼다)
	protectTickets: number, -- 방지권
	stats: PlayerStats,
	codex: { [string]: boolean }, -- "검id:구간" 달성 여부 (구간 = 5, 10, 15, 20)
	achievements: { [string]: boolean }, -- 사용 안 함 (업적 삭제)
	daily: DailyState,
	-- ProcessReceipt 중복 지급 방지용 PurchaseId 목록.
	-- 배열인 이유: 오래된 것부터 버려서 크기를 일정하게 유지해야 하기 때문이다.
	-- (스키마 v1 에서는 { [id]: true } 딕셔너리였고 v2 에서 배열로 옮겼다)
	purchaseHistory: { string },
	settings: PlayerSettings,
	bannedUntil: number?,
}

-- 서버 함수의 공통 반환 형태. 실패는 에러 대신 ok=false 로 돌려준다.
export type Failure = {
	ok: false,
	reason: string,
}

export type Success = { ok: true }

-- 결과에 따로 실어 보낼 값이 없는 요청의 응답
export type SimpleResponse = Success | Failure

--[[
	강화 화면에 노출하는 확률 (착용 검 기준, 이벤트 버프 반영 후, 퍼센트 단위).
	방지권을 켰을 때의 표시(실패 0, 유지 + 실패)는 클라이언트가
	Pure/EnhanceLogic.applyProtect 로 바꿔서 보여 준다.
]]
export type DisplayOdds = {
	level: number,
	success: number,
	keep: number,
	fail: number,
	cost: number, -- 0 이면 최대 레벨
	eventName: string?, -- 적용 중인 확률 버프 이벤트 이름(로컬라이즈 키)
}

export type EnhanceOutcome = "success" | "keep" | "fail" | "protected"

export type EnhanceSuccess = {
	ok: true,
	result: EnhanceOutcome,
	newLevel: number,
	gold: number,
	shardsGained: number,
	odds: DisplayOdds, -- 새 레벨 기준 확률. 클라이언트가 다시 물어보지 않아도 되도록 같이 보낸다.
}

export type EnhanceResponse = EnhanceSuccess | Failure

export type RenameSuccess = {
	ok: true,
	name: string, -- 필터링을 통과한 이름 (표시할 때도 이 값을 쓴다)
}

export type RenameResponse = RenameSuccess | Failure

export type EquipSuccess = {
	ok: true,
	swordId: string,
	odds: DisplayOdds, -- 새로 착용한 검 기준 확률
}

export type EquipResponse = EquipSuccess | Failure

-- 소지 상한 1칸 구매 + 새 검 뽑기 1회의 결과
export type DrawSuccess = {
	ok: true,
	swordId: string, -- 뽑힌 검
	pricePaid: number,
	gold: number,
	odds: DisplayOdds, -- 검 수가 늘어 강화 비용이 바뀌므로 다시 보낸다
}

export type DrawResponse = DrawSuccess | Failure

export type LeaderboardEntry = {
	rank: number,
	userId: number,
	name: string,
	value: number,
}

--------------------------------------------------------------------------------
-- 추격 생존 경주 (통합 기획서 4절)
--------------------------------------------------------------------------------

-- 경주에 함께 나간 사람 한 명 (다른 참가자에게 보여 주는 정보)
export type RaceEntrant = {
	userId: number,
	name: string,
	level: number, -- 출발할 때의 착용 검 레벨
}

-- 최종 순위표의 한 줄
export type RaceRankingRow = {
	rank: number,
	userId: number,
	name: string,
	level: number,
	distance: number, -- 서버가 인정한 거리(칸, 내림)
}

--[[
	서버가 RaceUpdate 이벤트로 보내는 알림. kind 로 구분한다.
	여기 있는 거리·보상·순위는 전부 서버가 계산한 값이다. 클라이언트는 표시만 한다.

	  queue      대기열 상태. queued=false 면 대기열에서 빠졌다는 뜻
	  lineup     출발선에 섰다. countdown 초 뒤에 출발
	  start      출발
	  eliminated 누군가(나 포함) 탈락했다
	  result     내 결과 (탈락한 순간 보상이 이미 지급됐다)
	  finished   모두 탈락해 판이 끝났다. returnIn 초 뒤 로비로 돌아간다
	  lobby      로비로 돌아왔다
]]
export type RaceUpdate = {
	kind: string,
	raceId: number?,

	-- queue
	queued: boolean?,
	count: number?, -- 대기 인원
	secondsLeft: number?, -- 출발 신호까지 남은 시간(초)

	-- lineup
	countdown: number?,
	originX: number?, -- 코스 출발선의 위치 (화면 표시용)
	originZ: number?,
	level: number?,
	speed: number?,
	maxDistance: number?,
	entrants: { RaceEntrant }?,

	-- eliminated / result
	userId: number?,
	rank: number?,
	distance: number?,
	reward: number?,
	bonus: number?, -- 1~3위 보너스 (미정 D6, 지금은 항상 0)
	racerCount: number?,

	-- finished
	ranking: { RaceRankingRow }?,
	returnIn: number?,
}

-- 서버가 TreadmillUpdate 이벤트로 보내는 트레드밀 상태
export type TreadmillUpdate = {
	onPad: boolean,
	progress: number, -- 이번 지급까지 채운 시간(초)
	interval: number, -- 몇 초마다
	gold: number, -- 몇 골드
	paid: number, -- 방금 지급된 골드 (없으면 0)
}

--------------------------------------------------------------------------------
-- 상점 (통합 기획서 7절)
--------------------------------------------------------------------------------

-- 뽑기 결과 한 줄. percent 는 화면에 보여 주는 값이며 한 목록의 합이 정확히 100 이다.
export type ShopOutcome = {
	tickets: number, -- 0 이면 꽝
	percent: number,
}

-- 상점에 보여 줄 항목 (클라이언트는 상품 ID 를 알 필요가 없다)
export type ShopItem = {
	key: string,
	kind: string, -- "fixed" | "random"
	ticketAmount: number, -- fixed 일 때 받는 방지권 수
	outcomes: { ShopOutcome }, -- random 일 때 모든 결과와 확률
}

export type ShopShardDraw = {
	cost: number, -- 1회에 드는 파편
	outcomes: { ShopOutcome },
}

--[[
	상점 화면에 필요한 것 전부. 아직 등록되지 않았거나 내용이 비어 있는 상품은 들어 있지 않다.
	유료 확률형이 제한된 유저(PolicyService)에게는 확률형 상품이 들어 있지 않다.
	천장 포인트의 현재 값은 복제받은 PlayerData.pityPoints 를 쓴다.
]]
export type ShopState = {
	items: { ShopItem },
	pityPerMiss: number,
	pityThreshold: number,
	pityTickets: number,
	shardDraw: ShopShardDraw?, -- 확률이 아직 없으면 nil
}

export type ShardDrawSuccess = {
	ok: true,
	tickets: number, -- 이번에 얻은 방지권 (0 이면 꽝)
	shards: number, -- 남은 파편
}

export type ShardDrawResponse = ShardDrawSuccess | Failure

return Types
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="28">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="29">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	서버 부트스트랩.
	services 폴더의 모듈을 정해진 순서대로 require → Init() → Start() 한다.

	- Init(): 상태 준비, 리모트 핸들러 등록. 다른 서비스를 호출하지 않는다.
	- Start(): 다른 서비스가 모두 Init 된 뒤에 실행되는 실제 동작 시작점.

	Init 단계에서 에러가 나면 게임이 정상 동작할 수 없으므로 크게 실패시킨다
	(데이터가 준비되지 않은 채로 플레이어를 받으면 안 된다).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

type Service = {
	Name: string?,
	Init: (() -> ())?,
	Start: (() -> ())?,
}

-- 의존 순서대로 나열한다. 여기 없는 모듈은 생명주기 없는 유틸로 간주하고 건너뛴다.
local SERVICE_ORDER = {
	"WorldService", -- 로비 바닥이 가장 먼저 있어야 한다
	"DataService",
	"AnalyticsService",
	"LiveOpsService",
	"EconomyService",
	"CodexService",
	"EnhanceService",
	"SwordService",
	"SwordDisplayService",
	"TreadmillService",
	"RaceService",
	"ChatCommandService",
	"ShopService",
	"LeaderboardService",
	"AdminService",
}

local servicesFolder = script:WaitForChild("services")

local function loadService(name: string): Service
	local module = servicesFolder:FindFirstChild(name)
	assert(
		module and module:IsA("ModuleScript"),
		`[Bootstrap] 서비스 모듈을 찾을 수 없습니다: {name}`
	)
	return require(module) :: Service
end

local function runStage(stage: "Init" | "Start", services: { Service })
	for _, service in services do
		local fn = if stage == "Init" then service.Init else service.Start
		if not fn then
			continue
		end

		local ok, err = xpcall(fn, debug.traceback)
		if not ok then
			warn(`[Bootstrap] {service.Name or "?"}.{stage} 실패:\n{err}`)
			if stage == "Init" then
				error(
					`[Bootstrap] {service.Name or "?"}.Init 실패로 서버 시작을 중단합니다`,
					0
				)
			end
		end
	end
end

-- 리모트는 서비스가 핸들러를 붙이기 전에 미리 만들어 둔다.
Remotes.Build()

local services: { Service } = {}
for _, name in SERVICE_ORDER do
	local service = loadService(name)
	service.Name = service.Name or name
	table.insert(services, service)
end

runStage("Init", services)
runStage("Start", services)

print(`[Bootstrap] 서비스 {#services}개 시작 완료`)
]]></string>
      </Properties>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">services</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	AdminService — 관리자 명령과 감사 로그.

	Config/Game.ADMIN_USER_IDS 에 들어 있는 UserId 만 쓸 수 있다.
	목록이 비어 있으면 아무도 쓸 수 없다(기본값이 "아무도 안 됨"이어야 안전하다).

	모든 관리자 행동은 print 로 남기고 서버 메모리에도 최근 기록을 보관한다.
	"누가 언제 무엇을 했는지"가 남아야 사고가 났을 때 되짚을 수 있다.

	명령은 채팅으로 쓴다:
	    /관리 도움말
	    /관리 골드 <닉네임> <양>
	    /관리 레벨 <닉네임> <레벨>
	    /관리 방지권 <닉네임> <개수>
	    /관리 차단 <닉네임> <시간>       (시간 단위, 0 이면 해제)
	    /관리 정보 <닉네임>
	    /관리 점검 켜기|끄기
	    /관리 이벤트 <성공확률+%p> <지속분>
	    /관리 이벤트끄기
	    /관리 이상기록
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))
local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("Game"))
local EnhanceTable = require(Shared:WaitForChild("Config"):WaitForChild("EnhanceTable"))

local services = script.Parent
local DataService = require(services:WaitForChild("DataService"))
local EconomyService = require(services:WaitForChild("EconomyService"))
local AnalyticsService = require(services:WaitForChild("AnalyticsService"))
local LiveOpsService = require(services:WaitForChild("LiveOpsService"))

local AdminService = {}
AdminService.Name = "AdminService"

local COMMAND_NAME = "ForgeAdminCommand"
local MAX_AUDIT = 200

local auditLog: { string } = {}
local feedRemote: RemoteEvent? = nil

local function record(admin: Player, action: string)
	local entry = `[{os.date("!%Y-%m-%d %H:%M:%S")}] {admin.Name}({admin.UserId}) {action}`

	print(`[Admin] {entry}`)
	table.insert(auditLog, entry)

	while #auditLog > MAX_AUDIT do
		table.remove(auditLog, 1)
	end
end

local function reply(player: Player, text: string)
	if feedRemote == nil then
		return
	end
	feedRemote:FireClient(player, { kind = "system", text = text })
end

-- 닉네임으로 접속 중인 플레이어를 찾는다. 정확히 일치하는 사람이 먼저고, 없으면 부분 일치.
local function findPlayer(name: string): Player?
	local lowered = string.lower(name)

	for _, player in Players:GetPlayers() do
		if string.lower(player.Name) == lowered or string.lower(player.DisplayName) == lowered then
			return player
		end
	end

	for _, player in Players:GetPlayers() do
		if
			string.find(string.lower(player.Name), lowered, 1, true)
			or string.find(string.lower(player.DisplayName), lowered, 1, true)
		then
			return player
		end
	end

	return nil
end

--------------------------------------------------------------------------------
-- 개별 명령
--------------------------------------------------------------------------------

type Handler = (admin: Player, arguments: { string }) -> ()

local function requireTarget(admin: Player, arguments: { string }): Player?
	local name = arguments[2]
	if name == nil then
		reply(admin, "대상 닉네임이 필요하다.")
		return nil
	end

	local target = findPlayer(name)
	if target == nil then
		reply(admin, `'{name}' 을(를) 찾지 못했다.`)
		return nil
	end

	return target
end

local function cmdGold(admin: Player, arguments: { string })
	local target = requireTarget(admin, arguments)
	if target == nil then
		return
	end

	local amount = tonumber(arguments[3])
	if amount == nil or amount ~= math.floor(amount) then
		reply(admin, "양은 정수로 적어라.")
		return
	end

	local data = DataService.getActiveData(target)
	if data == nil then
		reply(admin, "그 사람 데이터가 아직 열리지 않았다.")
		return
	end

	if amount >= 0 then
		EconomyService.addGold(target, data, amount, "admin_grant")
	else
		-- 회수는 가진 만큼만
		EconomyService.spendGold(target, data, math.min(-amount, data.gold), "admin_revoke")
	end

	DataService.replicate(target)
	reply(
		admin,
		`{target.Name} 골드 {Format.comma(amount)} 처리. 현재 {Format.comma(data.gold)}`
	)
	record(admin, `골드 {amount} → {target.Name}({target.UserId})`)
end

local function cmdLevel(admin: Player, arguments: { string })
	local target = requireTarget(admin, arguments)
	if target == nil then
		return
	end

	local level = tonumber(arguments[3])
	if
		level == nil
		or level ~= math.floor(level)
		or level < 0
		or level > EnhanceTable.MAX_LEVEL
	then
		reply(admin, `레벨은 0 ~ {EnhanceTable.MAX_LEVEL} 사이 정수여야 한다.`)
		return
	end

	local data = DataService.getActiveData(target)
	if data == nil then
		reply(admin, "그 사람 데이터가 아직 열리지 않았다.")
		return
	end

	-- 착용 중인 검의 레벨을 바꾼다. (도감 구간 기록은 건드리지 않는다)
	local sword = data.swords[data.equippedId]
	if sword == nil then
		reply(admin, "그 사람의 착용 검을 찾지 못했다.")
		return
	end

	sword.level = level
	if level > sword.bestLevel then
		sword.bestLevel = level
	end
	if level > data.stats.highestLevel then
		data.stats.highestLevel = level
	end

	DataService.replicate(target)
	reply(admin, `{target.Name} 착용 검({sword.id}) 레벨을 +{level} 로 설정.`)
	record(admin, `레벨 {level} → {target.Name}({target.UserId})`)
end

local function cmdTickets(admin: Player, arguments: { string })
	local target = requireTarget(admin, arguments)
	if target == nil then
		return
	end

	local count = tonumber(arguments[3])
	if count == nil or count ~= math.floor(count) then
		reply(admin, "개수는 정수로 적어라.")
		return
	end

	local data = DataService.getActiveData(target)
	if data == nil then
		reply(admin, "그 사람 데이터가 아직 열리지 않았다.")
		return
	end

	if count >= 0 then
		EconomyService.addTickets(target, data, count, "admin_grant")
	else
		EconomyService.spendTickets(
			target,
			data,
			math.min(-count, data.protectTickets),
			"admin_revoke"
		)
	end

	DataService.replicate(target)
	reply(admin, `{target.Name} 방지권 {count} 처리. 현재 {data.protectTickets}`)
	record(admin, `방지권 {count} → {target.Name}({target.UserId})`)
end

local function cmdBan(admin: Player, arguments: { string })
	local target = requireTarget(admin, arguments)
	if target == nil then
		return
	end

	local hours = tonumber(arguments[3])
	if hours == nil or hours < 0 then
		reply(admin, "시간은 0 이상 숫자여야 한다. 0 이면 해제.")
		return
	end

	local data = DataService.getActiveData(target)
	if data == nil then
		reply(admin, "그 사람 데이터가 아직 열리지 않았다.")
		return
	end

	if hours == 0 then
		data.bannedUntil = nil
		reply(admin, `{target.Name} 차단 해제.`)
		record(admin, `차단 해제 → {target.Name}({target.UserId})`)
		return
	end

	data.bannedUntil = os.time() + math.floor(hours * 3600)
	reply(admin, `{target.Name} {hours}시간 차단.`)
	record(admin, `차단 {hours}시간 → {target.Name}({target.UserId})`)

	-- 차단은 다음 접속 때 로드 시점에서도 확인되지만, 지금 있으면 바로 내보낸다.
	task.defer(function()
		if target.Parent == Players then
			target:Kick("출입이 금지되었다.")
		end
	end)
end

local function cmdInfo(admin: Player, arguments: { string })
	local target = requireTarget(admin, arguments)
	if target == nil then
		return
	end

	local data = DataService.getData(target)
	if data == nil then
		reply(admin, "그 사람 데이터가 아직 열리지 않았다.")
		return
	end

	local equipped = data.swords[data.equippedId]
	local swordCount = 0
	for _ in data.swords do
		swordCount += 1
	end

	reply(
		admin,
		`{target.Name} — {data.equippedId} +{if equipped then equipped.level else 0}`
			.. ` · 검 {swordCount}자루 · 골드 {Format.comma(data.gold)}`
			.. ` · 파편 {Format.comma(data.shards)} · 방지권 {data.protectTickets}`
			.. ` · 시도 {data.stats.enhanceTries} · 실패 {data.stats.destroyed}`
			.. ` · 최고 +{data.stats.highestLevel}`
			.. ` · 스키마 v{data.schemaVersion}`
	)
	record(admin, `정보 조회 → {target.Name}({target.UserId})`)
end

local function cmdMaintenance(admin: Player, arguments: { string })
	local mode = arguments[2]
	if mode ~= "켜기" and mode ~= "끄기" and mode ~= "on" and mode ~= "off" then
		reply(admin, "/관리 점검 켜기 | 끄기")
		return
	end

	local enabled = mode == "켜기" or mode == "on"

	task.spawn(function()
		local saved = LiveOpsService.setMaintenance(enabled)
		reply(
			admin,
			`점검 모드 {if enabled then "켜짐" else "꺼짐"}{if saved
				then ""
				else " (저장 실패, 이 서버에만 적용)"}`
		)
	end)

	record(admin, `점검 {tostring(enabled)}`)
end

local function cmdEvent(admin: Player, arguments: { string })
	local buff = tonumber(arguments[2])
	local minutes = tonumber(arguments[3])

	if buff == nil or minutes == nil or buff <= 0 or minutes <= 0 then
		reply(admin, "/관리 이벤트 <성공확률+%p> <지속분>")
		return
	end

	local event = {
		id = `admin_{os.time()}`,
		nameKey = "event.boost",
		successBuff = math.clamp(buff, 1, 50),
		endsAt = os.time() + math.floor(minutes * 60),
	}

	task.spawn(function()
		local saved = LiveOpsService.setEvent(event)
		reply(
			admin,
			`이벤트 시작: 성공 +{event.successBuff}%p, {minutes}분{if saved
				then ""
				else " (저장 실패)"}`
		)
	end)

	record(admin, `이벤트 +{buff}%p / {minutes}분`)
end

local function cmdEventOff(admin: Player, _arguments: { string })
	task.spawn(function()
		LiveOpsService.setEvent(nil)
		reply(admin, "이벤트를 껐다.")
	end)
	record(admin, "이벤트 종료")
end

local function cmdAnomalies(admin: Player, _arguments: { string })
	local entries = AnalyticsService.getAnomalyLog()

	if #entries == 0 then
		reply(admin, "이상 기록이 없다.")
		return
	end

	for index = math.max(1, #entries - 9), #entries do
		reply(admin, entries[index])
	end
end

local function cmdAudit(admin: Player, _arguments: { string })
	if #auditLog == 0 then
		reply(admin, "관리자 기록이 없다.")
		return
	end

	for index = math.max(1, #auditLog - 9), #auditLog do
		reply(admin, auditLog[index])
	end
end

local HANDLERS: { [string]: Handler } = {
	["골드"] = cmdGold,
	["gold"] = cmdGold,
	["레벨"] = cmdLevel,
	["level"] = cmdLevel,
	["방지권"] = cmdTickets,
	["tickets"] = cmdTickets,
	["차단"] = cmdBan,
	["ban"] = cmdBan,
	["정보"] = cmdInfo,
	["info"] = cmdInfo,
	["점검"] = cmdMaintenance,
	["maintenance"] = cmdMaintenance,
	["이벤트"] = cmdEvent,
	["event"] = cmdEvent,
	["이벤트끄기"] = cmdEventOff,
	["eventoff"] = cmdEventOff,
	["이상기록"] = cmdAnomalies,
	["anomalies"] = cmdAnomalies,
	["기록"] = cmdAudit,
	["audit"] = cmdAudit,
}

local HELP =
	"/관리 골드|레벨|방지권|차단|정보 <닉네임> <값> · 점검 켜기|끄기 · 이벤트 <%p> <분> · 이벤트끄기 · 이상기록 · 기록"

--------------------------------------------------------------------------------

local function onAdminCommand(player: Player, arguments: { string })
	if not GameConfig.isAdmin(player.UserId) then
		-- 관리자가 아니면 명령이 있다는 사실조차 알리지 않는다.
		warn(`[Admin] 권한 없는 시도: {player.Name}({player.UserId})`)
		return
	end

	local subcommand = arguments[1]
	if subcommand == nil or subcommand == "도움말" or subcommand == "help" then
		reply(player, HELP)
		return
	end

	local handler = HANDLERS[string.lower(subcommand)] or HANDLERS[subcommand]
	if handler == nil then
		reply(player, HELP)
		return
	end

	local ok, err = xpcall(handler, debug.traceback, player, arguments)
	if not ok then
		warn(`[Admin] 명령 처리 오류:\n{err}`)
		reply(player, "명령 처리 중 문제가 생겼다.")
	end
end

function AdminService.Init()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	feedRemote = remotesFolder:WaitForChild(Remotes.Events.FeedMessage) :: RemoteEvent
end

function AdminService.Start()
	if #GameConfig.ADMIN_USER_IDS == 0 then
		warn(
			"[Admin] 관리자 UserId 가 비어 있어 관리자 명령을 등록하지 않았습니다. "
				.. "src/shared/Config/Game.luau 의 ADMIN_USER_IDS 를 채워 주세요."
		)
		return
	end

	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		warn("[Admin] 레거시 채팅이라 관리자 명령을 등록하지 않았습니다.")
		return
	end

	local ok, err = pcall(function()
		local existing = TextChatService:FindFirstChild(COMMAND_NAME)
		local command = if existing and existing:IsA("TextChatCommand")
			then existing
			else Instance.new("TextChatCommand")

		command.Name = COMMAND_NAME
		command.PrimaryAlias = "/관리"
		command.SecondaryAlias = "/admin"
		command.AutocompleteVisible = false -- 일반 플레이어에게 노출하지 않는다
		command.Enabled = true
		command.Parent = TextChatService

		command.Triggered:Connect(function(textSource: TextSource, message: string)
			local player = Players:GetPlayerByUserId(textSource.UserId)
			if player == nil then
				return
			end

			local words = string.split(message, " ")
			local arguments: { string } = {}
			for index = 2, #words do
				if words[index] ~= "" then
					table.insert(arguments, words[index])
				end
			end

			onAdminCommand(player, arguments)
		end)
	end)

	if not ok then
		warn(`[Admin] 명령 등록 실패: {err}`)
		return
	end

	print(`[Admin] 관리자 {#GameConfig.ADMIN_USER_IDS}명, 명령 등록 완료`)
end

function AdminService.getAuditLog(): { string }
	return table.clone(auditLog)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">AnalyticsService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	AnalyticsService — 경제 이벤트(골드 source/sink)와 퍼널 이벤트를 기록한다.

	지금은 서버 로그(print)로만 남긴다. 중요한 건 "모든 재화 증감이 반드시
	이 모듈을 거친다"는 구조이고, 실제 전송 대상은 나중에 한 곳만 바꾸면 된다.

	[확인 필요 / Phase 4 이후] Roblox 내장 AnalyticsService 의
	LogEconomyEvent 시그니처를 공식 문서에서 확인한 뒤 sendToRoblox() 안에서 연결할 것.
	문서를 확인하기 전에는 추측해서 호출하지 않는다.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EconomyConfig = require(Shared:WaitForChild("Config"):WaitForChild("EconomyConfig"))

local AnalyticsService = {}
AnalyticsService.Name = "AnalyticsService"

export type Currency = "gold" | "shards" | "tickets"

-- 이상 탐지용 누적 기록: userId → { windowStart, gained }
type AnomalyRecord = { windowStart: number, gained: number }
local anomalyByUser: { [number]: AnomalyRecord } = {}

-- 관리자 확인용으로 서버 메모리에 남겨 두는 최근 이상 기록
local anomalyLog: { string } = {}
local MAX_ANOMALY_LOG = 100

local function sendToRoblox(_eventName: string, _payload: { [string]: any })
	-- [확인 필요] 공식 문서 확인 후 Roblox AnalyticsService 호출을 여기에 추가한다.
end

--[[
	재화 증감 기록. amount 가 양수면 획득(source), 음수면 소비(sink).
	reason 은 "enhance_cost", "enhance_destroy_shards", "daily_login" 같은 고정 문자열.
]]
function AnalyticsService.logCurrency(
	player: Player,
	currency: Currency,
	amount: number,
	reason: string,
	balanceAfter: number
)
	if amount == 0 then
		return
	end

	local direction = if amount > 0 then "source" else "sink"
	print(`[Economy] {player.UserId} {currency} {direction} {amount} ({reason}) → {balanceAfter}`)

	sendToRoblox("currency", {
		userId = player.UserId,
		currency = currency,
		amount = amount,
		reason = reason,
		balanceAfter = balanceAfter,
	})

	-- 서버가 계산한 큰 보상(경주)은 이상 탐지에서 뺀다. 넣으면 정상 유저마다 경고가 울린다.
	if currency == "gold" and amount > 0 and not EconomyConfig.ANOMALY_EXEMPT_REASONS[reason] then
		AnalyticsService.trackGoldGain(player, amount)
	end
end

-- 튜토리얼/퍼널 단계 기록
function AnalyticsService.logFunnel(player: Player, step: string, detail: { [string]: any }?)
	print(`[Funnel] {player.UserId} {step}`)
	sendToRoblox("funnel", { userId = player.UserId, step = step, detail = detail })
end

-- 강화 결과 분포 기록 (실제 확률이 설계대로 나오는지 라이브에서 확인하기 위함)
function AnalyticsService.logEnhance(player: Player, level: number, outcome: string, cost: number)
	print(`[Enhance] {player.UserId} +{level} → {outcome} (비용 {cost})`)
	sendToRoblox("enhance", {
		userId = player.UserId,
		level = level,
		outcome = outcome,
		cost = cost,
	})
end

--[[
	짧은 시간에 골드가 비정상적으로 늘면 기록해 둔다.
	치트/버그 탐지용이며, 자동으로 제재하지는 않는다(오탐 위험).
]]
function AnalyticsService.trackGoldGain(player: Player, amount: number)
	local now = os.time()
	local record = anomalyByUser[player.UserId]

	if not record or now - record.windowStart > EconomyConfig.ANOMALY_WINDOW_SECONDS then
		record = { windowStart = now, gained = 0 }
		anomalyByUser[player.UserId] = record
	end

	record.gained += amount

	if record.gained >= EconomyConfig.ANOMALY_GOLD_DELTA then
		local message = string.format(
			"[Anomaly] %d 가 %d초 안에 골드 %d 획득",
			player.UserId,
			EconomyConfig.ANOMALY_WINDOW_SECONDS,
			record.gained
		)
		warn(message)
		table.insert(anomalyLog, message)
		if #anomalyLog > MAX_ANOMALY_LOG then
			table.remove(anomalyLog, 1)
		end

		-- 같은 창에서 반복 경고가 쏟아지지 않도록 초기화
		record.windowStart = now
		record.gained = 0
	end
end

-- AdminService 가 조회한다.
function AnalyticsService.getAnomalyLog(): { string }
	return table.clone(anomalyLog)
end

function AnalyticsService.clearPlayer(userId: number)
	anomalyByUser[userId] = nil
end

function AnalyticsService.Init() end

function AnalyticsService.Start()
	local Players = game:GetService("Players")
	Players.PlayerRemoving:Connect(function(player)
		AnalyticsService.clearPlayer(player.UserId)
	end)
end

return AnalyticsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">ChatCommandService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ChatCommandService — 채팅 텍스트 명령어.

	버튼과 명령어는 "같은 서버 경로"를 탄다. 명령어 처리기는 직접 데이터를
	건드리지 않고 EnhanceService 의 공개 함수를 호출하므로, 검증·레이트 리밋·락이
	버튼과 똑같이 적용된다.

	확인한 공식 문서 내용:
	- TextChatCommand 는 TextChatService 아래에 있어야 동작한다.
	- Triggered(originTextSource: TextSource, unfilteredText: string) 는
	  서버 Script 에서 연결하는 것이 공식 예제의 방식이고,
	  textSource.UserId 로 Players:GetPlayerByUserId() 해서 플레이어를 얻는다.
	- TextChannel:DisplaySystemMessage() 는 클라이언트에서만 호출할 수 있으므로,
	  명령 결과 안내는 서버가 리모트로 보내고 클라이언트가 채팅에 표시한다.

	[확인 필요] TextChatCommand 인스턴스를 서버에서 런타임에 만들어 붙이는 방식은
	Studio 에서 한 번 확인해 줘. 공식 예제는 Studio 에서 미리 만들어 둔 인스턴스를
	WaitForChild 로 찾는 형태였다. 만약 런타임 생성이 동작하지 않으면
	Studio 의 TextChatService 아래에 TextChatCommand 를 직접 만들고
	아래 COMMANDS 의 이름과 맞추면 된다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))

local services = script.Parent
local DataService = require(services:WaitForChild("DataService"))
local EnhanceService = require(services:WaitForChild("EnhanceService"))

local ChatCommandService = {}
ChatCommandService.Name = "ChatCommandService"

local feedRemote: RemoteEvent? = nil

type CommandSpec = {
	name: string,
	primary: string,
	secondary: string,
	handler: (player: Player, arguments: { string }) -> (),
}

local function languageOf(player: Player): string
	local data = DataService.getData(player)
	if data and data.settings and data.settings.language then
		return data.settings.language
	end
	return Locale.DEFAULT_LANGUAGE
end

-- 명령 결과를 그 플레이어에게만 보낸다. 클라이언트가 채팅창에 표시한다.
local function reply(player: Player, text: string)
	if feedRemote == nil then
		return
	end
	feedRemote:FireClient(player, { kind = "system", text = text })
end

local function replyKey(player: Player, key: string, ...: any)
	reply(player, Locale.get(languageOf(player), key, ...))
end

local function onEnhanceCommand(player: Player, arguments: { string })
	-- "/강화 보호" 처럼 뒤에 보호 옵션을 붙일 수 있다.
	local wantsProtect = false
	for _, argument in arguments do
		local lowered = string.lower(argument)
		if lowered == "보호" or lowered == "protect" then
			wantsProtect = true
		end
	end

	local response = EnhanceService.requestEnhance(player, wantsProtect)

	if not response.ok then
		replyKey(player, `error.{response.reason}`)
		return
	end

	replyKey(player, `chat.result.{response.result}`, response.newLevel)
end

local function onOddsCommand(player: Player)
	local data = DataService.getData(player)
	if data == nil then
		replyKey(player, "error.not_ready")
		return
	end

	local odds = EnhanceService.getDisplayOdds(data)

	if odds.cost <= 0 then
		replyKey(player, "ui.maxLevel")
		return
	end

	replyKey(
		player,
		"chat.odds",
		odds.level,
		Format.percent(odds.success),
		Format.percent(odds.keep),
		Format.percent(odds.fail),
		Format.comma(odds.cost)
	)
end

local function onInfoCommand(player: Player)
	local data = DataService.getData(player)
	if data == nil then
		replyKey(player, "error.not_ready")
		return
	end

	replyKey(
		player,
		"chat.info",
		EnhanceService.getDisplayOdds(data).level,
		Format.comma(data.gold),
		Format.comma(data.shards),
		data.protectTickets,
		data.stats.enhanceTries,
		data.stats.destroyed,
		data.stats.highestLevel
	)
end

local function onHelpCommand(player: Player)
	replyKey(player, "chat.help")
end

local COMMANDS: { CommandSpec } = {
	{
		name = "ForgeEnhanceCommand",
		primary = "/강화",
		secondary = "/enhance",
		handler = onEnhanceCommand,
	},
	{
		name = "ForgeOddsCommand",
		primary = "/확률",
		secondary = "/odds",
		handler = function(player, _)
			onOddsCommand(player)
		end,
	},
	{
		name = "ForgeInfoCommand",
		primary = "/정보",
		secondary = "/info",
		handler = function(player, _)
			onInfoCommand(player)
		end,
	},
	{
		name = "ForgeHelpCommand",
		primary = "/도움말",
		secondary = "/forgehelp",
		handler = function(player, _)
			onHelpCommand(player)
		end,
	},
}

local function register(spec: CommandSpec)
	local existing = TextChatService:FindFirstChild(spec.name)
	local command = if existing and existing:IsA("TextChatCommand")
		then existing
		else Instance.new("TextChatCommand")

	command.Name = spec.name
	command.PrimaryAlias = spec.primary
	command.SecondaryAlias = spec.secondary
	command.AutocompleteVisible = true
	command.Enabled = true
	command.Parent = TextChatService

	command.Triggered:Connect(function(textSource: TextSource, message: string)
		local player = Players:GetPlayerByUserId(textSource.UserId)
		if player == nil then
			return
		end

		-- 첫 토큰은 명령어 자체이므로 버린다.
		local words = string.split(message, " ")
		local arguments: { string } = {}
		for index = 2, #words do
			if words[index] ~= "" then
				table.insert(arguments, words[index])
			end
		end

		local ok, err = xpcall(spec.handler, debug.traceback, player, arguments)
		if not ok then
			warn(`[ChatCommandService] {spec.primary} 처리 중 오류:\n{err}`)
			replyKey(player, "error.unknown")
		end
	end)
end

function ChatCommandService.Init()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	feedRemote = remotesFolder:WaitForChild(Remotes.Events.FeedMessage) :: RemoteEvent
end

function ChatCommandService.Start()
	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		warn(
			"[ChatCommandService] TextChatService 가 아닌 레거시 채팅이 켜져 있어 "
				.. "텍스트 명령어를 등록하지 않았습니다. "
				.. "게임 설정에서 ChatVersion 을 TextChatService 로 바꿔 주세요."
		)
		return
	end

	for _, spec in COMMANDS do
		local ok, err = pcall(register, spec)
		if not ok then
			warn(`[ChatCommandService] {spec.primary} 등록 실패: {err}`)
		end
	end

	print(`[ChatCommandService] 명령어 {#COMMANDS}개 등록`)
end

return ChatCommandService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">CodexService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CodexService — 도감 기록 (통합 기획서 5-5절).

	(Roblox 내장 CollectionService 와 이름이 겹치지 않도록 Codex 로 이름을 잡았다.)

	- 검 1종 = 1칸. 칸에는 그 검의 역대 최고 레벨(sword.bestLevel)을 보여 준다.
	- 검마다 5·10·15·20강을 처음 달성하면 codex["검id:구간"] 에 기록한다.
	- [미정 D16] 기념으로 주는 영구 업그레이드는 아직 없다. 기록만 남긴다.
	  수치가 정해지면 이 기록을 읽어서 효과를 주면 된다(예전에 달성한 것도 그대로 인정된다).

	도감 화면은 클라이언트가 복제받은 데이터(swords, codex)로 직접 그린다. 리모트는 없다.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Locale = require(Shared:WaitForChild("Locale"))

local ConfigFolder = Shared:WaitForChild("Config")
local Weapons = require(ConfigFolder:WaitForChild("Weapons"))

local services = script.Parent
local AnalyticsService = require(services:WaitForChild("AnalyticsService"))

local CodexService = {}
CodexService.Name = "CodexService"

local feedRemote: RemoteEvent? = nil

--[[
	검의 레벨이 올랐을 때 최고 레벨과 구간 기록을 갱신한다. yield 하지 않는다.
	반환값은 이번에 새로 달성한 구간 수.
]]
function CodexService.recordSwordLevel(
	player: Player,
	data: Types.PlayerData,
	sword: Types.SwordState
): number
	if sword.level > sword.bestLevel then
		sword.bestLevel = sword.level
	end

	local unlocked = 0

	for _, milestone in Weapons.CODEX_MILESTONES do
		if sword.bestLevel < milestone then
			continue
		end

		local key = `{sword.id}:{milestone}`
		if data.codex[key] then
			continue
		end

		data.codex[key] = true
		unlocked += 1

		if feedRemote then
			local language = data.settings.language
			local info = Weapons.get(sword.id)
			local name = if info then Locale.get(language, info.nameKey) else sword.id

			feedRemote:FireClient(player, {
				kind = "system",
				text = Locale.get(language, "codex.unlocked", name, milestone),
			})
		end

		AnalyticsService.logFunnel(player, "codex_unlocked", { key = key })
	end

	return unlocked
end

function CodexService.Init()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	feedRemote = remotesFolder:WaitForChild(Remotes.Events.FeedMessage) :: RemoteEvent
end

return CodexService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">CourseBuilder</string>
            <string name="Source"><![CDATA[--!strict
--[[
	CourseBuilder — 경주 코스 "쇳물 수로" 한 판을 블록으로 짓는 유틸 (통합 기획서 4-1·8-2절).

	생명주기(Init/Start)가 없어서 부트스트랩 순서 목록에 넣지 않는다. RaceService 만 쓴다.

	무엇을 어디에 놓을지(장애물 종류·위치)는 Pure/RaceLogic.generateObstacles 가 정하고,
	여기서는 그 목록을 받아 파트로 만들기만 한다.
	  바닥 = 검은 돌, 양쪽 가장자리 = 갈라진 틈처럼 빛나는 쇳물 줄, 벽 = 낮은 돌벽 + 보이지 않는 벽
	  100칸마다 바닥 문양 띠와 숫자판, 500칸마다 화로 아치
	  장애물: 식은 쇳덩이(옆으로 피함) · 쇳물 홈(뛰어넘음) · 거푸집 벽(틈으로 지나감)
	  출발선: 흰 선, 쇠창살(보기만, 부딪히지 않음), 화로 3개 (카운트다운에 맞춰 기기가 켠다)
	  추격자 = 쇳물 해일: 네온 벽 + 불 + 불티 + 강한 빛. 출렁이는 꼭대기 같은 장식은 기기가 붙인다.

	좌표: origin 이 출발선 가운데의 바닥 윗면이다. 코스는 +Z 방향으로 뻗는다.
	추격자는 서버가 매 프레임 옮기는 큰 벽이다. 닿아서 잡는 게 아니라 서버가 위치를 비교해 잡는다
	(그래서 추격자 파트는 부딪히지 않는다).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ConfigFolder = Shared:WaitForChild("Config")
local World = require(ConfigFolder:WaitForChild("World"))
local Palette = require(ConfigFolder:WaitForChild("Palette"))
local RaceLogic = require(Shared:WaitForChild("Pure"):WaitForChild("RaceLogic"))

local CourseBuilder = {}

export type Built = {
	folder: Folder,
	chaser: Part,
	origin: Vector3,
	length: number,
	trackWidth: number,
}

local W = Palette.WORLD
local function rgb(values: { number }): Color3
	return Color3.fromRGB(values[1], values[2], values[3])
end

local FLOOR_A = { 38, 34, 42 }
local FLOOR_B = { 32, 29, 36 }

local function makePart(
	parent: Instance,
	name: string,
	size: Vector3,
	position: Vector3,
	color: { number },
	material: Enum.Material?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanTouch = false
	part.Size = size
	part.Position = position
	part.Color = rgb(color)
	part.Material = material or Enum.Material.Slate
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function glow(part: Part, transparency: number?): Part
	part.Material = Enum.Material.Neon
	part.CanCollide = false
	part.CastShadow = false
	part.Transparency = transparency or 0
	return part
end

-- 바닥 · 쇳물 줄 · 돌벽 · 보이지 않는 벽을 zFrom ~ zTo 구간에 놓는다.
local function buildSegment(
	parent: Instance,
	origin: Vector3,
	trackWidth: number,
	zFrom: number,
	zTo: number,
	index: number
)
	local course = World.COURSE
	local length = zTo - zFrom
	local centerZ = origin.Z + (zFrom + zTo) / 2

	makePart(
		parent,
		`Floor{index}`,
		Vector3.new(trackWidth, course.floorThickness, length),
		Vector3.new(origin.X, origin.Y - course.floorThickness / 2, centerZ),
		if index % 2 == 0 then FLOOR_A else FLOOR_B
	)

	for side = -1, 1, 2 do
		local edgeX = origin.X + side * (trackWidth / 2 - 0.4)
		glow(
			makePart(
				parent,
				`Crack{index}`,
				Vector3.new(0.5, 0.06, length),
				Vector3.new(edgeX, origin.Y + 0.03, centerZ),
				W.molten
			),
			0.15
		)

		local wallX = origin.X + side * (trackWidth / 2 + course.wallThickness / 2)
		makePart(
			parent,
			`Wall{index}`,
			Vector3.new(course.wallThickness, course.solidWallHeight, length),
			Vector3.new(wallX, origin.Y + course.solidWallHeight / 2, centerZ),
			W.stone
		)
		local barrier = makePart(
			parent,
			`Barrier{index}`,
			Vector3.new(course.wallThickness, course.wallHeight - course.solidWallHeight, length),
			Vector3.new(
				wallX,
				origin.Y + course.solidWallHeight + (course.wallHeight - course.solidWallHeight) / 2,
				centerZ
			),
			W.stone
		)
		barrier.Transparency = 1
		barrier.CastShadow = false
	end
end

-- 100칸마다: 바닥 문양 띠 + 왼쪽 벽 위 숫자판
local function buildMarker(parent: Instance, origin: Vector3, trackWidth: number, z: number)
	glow(
		makePart(
			parent,
			`Marker{z}`,
			Vector3.new(trackWidth - 1, 0.08, 0.8),
			Vector3.new(origin.X, origin.Y + 0.04, origin.Z + z),
			W.ember
		),
		0.35
	)

	local plate = makePart(
		parent,
		`MarkerPlate{z}`,
		Vector3.new(0.4, 2.4, 4.4),
		Vector3.new(
			origin.X - trackWidth / 2 - 0.2,
			origin.Y + World.COURSE.solidWallHeight + 1.4,
			origin.Z + z
		),
		W.wood,
		Enum.Material.WoodPlanks
	)
	plate.CanCollide = false

	-- 숫자만 쓰므로 언어와 상관없이 서버가 붙인다 (오른쪽 면 = 트랙 쪽)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Right
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = plate
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = rgb(W.gold)
	label.Text = tostring(z)
	label.Parent = gui
end

-- 500칸마다: 돌기둥 두 개 + 윗돌 + 화로 두 개
local function buildArch(parent: Instance, origin: Vector3, trackWidth: number, z: number)
	local height = 14
	for side = -1, 1, 2 do
		local x = origin.X + side * (trackWidth / 2 - 1.5)
		makePart(
			parent,
			"ArchPillar",
			Vector3.new(3, height, 3),
			Vector3.new(x, origin.Y + height / 2, origin.Z + z),
			W.stone
		)
		local bowl = makePart(
			parent,
			"ArchBrazier",
			Vector3.new(2, 1, 2),
			Vector3.new(x, origin.Y + height + 0.5, origin.Z + z),
			W.iron,
			Enum.Material.Metal
		)
		local flame = Instance.new("Fire")
		flame.Color = rgb(W.molten)
		flame.SecondaryColor = rgb(W.moltenHot)
		flame.Size = 4
		flame.Parent = bowl
	end
	makePart(
		parent,
		"ArchLintel",
		Vector3.new(trackWidth, 2.5, 3),
		Vector3.new(origin.X, origin.Y + height - 1.25, origin.Z + z),
		W.stone
	)
end

-- 출발선: 흰 선 · 쇠창살 · 화로 3개
local function buildStart(parent: Instance, origin: Vector3, trackWidth: number)
	local course = World.COURSE
	glow(
		makePart(
			parent,
			"StartLine",
			Vector3.new(trackWidth, 0.1, 1.6),
			Vector3.new(origin.X, origin.Y + 0.05, origin.Z),
			{ 240, 236, 230 }
		),
		0
	)

	-- 쇠창살 (출발 신호 전에는 어차피 움직일 수 없으므로 보기만 한다)
	for index = 1, course.startBars do
		local x = origin.X - trackWidth / 2 + (index - 0.5) * trackWidth / course.startBars
		local bar = makePart(
			parent,
			"StartBar",
			Vector3.new(0.5, 8, 0.5),
			Vector3.new(x, origin.Y + 4, origin.Z + 1.5),
			W.iron,
			Enum.Material.Metal
		)
		bar.CanCollide = false
	end

	-- 출발 아치 + 화로 3개 (3·2·1 에 하나씩 켜진다)
	buildArch(parent, origin, trackWidth, -3)
	for index = 1, 3 do
		local x = origin.X + (index - 2) * 6
		local bowl = makePart(
			parent,
			`StartBrazier{index}`,
			Vector3.new(2, 1, 2),
			Vector3.new(x, origin.Y + 14.5, origin.Z - 3),
			W.iron,
			Enum.Material.Metal
		)
		local flame = Instance.new("Fire")
		flame.Name = "CountFire"
		flame.Color = rgb(W.molten)
		flame.SecondaryColor = rgb(W.moltenHot)
		flame.Size = 4
		flame.Enabled = false
		flame.Parent = bowl
	end
end

local function buildObstacle(
	parent: Instance,
	origin: Vector3,
	trackWidth: number,
	obstacle: RaceLogic.Obstacle,
	index: number
)
	local course = World.COURSE
	local z = origin.Z + obstacle.z

	if obstacle.kind == "block" then
		-- 식은 쇳덩이 + 윗면 모서리 열기 줄
		makePart(
			parent,
			`Block{index}`,
			Vector3.new(obstacle.width, course.blockHeight, course.blockDepth),
			Vector3.new(origin.X + obstacle.x, origin.Y + course.blockHeight / 2, z),
			W.iron,
			Enum.Material.Metal
		)
		glow(
			makePart(
				parent,
				`BlockSeam{index}`,
				Vector3.new(obstacle.width + 0.1, 0.25, 0.3),
				Vector3.new(
					origin.X + obstacle.x,
					origin.Y + course.blockHeight - 0.2,
					z - course.blockDepth / 2
				),
				W.moltenHot
			),
			0.1
		)
	elseif obstacle.kind == "hurdle" then
		-- 쇳물 홈: 낮은 쇠 막대 + 밑에서 새어 나오는 주황 빛 ("뜨거우니 넘어라")
		makePart(
			parent,
			`Hurdle{index}`,
			Vector3.new(obstacle.width, course.hurdleHeight, course.hurdleDepth),
			Vector3.new(origin.X + obstacle.x, origin.Y + course.hurdleHeight / 2, z),
			W.iron,
			Enum.Material.Metal
		)
		glow(
			makePart(
				parent,
				`HurdleGlow{index}`,
				Vector3.new(obstacle.width, 0.08, course.hurdleDepth + 2),
				Vector3.new(origin.X + obstacle.x, origin.Y + 0.05, z),
				W.molten
			),
			0.25
		)
	else
		-- 거푸집 벽: 틈 양쪽을 막고, 틈 가장자리에 등불 (멀리서도 틈이 보이게)
		local half = trackWidth / 2
		local gapLeft = obstacle.x - obstacle.width / 2
		local gapRight = obstacle.x + obstacle.width / 2

		local leftWidth = gapLeft + half
		if leftWidth > 0.5 then
			makePart(
				parent,
				`Gate{index}L`,
				Vector3.new(leftWidth, course.gateHeight, course.gateDepth),
				Vector3.new(origin.X + (-half + gapLeft) / 2, origin.Y + course.gateHeight / 2, z),
				W.stone
			)
		end
		local rightWidth = half - gapRight
		if rightWidth > 0.5 then
			makePart(
				parent,
				`Gate{index}R`,
				Vector3.new(rightWidth, course.gateHeight, course.gateDepth),
				Vector3.new(origin.X + (gapRight + half) / 2, origin.Y + course.gateHeight / 2, z),
				W.stone
			)
		end
		for _, edge in { gapLeft, gapRight } do
			glow(
				makePart(
					parent,
					`Lantern{index}`,
					Vector3.new(0.8, 1.2, 0.8),
					Vector3.new(
						origin.X + edge,
						origin.Y + course.gateHeight - 1.5,
						z - course.gateDepth / 2 - 0.5
					),
					W.gold
				),
				0
			)
		end
	end
end

--[[
	코스 한 판을 짓는다.
	headStart: 출발할 때 추격자가 출발선보다 뒤에 있는 거리 (그 뒤쪽까지 바닥을 깐다).
]]
function CourseBuilder.build(
	parent: Instance,
	raceId: number,
	origin: Vector3,
	length: number,
	headStart: number,
	trackWidth: number,
	obstacles: { RaceLogic.Obstacle }
): Built
	local course = World.COURSE

	local folder = Instance.new("Folder")
	folder.Name = `{World.RACE_FOLDER_PREFIX}{raceId}`

	-- 출발선 뒤쪽 (추격자가 달려오는 구간)
	local backZ = -(headStart + course.backExtra)
	buildSegment(folder, origin, trackWidth, backZ, 0, 0)

	local index = 1
	local z = 0
	while z < length do
		local nextZ = math.min(length, z + course.segmentLength)
		buildSegment(folder, origin, trackWidth, z, nextZ, index)
		z = nextZ
		index += 1
	end

	-- 앞뒤 끝을 막는 벽
	local outerWidth = trackWidth + course.wallThickness * 2
	for _, endZ in { backZ - course.wallThickness / 2, length + course.wallThickness / 2 } do
		makePart(
			folder,
			"EndWall",
			Vector3.new(outerWidth, course.wallHeight, course.wallThickness),
			Vector3.new(origin.X, origin.Y + course.wallHeight / 2, origin.Z + endZ),
			W.stone
		)
	end

	buildStart(folder, origin, trackWidth)

	local marker = course.markerEvery
	while marker < length do
		buildMarker(folder, origin, trackWidth, marker)
		if marker % course.archEvery == 0 then
			buildArch(folder, origin, trackWidth, marker + 3)
		end
		marker += course.markerEvery
	end

	for obstacleIndex, obstacle in obstacles do
		buildObstacle(folder, origin, trackWidth, obstacle, obstacleIndex)
	end

	-- 쇳물 해일
	local chaser = makePart(
		folder,
		World.CHASER_NAME,
		Vector3.new(outerWidth, course.chaserHeight, course.chaserDepth),
		Vector3.new(origin.X, origin.Y + course.chaserHeight / 2, origin.Z),
		W.molten,
		Enum.Material.Neon
	)
	chaser.CanCollide = false
	chaser.CastShadow = false
	chaser.Transparency = 0.15

	local flame = Instance.new("Fire")
	flame.Color = rgb(W.molten)
	flame.SecondaryColor = rgb(W.moltenHot)
	flame.Size = 25
	flame.Heat = 20
	flame.Parent = chaser

	local embers = Instance.new("ParticleEmitter")
	embers.Name = "Embers"
	embers.Color = ColorSequence.new(rgb(W.moltenHot))
	embers.LightEmission = 1
	embers.Rate = 40
	embers.Lifetime = NumberRange.new(1, 2)
	embers.Speed = NumberRange.new(6, 14)
	embers.SpreadAngle = Vector2.new(40, 40)
	embers.Acceleration = Vector3.new(0, 6, 0)
	embers.Size = NumberSequence.new(0.5, 0)
	embers.EmissionDirection = Enum.NormalId.Front
	embers.Parent = chaser

	local chaserLight = Instance.new("PointLight")
	chaserLight.Color = rgb(W.molten)
	chaserLight.Range = 60
	chaserLight.Brightness = 3
	chaserLight.Parent = chaser

	local built: Built = {
		folder = folder,
		chaser = chaser,
		origin = origin,
		length = length,
		trackWidth = trackWidth,
	}

	CourseBuilder.moveChaser(built, -headStart)

	folder.Parent = parent
	return built
end

-- 추격자 앞면을 출발선 기준 front 칸 위치로 옮긴다. (앞면 = +Z 쪽 면, 파트의 Back 면)
function CourseBuilder.moveChaser(built: Built, front: number)
	local course = World.COURSE
	local origin = built.origin

	built.chaser.CFrame = CFrame.new(
		origin.X,
		origin.Y + course.chaserHeight / 2,
		origin.Z + front - course.chaserDepth / 2
	) * CFrame.Angles(0, math.pi, 0) -- Front 면(불티 나오는 쪽)이 +Z 를 보게
end

-- 출발선 위, 트랙 중심에서 offsetX 만큼 옆에 서서 코스 앞쪽(+Z)을 보는 자리
function CourseBuilder.lineupCFrame(built: Built, offsetX: number): CFrame
	local origin = built.origin
	local position = Vector3.new(origin.X + offsetX, origin.Y + World.COURSE.spawnHeight, origin.Z)
	return CFrame.lookAt(position, position + Vector3.new(0, 0, 1))
end

function CourseBuilder.destroy(built: Built)
	built.folder:Destroy()
end

return CourseBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DataService — 플레이어 데이터의 단일 진입점.

	ProfileStore 로 세션 락이 걸린 프로필을 열고, 다른 서비스는 전부
	이 모듈을 통해서만 데이터를 읽고 쓴다.

	중요한 규칙:
	- 로드에 실패하면 기본값으로 덮어쓰지 않고 Kick 한다. (데이터 유실 방지)
	- Studio 는 _DEV 스토어, 라이브는 _PROD 스토어를 쓴다. 절대 섞지 않는다.
	- 서버 종료 시 저장 대기는 ProfileStore 가 내부 game:BindToClose 에서
	  모든 활성 프로필의 저장이 끝날 때까지 기다린다. 여기서 따로 BindToClose 를
	  걸면 같은 일을 두 번 하게 되므로 걸지 않는다.
	- getActiveData() 로 받은 테이블은 "yield 하지 않고" 즉시 수정해야 한다.
	  (task.wait, WaitForChild 등을 끼우면 그 사이 세션이 끝날 수 있다)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Locale = require(Shared:WaitForChild("Locale"))

local ConfigFolder = Shared:WaitForChild("Config")
local GameConfig = require(ConfigFolder:WaitForChild("Game"))
local EconomyConfig = require(ConfigFolder:WaitForChild("EconomyConfig"))
local Weapons = require(ConfigFolder:WaitForChild("Weapons"))
local Products = require(ConfigFolder:WaitForChild("Products"))
local EnhanceTable = require(ConfigFolder:WaitForChild("EnhanceTable"))

local DataMigration = require(Shared:WaitForChild("Pure"):WaitForChild("DataMigration"))

local DataService = {}
DataService.Name = "DataService"

-- ProfileStore 는 require 로 가져오므로 정적 타입이 붙지 않는다.
type Profile = any

local profiles: { [Player]: Profile } = {}
local loadedListeners: { (player: Player, data: Types.PlayerData) -> () } = {}
local unloadingListeners: { (player: Player, data: Types.PlayerData) -> () } = {}

local playerStore: any = nil
local dataChangedRemote: RemoteEvent? = nil

--[[
	ProfileStore 모듈을 가져온다.

	두 위치를 순서대로 찾는다.
	  1) ServerScriptService/Server/vendor/ProfileStore  (저장소에 포함된 사본)
	  2) ServerStorage/ServerPackages/ProfileStore        (Wally 로 설치한 경우)

	둘 다 없으면 무엇을 해야 하는지 알려 주고 멈춘다.
	(WaitForChild 로 조용히 영원히 기다리면 원인을 찾기 어렵다.)
]]
local function requireProfileStore(): any
	-- 1) 저장소에 포함된 사본. services 폴더의 형제인 vendor 폴더에 있다.
	local serverRoot = script.Parent.Parent
	local vendor = serverRoot and serverRoot:FindFirstChild("vendor")
	local vendored = vendor and vendor:FindFirstChild("ProfileStore")

	if vendored and vendored:IsA("ModuleScript") then
		return require(vendored)
	end

	-- 2) Wally 로 설치한 경우
	local packages = ServerStorage:FindFirstChild("ServerPackages")
	local installed = packages and packages:FindFirstChild("ProfileStore")

	if installed and installed:IsA("ModuleScript") then
		return require(installed)
	end

	error(
		"[DataService] ProfileStore 모듈을 찾을 수 없습니다.\n"
			.. "Rojo 동기화가 제대로 됐는지 확인해 주세요.\n"
			.. "(ServerScriptService/Server/vendor/ProfileStore 에 있어야 합니다)",
		0
	)
end

--[[
	새 플레이어의 기본 데이터. ProfileStore 가 이 표를 깊은 복사해서 쓴다.

	battleWins / battleLosses / rating / keepStreak / bestKeepStreak / ticketsUsed,
	achievements, daily.battlesToday / opponentsToday 는 기획에서 빠진 기능(1:1 배틀, 업적)의
	필드다. 저장 스키마를 그대로 두려고 남겨 두었고, 코드는 더 이상 읽지도 쓰지도 않는다.

	swords 는 빈 표로 두고, 기본 검은 DataMigration.repair 가 넣는다.
	(템플릿에 넣으면 Reconcile 이 옛 데이터의 swords 에도 끼워 넣어 마이그레이션과 엉킨다.)
	v3 까지의 weapon 필드는 템플릿에 없다. 옛 데이터에만 남아 있다.
]]
local function buildTemplate(): Types.PlayerData
	return {
		schemaVersion = Types.SCHEMA_VERSION,
		gold = EconomyConfig.STARTING_GOLD,
		shards = EconomyConfig.STARTING_SHARDS,
		swords = {},
		equippedId = Weapons.DEFAULT_ID,
		swordCapacity = 1,
		pityPoints = 0,
		protectTickets = EconomyConfig.STARTING_PROTECT_TICKETS,
		stats = {
			enhanceTries = 0,
			enhanceSuccess = 0,
			destroyed = 0,
			highestLevel = 0,
			battleWins = 0,
			battleLosses = 0,
			rating = 1000,
			keepStreak = 0,
			bestKeepStreak = 0,
			ticketsUsed = 0,
		},
		codex = {},
		achievements = {},
		daily = {
			lastLoginDay = 0,
			streak = 0,
			battlesToday = 0,
			opponentsToday = {},
		},
		purchaseHistory = {} :: { string },
		settings = {
			sfx = true,
			language = GameConfig.DEFAULT_LANGUAGE,
		},
	}
end

-- 저장된 데이터를 현재 스키마로 올린다. 실제 단계는 Pure/DataMigration 에 있다(테스트 대상).
local MIGRATION_OPTIONS: DataMigration.Options = {
	schemaVersion = Types.SCHEMA_VERSION,
	purchaseHistoryLimit = Products.PURCHASE_HISTORY_LIMIT,
	defaultWeaponId = Weapons.DEFAULT_ID,
	maxLevel = EnhanceTable.MAX_LEVEL,
	isKnownWeapon = function(id: string): boolean
		return Weapons.get(id) ~= nil
	end,
}

local function migrate(data: Types.PlayerData): Types.PlayerData
	local _, isNewer = DataMigration.migrate(data, MIGRATION_OPTIONS)

	if isNewer then
		warn(
			`[DataService] 저장된 스키마 버전({data.schemaVersion})이 코드 버전({Types.SCHEMA_VERSION})보다 높습니다`
		)
	end

	return data
end

local function fire(
	listeners: { (Player, Types.PlayerData) -> () },
	player: Player,
	data: Types.PlayerData
)
	for _, listener in listeners do
		local ok, err = xpcall(listener, debug.traceback, player, data)
		if not ok then
			warn(`[DataService] 리스너 오류:\n{err}`)
		end
	end
end

--[[
	클라이언트에 현재 데이터를 보낸다.
	RemoteEvent 로 보내는 순간 테이블이 복사되므로 서버 테이블이 노출되지는 않는다.
]]
function DataService.replicate(player: Player)
	local profile = profiles[player]
	if not profile or not dataChangedRemote then
		return
	end
	dataChangedRemote:FireClient(player, profile.Data)
end

-- 세션이 살아 있을 때만 데이터를 준다. 반환값은 yield 없이 즉시 수정할 것.
function DataService.getActiveData(player: Player): Types.PlayerData?
	local profile = profiles[player]
	if not profile or not profile:IsActive() then
		return nil
	end
	return profile.Data
end

-- 읽기 전용 용도(세션이 끝나가는 중일 수도 있음)
function DataService.getData(player: Player): Types.PlayerData?
	local profile = profiles[player]
	return if profile then profile.Data else nil
end

function DataService.isReady(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile:IsActive()
end

function DataService.getProfile(player: Player): Profile
	return profiles[player]
end

-- 구매 등 중요한 변경 직후 즉시 저장하고 싶을 때만 쓴다(DataStore 호출 1회).
function DataService.saveNow(player: Player)
	local profile = profiles[player]
	if profile and profile:IsActive() then
		profile:Save()
	end
end

function DataService.onLoaded(listener: (player: Player, data: Types.PlayerData) -> ())
	table.insert(loadedListeners, listener)

	-- 이미 로드된 플레이어에게도 바로 알려 준다(서비스 등록 순서에 의존하지 않도록).
	for player, profile in profiles do
		task.spawn(listener, player, profile.Data)
	end
end

function DataService.onUnloading(listener: (player: Player, data: Types.PlayerData) -> ())
	table.insert(unloadingListeners, listener)
end

function DataService.getAllActive(): { [Player]: Types.PlayerData }
	local result: { [Player]: Types.PlayerData } = {}
	for player, profile in profiles do
		if profile:IsActive() then
			result[player] = profile.Data
		end
	end
	return result
end

local function onPlayerAdded(player: Player)
	local profile = playerStore:StartSessionAsync(tostring(player.UserId), {
		Cancel = function()
			return player.Parent ~= Players
		end,
	})

	if profile == nil then
		-- 다른 서버가 동시에 같은 프로필 세션을 잡으려 한 드문 경우.
		player:Kick(Locale.get(nil, "error.load_fail"))
		return
	end

	profile:AddUserId(player.UserId) -- GDPR: 데이터 삭제 요청 대응
	profile:Reconcile() -- 템플릿에 새로 생긴 키 채우기
	migrate(profile.Data)

	--[[
		세션이 "밖에서" 끝난 경우(다른 서버가 같은 프로필을 열었을 때 등)만 처리한다.
		우리가 EndSession() 을 부른 경우에는 그 전에 profiles[player] 를 비워 두므로
		여기서 아무 일도 하지 않는다. (EndSession 은 이 신호를 그 자리에서 바로 부른다.
		구분하지 않으면 나갈 때 리스너가 두 번 불리고, 차단 안내 대신 이 안내가 먼저 나간다.)
	]]
	profile.OnSessionEnd:Connect(function()
		if profiles[player] ~= profile then
			return
		end

		profiles[player] = nil
		fire(unloadingListeners, player, profile.Data)
		player:Kick(Locale.get(nil, "error.session_end"))
	end)

	if player.Parent ~= Players then
		-- 로드되는 사이에 나갔다.
		profile:EndSession()
		return
	end

	local data = profile.Data :: Types.PlayerData

	-- 차단 확인은 로드 직후에 한다.
	if data.bannedUntil ~= nil and data.bannedUntil > os.time() then
		profile:EndSession()
		player:Kick(Locale.get(data.settings and data.settings.language, "error.banned"))
		return
	end

	profiles[player] = profile

	fire(loadedListeners, player, data)
	DataService.replicate(player)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile == nil then
		return
	end

	profiles[player] = nil
	fire(unloadingListeners, player, profile.Data)
	profile:EndSession()
end

function DataService.Init()
	local ProfileStore = requireProfileStore()

	local storeName = if RunService:IsStudio()
		then GameConfig.DATASTORE_DEV
		else GameConfig.DATASTORE_PROD

	playerStore = ProfileStore.New(storeName, buildTemplate())

	ProfileStore.OnError:Connect(function(message: string, storeName_: string, profileKey: string)
		warn(`[DataService] DataStore 오류 (store={storeName_}, key={profileKey}): {message}`)
	end)

	ProfileStore.OnCriticalToggle:Connect(function(isCritical: boolean)
		if isCritical then
			warn("[DataService] DataStore 가 불안정한 상태입니다")
		else
			print("[DataService] DataStore 가 정상으로 돌아왔습니다")
		end
	end)

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	dataChangedRemote = remotesFolder:WaitForChild(Remotes.Events.DataChanged) :: RemoteEvent

	-- 설정 변경 (사운드 on/off, 언어)
	local settingRemote = remotesFolder:WaitForChild(Remotes.Functions.SetSetting) :: RemoteFunction
	settingRemote.OnServerInvoke = function(player: Player, key: any, value: any)
		local data = DataService.getActiveData(player)
		if data == nil then
			return { ok = false, reason = "not_ready" }
		end

		if key == "sfx" then
			if type(value) ~= "boolean" then
				return { ok = false, reason = "invalid_argument" }
			end
			data.settings.sfx = value
		elseif key == "language" then
			if not table.find(GameConfig.SUPPORTED_LANGUAGES, value) then
				return { ok = false, reason = "invalid_argument" }
			end
			data.settings.language = value
		else
			return { ok = false, reason = "invalid_argument" }
		end

		DataService.replicate(player)
		return { ok = true }
	end

	print(`[DataService] 스토어 "{storeName}" 사용`)
end

function DataService.Start()
	-- 이 스크립트보다 먼저 들어온 플레이어도 처리한다.
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EconomyService — 재화 증감의 단일 창구.

	골드/파편/방지권이 바뀌는 곳은 전부 여기를 거친다. 그래야
	(1) 모든 증감이 빠짐없이 기록되고 (2) 음수·소수 같은 잘못된 값이 저장되지 않는다.

	골드를 늘리는 유료 혜택(배수, 골드 팩)은 없다. 골드는 Robux 로 직접도 간접적으로도
	얻을 수 없어야 한다(통합 기획서 6절). 그래서 addGold 에는 배수 인자가 없다.

	모든 함수는 yield 하지 않는다. 호출자는 DataService.getActiveData() 로 받은
	데이터를 그대로 넘기고, 한 요청의 모든 변경을 끝낸 뒤 마지막에
	DataService.replicate(player) 를 한 번만 호출한다.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))

local ConfigFolder = Shared:WaitForChild("Config")
local EconomyConfig = require(ConfigFolder:WaitForChild("EconomyConfig"))

local AnalyticsService = require(script.Parent:WaitForChild("AnalyticsService"))
local DataService = require(script.Parent:WaitForChild("DataService"))

local EconomyService = {}
EconomyService.Name = "EconomyService"

-- 접속 중인 사람의 날짜 변경을 확인하는 주기
local DAILY_CHECK_INTERVAL_SECONDS = 60

-- 재화는 항상 0 이상의 정수로 유지한다.
local function sanitize(value: number): number
	if value ~= value then -- NaN
		return 0
	end
	return math.max(0, math.floor(value))
end

function EconomyService.canAfford(data: Types.PlayerData, cost: number): boolean
	return data.gold >= cost
end

-- 골드를 지급한다. 반환값은 실제로 지급된 양이다.
function EconomyService.addGold(
	player: Player,
	data: Types.PlayerData,
	amount: number,
	reason: string
): number
	local granted = sanitize(amount)
	if granted == 0 then
		return 0
	end

	data.gold = sanitize(data.gold + granted)
	AnalyticsService.logCurrency(player, "gold", granted, reason, data.gold)
	return granted
end

-- 골드를 차감한다. 잔액이 모자라면 아무것도 바꾸지 않고 false 를 반환한다.
function EconomyService.spendGold(
	player: Player,
	data: Types.PlayerData,
	amount: number,
	reason: string
): boolean
	local cost = sanitize(amount)
	if cost == 0 then
		return true
	end
	if data.gold < cost then
		return false
	end

	data.gold = sanitize(data.gold - cost)
	AnalyticsService.logCurrency(player, "gold", -cost, reason, data.gold)
	return true
end

function EconomyService.addShards(
	player: Player,
	data: Types.PlayerData,
	amount: number,
	reason: string
): number
	local granted = sanitize(amount)
	if granted == 0 then
		return 0
	end

	data.shards = sanitize(data.shards + granted)
	AnalyticsService.logCurrency(player, "shards", granted, reason, data.shards)
	return granted
end

function EconomyService.spendShards(
	player: Player,
	data: Types.PlayerData,
	amount: number,
	reason: string
): boolean
	local cost = sanitize(amount)
	if data.shards < cost then
		return false
	end

	data.shards = sanitize(data.shards - cost)
	AnalyticsService.logCurrency(player, "shards", -cost, reason, data.shards)
	return true
end

function EconomyService.addTickets(
	player: Player,
	data: Types.PlayerData,
	amount: number,
	reason: string
): number
	local granted = sanitize(amount)
	if granted == 0 then
		return 0
	end

	data.protectTickets = sanitize(data.protectTickets + granted)
	AnalyticsService.logCurrency(player, "tickets", granted, reason, data.protectTickets)
	return granted
end

function EconomyService.spendTickets(
	player: Player,
	data: Types.PlayerData,
	amount: number,
	reason: string
): boolean
	local cost = sanitize(amount)
	if data.protectTickets < cost then
		return false
	end

	data.protectTickets = sanitize(data.protectTickets - cost)
	AnalyticsService.logCurrency(player, "tickets", -cost, reason, data.protectTickets)
	return true
end

--[[
	UTC 기준으로 날짜가 바뀌었으면 출석 날짜와 연속 일수를 갱신한다.
	새 날이면 true 를 반환한다(출석 보상 지급 판단에 쓴다).

	daily.battlesToday / daily.opponentsToday 는 폐지된 1:1 배틀의 기록이다.
	저장된 값을 지우지 않으려고 여기서 더 이상 건드리지 않는다.
]]
function EconomyService.rolloverDaily(data: Types.PlayerData, nowSeconds: number?): boolean
	local today = math.floor((nowSeconds or os.time()) / 86400)

	if data.daily.lastLoginDay == today then
		return false
	end

	local isConsecutive = data.daily.lastLoginDay == today - 1
	data.daily.streak = if isConsecutive then data.daily.streak + 1 else 1
	data.daily.lastLoginDay = today

	return true
end

--[[
	출석 보상. 연속 일수에 따라 금액이 커지고, 표 끝을 넘으면 마지막 값을 계속 준다.
	rolloverDaily 가 true 를 돌려준 직후에만 호출한다.
]]
function EconomyService.grantDailyLogin(player: Player, data: Types.PlayerData): number
	local rewards = EconomyConfig.DAILY_LOGIN_GOLD
	local index = math.clamp(data.daily.streak, 1, #rewards)
	local amount = rewards[index]

	return EconomyService.addGold(player, data, amount, "daily_login")
end

function EconomyService.Start()
	-- 접속 시 출석 확인
	DataService.onLoaded(function(player, data)
		if EconomyService.rolloverDaily(data) then
			EconomyService.grantDailyLogin(player, data)
			DataService.replicate(player)
			AnalyticsService.logFunnel(player, "daily_login", { streak = data.daily.streak })
		end
	end)

	-- 플레이 시간 보상
	task.spawn(function()
		while true do
			task.wait(EconomyConfig.PLAYTIME_REWARD_INTERVAL_SECONDS)

			for player, data in DataService.getAllActive() do
				EconomyService.addGold(player, data, EconomyConfig.PLAYTIME_REWARD_GOLD, "playtime")
				DataService.replicate(player)
			end
		end
	end)

	--[[
		접속한 채로 날짜가 바뀐 사람의 출석 날짜·연속 일수를 갱신한다.
		(배틀 서비스에 있던 주기 확인을 동작 그대로 옮겨 왔다.)
		이 경로에서는 출석 골드를 주지 않는다. 예전부터의 동작이며,
		출석 보상을 다시 정할 때(통합 기획서 6절) 함께 정한다.
	]]
	task.spawn(function()
		while true do
			task.wait(DAILY_CHECK_INTERVAL_SECONDS)

			for player, data in DataService.getAllActive() do
				if EconomyService.rolloverDaily(data) then
					DataService.replicate(player)
				end
			end
		end
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">EnhanceService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EnhanceService — 강화 요청 처리 (통합 기획서 3절).

	강화 대상은 항상 "착용 중인 검"이다.

	흐름:
	  1) 레이트 리밋 + 동시 요청 락
	  2) 점검 모드 / 프로필 로드 상태 확인
	  3) 레벨 < MAX, 골드 >= 비용 확인
	  4) 골드 차감 → 결과 계산 → 레벨/통계/도감 갱신을 yield 없이 한 번에
	  5) 결과 반환
	  6) 경제/결과 로그

	난수는 서버에서 Random 객체 하나를 만들어 재사용한다.
	클라이언트가 보낸 값은 "방지권을 쓸지" 하나뿐이고, 그것도 boolean 인지 검사한다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ConfigFolder = Shared:WaitForChild("Config")
local EnhanceTable = require(ConfigFolder:WaitForChild("EnhanceTable"))
local Weapons = require(ConfigFolder:WaitForChild("Weapons"))

local Pure = Shared:WaitForChild("Pure")
local EnhanceLogic = require(Pure:WaitForChild("EnhanceLogic"))
local SwordLogic = require(Pure:WaitForChild("SwordLogic"))

local services = script.Parent
local DataService = require(services:WaitForChild("DataService"))
local EconomyService = require(services:WaitForChild("EconomyService"))
local AnalyticsService = require(services:WaitForChild("AnalyticsService"))
local LiveOpsService = require(services:WaitForChild("LiveOpsService"))
local RateLimiter = require(services:WaitForChild("RateLimiter"))
local CodexService = require(services:WaitForChild("CodexService"))

local EnhanceService = {}
EnhanceService.Name = "EnhanceService"

-- 서버 난수. 요청마다 새로 만들지 않는다.
local rng = Random.new()

-- 플레이어당 초당 3회, 동시 처리 1건
local limiter = RateLimiter.new({ maxRequests = 3, windowSeconds = 1 })

-- 이름 변경은 필터링 API 를 부르므로 훨씬 드물게만 허용한다.
local renameLimiter = RateLimiter.new({ maxRequests = 2, windowSeconds = 30 })

local MAX_NAME_LENGTH = 16

local feedRemote: RemoteEvent? = nil

local function fail(reason: string): Types.Failure
	return { ok = false, reason = reason }
end

-- 레벨 level 에서 한 번 강화하는 비용 (가진 검 수 할증 포함)
local function costFor(level: number, swordCount: number): number
	return EnhanceLogic.cost(
		level,
		swordCount,
		EnhanceTable.COST_BASE,
		EnhanceTable.SWORD_COUNT_EXPONENT
	)
end

-- 현재 적용 중인 이벤트까지 반영한 최종 확률
local function finalOddsFor(level: number): EnhanceLogic.Odds?
	local base = EnhanceTable.Odds[level]
	if base == nil then
		return nil
	end
	return EnhanceLogic.applyBuff(base, LiveOpsService.getSuccessBuff())
end

-- 착용 검 기준으로 화면에 보여 줄 확률과 비용
local function buildDisplayOdds(data: Types.PlayerData): Types.DisplayOdds
	local sword = SwordLogic.equipped(data.swords, data.equippedId)
	local level = if sword then sword.level else 0
	local odds = finalOddsFor(level)
	local event = LiveOpsService.getActiveEvent()

	if odds == nil then
		-- 최대 레벨: 더 이상 강화할 수 없다.
		return {
			level = level,
			success = 0,
			keep = 0,
			fail = 0,
			cost = 0,
			eventName = if event then event.nameKey else nil,
		}
	end

	return {
		level = level,
		success = odds.success,
		keep = odds.keep,
		fail = odds.fail,
		cost = costFor(level, SwordLogic.count(data.swords)),
		eventName = if event then event.nameKey else nil,
	}
end

local function broadcastIfNotable(player: Player, swordId: string, level: number)
	if level < EnhanceTable.BROADCAST_MIN_LEVEL or feedRemote == nil then
		return
	end

	local weapon = Weapons.get(swordId)
	feedRemote:FireAllClients({
		kind = "broadcast",
		playerName = player.DisplayName,
		weaponKey = if weapon then weapon.nameKey else "",
		level = level,
	})
end

--[[
	실제 처리. 여기에는 yield 가 하나도 없다.
	(task.wait, WaitForChild, :Async 호출을 넣으면 그 사이에 세션이 끝나거나
	 같은 플레이어의 다음 요청이 끼어들어 골드/레벨이 어긋날 수 있다)
]]
local function process(player: Player, wantsProtect: boolean): Types.EnhanceResponse
	if LiveOpsService.isMaintenance() then
		return fail("maintenance")
	end

	local data = DataService.getActiveData(player)
	if data == nil then
		return fail("not_ready")
	end

	local sword = SwordLogic.equipped(data.swords, data.equippedId)
	if sword == nil then
		return fail("not_ready")
	end

	local level = sword.level
	if level >= EnhanceTable.MAX_LEVEL then
		return fail("max_level")
	end

	local odds = finalOddsFor(level)
	if odds == nil then
		return fail("max_level")
	end

	local cost = costFor(level, SwordLogic.count(data.swords))
	if not EconomyService.canAfford(data, cost) then
		return fail("not_enough_gold")
	end

	-- 여기서부터 실제 변경. 실패할 수 있는 조건은 위에서 모두 걸렀다.
	EconomyService.spendGold(player, data, cost, "enhance_cost")

	local result = EnhanceLogic.resolve({
		level = level,
		maxLevel = EnhanceTable.MAX_LEVEL,
		safeLevel = EnhanceTable.SAFE_LEVEL,
		odds = odds,
		roll = rng:NextNumber() * 100,
		useProtect = wantsProtect,
		protectTickets = data.protectTickets,
		shardsOnFail = EnhanceLogic.shardsFor(level, EnhanceTable.SHARD_EXPONENT),
	})

	sword.level = result.newLevel
	data.stats.enhanceTries += 1

	if result.outcome == "success" then
		data.stats.enhanceSuccess += 1
		if result.newLevel > data.stats.highestLevel then
			data.stats.highestLevel = result.newLevel
		end
		CodexService.recordSwordLevel(player, data, sword)
	elseif result.outcome == "fail" then
		data.stats.destroyed += 1
		if result.shardsGained > 0 then
			EconomyService.addShards(player, data, result.shardsGained, "enhance_fail")
		end
	elseif result.outcome == "protected" then
		EconomyService.spendTickets(player, data, result.ticketsUsed, "enhance_protect")
	end

	AnalyticsService.logEnhance(player, level, result.outcome, cost)

	-- 첫 1분 튜토리얼 퍼널: 몇 명이 1/2/3회차까지 오는지 본다.
	if data.stats.enhanceTries <= 3 then
		AnalyticsService.logFunnel(player, `tutorial_enhance_{data.stats.enhanceTries}`)
	end

	if result.outcome == "success" then
		broadcastIfNotable(player, sword.id, result.newLevel)
	end

	return {
		ok = true,
		result = result.outcome,
		newLevel = result.newLevel,
		gold = data.gold,
		shardsGained = result.shardsGained,
		odds = buildDisplayOdds(data),
	}
end

--[[
	강화 1회 요청의 입구.
	useProtect: 방지권을 쓸지 여부. 이것이 클라이언트가 보내는 유일한 값이다.
]]
local function handleEnhance(player: Player, useProtect: any): Types.EnhanceResponse
	-- 1) 입력 타입 검증 (nil 은 "사용 안 함"으로 본다)
	if useProtect ~= nil and type(useProtect) ~= "boolean" then
		return fail("invalid_argument")
	end
	local wantsProtect: boolean = useProtect == true

	-- 2) 레이트 리밋
	if not limiter:consume(player.UserId) then
		return fail("too_fast")
	end

	-- 3) 동시 처리 1건
	if not limiter:tryLock(player.UserId) then
		return fail("busy")
	end

	-- 처리 중 예기치 못한 오류가 나도 락은 반드시 풀어야 한다.
	-- (락이 남으면 그 플레이어는 다시는 강화할 수 없게 된다)
	local ok, response = xpcall(process, debug.traceback, player, wantsProtect)

	limiter:unlock(player.UserId)

	if not ok then
		warn(`[EnhanceService] 처리 중 오류 ({player.UserId}):\n{response}`)
		return fail("unknown")
	end

	if response.ok then
		DataService.replicate(player)
	end

	return response
end

--[[
	착용 검 이름 짓기.

	필터링(FilterStringAsync)은 yield 하는 웹 요청이라 다른 처리와 성격이 다르다.
	그래서 순서를 이렇게 잡는다.
	  1) 형식 검사 (길이, 빈 문자열, 올바른 UTF-8)
	  2) 어느 검에 붙일 이름인지 기억해 둔다 (기다리는 동안 착용 검을 바꿀 수 있으므로)
	  3) 필터링 (여기서 yield)
	  4) yield 가 끝난 뒤에 데이터를 "다시" 가져와서 저장
	4번이 중요하다. 필터링을 기다리는 동안 플레이어가 나가거나 세션이 끝났을 수
	있으므로, yield 이전에 잡아 둔 데이터 참조를 그대로 쓰면 안 된다.

	저장하는 값도 표시하는 값도 전부 필터링을 통과한 문자열이다.
	지어 준 이름은 레벨이 바뀌어도(10강으로 돌아가도) 그대로 둔다.
]]
local function handleRename(player: Player, rawName: any): Types.RenameResponse
	if type(rawName) ~= "string" then
		return fail("invalid_argument")
	end

	local trimmed = string.match(rawName, "^%s*(.-)%s*$") or ""
	local length = utf8.len(trimmed)

	if length == nil or length == 0 or length > MAX_NAME_LENGTH then
		return fail("invalid_name")
	end

	local before = DataService.getActiveData(player)
	if before == nil then
		return fail("not_ready")
	end
	local targetId = before.equippedId

	if not renameLimiter:consume(player.UserId) then
		return fail("too_fast")
	end

	-- 여기서부터 yield 한다.
	local ok, filterResult = pcall(function()
		return TextService:FilterStringAsync(
			trimmed,
			player.UserId,
			Enum.TextFilterContext.PublicChat
		)
	end)

	if not ok then
		warn(`[EnhanceService] 이름 필터링 실패: {filterResult}`)
		return fail("filter_failed")
	end

	-- 다른 사람에게도 보이는 이름이므로 broadcast 용 결과를 쓴다.
	local okBroadcast, filtered = pcall(function()
		return filterResult:GetNonChatStringForBroadcastAsync()
	end)

	if not okBroadcast or type(filtered) ~= "string" or filtered == "" then
		warn(`[EnhanceService] 필터 결과를 얻지 못했습니다: {filtered}`)
		return fail("filter_failed")
	end

	-- yield 가 끝났으니 데이터를 다시 가져온다.
	local data = DataService.getActiveData(player)
	if data == nil then
		return fail("not_ready")
	end

	local sword = data.swords[targetId]
	if sword == nil then
		return fail("not_owned")
	end

	sword.customName = filtered
	DataService.replicate(player)

	return { ok = true, name = filtered }
end

local function handleGetOdds(player: Player): Types.DisplayOdds | Types.Failure
	local data = DataService.getData(player)
	if data == nil then
		return fail("not_ready")
	end
	return buildDisplayOdds(data)
end

-- 접속 직후 클라이언트가 현재 상태를 한 번에 받아 가는 경로
local function handleGetState(player: Player): any
	local data = DataService.getData(player)
	if data == nil then
		return fail("not_ready")
	end

	local liveOps = LiveOpsService.getConfig()

	return {
		ok = true,
		data = data,
		odds = buildDisplayOdds(data),
		-- 이벤트·점검 상태는 바뀔 때만 방송되므로, 늦게 들어온 사람에게는 여기서 알려 준다.
		liveOps = {
			maintenance = liveOps.maintenance,
			notice = liveOps.notice,
			event = LiveOpsService.getActiveEvent(),
		},
	}
end

function EnhanceService.Init()
	-- 확률표가 깨진 채로 서버가 뜨는 일이 없도록 시작할 때 검사한다.
	local problem = EnhanceTable.validate()
	if problem ~= nil then
		error(`[EnhanceService] 확률표가 잘못되었습니다: {problem}`, 0)
	end

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)

	local enhanceRemote = remotesFolder:WaitForChild(Remotes.Functions.Enhance) :: RemoteFunction
	enhanceRemote.OnServerInvoke = handleEnhance

	local renameRemote =
		remotesFolder:WaitForChild(Remotes.Functions.RenameWeapon) :: RemoteFunction
	renameRemote.OnServerInvoke = handleRename

	local oddsRemote = remotesFolder:WaitForChild(Remotes.Functions.GetOdds) :: RemoteFunction
	oddsRemote.OnServerInvoke = handleGetOdds

	local stateRemote = remotesFolder:WaitForChild(Remotes.Functions.GetState) :: RemoteFunction
	stateRemote.OnServerInvoke = handleGetState

	feedRemote = remotesFolder:WaitForChild(Remotes.Events.FeedMessage) :: RemoteEvent
end

function EnhanceService.Start()
	Players.PlayerRemoving:Connect(function(player)
		limiter:clear(player.UserId)
		renameLimiter:clear(player.UserId)
	end)
end

--[[
	버튼과 채팅 명령이 "같은 서버 경로"를 타도록 공개한다.
	ChatCommandService 는 이 함수를 호출하며, 리모트 핸들러와 완전히 같은
	검증·레이트 리밋·락을 거친다.
]]
function EnhanceService.requestEnhance(player: Player, useProtect: boolean?): Types.EnhanceResponse
	return handleEnhance(player, useProtect)
end

-- 착용 검 기준 표시 확률 (채팅 명령, 검 서비스가 쓴다)
function EnhanceService.getDisplayOdds(data: Types.PlayerData): Types.DisplayOdds
	return buildDisplayOdds(data)
end

-- 가진 검 수를 반영한 강화 비용 (소지 상한 가격 계산에 쓴다)
function EnhanceService.costFor(level: number, swordCount: number): number
	return costFor(level, swordCount)
end

return EnhanceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	LeaderboardService — 전체 순위 (최고 강화 레벨).

	배틀 레이팅 순위는 1:1 배틀과 함께 없앴다. 그 자리를 무엇으로 채울지는
	아직 정해지지 않았다(통합 기획서 9절 D7). 새 순위를 추가할 때는 BoardKind 와
	stores / lastWritten / valueFor 에 종류를 하나 더하면 된다.

	OrderedDataStore 는 호출 예산이 빠듯해서 아무 때나 쓰면 안 된다.
	그래서 쓰기는 두 경우로 제한한다.
	  - 플레이어가 나갈 때 (그 사람 것 1건)
	  - 5분 주기로 접속 중인 사람들 (값이 바뀐 사람만)

	쓰기 전에는 항상 DataStoreService:GetRequestBudgetForRequestType 으로
	남은 예산을 확인하고, 모자라면 이번 차례를 건너뛴다.
	순위표가 조금 늦게 갱신되는 건 괜찮지만, 예산이 바닥나면
	데이터 저장까지 영향을 받기 때문이다.

	읽기는 60초 동안 캐시해서 같은 서버의 여러 사람이 눌러도 한 번만 조회한다.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("Game"))

local DataService = require(script.Parent:WaitForChild("DataService"))

local LeaderboardService = {}
LeaderboardService.Name = "LeaderboardService"

local TOP_COUNT = 50
local WRITE_INTERVAL_SECONDS = 300
local CACHE_SECONDS = 60
local MIN_BUDGET = 10 -- 이만큼은 남겨 둔다

type BoardKind = "level"

local stores: { [string]: OrderedDataStore } = {}

-- 마지막으로 써 넣은 값. 바뀌지 않았으면 다시 쓰지 않는다.
local lastWritten: { [string]: { [number]: number } } = {
	level = {},
}

type Cache = {
	entries: { Types.LeaderboardEntry },
	fetchedAt: number,
}

local caches: { [string]: Cache } = {}
local nameCache: { [number]: string } = {}

local function hasBudget(requestType: Enum.DataStoreRequestType): boolean
	local ok, budget = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(requestType)
	end)
	return ok and budget > MIN_BUDGET
end

local function valueFor(_kind: BoardKind, data: Types.PlayerData): number
	return data.stats.highestLevel
end

--[[
	한 사람의 점수를 올린다. yield 한다.
	실패해도 게임 진행에는 영향이 없으므로 경고만 남긴다.
]]
local function writeEntry(kind: BoardKind, userId: number, value: number)
	local store = stores[kind]
	if store == nil then
		return
	end

	if lastWritten[kind][userId] == value then
		return -- 바뀐 게 없다
	end

	if not hasBudget(Enum.DataStoreRequestType.SetIncrementSortedAsync) then
		return -- 예산이 모자라면 다음 차례에
	end

	local ok, err = pcall(function()
		store:SetAsync(tostring(userId), value)
	end)

	if ok then
		lastWritten[kind][userId] = value
	else
		warn(`[LeaderboardService] {kind} 순위 기록 실패 ({userId}): {err}`)
	end
end

local function displayName(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end

	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)

	local resolved = if ok and type(name) == "string" then name else `#{userId}`
	nameCache[userId] = resolved
	return resolved
end

-- 상위 목록을 읽는다. yield 한다.
local function fetchTop(kind: BoardKind): { Types.LeaderboardEntry }
	local cache = caches[kind]
	if cache and os.clock() - cache.fetchedAt < CACHE_SECONDS then
		return cache.entries
	end

	local store = stores[kind]
	if store == nil then
		return {}
	end

	if not hasBudget(Enum.DataStoreRequestType.GetSortedAsync) then
		return if cache then cache.entries else {}
	end

	local ok, result = pcall(function()
		local pages = store:GetSortedAsync(false, TOP_COUNT) -- 내림차순
		return pages:GetCurrentPage()
	end)

	if not ok then
		warn(`[LeaderboardService] {kind} 순위 조회 실패: {result}`)
		return if cache then cache.entries else {}
	end

	local entries: { Types.LeaderboardEntry } = {}
	for rank, row in result :: { { key: string, value: number } } do
		local userId = tonumber(row.key) or 0
		table.insert(entries, {
			rank = rank,
			userId = userId,
			name = displayName(userId),
			value = row.value,
		})
	end

	caches[kind] = { entries = entries, fetchedAt = os.clock() }
	return entries
end

local function handleGetLeaderboard(_player: Player, kind: any): { Types.LeaderboardEntry }
	if kind ~= "level" then
		return {}
	end
	return fetchTop(kind)
end

function LeaderboardService.Init()
	local ok, err = pcall(function()
		stores.level = DataStoreService:GetOrderedDataStore(GameConfig.ORDERED_STORE_LEVEL)
	end)

	if not ok then
		warn(`[LeaderboardService] 순위 저장소를 열지 못했습니다: {err}`)
	end

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	local boardRemote =
		remotesFolder:WaitForChild(Remotes.Functions.GetLeaderboard) :: RemoteFunction
	boardRemote.OnServerInvoke = handleGetLeaderboard
end

function LeaderboardService.Start()
	-- 나갈 때 그 사람 점수만 기록
	DataService.onUnloading(function(player, data)
		task.spawn(function()
			writeEntry("level", player.UserId, valueFor("level", data))
		end)
	end)

	-- 5분 주기로 접속 중인 사람들 기록
	task.spawn(function()
		while true do
			task.wait(WRITE_INTERVAL_SECONDS)

			for player, data in DataService.getAllActive() do
				writeEntry("level", player.UserId, valueFor("level", data))
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastWritten.level[player.UserId] = nil
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">LiveOpsService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	LiveOpsService — 확률 버프 이벤트, 공지, 점검 모드.

	설정은 DataStore 키 하나에 통째로 들어 있고, 모든 서버가 주기적으로 읽는다.
	게임을 다시 올리지 않고도 이벤트를 켜고 끌 수 있다.

	저장 형태:
	    {
	      maintenance = false,
	      notice = "" ,                       -- 비어 있으면 공지 없음
	      event = {                           -- nil 이면 진행 중인 이벤트 없음
	        id = "weekend1",
	        nameKey = "event.weekend",        -- Locale 키 또는 그냥 문구
	        successBuff = 5,                  -- 성공 확률에 더할 %p
	        endsAt = 1790000000,              -- UTC 종료 시각
	      },
	    }

	읽기 실패는 조용히 넘어가고 직전 설정을 유지한다.
	통신이 잠깐 끊겼다고 이벤트가 꺼지거나 점검이 걸리면 안 되기 때문이다.
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local GameConfig = require(Shared:WaitForChild("Config"):WaitForChild("Game"))

local LiveOpsService = {}
LiveOpsService.Name = "LiveOpsService"

local POLL_SECONDS = 60
local CONFIG_KEY = "config"

export type ActiveEvent = {
	id: string,
	nameKey: string,
	successBuff: number,
	endsAt: number,
}

export type LiveConfig = {
	maintenance: boolean,
	notice: string,
	event: ActiveEvent?,
}

local current: LiveConfig = {
	maintenance = false,
	notice = "",
	event = nil,
}

local store: DataStore? = nil
local changedRemote: RemoteEvent? = nil

local function storeName(): string
	local base = if RunService:IsStudio()
		then GameConfig.DATASTORE_DEV
		else GameConfig.DATASTORE_PROD
	return `{base}_LiveOps`
end

-- 저장된 값이 우리가 기대하는 모양인지 확인한다. 이상하면 무시한다.
local function sanitize(raw: any): LiveConfig?
	if type(raw) ~= "table" then
		return nil
	end

	local event: ActiveEvent? = nil
	local rawEvent = raw.event

	if type(rawEvent) == "table" then
		local buff = tonumber(rawEvent.successBuff) or 0
		local endsAt = tonumber(rawEvent.endsAt) or 0

		if endsAt > os.time() and buff > 0 then
			event = {
				id = tostring(rawEvent.id or "event"),
				nameKey = tostring(rawEvent.nameKey or "event.default"),
				successBuff = math.clamp(buff, 0, 100),
				endsAt = endsAt,
			}
		end
	end

	return {
		maintenance = raw.maintenance == true,
		notice = if type(raw.notice) == "string" then raw.notice else "",
		event = event,
	}
end

local function broadcast()
	if changedRemote == nil then
		return
	end

	changedRemote:FireAllClients({
		maintenance = current.maintenance,
		notice = current.notice,
		event = current.event,
	})
end

local function apply(config: LiveConfig)
	local changed = config.maintenance ~= current.maintenance
		or config.notice ~= current.notice
		or (config.event ~= nil) ~= (current.event ~= nil)
		or (config.event ~= nil and current.event ~= nil and config.event.id ~= current.event.id)

	current = config

	if changed then
		broadcast()
		print(
			`[LiveOps] 설정 갱신 — 점검 {current.maintenance}, `
				.. `이벤트 {if current.event then current.event.id else "없음"}`
		)
	end
end

local function poll()
	if store == nil then
		return
	end

	local ok, raw = pcall(function()
		return (store :: DataStore):GetAsync(CONFIG_KEY)
	end)

	if not ok then
		warn(`[LiveOps] 설정을 읽지 못했습니다: {raw}`)
		return -- 직전 설정을 그대로 유지한다
	end

	local sanitized = sanitize(raw)
	if sanitized ~= nil then
		apply(sanitized)
	end
end

--------------------------------------------------------------------------------
-- 다른 서비스가 쓰는 조회 함수
--------------------------------------------------------------------------------

function LiveOpsService.getSuccessBuff(): number
	local event = LiveOpsService.getActiveEvent()
	return if event then event.successBuff else 0
end

function LiveOpsService.getActiveEvent(): ActiveEvent?
	local event = current.event
	if event ~= nil and os.time() >= event.endsAt then
		current.event = nil
		broadcast()
		return nil
	end
	return event
end

function LiveOpsService.isMaintenance(): boolean
	return current.maintenance
end

function LiveOpsService.getNotice(): string
	return current.notice
end

function LiveOpsService.getConfig(): LiveConfig
	return current
end

--------------------------------------------------------------------------------
-- AdminService 가 쓰는 변경 함수 (즉시 적용 + DataStore 저장)
--------------------------------------------------------------------------------

-- 이 함수는 yield 한다. 성공 여부를 반환한다.
function LiveOpsService.save(config: LiveConfig): boolean
	apply(config)

	if store == nil then
		return false
	end

	local ok, err = pcall(function()
		(store :: DataStore):SetAsync(CONFIG_KEY, {
			maintenance = config.maintenance,
			notice = config.notice,
			event = config.event,
		})
	end)

	if not ok then
		warn(`[LiveOps] 설정 저장 실패: {err}`)
	end

	return ok
end

function LiveOpsService.setMaintenance(enabled: boolean): boolean
	local config = LiveOpsService.getConfig()
	return LiveOpsService.save({
		maintenance = enabled,
		notice = config.notice,
		event = config.event,
	})
end

function LiveOpsService.setNotice(notice: string): boolean
	local config = LiveOpsService.getConfig()
	return LiveOpsService.save({
		maintenance = config.maintenance,
		notice = notice,
		event = config.event,
	})
end

function LiveOpsService.setEvent(event: ActiveEvent?): boolean
	local config = LiveOpsService.getConfig()
	return LiveOpsService.save({
		maintenance = config.maintenance,
		notice = config.notice,
		event = event,
	})
end

--------------------------------------------------------------------------------

function LiveOpsService.Init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(storeName())
	end)

	if ok then
		store = result
	else
		warn(`[LiveOps] 설정 저장소를 열지 못했습니다: {result}`)
	end

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	changedRemote = remotesFolder:WaitForChild(Remotes.Events.LiveOpsChanged) :: RemoteEvent
end

function LiveOpsService.Start()
	task.spawn(function()
		while true do
			poll()
			task.wait(POLL_SECONDS)
		end
	end)
end

return LiveOpsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">RaceService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RaceService — 추격 생존 경주 (통합 기획서 4절).

	한 판의 흐름:
	  1) 로비에서 "매칭"을 누르면 대기열에 들어간다.
	  2) 대기열이 20명이 되면 바로, 아니면 첫 사람이 누른 뒤 7초에 대기열을 닫고
	     전원을 출발선에 세운다. 3초 카운트다운 뒤 출발 (누른 뒤 10초 안에 출발).
	  3) 모두가 공유하는 추격자 하나가 30칸 뒤에서 출발해 지수적으로 빨라진다.
	  4) 추격자에게 따라잡히면 탈락. 그 순간 보상을 확정해 지급한다.
	  5) 탈락한 사람은 관전하거나 "로비로" 를 눌러 나간다. 모두 탈락하면 판이 끝난다.

	서버 권위 (통합 기획서 4-5절):
	  - 클라이언트가 보내는 값은 "매칭", "대기 취소", "로비로" 요청뿐이다. 거리·속도·순위는 받지 않는다.
	  - 거리는 서버가 매 프레임 캐릭터 위치를 보고 계산한다. 그 위치는 플레이어 기기가 만드는 값이라
	    조작할 수 있으므로, "허용 최대 속도 × 지난 시간"까지만 인정한다(Pure/RaceLogic.effectivePosition).
	    그보다 앞에 있다고 주장해도 한계 위치에 있는 것으로 보고 추격자가 그 위치를 지나면 탈락시킨다.
	  - 이동 속도, 최대 거리, 보상은 "출발선에 섰을 때의 착용 검 레벨"로 정한다.
	    경주 중에 검을 바꾸거나 강화해도 그 판에는 영향이 없다.

	코스는 판마다 새로 짓는다(장애물 위치가 매번 다르다). 여러 판이 동시에 열릴 수 있어서
	판마다 옆으로 떨어진 자리(slot)를 하나씩 쓴다.

	아직 값이 없어서 자리만 만든 것:
	  [미정 D6]  1~3위 보너스 → rankBonusFor
	  [미정 D16] 특수 능력·도감 기념 업그레이드 → allowedSpeedFor (허용 속도에 반영할 자리)
	  [미정 D17] 신규 유저 보호 → 방해 능력이 생길 때 함께 만든다
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ConfigFolder = Shared:WaitForChild("Config")
local RaceConfig = require(ConfigFolder:WaitForChild("RaceConfig"))
local EnhanceTable = require(ConfigFolder:WaitForChild("EnhanceTable"))
local World = require(ConfigFolder:WaitForChild("World"))

local Pure = Shared:WaitForChild("Pure")
local RaceLogic = require(Pure:WaitForChild("RaceLogic"))
local EnhanceLogic = require(Pure:WaitForChild("EnhanceLogic"))
local SwordLogic = require(Pure:WaitForChild("SwordLogic"))

local services = script.Parent
local DataService = require(services:WaitForChild("DataService"))
local EconomyService = require(services:WaitForChild("EconomyService"))
local AnalyticsService = require(services:WaitForChild("AnalyticsService"))
local LiveOpsService = require(services:WaitForChild("LiveOpsService"))
local WorldService = require(services:WaitForChild("WorldService"))
local RateLimiter = require(services:WaitForChild("RateLimiter"))
local CourseBuilder = require(services:WaitForChild("CourseBuilder"))

local RaceService = {}
RaceService.Name = "RaceService"

type Racer = {
	player: Player,
	userId: number,
	name: string,
	level: number, -- 출발선에 섰을 때의 착용 검 레벨
	speed: number, -- 그 레벨의 이동 속도 v(L)
	maxDistance: number, -- 그 레벨의 최대 거리 Dmax(L)
	lane: number, -- 출발선에서 설 자리 (트랙 중심 기준 좌우)
	best: number, -- 서버가 인정한 가장 먼 위치 (출발선 기준)
	alive: boolean,
	present: boolean, -- 아직 이 판에 붙어 있는지 (로비로 나가거나 접속을 끊으면 false)
	rank: number, -- 탈락했을 때 정해진다 (끝까지 남은 사람이 1위)
	distance: number, -- 보상에 쓴 거리
	reward: number, -- 지급한 골드
}

type Race = {
	id: number,
	slot: number,
	state: "lineup" | "running" | "finished",
	course: CourseBuilder.Built,
	racers: { Racer },
	aliveCount: number,
	placed: boolean, -- 캐릭터를 출발선으로 옮겼는지
	placeAt: number, -- 출발선으로 옮기는 시각 (os.clock)
	goAt: number, -- 출발 신호 시각
	startedAt: number,
	closeAt: number, -- 결과 표시가 끝나고 정리하는 시각
}

local CURVE: RaceLogic.Curve = {
	minTime = RaceConfig.MIN_TIME_SECONDS,
	maxTime = RaceConfig.MAX_TIME_SECONDS,
	maxLevel = EnhanceTable.MAX_LEVEL,
	accel = RaceConfig.CHASER_ACCEL,
	headStart = RaceConfig.HEAD_START,
	baseSpeed = RaceConfig.BASE_SPEED,
}

--[[
	코스를 지은 뒤 캐릭터를 출발선으로 옮기기까지 두는 틈(초).
	코스 파트가 플레이어 기기에 도착하기 전에 캐릭터부터 옮겨지면 바닥이 없는 곳에 떨어질 수 있다.
	LINEUP_SECONDS 안에 포함된다.
]]
local PLACE_DELAY_SECONDS = 0.5

local rng = Random.new()

-- 플레이어당 초당 4회 (매칭 버튼 연타 방지)
local limiter = RateLimiter.new({ maxRequests = 4, windowSeconds = 1 })

local queue: { Player } = {}
local queueOpenedAt = 0 -- 지금 대기열의 첫 사람이 들어온 시각

local races: { [number]: Race } = {}
local raceOf: { [Player]: Race } = {}
local usedSlots: { [number]: boolean } = {}
local nextRaceId = 1

local updateRemote: RemoteEvent? = nil

-- 쇳물 관문 바닥 원으로 대기열에 들어온 사람 (원 밖으로 나가면 빠진다)
local joinedByRing: { [Player]: boolean } = {}
local RING_CHECK_SECONDS = 0.2
local lastRingCheck = 0

local function fail(reason: string): Types.Failure
	return { ok = false, reason = reason }
end

local function send(player: Player, payload: Types.RaceUpdate)
	if updateRemote and player.Parent == Players then
		updateRemote:FireClient(player, payload)
	end
end

-- 그 판에 아직 붙어 있는 사람 모두에게 보낸다(관전 중인 사람 포함).
local function broadcast(race: Race, payload: Types.RaceUpdate)
	for _, racer in race.racers do
		if racer.present then
			send(racer.player, payload)
		end
	end
end

local function humanoidOf(player: Player): Humanoid?
	local character = player.Character
	if character == nil then
		return nil
	end
	return character:FindFirstChildOfClass("Humanoid")
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function setWalkSpeed(player: Player, speed: number)
	local humanoid = humanoidOf(player)
	if humanoid then
		humanoid.WalkSpeed = speed
	end
end

local function findRacer(race: Race, player: Player): Racer?
	for _, racer in race.racers do
		if racer.player == player then
			return racer
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- 수치
--------------------------------------------------------------------------------

-- 보상 = 그 레벨의 강화 비용(검 1개 기준, 할증 없음) × 배율 × 달린 비율
local function rewardFor(level: number, distance: number, maxDistance: number): number
	local odds = EnhanceTable.Odds[level]
	local multiplier =
		RaceLogic.rewardMultiplier(level, if odds then odds.success else 0, RaceConfig.Multiplier)
	local cost =
		EnhanceLogic.cost(level, 1, EnhanceTable.COST_BASE, EnhanceTable.SWORD_COUNT_EXPONENT)

	return RaceLogic.reward(cost, multiplier, distance, maxDistance)
end

--[[
	서버가 인정하는 최대 이동 속도.
	[미정 D16] 도감 기념 업그레이드와 특수 능력이 속도를 올리게 되면 여기에 반영한다.
	(반영하지 않으면 정상적으로 빨라진 사람의 거리를 서버가 깎게 된다.)
]]
local function allowedSpeedFor(racer: Racer): number
	return racer.speed
end

--[[
	[미정 D6] 1~3위 보너스. 크기와 지급 최소 인원이 정해지면 여기서 계산한다.
	순위(racer.rank)와 참가 인원(#race.racers)은 탈락하는 순간 이미 정해져 있다.
]]
local function rankBonusFor(_race: Race, _racer: Racer): number
	return 0
end

--------------------------------------------------------------------------------
-- 대기열
--------------------------------------------------------------------------------

-- 관문 전광판·고리 연출용 상태 (대기 인원, 출발 예정 시각)
local function publishGate(secondsLeft: number?)
	local gate = WorldService.getGate()
	if gate == nil then
		return
	end
	gate:SetAttribute(World.ATTR.queueCount, #queue)
	gate:SetAttribute(
		World.ATTR.departAt,
		if #queue > 0 and secondsLeft then Workspace:GetServerTimeNow() + secondsLeft else 0
	)
end

local function notifyQueue()
	local waited = os.clock() - queueOpenedAt
	local secondsLeft = RaceLogic.secondsUntilStart(waited, RaceConfig.MATCH_WINDOW_SECONDS)
	publishGate(secondsLeft)

	for _, player in queue do
		send(player, {
			kind = "queue",
			queued = true,
			count = #queue,
			secondsLeft = secondsLeft,
		})
	end
end

local function removeFromQueue(player: Player): boolean
	local index = table.find(queue, player)
	if index == nil then
		return false
	end
	table.remove(queue, index)
	joinedByRing[player] = nil
	return true
end

--------------------------------------------------------------------------------
-- 로비로 돌려보내기
--------------------------------------------------------------------------------

local function sendToLobby(player: Player)
	-- 관문 앞으로 돌아온다 (바로 다시 참가하기 쉽게)
	WorldService.teleportToReturnPoint(player)
	setWalkSpeed(player, RaceConfig.BASE_SPEED)
	send(player, { kind = "lobby" })
end

--------------------------------------------------------------------------------
-- 탈락과 보상
--------------------------------------------------------------------------------

--[[
	탈락 처리. 이 순간 보상을 확정해 지급한다(바로 로비로 나가도 잃지 않는다).
	yield 하지 않는다.

	unloadingData: 접속을 끊는 중에 불린 경우 DataService 가 넘겨준 데이터.
	그때는 getActiveData 가 이미 nil 이라 이 데이터에 직접 지급한다(곧바로 저장된다).
]]
local function eliminate(race: Race, racer: Racer, unloadingData: Types.PlayerData?)
	if not racer.alive then
		return
	end

	racer.alive = false
	race.aliveCount -= 1
	racer.rank = race.aliveCount + 1
	racer.distance = RaceLogic.creditedDistance(racer.best, RaceConfig.DEAD_ZONE)

	local player = racer.player
	local bonus = rankBonusFor(race, racer)
	local amount = rewardFor(racer.level, racer.distance, racer.maxDistance) + bonus

	local data = unloadingData or DataService.getActiveData(player)
	if data ~= nil then
		racer.reward = EconomyService.addGold(player, data, amount, "race_reward")
		if unloadingData == nil then
			DataService.replicate(player)
		end
	end

	setWalkSpeed(player, 0)

	AnalyticsService.logFunnel(player, "race_eliminated", {
		level = racer.level,
		distance = racer.distance,
		rank = racer.rank,
		reward = racer.reward,
	})

	send(player, {
		kind = "result",
		raceId = race.id,
		rank = racer.rank,
		racerCount = #race.racers,
		level = racer.level,
		distance = math.floor(racer.distance),
		maxDistance = racer.maxDistance,
		reward = racer.reward,
		bonus = bonus,
	})

	broadcast(race, {
		kind = "eliminated",
		raceId = race.id,
		userId = racer.userId,
		rank = racer.rank,
		distance = math.floor(racer.distance),
	})
end

--------------------------------------------------------------------------------
-- 판 시작 · 진행 · 끝
--------------------------------------------------------------------------------

local function takeSlot(): number
	local slot = 0
	while usedSlots[slot] do
		slot += 1
	end
	usedSlots[slot] = true
	return slot
end

-- 대기열에 있던 사람들로 한 판을 연다.
local function startRace(batch: { Player })
	local racers: { Racer } = {}

	for _, player in batch do
		local data = DataService.getActiveData(player)
		local sword = if data then SwordLogic.equipped(data.swords, data.equippedId) else nil
		local humanoid = humanoidOf(player)

		local canRace = player.Parent == Players
			and sword ~= nil
			and humanoid ~= nil
			and humanoid.Health > 0
			and rootOf(player) ~= nil
			and raceOf[player] == nil

		if not canRace or sword == nil then
			-- 기다리는 사이에 나갔거나 캐릭터가 없다. 대기열에서 빠졌다고 알려 준다.
			send(player, { kind = "queue", queued = false })
			continue
		end

		local level = sword.level
		table.insert(racers, {
			player = player,
			userId = player.UserId,
			name = player.DisplayName,
			level = level,
			speed = RaceLogic.runSpeed(level, CURVE),
			maxDistance = RaceLogic.maxDistance(level, CURVE),
			lane = 0,
			best = 0,
			alive = true,
			present = true,
			rank = 0,
			distance = 0,
			reward = 0,
		})
	end

	if #racers == 0 then
		return
	end

	-- 출발 자리를 섞는다.
	for index = #racers, 2, -1 do
		local other = rng:NextInteger(1, index)
		racers[index], racers[other] = racers[other], racers[index]
	end

	-- 코스 길이는 이 판에서 가장 멀리 갈 수 있는 사람 기준.
	local topDistance = 0
	for _, racer in racers do
		topDistance = math.max(topDistance, racer.maxDistance)
	end

	local courseConfig = RaceConfig.Course
	local length = RaceLogic.courseLength(topDistance, courseConfig)
	local obstacles = RaceLogic.generateObstacles(length, courseConfig, function(): number
		return rng:NextNumber()
	end)

	local slot = takeSlot()
	local id = nextRaceId
	nextRaceId += 1

	local origin = Vector3.new(slot * World.COURSE.slotSpacing, 0, World.COURSE.startZ)

	local ok, result = pcall(
		CourseBuilder.build,
		WorldService.getRacesFolder(),
		id,
		origin,
		length,
		RaceConfig.HEAD_START,
		courseConfig.trackWidth,
		obstacles
	)

	if not ok then
		usedSlots[slot] = nil
		error(`코스를 짓지 못했습니다: {result}`, 0)
	end

	local now = os.clock()
	local race: Race = {
		id = id,
		slot = slot,
		state = "lineup",
		course = result :: CourseBuilder.Built,
		racers = racers,
		aliveCount = #racers,
		placed = false,
		placeAt = now + PLACE_DELAY_SECONDS,
		goAt = now + RaceConfig.LINEUP_SECONDS,
		startedAt = 0,
		closeAt = 0,
	}
	races[id] = race

	local offsets =
		RaceLogic.lineupOffsets(#racers, courseConfig.lineupWidth, courseConfig.lineupMaxSpacing)
	local entrants: { Types.RaceEntrant } = {}

	for index, racer in racers do
		raceOf[racer.player] = race
		racer.lane = offsets[index]

		-- 출발 신호 전에는 움직이지 못한다. (출발선으로는 잠시 뒤 stepRace 가 옮긴다)
		setWalkSpeed(racer.player, 0)

		table.insert(entrants, {
			userId = racer.userId,
			name = racer.name,
			level = racer.level,
		})
	end

	for _, racer in racers do
		send(racer.player, {
			kind = "lineup",
			raceId = id,
			countdown = RaceConfig.LINEUP_SECONDS,
			originX = origin.X,
			originZ = origin.Z,
			level = racer.level,
			speed = racer.speed,
			maxDistance = racer.maxDistance,
			entrants = entrants,
		})
		AnalyticsService.logFunnel(racer.player, "race_start", {
			level = racer.level,
			racers = #racers,
		})
	end
end

-- 모두 탈락했다. 최종 순위를 알리고 잠시 뒤 정리한다.
local function finishRace(race: Race, now: number)
	race.state = "finished"
	race.closeAt = now + RaceConfig.RESULT_SECONDS

	local ranking: { Types.RaceRankingRow } = {}
	for _, racer in race.racers do
		table.insert(ranking, {
			rank = racer.rank,
			userId = racer.userId,
			name = racer.name,
			level = racer.level,
			distance = math.floor(racer.distance),
		})
	end
	table.sort(ranking, function(a, b)
		return a.rank < b.rank
	end)

	broadcast(race, {
		kind = "finished",
		raceId = race.id,
		ranking = ranking,
		returnIn = RaceConfig.RESULT_SECONDS,
	})
end

-- 판을 치운다. 아직 남아 있는 사람은 로비로 돌려보내고 코스를 지운다.
local function closeRace(race: Race)
	races[race.id] = nil
	usedSlots[race.slot] = nil

	for _, racer in race.racers do
		local player = racer.player
		if raceOf[player] == race then
			raceOf[player] = nil
		end

		if racer.present then
			racer.present = false
			if player.Parent == Players then
				sendToLobby(player)
			end
		end
	end

	CourseBuilder.destroy(race.course)
end

-- 캐릭터를 출발선의 자기 자리로 옮긴다.
local function placeOnLine(race: Race, racer: Racer)
	local character = racer.player.Character
	if character then
		character:PivotTo(CourseBuilder.lineupCFrame(race.course, racer.lane))
	end
end

local function stepRace(race: Race, now: number)
	if race.state == "lineup" then
		if not race.placed and now >= race.placeAt then
			race.placed = true
			for _, racer in race.racers do
				if racer.alive then
					placeOnLine(race, racer)
				end
			end
		end

		if now < race.goAt then
			return
		end

		race.state = "running"
		race.startedAt = now

		local floorY = race.course.origin.Y
		for _, racer in race.racers do
			if not racer.alive then
				continue
			end

			-- 드물게 바닥보다 먼저 옮겨져 아래로 떨어진 사람은 출발선에 다시 세운다.
			local root = rootOf(racer.player)
			if root and root.Position.Y < floorY - 5 then
				placeOnLine(race, racer)
			end

			setWalkSpeed(racer.player, racer.speed)
		end

		broadcast(race, { kind = "start", raceId = race.id })
		return
	end

	if race.state == "finished" then
		if now >= race.closeAt then
			closeRace(race)
		end
		return
	end

	-- 달리는 중
	local elapsed = now - race.startedAt
	local front = RaceLogic.chaserFront(elapsed, CURVE)
	CourseBuilder.moveChaser(race.course, front)

	local originZ = race.course.origin.Z
	local caught: { Racer } = {}

	for _, racer in race.racers do
		if not racer.alive then
			continue
		end

		local player = racer.player
		local root = rootOf(player)
		local humanoid = humanoidOf(player)

		if player.Parent ~= Players or root == nil or humanoid == nil or humanoid.Health <= 0 then
			-- 접속이 끊겼거나 캐릭터가 죽었다. 지금까지 인정된 거리로 탈락 처리한다.
			table.insert(caught, racer)
			continue
		end

		local position = RaceLogic.effectivePosition(
			root.Position.Z - originZ,
			elapsed,
			allowedSpeedFor(racer),
			RaceConfig.SPEED_TOLERANCE,
			RaceConfig.DISTANCE_SLACK
		)

		if position > racer.best then
			racer.best = position
		end

		if front >= position then
			table.insert(caught, racer)
		end
	end

	if #caught > 0 then
		-- 같은 순간에 여럿이 잡히면 덜 간 사람부터 탈락시킨다(더 간 사람의 순위가 높다).
		table.sort(caught, function(a, b)
			if a.best ~= b.best then
				return a.best < b.best
			end
			return a.userId < b.userId
		end)

		for _, racer in caught do
			eliminate(race, racer, nil)
		end
	end

	if race.aliveCount <= 0 then
		finishRace(race, now)
	end
end

-- 관문 바닥 원 확인 (아래 "리모트" 부분에서 정의한다. step 이 먼저 나오므로 이름만 미리 둔다)
local checkRing: () -> ()

local function step()
	local now = os.clock()

	if now - lastRingCheck >= RING_CHECK_SECONDS then
		lastRingCheck = now
		local ok, err = pcall(checkRing)
		if not ok then
			warn(`[RaceService] 관문 원 확인 오류: {err}`)
		end
	end

	if
		RaceLogic.shouldDepart(
			#queue,
			now - queueOpenedAt,
			RaceConfig.MATCH_WINDOW_SECONDS,
			RaceConfig.LINEUP_SECONDS,
			RaceConfig.MATCH_FULL_COUNT
		)
	then
		local batch = queue
		queue = {}
		joinedByRing = {}
		publishGate(nil)
		local gate = WorldService.getGate()
		if gate then
			gate:SetAttribute(World.ATTR.launchAt, Workspace:GetServerTimeNow())
		end

		local ok, err = xpcall(startRace, debug.traceback, batch)
		if not ok then
			warn(`[RaceService] 판을 열지 못했습니다:\n{err}`)
			for _, player in batch do
				if raceOf[player] == nil then
					send(player, { kind = "queue", queued = false })
				end
			end
		end
	end

	for _, race in races do
		local ok, err = xpcall(stepRace, debug.traceback, race, now)
		if not ok then
			-- 같은 오류가 매 프레임 반복되지 않도록 그 판을 닫고 사람들을 로비로 돌려보낸다.
			warn(`[RaceService] 판 {race.id} 진행 중 오류, 판을 닫습니다:\n{err}`)
			local closed, closeErr = pcall(closeRace, race)
			if not closed then
				warn(`[RaceService] 판 {race.id} 정리 실패: {closeErr}`)
				races[race.id] = nil
			end
		end
	end
end

--------------------------------------------------------------------------------
-- 리모트
--------------------------------------------------------------------------------

-- 대기열에 넣는다 (버튼과 관문 바닥 원이 같이 쓴다). 레이트 리밋은 부르는 쪽이 한다.
local function joinQueue(player: Player): Types.SimpleResponse
	if LiveOpsService.isMaintenance() then
		return fail("maintenance")
	end

	local data = DataService.getActiveData(player)
	if data == nil or SwordLogic.equipped(data.swords, data.equippedId) == nil then
		return fail("not_ready")
	end

	if raceOf[player] ~= nil then
		return fail("in_race")
	end

	local humanoid = humanoidOf(player)
	if humanoid == nil or humanoid.Health <= 0 then
		return fail("not_ready")
	end

	if table.find(queue, player) == nil then
		if #queue == 0 then
			queueOpenedAt = os.clock()
		end
		table.insert(queue, player)
		AnalyticsService.logFunnel(player, "race_queue")
	end

	notifyQueue()
	return { ok = true }
end

local function handleJoin(player: Player): Types.SimpleResponse
	if not limiter:consume(player.UserId) then
		return fail("too_fast")
	end
	return joinQueue(player)
end

--[[
	쇳물 관문 바닥 원: 올라서면 대기열에 들어가고, 원으로 들어온 사람이 원 밖으로 나가면 빠진다.
	위치는 서버가 본 캐릭터 위치로 판단한다. 버튼으로 들어온 사람은 원 밖에 있어도 그대로 둔다.
]]
function checkRing()
	local gateSpec = World.GATE
	if WorldService.getGate() == nil then
		return
	end

	for _, player in Players:GetPlayers() do
		if raceOf[player] ~= nil then
			continue
		end
		local root = rootOf(player)
		local inside = false
		if root then
			local position = root.Position
			local dx, dz = position.X - gateSpec.ringX, position.Z - gateSpec.ringZ
			inside = dx * dx + dz * dz <= gateSpec.ringRadius * gateSpec.ringRadius
				and position.Y >= 0
				and position.Y <= gateSpec.ringReach
		end

		local queued = table.find(queue, player) ~= nil
		if inside and not queued then
			local response = joinQueue(player)
			if response.ok then
				joinedByRing[player] = true
			end
		elseif not inside and queued and joinedByRing[player] then
			removeFromQueue(player)
			notifyQueue()
			send(player, { kind = "queue", queued = false })
		end
	end
end

local function handleLeaveQueue(player: Player): Types.SimpleResponse
	if not limiter:consume(player.UserId) then
		return fail("too_fast")
	end

	if removeFromQueue(player) then
		notifyQueue()
	end
	send(player, { kind = "queue", queued = false })

	return { ok = true }
end

--[[
	"로비로". 탈락한 뒤 관전을 끝내고 나갈 때 쓴다.
	아직 달리는 중(탈락 전)에는 쓸 수 없다. 경주 중이 아닐 때 누르면 그냥 로비 스폰으로 옮겨 준다.
]]
local function handleReturnToLobby(player: Player): Types.SimpleResponse
	if not limiter:consume(player.UserId) then
		return fail("too_fast")
	end

	local race = raceOf[player]
	if race ~= nil then
		local racer = findRacer(race, player)
		if racer ~= nil then
			if racer.alive then
				return fail("in_race")
			end
			racer.present = false
		end
		raceOf[player] = nil
	end

	sendToLobby(player)
	return { ok = true }
end

-- 처리 중 오류가 나도 클라이언트에는 { ok = false } 를 돌려준다.
local function guarded(handler: (player: Player) -> Types.SimpleResponse)
	return function(player: Player): Types.SimpleResponse
		local ok, response = xpcall(handler, debug.traceback, player)
		if not ok then
			warn(`[RaceService] 요청 처리 중 오류 ({player.UserId}):\n{response}`)
			return fail("unknown")
		end
		return response
	end
end

--------------------------------------------------------------------------------

function RaceService.Init()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)

	updateRemote = remotesFolder:WaitForChild(Remotes.Events.RaceUpdate) :: RemoteEvent

	local joinRemote = remotesFolder:WaitForChild(Remotes.Functions.JoinRace) :: RemoteFunction
	joinRemote.OnServerInvoke = guarded(handleJoin)

	local leaveRemote =
		remotesFolder:WaitForChild(Remotes.Functions.LeaveRaceQueue) :: RemoteFunction
	leaveRemote.OnServerInvoke = guarded(handleLeaveQueue)

	local lobbyRemote =
		remotesFolder:WaitForChild(Remotes.Functions.ReturnToLobby) :: RemoteFunction
	lobbyRemote.OnServerInvoke = guarded(handleReturnToLobby)
end

function RaceService.Start()
	--[[
		접속을 끊는 순간. DataService 가 저장 직전에 데이터를 넘겨준다.
		달리던 중이었다면 지금까지의 거리로 보상을 확정해 그 데이터에 넣는다.
	]]
	DataService.onUnloading(function(player, data)
		if removeFromQueue(player) then
			notifyQueue()
		end

		local race = raceOf[player]
		if race == nil then
			return
		end

		local racer = findRacer(race, player)
		if racer ~= nil then
			if racer.alive then
				eliminate(race, racer, data)
			end
			racer.present = false
		end
		raceOf[player] = nil
	end)

	Players.PlayerRemoving:Connect(function(player)
		limiter:clear(player.UserId)

		-- 프로필이 열리기 전에 나간 경우 등 위 경로를 타지 않았을 때의 뒷정리.
		task.defer(function()
			if removeFromQueue(player) then
				notifyQueue()
			end

			local race = raceOf[player]
			if race == nil then
				return
			end

			local racer = findRacer(race, player)
			if racer ~= nil then
				if racer.alive then
					eliminate(race, racer, nil)
				end
				racer.present = false
			end
			raceOf[player] = nil
		end)
	end)

	RunService.Heartbeat:Connect(step)
end

-- 지금 경주에 붙어 있는지 (달리는 중이거나 관전 중)
function RaceService.isInRace(player: Player): boolean
	return raceOf[player] ~= nil
end

return RaceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
--[[
	RateLimiter — 플레이어별 요청 속도 제한과 동시 요청 락.

	생명주기(Init/Start)가 없는 유틸 모듈이라 부트스트랩 순서 목록에 넣지 않는다.
	Roblox API 를 쓰지 않고 시계 함수를 주입받으므로 Studio 밖에서도 테스트된다.

	사용 예:
		local limiter = RateLimiter.new({ maxRequests = 3, windowSeconds = 1 })

		if not limiter:consume(userId) then
			return { ok = false, reason = "too_fast" }
		end
		if not limiter:tryLock(userId) then
			return { ok = false, reason = "busy" }
		end
		-- ... 처리 ...
		limiter:unlock(userId)
]]

local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type Config = {
	maxRequests: number, -- 창(window) 당 허용 요청 수
	windowSeconds: number,
	clock: (() -> number)?, -- 테스트용 주입. 기본은 os.clock
}

type Self = {
	maxRequests: number,
	windowSeconds: number,
	clock: () -> number,
	history: { [number]: { number } },
	locks: { [number]: true },
}

export type Limiter = typeof(setmetatable({} :: Self, RateLimiter))

function RateLimiter.new(config: Config): Limiter
	assert(config.maxRequests > 0, "maxRequests 는 1 이상이어야 합니다")
	assert(config.windowSeconds > 0, "windowSeconds 는 0 보다 커야 합니다")

	return setmetatable(
		{
			maxRequests = config.maxRequests,
			windowSeconds = config.windowSeconds,
			clock = config.clock or os.clock,
			history = {},
			locks = {},
		} :: Self,
		RateLimiter
	)
end

--[[
	요청 1건을 기록하고 허용 여부를 반환한다.
	허용되지 않으면 아무것도 기록하지 않는다(거절된 요청이 다음 요청을 더 막지 않도록).
]]
function RateLimiter.consume(self: Limiter, userId: number): boolean
	local now = self.clock()
	local stamps = self.history[userId]

	if not stamps then
		stamps = {}
		self.history[userId] = stamps
	end

	-- 창 밖으로 나간 기록을 앞에서부터 버린다.
	local cutoff = now - self.windowSeconds
	while #stamps > 0 and stamps[1] <= cutoff do
		table.remove(stamps, 1)
	end

	if #stamps >= self.maxRequests then
		return false
	end

	table.insert(stamps, now)
	return true
end

-- 처리 중인 요청이 있으면 false. 성공하면 반드시 unlock 을 호출해야 한다.
function RateLimiter.tryLock(self: Limiter, userId: number): boolean
	if self.locks[userId] then
		return false
	end
	self.locks[userId] = true
	return true
end

function RateLimiter.unlock(self: Limiter, userId: number)
	self.locks[userId] = nil
end

function RateLimiter.isLocked(self: Limiter, userId: number): boolean
	return self.locks[userId] == true
end

-- 플레이어가 나갈 때 기록을 정리한다(메모리 누수 방지).
function RateLimiter.clear(self: Limiter, userId: number)
	self.history[userId] = nil
	self.locks[userId] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ShopService — 방지권 상품(Robux)과 파편 뽑기 (통합 기획서 3-4절, 7절).

	상품 세 가지 (Config/Products):
	  확정 1개 / 확정 묶음 / 확률형(꽝이면 천장 포인트 +1, 3점이면 방지권 1개 후 0점)
	그리고 Robux 가 닿지 않는 파편 뽑기(파편 50개 = 1회, 천장 포인트 없음).

	설계 원칙:
	- 유료 상품은 방지권뿐이다. 골드·파편을 주거나 골드 획득량을 늘리는 상품은 만들지 않는다.
	- ID 나 내용이 비어 있는 상품은 목록에 넣지 않고 구매 요청도 받지 않는다
	  (개수·확률·가격은 미정 D12, 상품 ID 는 개발자 입력 대기).

	로블록스 유료 확률형 정책 (통합 기획서 7절, creator-docs paid-random-items.md 로 확인):
	  1) 사기 전에 모든 결과와 확률을 %로, 합계 정확히 100% 로 보여 준다
	     → GetShopItems 가 결과별 %를 함께 보낸다(Pure/SwordLogic.exactPercents, 합이 정확히 100).
	  2) 확률을 바꾸는 장치(방지권, 천장)는 숫자로 설명하고 적용 중이면 표시를 바꾼다
	     → 방지권은 강화 화면이, 천장은 상점 화면이 처리한다.
	  3) PolicyService 의 ArePaidRandomItemsRestricted 가 참인 유저에게는 확률형을 숨긴다
	     → 목록에서 빼고, 구매창도 띄우지 않고, 혹시 결제가 들어와도 뽑지 않는다.
	     확인에 실패하면 제한된 것으로 본다(안전한 쪽).
	  4) 결제가 재시도돼도 다시 뽑지 않는다
	     → 뽑기 결과·천장 포인트 변경·PurchaseId 기록을 yield 없는 한 번의 변경으로 처리한다.
	       같은 PurchaseId 가 다시 오면 기록을 보고 건너뛴다.

	ProcessReceipt 구현은 ProfileStore 공식 문서의 "PurchaseId 캐싱" 방식을 따른다.
	핵심은 "지급했다"가 아니라 "지급한 사실이 DataStore 에 저장됐다"를 확인한 뒤에야
	PurchaseGranted 를 돌려준다는 것이다. 그래야 지급 직후 서버가 죽어도
	플레이어가 산 것을 잃지 않는다.

	  1) 프로필이 아직 안 열렸으면 NotProcessedYet (다음에 다시 물어본다)
	  2) purchaseHistory 에 PurchaseId 가 있으면 이미 지급한 것 → 중복 지급 안 함
	  3) 지급과 기록을 같은 프로필 업데이트 안에서 처리
	  4) LastSavedData 에 그 PurchaseId 가 보일 때까지 기다린 뒤 PurchaseGranted

	ProcessReceipt 콜백은 서버 전체에 딱 하나만 설정할 수 있다. 여기서만 설정한다.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Locale = require(Shared:WaitForChild("Locale"))

local ConfigFolder = Shared:WaitForChild("Config")
local Products = require(ConfigFolder:WaitForChild("Products"))

local Pure = Shared:WaitForChild("Pure")
local DrawLogic = require(Pure:WaitForChild("DrawLogic"))
local SwordLogic = require(Pure:WaitForChild("SwordLogic"))

local services = script.Parent
local DataService = require(services:WaitForChild("DataService"))
local EconomyService = require(services:WaitForChild("EconomyService"))
local AnalyticsService = require(services:WaitForChild("AnalyticsService"))
local LiveOpsService = require(services:WaitForChild("LiveOpsService"))
local RateLimiter = require(services:WaitForChild("RateLimiter"))

local ShopService = {}
ShopService.Name = "ShopService"

-- 서버 난수. 뽑기 결과는 서버에서만 정한다.
local rng = Random.new()

-- 플레이어당 초당 3회, 동시 처리 1건 (파편 뽑기)
local limiter = RateLimiter.new({ maxRequests = 3, windowSeconds = 1 })

-- 표시 확률의 소수 자릿수
local PERCENT_DECIMALS = 2

-- 유료 확률형 제한 여부(PolicyService). true = 제한됨. 확인에 성공한 값만 넣는다.
local restrictedCache: { [Player]: boolean } = {}

local feedRemote: RemoteEvent? = nil

local function fail(reason: string): Types.Failure
	return { ok = false, reason = reason }
end

-- 그 플레이어의 채팅·피드에 한 줄 띄운다.
local function notify(player: Player, text: string)
	if feedRemote and player.Parent == Players then
		feedRemote:FireClient(player, { kind = "system", text = text })
	end
end

--------------------------------------------------------------------------------
-- 유료 확률형 제한 확인
--------------------------------------------------------------------------------

--[[
	이 플레이어가 유료 확률형 아이템을 쓸 수 없는지. **yield 한다**(웹 요청).
	확인에 실패하면 true(제한됨)를 돌려주고 캐시하지 않는다 → 다음에 다시 확인한다.
]]
local function isRandomRestricted(player: Player): boolean
	local cached = restrictedCache[player]
	if cached ~= nil then
		return cached
	end

	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)

	if not ok or type(info) ~= "table" then
		warn(`[ShopService] 정책 정보를 받지 못했습니다 ({player.UserId}): {info}`)
		return true
	end

	-- 값이 명확히 false 일 때만 허용한다.
	local restricted = info.ArePaidRandomItemsRestricted ~= false

	if player.Parent == Players then
		restrictedCache[player] = restricted
	end
	return restricted
end

--------------------------------------------------------------------------------
-- 개발자 상품 지급
--------------------------------------------------------------------------------

--[[
	상품 하나를 지급한다. **yield 하지 않는다.**
	확률형은 여기서 한 번만 뽑는다. 이 함수가 끝나면 호출자가 곧바로 같은 흐름에서
	PurchaseId 를 기록하므로, 같은 결제가 다시 와도 다시 뽑히지 않는다.
]]
local function grantProduct(
	player: Player,
	data: Types.PlayerData,
	product: Products.DeveloperProduct
)
	local language = data.settings.language
	local reason = `purchase_{product.key}`

	if product.kind == "fixed" then
		EconomyService.addTickets(player, data, product.ticketAmount, reason)
		notify(player, Locale.get(language, "shop.granted", product.ticketAmount))
		return
	end

	local result = DrawLogic.resolvePaid(
		product.outcomes,
		rng:NextNumber(),
		data.pityPoints,
		Products.PITY_PER_MISS,
		Products.PITY_THRESHOLD,
		Products.PITY_TICKETS
	)
	if result == nil then
		error("확률형 상품의 결과 목록이 비어 있습니다", 0)
	end

	-- 여기서부터 실제 변경.
	data.pityPoints = result.pityAfter
	if result.totalTickets > 0 then
		EconomyService.addTickets(player, data, result.totalTickets, reason)
	end

	if not result.isMiss then
		notify(player, Locale.get(language, "shop.randomWin", result.rolledTickets))
	elseif result.pityTickets > 0 then
		notify(player, Locale.get(language, "shop.randomPity", result.pityTickets))
	else
		notify(
			player,
			Locale.get(language, "shop.randomMiss", result.pityAfter, Products.PITY_THRESHOLD)
		)
	end

	AnalyticsService.logFunnel(player, "ticket_random", {
		tickets = result.rolledTickets,
		pityTickets = result.pityTickets,
		pityAfter = result.pityAfter,
	})
end

local function historyContains(history: { string }, purchaseId: string): boolean
	return table.find(history, purchaseId) ~= nil
end

--[[
	지급 → 저장 확인까지 기다린다.
	이 함수는 yield 한다. ProcessReceipt 는 결과를 돌려줄 때까지 기다려 주므로 괜찮다.
]]
local function grantAndConfirm(
	player: Player,
	profile: any,
	purchaseId: string,
	product: Products.DeveloperProduct
): Enum.ProductPurchaseDecision
	if not profile:IsActive() then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local data = profile.Data :: Types.PlayerData

	-- 아직 지급하지 않았다면 지급과 기록을 함께 처리한다. (이 구간에는 yield 가 없다)
	if not historyContains(data.purchaseHistory, purchaseId) then
		local ok, err = pcall(grantProduct, player, data, product)
		if not ok then
			warn(`[ShopService] 지급 실패 ({product.key}): {err}`)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		-- 기록이 무한히 커지지 않도록 오래된 것부터 버린다.
		while #data.purchaseHistory >= Products.PURCHASE_HISTORY_LIMIT do
			table.remove(data.purchaseHistory, 1)
		end
		table.insert(data.purchaseHistory, purchaseId)

		DataService.replicate(player)
		AnalyticsService.logFunnel(player, "purchase_granted", { product = product.key })
	end

	-- 저장이 확인될 때까지 기다린다.
	local function isSaved(): boolean
		local saved = profile.LastSavedData
		if saved == nil or saved.purchaseHistory == nil then
			return false
		end
		return historyContains(saved.purchaseHistory, purchaseId)
	end

	if isSaved() then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	while profile:IsActive() do
		local before = profile.LastSavedData
		profile:Save()

		if profile.LastSavedData == before then
			profile.OnAfterSave:Wait()
		end

		if isSaved() then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end

		if profile:IsActive() then
			task.wait(10)
		end
	end

	-- 저장을 확인하지 못했다. 다음에 다시 물어보게 둔다.
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if player == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local product = Products.byProductId(receipt.ProductId)
	if product == nil then
		warn(`[ShopService] 모르는 상품 ID: {receipt.ProductId}`)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if not Products.isSellable(product) then
		warn(
			`[ShopService] 내용이 비어 있는 상품의 결제가 들어왔습니다: {product.key}`
		)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	--[[
		유료 확률형이 제한된 유저의 결제는 뽑지 않고 "아직 처리 안 됨"으로 둔다.
		상점은 이런 유저에게 확률형을 보여 주지도, 구매창을 띄우지도 않으므로 게임 안의 정상
		경로로는 여기 올 수 없다. (조작한 클라이언트가 직접 구매창을 띄웠거나, 상품을 게임 소개
		페이지의 Store 탭에 노출한 경우에만 생긴다 → 확률형은 Store 탭에 올리지 말 것.)

		[결정 필요] 공식 문서상 처리 안 된 결제는 자동으로 환불되지 않고, 접속할 때마다 다시
		들어온다. 이런 결제에 무엇을 줄지(예: 확정 개수로 바꿔 지급)는 기획에 없어서 정하지 않았다.
		정해지면 여기서 지급하면 되고, 그때까지 쌓인 결제도 다음 접속 때 함께 처리된다.
	]]
	if product.kind == "random" and isRandomRestricted(player) then
		warn(
			`[ShopService] 확률형이 제한된 유저의 결제를 처리하지 않습니다 ({player.UserId})`
		)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- 프로필이 열릴 때까지 기다린다(방금 접속한 직후일 수 있다).
	local profile = DataService.getProfile(player)
	while profile == nil and player.Parent == Players do
		task.wait()
		profile = DataService.getProfile(player)
	end

	if profile == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	return grantAndConfirm(player, profile, tostring(receipt.PurchaseId), product)
end

--------------------------------------------------------------------------------
-- 상점 목록
--------------------------------------------------------------------------------

-- 결과 목록을 "결과 + 표시 확률" 로 바꾼다. 표시 확률의 합은 정확히 100 이다.
local function describeOutcomes(outcomes: { Products.TicketOutcome }): { Types.ShopOutcome }
	local percents = SwordLogic.exactPercents(DrawLogic.weights(outcomes), PERCENT_DECIMALS)

	local described: { Types.ShopOutcome } = {}
	for index, outcome in outcomes do
		described[index] = { tickets = outcome.tickets, percent = percents[index] }
	end
	return described
end

-- yield 할 수 있다(확률형 제한 확인).
local function handleGetShopItems(player: Player): Types.ShopState
	local items: { Types.ShopItem } = {}

	for _, key in Products.ORDER do
		local product = Products.DeveloperProducts[key]
		if product == nil or not Products.isSellable(product) then
			continue -- ID 나 내용을 넣지 않은 상품은 노출하지 않는다
		end

		if product.kind == "random" then
			if isRandomRestricted(player) then
				continue -- 유료 확률형이 제한된 유저에게는 확정형만 보여 준다
			end
			table.insert(items, {
				key = key,
				kind = "random",
				ticketAmount = 0,
				outcomes = describeOutcomes(product.outcomes),
			})
		else
			table.insert(items, {
				key = key,
				kind = "fixed",
				ticketAmount = product.ticketAmount,
				outcomes = {},
			})
		end
	end

	local shardDraw: Types.ShopShardDraw? = nil
	local shardConfig = Products.SHARD_DRAW
	if Products.isDrawReady(shardConfig.outcomes) then
		shardDraw = {
			cost = shardConfig.cost,
			outcomes = describeOutcomes(shardConfig.outcomes),
		}
	end

	return {
		items = items,
		pityPerMiss = Products.PITY_PER_MISS,
		pityThreshold = Products.PITY_THRESHOLD,
		pityTickets = Products.PITY_TICKETS,
		shardDraw = shardDraw,
	}
end

local function handlePromptPurchase(player: Player, key: any): Types.SimpleResponse
	if type(key) ~= "string" then
		return fail("invalid_argument")
	end

	local product = Products.DeveloperProducts[key]
	if product == nil or not Products.isSellable(product) then
		return fail("not_available")
	end

	if product.kind == "random" and isRandomRestricted(player) then
		return fail("not_available")
	end

	MarketplaceService:PromptProductPurchase(player, product.productId)
	return { ok = true }
end

--------------------------------------------------------------------------------
-- 파편 뽑기 (Robux 가 닿지 않는다)
--------------------------------------------------------------------------------

-- 파편 50개로 방지권 뽑기 1회. yield 하지 않는다.
local function processShardDraw(player: Player): Types.ShardDrawResponse
	if LiveOpsService.isMaintenance() then
		return fail("maintenance")
	end

	local config = Products.SHARD_DRAW
	if not Products.isDrawReady(config.outcomes) then
		return fail("not_available") -- 확률이 아직 정해지지 않았다 (미정 D12)
	end

	local data = DataService.getActiveData(player)
	if data == nil then
		return fail("not_ready")
	end

	if data.shards < config.cost then
		return fail("not_enough_shards")
	end

	local result = DrawLogic.resolveFree(config.outcomes, rng:NextNumber())
	if result == nil then
		return fail("not_available")
	end

	-- 여기서부터 실제 변경.
	EconomyService.spendShards(player, data, config.cost, "shard_draw")
	if result.tickets > 0 then
		EconomyService.addTickets(player, data, result.tickets, "shard_draw")
	end

	AnalyticsService.logFunnel(player, "shard_draw", { tickets = result.tickets })

	return {
		ok = true,
		tickets = result.tickets,
		shards = data.shards,
	}
end

local function handleShardDraw(player: Player): Types.ShardDrawResponse
	if not limiter:consume(player.UserId) then
		return fail("too_fast")
	end
	if not limiter:tryLock(player.UserId) then
		return fail("busy")
	end

	local ok, response = xpcall(processShardDraw, debug.traceback, player)

	limiter:unlock(player.UserId)

	if not ok then
		warn(`[ShopService] 파편 뽑기 처리 중 오류 ({player.UserId}):\n{response}`)
		return fail("unknown")
	end

	if response.ok then
		DataService.replicate(player)
	end

	return response
end

--------------------------------------------------------------------------------

function ShopService.Init()
	-- 상품 설정이 잘못된 채로 서버가 뜨는 일이 없도록 시작할 때 검사한다.
	local problem = Products.validate()
	if problem ~= nil then
		error(`[ShopService] 상품 설정이 잘못되었습니다: {problem}`, 0)
	end

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)

	local itemsRemote = remotesFolder:WaitForChild(Remotes.Functions.GetShopItems) :: RemoteFunction
	itemsRemote.OnServerInvoke = handleGetShopItems

	local promptRemote =
		remotesFolder:WaitForChild(Remotes.Functions.PromptPurchase) :: RemoteFunction
	promptRemote.OnServerInvoke = handlePromptPurchase

	local shardRemote = remotesFolder:WaitForChild(Remotes.Functions.ShardDraw) :: RemoteFunction
	shardRemote.OnServerInvoke = handleShardDraw

	feedRemote = remotesFolder:WaitForChild(Remotes.Events.FeedMessage) :: RemoteEvent
end

function ShopService.Start()
	-- 콜백은 서버 전체에 딱 한 번만 설정한다.
	MarketplaceService.ProcessReceipt = processReceipt

	Players.PlayerRemoving:Connect(function(player)
		restrictedCache[player] = nil
		limiter:clear(player.UserId)
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">SwordDisplayService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SwordDisplayService — 블록 3D 검을 보여 준다 (통합 기획서 8-2절).

	1) 손에 든 검: 모든 플레이어의 오른손에 착용 검을 붙인다. 레벨 색(쇠 달구는 색)과 등급 색이 보인다.
	   보기만 하는 장식이다(부딪힘·무게·능력 없음). 착용 검이나 레벨이 바뀌면 다시 붙인다.
	2) 이 서버 최고 검 진열대: 지금 서버에 있는 사람 중 가장 높은 착용 검을 진열대에 세우고,
	   받침에 주인 이름·검·레벨 속성을 단다(명패 글자와 회전은 기기가 한다). 저장하지 않는다.

	검 모양은 shared/SwordModel(Config/SwordShapes) 이 만든다. 1초마다 바뀐 것만 확인한다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SwordModel = require(Shared:WaitForChild("SwordModel"))
local World = require(Shared:WaitForChild("Config"):WaitForChild("World"))
local SwordLogic = require(Shared:WaitForChild("Pure"):WaitForChild("SwordLogic"))

local services = script.Parent
local DataService = require(services:WaitForChild("DataService"))
local WorldService = require(services:WaitForChild("WorldService"))

local SwordDisplayService = {}
SwordDisplayService.Name = "SwordDisplayService"

local CHECK_SECONDS = 1
local HAND_SCALE = 0.62 -- 캐릭터 키(약 5칸)에 맞춘 크기

-- 플레이어마다 지금 손에 붙인 검의 "검id:레벨"
local handSignature: { [Player]: string } = {}
local showcaseSignature = ""
local showcaseModel: Model? = nil

local function handOf(character: Model): BasePart?
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if hand and hand:IsA("BasePart") then
		return hand
	end
	return nil
end

local function attachToHand(player: Player, swordId: string, level: number)
	local character = player.Character
	if character == nil then
		return
	end
	local hand = handOf(character)
	if hand == nil then
		return
	end

	local old = character:FindFirstChild(SwordModel.MODEL_NAME)
	if old then
		old:Destroy()
	end

	-- 손 아래쪽에서 쥐고, 칼날이 앞(-Z)을 향하게
	local grip = hand.CFrame
		* CFrame.new(0, -hand.Size.Y / 2, -0.15)
		* CFrame.Angles(math.rad(-90), 0, 0)
	local model = SwordModel.build(swordId, level, {
		cframe = grip,
		scale = HAND_SCALE,
		anchored = false,
		effects = true,
	})

	local handle = model.PrimaryPart
	if handle == nil then
		model:Destroy()
		return
	end

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hand
	weld.Part1 = handle
	weld.Parent = handle

	model.Parent = character
	handSignature[player] = `{swordId}:{level}`
end

local function updateHands()
	for player, data in DataService.getAllActive() do
		local sword = SwordLogic.equipped(data.swords, data.equippedId)
		local character = player.Character
		if sword == nil or character == nil then
			continue
		end

		local signature = `{sword.id}:{sword.level}`
		local attached = character:FindFirstChild(SwordModel.MODEL_NAME) ~= nil
		if handSignature[player] ~= signature or not attached then
			local ok, err = pcall(attachToHand, player, sword.id, sword.level)
			if not ok then
				warn(
					`[SwordDisplayService] 손에 검을 붙이지 못했습니다 ({player.UserId}): {err}`
				)
			end
		end
	end
end

local function updateShowcase()
	local base = WorldService.getShowcaseBase()
	if base == nil then
		return
	end

	-- 지금 서버에서 가장 높은 착용 검 (같으면 이름순)
	local bestPlayer: Player? = nil
	local bestId, bestLevel = "", -1
	for player, data in DataService.getAllActive() do
		local sword = SwordLogic.equipped(data.swords, data.equippedId)
		if sword == nil then
			continue
		end
		local better = sword.level > bestLevel
			or (sword.level == bestLevel and bestPlayer ~= nil and player.Name < bestPlayer.Name)
		if better then
			bestPlayer, bestId, bestLevel = player, sword.id, sword.level
		end
	end

	local owner = bestPlayer
	local signature = if owner then `{owner.UserId}:{bestId}:{bestLevel}` else ""
	if signature == showcaseSignature then
		return
	end
	showcaseSignature = signature

	local old = showcaseModel
	if old then
		old:Destroy()
		showcaseModel = nil
	end

	if owner == nil then
		base:SetAttribute(World.ATTR.ownerName, "")
		base:SetAttribute(World.ATTR.swordId, "")
		base:SetAttribute(World.ATTR.swordLevel, 0)
		return
	end

	-- 유리 상자 가운데에 세운다 (회전·떠오르기는 기기가 한다)
	local top = base.Position.Y + base.Size.Y / 2
	local model = SwordModel.build(bestId, bestLevel, {
		cframe = CFrame.new(base.Position.X, top + 1.3, base.Position.Z),
		scale = 0.85,
		anchored = true,
		effects = true,
	})
	model.Name = "ShowcaseSword"
	model.Parent = base.Parent
	showcaseModel = model

	base:SetAttribute(World.ATTR.ownerName, owner.DisplayName)
	base:SetAttribute(World.ATTR.swordId, bestId)
	base:SetAttribute(World.ATTR.swordLevel, bestLevel)
end

function SwordDisplayService.Start()
	Players.PlayerRemoving:Connect(function(player)
		handSignature[player] = nil
	end)

	task.spawn(function()
		while true do
			local ok, err = pcall(updateHands)
			if not ok then
				warn(`[SwordDisplayService] 손에 든 검 갱신 오류: {err}`)
			end
			local okShowcase, errShowcase = pcall(updateShowcase)
			if not okShowcase then
				warn(`[SwordDisplayService] 진열대 갱신 오류: {errShowcase}`)
			end
			task.wait(CHECK_SECONDS)
		end
	end)
end

return SwordDisplayService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">SwordService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SwordService — 검 보관함: 착용 검 바꾸기, 소지 상한 구매 + 새 검 뽑기 (통합 기획서 5절).

	- 착용 검은 가진 검 중에서만 고를 수 있다.
	- 소지 상한은 골드로 1칸씩 산다. 1칸을 사면 그 자리에서 새 검을 1번 뽑는다.
	    가격 = SLOT_PRICE_MULTIPLIER × (SLOT_PRICE_LEVEL 강의 강화 비용, 가진 검 수 할증 포함)
	- 이미 가진 검은 뽑히지 않는다. 뽑힌 검은 0강에서 시작한다.
	- 확률표는 클라이언트가 같은 Pure/SwordLogic 으로 그린다(복제된 데이터 기준).

	골드로만 한다. 여기에 Robux 가 닿는 상품을 만들면 유료 확률형 아이템이 되므로 만들지 않는다.
	클라이언트가 보내는 값은 "착용할 검 id" 하나뿐이다. 가격·확률·결과는 전부 서버가 정한다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ConfigFolder = Shared:WaitForChild("Config")
local Weapons = require(ConfigFolder:WaitForChild("Weapons"))

local SwordLogic = require(Shared:WaitForChild("Pure"):WaitForChild("SwordLogic"))

local services = script.Parent
local DataService = require(services:WaitForChild("DataService"))
local EconomyService = require(services:WaitForChild("EconomyService"))
local AnalyticsService = require(services:WaitForChild("AnalyticsService"))
local LiveOpsService = require(services:WaitForChild("LiveOpsService"))
local EnhanceService = require(services:WaitForChild("EnhanceService"))
local RateLimiter = require(services:WaitForChild("RateLimiter"))

local SwordService = {}
SwordService.Name = "SwordService"

local rng = Random.new()

-- 플레이어당 초당 3회, 동시 처리 1건
local limiter = RateLimiter.new({ maxRequests = 3, windowSeconds = 1 })

local RARITY_OF = Weapons.rarityMap()

local function fail(reason: string): Types.Failure
	return { ok = false, reason = reason }
end

-- 지금 가진 검 수 기준 소지 상한 1칸 가격
local function slotPriceFor(data: Types.PlayerData): number
	local count = SwordLogic.count(data.swords)
	return SwordLogic.slotPrice(
		EnhanceService.costFor(Weapons.SLOT_PRICE_LEVEL, count),
		Weapons.SLOT_PRICE_MULTIPLIER
	)
end

local function processEquip(player: Player, swordId: string): Types.EquipResponse
	local data = DataService.getActiveData(player)
	if data == nil then
		return fail("not_ready")
	end

	if data.swords[swordId] == nil then
		return fail("not_owned")
	end

	data.equippedId = swordId

	return {
		ok = true,
		swordId = swordId,
		odds = EnhanceService.getDisplayOdds(data),
	}
end

-- 소지 상한 1칸 구매 + 뽑기 1회. yield 하지 않는다.
local function processDraw(player: Player): Types.DrawResponse
	if LiveOpsService.isMaintenance() then
		return fail("maintenance")
	end

	local data = DataService.getActiveData(player)
	if data == nil then
		return fail("not_ready")
	end

	local drawTable =
		SwordLogic.buildDrawTable(Weapons.Order, RARITY_OF, Weapons.DRAW_WEIGHTS, data.swords)
	if #drawTable.entries == 0 then
		return fail("no_more_swords")
	end

	local price = slotPriceFor(data)
	if not EconomyService.canAfford(data, price) then
		return fail("not_enough_gold")
	end

	local swordId = SwordLogic.pick(drawTable, rng:NextNumber())
	if swordId == nil then
		return fail("no_more_swords")
	end

	-- 여기서부터 실제 변경.
	EconomyService.spendGold(player, data, price, "sword_slot")

	data.swordCapacity = math.max(data.swordCapacity, SwordLogic.count(data.swords)) + 1
	data.swords[swordId] = { id = swordId, level = 0, bestLevel = 0 }

	AnalyticsService.logFunnel(player, "sword_drawn", { sword = swordId, price = price })

	return {
		ok = true,
		swordId = swordId,
		pricePaid = price,
		gold = data.gold,
		odds = EnhanceService.getDisplayOdds(data),
	}
end

-- 레이트 리밋·락·오류 처리를 씌운 공통 입구
local function guarded(player: Player, handler: (...any) -> any, ...: any): any
	if not limiter:consume(player.UserId) then
		return fail("too_fast")
	end
	if not limiter:tryLock(player.UserId) then
		return fail("busy")
	end

	local ok, response = xpcall(handler, debug.traceback, player, ...)

	limiter:unlock(player.UserId)

	if not ok then
		warn(`[SwordService] 처리 중 오류 ({player.UserId}):\n{response}`)
		return fail("unknown")
	end

	if response.ok then
		DataService.replicate(player)
	end

	return response
end

local function handleEquip(player: Player, swordId: any): Types.EquipResponse
	if type(swordId) ~= "string" or Weapons.get(swordId) == nil then
		return fail("invalid_argument")
	end
	return guarded(player, processEquip, swordId)
end

local function handleDraw(player: Player): Types.DrawResponse
	return guarded(player, processDraw)
end

function SwordService.Init()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)

	local equipRemote = remotesFolder:WaitForChild(Remotes.Functions.EquipSword) :: RemoteFunction
	equipRemote.OnServerInvoke = handleEquip

	local drawRemote = remotesFolder:WaitForChild(Remotes.Functions.BuySwordSlot) :: RemoteFunction
	drawRemote.OnServerInvoke = handleDraw
end

function SwordService.Start()
	Players.PlayerRemoving:Connect(function(player)
		limiter:clear(player.UserId)
	end)
end

return SwordService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">TreadmillService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	TreadmillService — 로비 트레드밀 수입 (통합 기획서 6절).

	발판 위에 있으면 단계별로 정해진 시간마다 골드를 받는다(1단계: 20초당 100골드).
	- 무료만 있다. Robux 가 닿는 트레드밀은 만들지 않는다(골드를 간접적으로 파는 것이 된다).
	- 자리 비움 제한을 두지 않는다. 가만히 서 있어도 받는다.
	- "발판 위에 있는지"는 서버가 본 캐릭터 위치로 판단한다. 클라이언트가 보내는 값은 없다.
	- 발판에서 내려오면 채우던 시간은 멈춘 채 남는다. 다시 올라오면 이어서 채운다(접속 중에만).
	- 점검 모드에서는 시간이 가지 않는다(다른 골드 변동과 같이 멈춘다).

	[미정 D18] 2단계 이상은 아직 없다. EconomyConfig.TREADMILL_TIERS 와 Config/World 의
	TREADMILL_PADS 에 추가하면 이 서비스는 그대로 동작한다. 해금 조건이 생기면 padUnder 에서 확인한다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local TreadmillLogic = require(Shared:WaitForChild("Pure"):WaitForChild("TreadmillLogic"))
local World = require(Shared:WaitForChild("Config"):WaitForChild("World"))

local services = script.Parent
local DataService = require(services:WaitForChild("DataService"))
local EconomyService = require(services:WaitForChild("EconomyService"))
local LiveOpsService = require(services:WaitForChild("LiveOpsService"))
local WorldService = require(services:WaitForChild("WorldService"))

local TreadmillService = {}
TreadmillService.Name = "TreadmillService"

-- 발판 위에 있는지 확인하는 주기(초)
local TICK_SECONDS = 1

-- 이번 지급까지 채운 시간(초). 접속 중에만 유지한다.
local progress: { [Player]: number } = {}
local wasOnPad: { [Player]: boolean } = {}

local updateRemote: RemoteEvent? = nil

local function send(player: Player, payload: Types.TreadmillUpdate)
	if updateRemote then
		updateRemote:FireClient(player, payload)
	end
end

-- 플레이어가 올라가 있는 발판. 없으면 nil.
local function padUnder(player: Player): WorldService.TreadmillPad?
	local character = player.Character
	if character == nil then
		return nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil or humanoid.Health <= 0 then
		return nil
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	if root == nil or not root:IsA("BasePart") then
		return nil
	end

	local position = root.Position
	for _, pad in WorldService.getTreadmillPads() do
		if TreadmillLogic.isOnPad(position.X, position.Y, position.Z, pad.bounds) then
			return pad
		end
	end
	return nil
end

--[[
	광장 연출용 상태를 세계 물체의 속성으로 알린다 (기기가 보고 벨트·풀무·화덕을 움직인다).
	  발판 Occupied: 누가 올라서 있는지 / Lobby TreadmillUsers: 러닝머신 위 인원 (화덕 불 크기)
]]
local function publishOccupancy(occupied: { [BasePart]: boolean }, users: number)
	for _, pad in WorldService.getTreadmillPads() do
		local now = occupied[pad.part] == true
		if pad.part:GetAttribute(World.ATTR.occupied) ~= now then
			pad.part:SetAttribute(World.ATTR.occupied, now)
		end
	end
	local lobby = WorldService.getLobby()
	if lobby and lobby:GetAttribute(World.ATTR.treadmillUsers) ~= users then
		lobby:SetAttribute(World.ATTR.treadmillUsers, users)
	end
end

local function step(dt: number)
	if LiveOpsService.isMaintenance() then
		publishOccupancy({}, 0)
		return
	end

	local occupied: { [BasePart]: boolean } = {}
	local users = 0

	for player, data in DataService.getAllActive() do
		local pad = padUnder(player)

		if pad == nil then
			if wasOnPad[player] then
				wasOnPad[player] = nil
				send(player, {
					onPad = false,
					progress = progress[player] or 0,
					interval = 0,
					gold = 0,
					paid = 0,
				})
			end
			continue
		end

		occupied[pad.part] = true
		users += 1

		local tier = pad.tier
		local rest, payouts =
			TreadmillLogic.advance(progress[player] or 0, dt, tier.intervalSeconds)
		progress[player] = rest
		wasOnPad[player] = true

		local paid = 0
		if payouts > 0 then
			paid = EconomyService.addGold(player, data, payouts * tier.gold, "treadmill")
			DataService.replicate(player)
			-- 주변 사람에게도 금화가 튀는 연출이 보이게 지급 시각을 남긴다
			pad.part:SetAttribute(World.ATTR.paidAt, Workspace:GetServerTimeNow())
		end

		send(player, {
			onPad = true,
			progress = rest,
			interval = tier.intervalSeconds,
			gold = tier.gold,
			paid = paid,
		})
	end

	publishOccupancy(occupied, users)
end

function TreadmillService.Init()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	updateRemote = remotesFolder:WaitForChild(Remotes.Events.TreadmillUpdate) :: RemoteEvent
end

function TreadmillService.Start()
	Players.PlayerRemoving:Connect(function(player)
		progress[player] = nil
		wasOnPad[player] = nil
	end)

	task.spawn(function()
		local last = os.clock()

		while true do
			task.wait(TICK_SECONDS)

			local now = os.clock()
			local ok, err = xpcall(step, debug.traceback, now - last)
			last = now

			if not ok then
				warn(`[TreadmillService] 처리 중 오류:\n{err}`)
			end
		end
	end)
end

return TreadmillService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WorldService — 불씨 광장(로비)을 블록으로 짓는다 (통합 기획서 8-2절, 디자인 시안 "불씨 광장과 쇳물 수로").

	해 질 녘 대장간 마을. 지은 뒤 움직이는 장식(망치질, 벨트, 풀무, 관문 고리, 불빛 흔들림)은
	각 플레이어 기기(WorldFxController)가 돌리고, 서버는 짓기와 "상태 속성"만 맡는다(서버 부담을 줄이기 위해).
	글자(표지판, 전광판, 명예의 벽, 진열대 명패)도 언어가 플레이어마다 달라서 기기가 붙인다.

	지은 것:
	  바닥·낮은 돌담·보이지 않는 벽 / 스폰 원판 / 돌길과 표지판 / 횃불 8개
	  모루 영감의 대장간(기단·기둥·지붕·뒷벽·화덕·굴뚝·모루·연장·물통) + 모루 영감 블록 인형 + "강화하기" 근접 버튼
	  쇳물 관문(기둥·윗돌·문양·전광판·뒤 쇳물 폭포) + 바닥 원(고리 12칸)
	  풀무 러닝머신 4대(받침·벨트·줄무늬·난간·손잡이·계기판·풀무) + 화덕까지 이어진 쇠 관
	  명예의 벽 / 서버 최고 검 진열대(검은 SwordDisplayService 가 넣는다) / 담 밖 산
	  해 질 녘 빛(시각·대기·번짐·색 보정·햇살)

	- Workspace 에 이미 "Lobby" 폴더가 있으면(개발자가 Studio 에서 직접 꾸민 경우) 새로 짓지 않고
	  그 안의 Treadmills 폴더에서 발판을 찾아 쓴다.
	- 캐릭터끼리는 서로 부딪치지 않게 한다 (공식 문서 workspace/collisions 의 방식).
	- 부트스트랩 맨 앞에서 Init 된다. 캐릭터가 나타나기 전에 바닥이 있어야 하기 때문이다.
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))

local ConfigFolder = Shared:WaitForChild("Config")
local World = require(ConfigFolder:WaitForChild("World"))
local EconomyConfig = require(ConfigFolder:WaitForChild("EconomyConfig"))
local Palette = require(ConfigFolder:WaitForChild("Palette"))

local TreadmillLogic = require(Shared:WaitForChild("Pure"):WaitForChild("TreadmillLogic"))

local WorldService = {}
WorldService.Name = "WorldService"

export type TreadmillPad = {
	part: BasePart,
	tier: EconomyConfig.TreadmillTier,
	bounds: TreadmillLogic.Pad,
}

local W = Palette.WORLD
local function rgb(values: { number }): Color3
	return Color3.fromRGB(values[1], values[2], values[3])
end

local rng = Random.new()

local pads: { TreadmillPad } = {}
local racesFolder: Folder? = nil
local lobbyFolder: Instance? = nil
local gateModel: Model? = nil
local showcaseBase: BasePart? = nil
local collisionGroupReady = false
local worldEvent: RemoteEvent? = nil

--------------------------------------------------------------------------------
-- 블록 하나 놓기
--------------------------------------------------------------------------------

type PartProps = {
	name: string?,
	size: Vector3,
	cframe: CFrame,
	color: { number },
	material: Enum.Material?,
	shape: Enum.PartType?,
	collide: boolean?,
	transparency: number?,
	shadow: boolean?,
}

local function block(parent: Instance, props: PartProps): Part
	local part = Instance.new("Part")
	part.Name = props.name or "Part"
	part.Anchored = true
	part.CanTouch = false
	part.Size = props.size
	part.CFrame = props.cframe
	part.Color = rgb(props.color)
	part.Material = props.material or Enum.Material.SmoothPlastic
	part.Shape = props.shape or Enum.PartType.Block
	part.CanCollide = props.collide ~= false
	part.Transparency = props.transparency or 0
	part.CastShadow = props.shadow ~= false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function light(
	parent: Instance,
	name: string,
	color: { number },
	range: number,
	brightness: number,
	shadows: boolean?
)
	local pointLight = Instance.new("PointLight")
	pointLight.Name = name
	pointLight.Color = rgb(color)
	pointLight.Range = range
	pointLight.Brightness = brightness
	pointLight.Shadows = shadows == true
	pointLight.Parent = parent
	return pointLight
end

local function fire(parent: Instance, size: number, heat: number, name: string?)
	local flame = Instance.new("Fire")
	flame.Name = name or "Fire"
	flame.Color = rgb(W.molten)
	flame.SecondaryColor = rgb(W.moltenHot)
	flame.Size = size
	flame.Heat = heat
	flame.Parent = parent
	return flame
end

-- 불티 (기본 상태는 꺼짐, 연출이 :Emit 으로 쏜다)
local function sparks(parent: Instance, name: string, color: { number }): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name
	emitter.Color = ColorSequence.new(rgb(color))
	emitter.LightEmission = 1
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.3, 0.7)
	emitter.Speed = NumberRange.new(6, 12)
	emitter.SpreadAngle = Vector2.new(50, 50)
	emitter.Size = NumberSequence.new(0.18, 0)
	emitter.Acceleration = Vector3.new(0, -30, 0)
	emitter.Parent = parent
	return emitter
end

--------------------------------------------------------------------------------
-- 캐릭터끼리 부딪치지 않게
--------------------------------------------------------------------------------

local function setupCollisionGroup()
	local group = World.CHARACTER_COLLISION_GROUP
	local ok, err = pcall(function()
		if not Workspace:IsCollisionGroupRegistered(group) then
			Workspace:RegisterCollisionGroup(group)
		end
		Workspace:CollisionGroupSetCollidable(group, group, false)
	end)
	if ok then
		collisionGroupReady = true
	else
		warn(`[WorldService] 충돌 그룹을 만들지 못했습니다: {err}`)
	end
end

local function onCharacterDescendantAdded(descendant: Instance)
	if collisionGroupReady and descendant:IsA("BasePart") then
		descendant.CollisionGroup = World.CHARACTER_COLLISION_GROUP
	end
end

local function onCharacterAdded(character: Model)
	for _, descendant in character:GetDescendants() do
		onCharacterDescendantAdded(descendant)
	end
	character.DescendantAdded:Connect(onCharacterDescendantAdded)
end

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(onCharacterAdded)
	local character = player.Character
	if character then
		onCharacterAdded(character)
	end
end

--------------------------------------------------------------------------------
-- 해 질 녘 빛
--------------------------------------------------------------------------------

local function setupLighting()
	Lighting.ClockTime = 17.6
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(70, 52, 62)
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 96, 96)

	-- Studio 에서 직접 넣은 효과가 있으면 존중한다
	if Lighting:FindFirstChildOfClass("Atmosphere") == nil then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.35
		atmosphere.Offset = 0.2
		atmosphere.Color = Color3.fromRGB(255, 170, 120)
		atmosphere.Decay = Color3.fromRGB(90, 60, 80)
		atmosphere.Glare = 0.4
		atmosphere.Haze = 1.6
		atmosphere.Parent = Lighting
	end
	if Lighting:FindFirstChildOfClass("BloomEffect") == nil then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.6
		bloom.Size = 24
		bloom.Threshold = 1.6
		bloom.Parent = Lighting
	end
	if Lighting:FindFirstChildOfClass("ColorCorrectionEffect") == nil then
		local correction = Instance.new("ColorCorrectionEffect")
		correction.Saturation = 0.1
		correction.TintColor = Color3.fromRGB(255, 240, 225)
		correction.Parent = Lighting
	end
	if Lighting:FindFirstChildOfClass("SunRaysEffect") == nil then
		local rays = Instance.new("SunRaysEffect")
		rays.Intensity = 0.05
		rays.Parent = Lighting
	end
end

--------------------------------------------------------------------------------
-- 광장 바탕
--------------------------------------------------------------------------------

local function buildGround(parent: Instance)
	local lobby = World.LOBBY
	local halfX, halfZ = lobby.sizeX / 2, lobby.sizeZ / 2

	block(parent, {
		name = "Floor",
		size = Vector3.new(lobby.sizeX, lobby.floorThickness, lobby.sizeZ),
		cframe = at(0, -lobby.floorThickness / 2, 0),
		color = W.stoneDark,
		material = Enum.Material.Slate,
	})

	-- 낮은 돌담 + 그 위 보이지 않는 벽
	local t = 2
	local walls = {
		{ Vector3.new(lobby.sizeX + 2 * t, 0, t), Vector3.new(0, 0, halfZ + t / 2) },
		{ Vector3.new(lobby.sizeX + 2 * t, 0, t), Vector3.new(0, 0, -halfZ - t / 2) },
		{ Vector3.new(t, 0, lobby.sizeZ), Vector3.new(halfX + t / 2, 0, 0) },
		{ Vector3.new(t, 0, lobby.sizeZ), Vector3.new(-halfX - t / 2, 0, 0) },
	}
	for index, wall in walls do
		local size, pos = wall[1], wall[2]
		block(parent, {
			name = `StoneWall{index}`,
			size = Vector3.new(size.X, lobby.stoneWallHeight, size.Z),
			cframe = at(pos.X, lobby.stoneWallHeight / 2, pos.Z),
			color = W.stone,
			material = Enum.Material.Slate,
		})
		block(parent, {
			name = `Barrier{index}`,
			size = Vector3.new(size.X, lobby.wallHeight, size.Z),
			cframe = at(pos.X, lobby.stoneWallHeight + lobby.wallHeight / 2, pos.Z),
			color = W.stone,
			transparency = 1,
			shadow = false,
		})
	end

	-- 돌길 (밟아도 걸리지 않게 얇고 부딪힘 없음)
	for index, path in World.PATHS do
		local dx, dz = path.x2 - path.x1, path.z2 - path.z1
		local length = math.sqrt(dx * dx + dz * dz)
		local mid = Vector3.new((path.x1 + path.x2) / 2, 0.06, (path.z1 + path.z2) / 2)
		block(parent, {
			name = `Path{index}`,
			size = Vector3.new(path.width, 0.12, length + path.width),
			cframe = CFrame.lookAt(mid, mid + Vector3.new(dx, 0, dz)),
			color = W.cobble,
			material = Enum.Material.Cobblestone,
			collide = false,
			shadow = false,
		})
	end
end

local function buildSpawn(parent: Instance)
	local lobby = World.LOBBY
	local x, z = lobby.spawnX, lobby.spawnZ

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 0.4, 12)
	spawn.CFrame =
		CFrame.lookAt(Vector3.new(x, 0.2, z), Vector3.new(World.FORGE.x, 0.2, World.FORGE.z))
	spawn.Transparency = 1
	spawn.Neutral = true
	spawn.Duration = 0 -- 스폰 직후 보호막 없음
	spawn.Parent = parent

	-- 둥근 돌 원판 + 불꽃 테두리 + 모루 무늬
	local flat = CFrame.Angles(0, 0, math.rad(90))
	block(parent, {
		name = "SpawnDisc",
		size = Vector3.new(0.3, lobby.spawnSize, lobby.spawnSize),
		cframe = at(x, 0.15, z) * flat,
		color = W.stone,
		material = Enum.Material.Slate,
		shape = Enum.PartType.Cylinder,
		collide = false,
	})
	block(parent, {
		name = "SpawnRing",
		size = Vector3.new(0.2, lobby.spawnSize + 1, lobby.spawnSize + 1),
		cframe = at(x, 0.1, z) * flat,
		color = W.ember,
		material = Enum.Material.Neon,
		shape = Enum.PartType.Cylinder,
		collide = false,
		transparency = 0.35,
		shadow = false,
	})
	-- 모루 무늬 (윗판 · 허리 · 받침)
	for _, piece in { { 6, 1.2, 1.4 }, { 1.6, 1.2, -0.2 }, { 4, 1.2, -1.6 } } do
		block(parent, {
			name = "SpawnMark",
			size = Vector3.new(piece[1], 0.05, piece[2]),
			cframe = at(x, 0.32, z + piece[3]),
			color = W.ember,
			material = Enum.Material.Neon,
			collide = false,
			transparency = 0.2,
			shadow = false,
		})
	end
end

local function buildTorch(parent: Instance, x: number, z: number, index: number)
	local baseY = World.LOBBY.stoneWallHeight
	block(parent, {
		name = `TorchPost{index}`,
		size = Vector3.new(0.6, 4, 0.6),
		cframe = at(x, baseY + 2, z),
		color = W.wood,
		material = Enum.Material.Wood,
	})
	local bowl = block(parent, {
		name = `TorchBowl{index}`,
		size = Vector3.new(0.8, 1.6, 1.6),
		cframe = at(x, baseY + 4.3, z) * CFrame.Angles(0, 0, math.rad(90)),
		color = W.iron,
		material = Enum.Material.Metal,
		shape = Enum.PartType.Cylinder,
	})
	fire(bowl, 3, 6)
	light(bowl, "TorchLight", W.ember, 14, 1.3)
end

local function buildSigns(parent: Instance)
	for index, sign in World.SIGNS do
		local rotation = CFrame.Angles(0, math.rad(sign.facing), 0)
		block(parent, {
			name = `SignPost{index}`,
			size = Vector3.new(0.5, 4, 0.5),
			cframe = at(sign.x, 2, sign.z) * rotation,
			color = W.wood,
			material = Enum.Material.Wood,
		})
		local board = block(parent, {
			name = `Sign{index}`,
			size = Vector3.new(7, 2.2, 0.4),
			cframe = at(sign.x, 4.6, sign.z) * rotation,
			color = W.wood,
			material = Enum.Material.WoodPlanks,
		})
		board:SetAttribute(World.ATTR.signKey, sign.key)
	end
end

local function buildMountains(parent: Instance)
	for index, mountain in World.MOUNTAINS do
		-- 쐐기 두 개를 등지게 붙여 산마루 모양
		for side = 0, 1 do
			block(parent, {
				name = `Mountain{index}`,
				size = Vector3.new(mountain.width / 2, mountain.height, mountain.width * 0.6),
				cframe = at(
					mountain.x + (side - 0.5) * mountain.width / 2,
					mountain.height / 2 - 4,
					mountain.z
				) * CFrame.Angles(0, math.rad(if side == 0 then 90 else -90), 0),
				color = W.mountain,
				material = Enum.Material.Slate,
				shape = Enum.PartType.Wedge,
				collide = false,
				shadow = false,
			})
		end
	end
end

--------------------------------------------------------------------------------
-- 모루 영감의 대장간
--------------------------------------------------------------------------------

local function buildNpc(parent: Instance)
	local spec = World.FORGE.npc
	local anvil = World.FORGE.anvil
	local base = 1 -- 대장간 기단 윗면
	-- 모루 쪽(+X)을 바라본다
	local facing = CFrame.lookAt(Vector3.new(spec.x, 0, spec.z), Vector3.new(anvil.x, 0, anvil.z))
	local function local_(x: number, y: number, z: number): CFrame
		return CFrame.new(spec.x, base, spec.z) * (facing - facing.Position) * CFrame.new(x, y, z)
	end

	local npc = Instance.new("Model")
	npc.Name = "AnvilElder"

	block(npc, {
		name = "LegL",
		size = Vector3.new(0.9, 2, 0.9),
		cframe = local_(-0.5, 1, 0),
		color = W.iron,
	})
	block(npc, {
		name = "LegR",
		size = Vector3.new(0.9, 2, 0.9),
		cframe = local_(0.5, 1, 0),
		color = W.iron,
	})
	block(npc, {
		name = "Torso",
		size = Vector3.new(2.2, 2.2, 1.2),
		cframe = local_(0, 3.1, 0),
		color = W.apron,
	})
	block(npc, {
		name = "Apron",
		size = Vector3.new(1.8, 2.8, 0.2),
		cframe = local_(0, 2.6, -0.7),
		color = W.leather,
		material = Enum.Material.Fabric,
	})
	local head = block(npc, {
		name = "Head",
		size = Vector3.new(1.4, 1.4, 1.4),
		cframe = local_(0, 4.9, 0),
		color = W.skin,
	})
	block(npc, {
		name = "Beard",
		size = Vector3.new(1.4, 1.2, 0.5),
		cframe = local_(0, 4.25, -0.75) * CFrame.Angles(math.rad(180), 0, 0),
		color = W.beard,
		material = Enum.Material.Fabric,
		shape = Enum.PartType.Wedge,
	})
	block(npc, {
		name = "BrowL",
		size = Vector3.new(0.5, 0.18, 0.2),
		cframe = local_(-0.35, 5.25, -0.72),
		color = W.beard,
	})
	block(npc, {
		name = "BrowR",
		size = Vector3.new(0.5, 0.18, 0.2),
		cframe = local_(0.35, 5.25, -0.72),
		color = W.beard,
	})
	block(npc, {
		name = "Cap",
		size = Vector3.new(1.5, 0.4, 1.5),
		cframe = local_(0, 5.75, 0),
		color = W.apron,
		material = Enum.Material.Fabric,
	})
	block(npc, {
		name = "ArmL",
		size = Vector3.new(0.7, 2, 0.7),
		cframe = local_(-1.45, 3.1, 0),
		color = W.skin,
	})

	-- 망치 든 오른팔: 어깨를 축으로 돈다 (기기가 돌린다)
	local arm = Instance.new("Model")
	arm.Name = "HammerArm"
	local shoulder = local_(1.45, 4.1, 0)
	block(arm, {
		name = "Arm",
		size = Vector3.new(0.7, 2, 0.7),
		cframe = shoulder * CFrame.new(0, -1, 0),
		color = W.skin,
	})
	block(arm, {
		name = "Haft",
		size = Vector3.new(0.25, 2.2, 0.25),
		cframe = shoulder * CFrame.new(0, -2, -0.9) * CFrame.Angles(math.rad(90), 0, 0),
		color = W.wood,
		material = Enum.Material.Wood,
	})
	block(arm, {
		name = "HammerHead",
		size = Vector3.new(0.6, 0.6, 1.1),
		cframe = shoulder * CFrame.new(0, -2, -2),
		color = W.iron,
		material = Enum.Material.Metal,
	})
	arm.WorldPivot = shoulder
	arm.Parent = npc

	npc.PrimaryPart = head
	npc.Parent = parent
end

local function buildForge(parent: Instance)
	local spec = World.FORGE
	local forge = folder(parent, "Forge")
	local cx, cz = spec.x, spec.z
	local hx, hz = spec.sizeX / 2, spec.sizeZ / 2

	block(forge, {
		name = "Base",
		size = Vector3.new(spec.sizeX, 1, spec.sizeZ),
		cframe = at(cx, 0.5, cz),
		color = W.stone,
		material = Enum.Material.Slate,
	})

	for _, corner in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		block(forge, {
			name = "Post",
			size = Vector3.new(1.6, spec.postHeight, 1.6),
			cframe = at(
				cx + corner[1] * (hx - 1),
				1 + spec.postHeight / 2,
				cz + corner[2] * (hz - 1)
			),
			color = W.wood,
			material = Enum.Material.Wood,
		})
	end

	-- 뒷벽(북쪽)과 양옆 반쯤 막힌 벽
	block(forge, {
		name = "BackWall",
		size = Vector3.new(spec.sizeX - 2, spec.postHeight, 1),
		cframe = at(cx, 1 + spec.postHeight / 2, cz + hz - 1),
		color = W.brick,
		material = Enum.Material.Brick,
	})
	for side = -1, 1, 2 do
		block(forge, {
			name = "SideWall",
			size = Vector3.new(1, spec.postHeight * 0.45, spec.sizeZ - 2),
			cframe = at(cx + side * (hx - 1), 1 + spec.postHeight * 0.225, cz),
			color = W.brick,
			material = Enum.Material.Brick,
		})
	end

	-- 지붕: 앞쪽으로 기운 판 + 마룻대
	block(forge, {
		name = "Roof",
		size = Vector3.new(spec.sizeX + 4, 1, spec.sizeZ + 4),
		cframe = at(cx, 1 + spec.postHeight + 1.2, cz) * CFrame.Angles(math.rad(-10), 0, 0),
		color = W.roof,
		material = Enum.Material.Slate,
	})
	block(forge, {
		name = "RoofBeam",
		size = Vector3.new(spec.sizeX + 5, 1.2, 1.2),
		cframe = at(cx, 1 + spec.postHeight + 2.4, cz + hz + 1.2),
		color = W.wood,
		material = Enum.Material.Wood,
	})

	-- 화덕
	local furnace = spec.furnace
	block(forge, {
		name = "Furnace",
		size = Vector3.new(furnace.sizeX, furnace.sizeY, furnace.sizeZ),
		cframe = at(furnace.x, 1 + furnace.sizeY / 2, furnace.z),
		color = W.brick,
		material = Enum.Material.Brick,
	})
	local mouth = block(forge, {
		name = "FurnaceMouth",
		size = Vector3.new(3.6, 2.4, 0.3),
		cframe = at(furnace.x, 1 + 2.2, furnace.z - furnace.sizeZ / 2 - 0.1),
		color = W.moltenHot,
		material = Enum.Material.Neon,
		collide = false,
	})
	light(mouth, "FurnaceLight", W.ember, 18, 2.2, true)
	local flameHolder = block(forge, {
		name = "FurnaceFlame",
		size = Vector3.new(2, 1, 2),
		cframe = at(furnace.x, 1 + 2.4, furnace.z - 1),
		color = W.molten,
		transparency = 1,
		collide = false,
		shadow = false,
	})
	fire(flameHolder, 4, 8, "FurnaceFire")

	-- 굴뚝
	local chimney = spec.chimney
	local chimneyBottom = 1 + furnace.sizeY
	local chimneyHeight = chimney.height - chimneyBottom
	block(forge, {
		name = "Chimney",
		size = Vector3.new(chimney.size, chimneyHeight, chimney.size),
		cframe = at(chimney.x, chimneyBottom + chimneyHeight / 2, chimney.z),
		color = W.brick,
		material = Enum.Material.Brick,
	})
	local top = block(forge, {
		name = "ChimneyTop",
		size = Vector3.new(chimney.size, 0.5, chimney.size),
		cframe = at(chimney.x, chimney.height + 0.25, chimney.z),
		color = W.iron,
		material = Enum.Material.Metal,
	})
	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(150, 140, 145)
	smoke.Opacity = 0.18
	smoke.RiseVelocity = 4
	smoke.Size = 3
	smoke.Parent = top

	-- 모루 (받침 · 허리 · 윗판 · 뿔)
	local anvil = spec.anvil
	block(forge, {
		name = "AnvilBase",
		size = Vector3.new(3, 1.2, 2),
		cframe = at(anvil.x, 1.6, anvil.z),
		color = W.iron,
		material = Enum.Material.Metal,
	})
	block(forge, {
		name = "AnvilWaist",
		size = Vector3.new(1.4, 1.4, 1),
		cframe = at(anvil.x, 2.9, anvil.z),
		color = W.iron,
		material = Enum.Material.Metal,
	})
	local anvilTop = block(forge, {
		name = "AnvilTop",
		size = Vector3.new(4.4, 1.2, 1.8),
		cframe = at(anvil.x, 4.2, anvil.z),
		color = W.iron,
		material = Enum.Material.Metal,
	})
	block(forge, {
		name = "AnvilHorn",
		size = Vector3.new(1.8, 1.2, 1.6),
		cframe = at(anvil.x + 3, 4.2, anvil.z) * CFrame.Angles(0, math.rad(-90), 0),
		color = W.iron,
		material = Enum.Material.Metal,
		shape = Enum.PartType.Wedge,
	})
	sparks(anvilTop, "Sparks", W.gold)
	light(anvilTop, "AnvilGlow", W.gold, 10, 0)

	-- "강화하기" 근접 버튼. 글자는 기기가 플레이어 언어로 바꾼다.
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ForgePrompt"
	prompt.ActionText = ""
	prompt.ObjectText = ""
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = spec.promptDistance
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = anvilTop
	prompt.Triggered:Connect(function(player: Player)
		if worldEvent then
			worldEvent:FireClient(player, { kind = "openForge" })
		end
	end)

	-- 연장 걸이와 물통
	for index, x in { -8, -5, -2 } do
		block(forge, {
			name = `ToolHaft{index}`,
			size = Vector3.new(0.3, 2.6, 0.3),
			cframe = at(cx + x, 7, cz + hz - 1.7),
			color = W.wood,
			material = Enum.Material.Wood,
		})
		block(forge, {
			name = `ToolHead{index}`,
			size = Vector3.new(1.1, 0.6, 0.6),
			cframe = at(cx + x, 8.2, cz + hz - 1.7),
			color = W.iron,
			material = Enum.Material.Metal,
		})
	end
	block(forge, {
		name = "QuenchTub",
		size = Vector3.new(2, 3, 3),
		cframe = at(cx - 11, 2, cz + 4) * CFrame.Angles(0, 0, math.rad(90)),
		color = W.wood,
		material = Enum.Material.WoodPlanks,
		shape = Enum.PartType.Cylinder,
	})
	block(forge, {
		name = "QuenchWater",
		size = Vector3.new(0.1, 2.6, 2.6),
		cframe = at(cx - 11, 3, cz + 4) * CFrame.Angles(0, 0, math.rad(90)),
		color = W.glass,
		material = Enum.Material.Glass,
		shape = Enum.PartType.Cylinder,
		transparency = 0.4,
		collide = false,
	})

	buildNpc(forge)
end

--------------------------------------------------------------------------------
-- 쇳물 관문
--------------------------------------------------------------------------------

local function buildGate(parent: Instance)
	local spec = World.GATE
	local gate = Instance.new("Model")
	gate.Name = "Gate"

	local half = spec.width / 2 - spec.pillarSize / 2
	for side = -1, 1, 2 do
		local x = spec.x + side * half
		block(gate, {
			name = "Pillar",
			size = Vector3.new(spec.pillarSize, spec.pillarHeight, spec.pillarSize),
			cframe = at(x, spec.pillarHeight / 2, spec.z),
			color = W.stone,
			material = Enum.Material.Slate,
		})
		for _, y in { 5, 12 } do
			block(gate, {
				name = "Band",
				size = Vector3.new(spec.pillarSize + 0.4, 0.6, spec.pillarSize + 0.4),
				cframe = at(x, y, spec.z),
				color = W.iron,
				material = Enum.Material.Metal,
			})
		end
		local rune = block(gate, {
			name = "Rune",
			size = Vector3.new(0.3, 12, 0.6),
			cframe = at(x - side * (spec.pillarSize / 2 + 0.1), 9, spec.z),
			color = W.molten,
			material = Enum.Material.Neon,
			collide = false,
			transparency = 0.5,
			shadow = false,
		})
		light(rune, "RuneLight", W.molten, 10, 0.8)
	end

	block(gate, {
		name = "Lintel",
		size = Vector3.new(spec.width, 4, spec.pillarSize),
		cframe = at(spec.x, spec.pillarHeight + 2, spec.z),
		color = W.stone,
		material = Enum.Material.Slate,
	})
	block(gate, {
		name = "Board",
		size = Vector3.new(14, 4, 0.4),
		cframe = at(spec.x, spec.pillarHeight + 6.5, spec.z - 0.6),
		color = W.wood,
		material = Enum.Material.WoodPlanks,
	})

	-- 관문 뒤로 흘러내리는 쇳물 (네온 줄 3개, 밝기는 기기가 엇갈려 바꾼다)
	block(gate, {
		name = "FallWall",
		size = Vector3.new(spec.width - 4, 16, 1),
		cframe = at(spec.x, 8, spec.z + 3),
		color = W.stoneDark,
		material = Enum.Material.Slate,
	})
	for index, x in { -6, 0, 6 } do
		local fall = block(gate, {
			name = `MoltenFall{index}`,
			size = Vector3.new(1.4, 16, 0.2),
			cframe = at(spec.x + x, 8, spec.z + 2.4),
			color = W.molten,
			material = Enum.Material.Neon,
			collide = false,
			shadow = false,
		})
		if index == 2 then
			local embers = sparks(fall, "Embers", W.moltenHot)
			embers.Rate = 6
			embers.Speed = NumberRange.new(1, 3)
			embers.Acceleration = Vector3.new(0, 4, 0)
		end
	end

	-- 바닥 원: 돌 원판 + 고리 12칸
	local flat = CFrame.Angles(0, 0, math.rad(90))
	block(gate, {
		name = "RingDisc",
		size = Vector3.new(0.25, spec.ringRadius * 2, spec.ringRadius * 2),
		cframe = at(spec.ringX, 0.12, spec.ringZ) * flat,
		color = W.stone,
		material = Enum.Material.Slate,
		shape = Enum.PartType.Cylinder,
		collide = false,
	})
	for index = 1, spec.ringSegments do
		local angle = (index - 0.5) / spec.ringSegments * math.pi * 2
		local px = spec.ringX + math.sin(angle) * spec.ringRadius
		local pz = spec.ringZ + math.cos(angle) * spec.ringRadius
		local arc = 2 * math.pi * spec.ringRadius / spec.ringSegments
		local segment = block(gate, {
			name = "RingSegment",
			size = Vector3.new(arc * 0.82, 0.25, 0.7),
			cframe = CFrame.lookAt(
				Vector3.new(px, 0.2, pz),
				Vector3.new(spec.ringX, 0.2, spec.ringZ)
			),
			color = W.molten,
			material = Enum.Material.Neon,
			collide = false,
			transparency = 0.5,
			shadow = false,
		})
		segment:SetAttribute("Index", index)
	end

	gate:SetAttribute(World.ATTR.queueCount, 0)
	gate:SetAttribute(World.ATTR.departAt, 0)
	gate:SetAttribute(World.ATTR.launchAt, 0)
	gate.Parent = parent
	gateModel = gate
end

--------------------------------------------------------------------------------
-- 풀무 러닝머신
--------------------------------------------------------------------------------

local function cylinderBetween(
	parent: Instance,
	name: string,
	a: Vector3,
	b: Vector3,
	diameter: number
)
	local length = (b - a).Magnitude
	if length < 0.01 then
		return
	end
	local mid = (a + b) / 2
	-- 원기둥의 축은 X 다: 두 점을 잇는 방향을 X 로 맞춘다
	local look = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.rad(90), 0)
	block(parent, {
		name = name,
		size = Vector3.new(length, diameter, diameter),
		cframe = look,
		color = W.iron,
		material = Enum.Material.Metal,
		shape = Enum.PartType.Cylinder,
		collide = false,
	})
end

local function buildTreadmills(parent: Instance)
	local treadmills = folder(parent, World.TREADMILL_FOLDER)
	local padSpec = World.TREADMILL_PAD
	local counts: { [string]: number } = {}

	for padIndex, spec in World.TREADMILL_PADS do
		counts[spec.tierId] = (counts[spec.tierId] or 0) + 1

		local model = Instance.new("Model")
		model.Name = `Treadmill_{spec.tierId}_{counts[spec.tierId]}`
		model:SetAttribute("PadIndex", padIndex)

		local h = padSpec.height
		local pad = block(model, {
			name = "Pad",
			size = Vector3.new(padSpec.sizeX, h, padSpec.sizeZ),
			cframe = at(spec.x, h / 2, spec.z),
			color = W.iron,
			material = Enum.Material.Metal,
		})
		pad:SetAttribute(World.TREADMILL_TIER_ATTRIBUTE, spec.tierId)
		pad:SetAttribute(World.ATTR.occupied, false)
		pad:SetAttribute(World.ATTR.paidAt, 0)

		local beltLength = padSpec.sizeZ - 2
		block(model, {
			name = "Belt",
			size = Vector3.new(padSpec.sizeX - 2, 0.12, beltLength),
			cframe = at(spec.x, h + 0.06, spec.z),
			color = { 20, 18, 22 },
			material = Enum.Material.Slate,
			collide = false,
		})
		for index = 1, padSpec.stripes do
			local stripe = block(model, {
				name = "BeltStripe",
				size = Vector3.new(padSpec.sizeX - 2.2, 0.14, 0.45),
				cframe = at(
					spec.x,
					h + 0.08,
					spec.z - beltLength / 2 + (index - 0.5) * beltLength / padSpec.stripes
				),
				color = { 72, 74, 82 },
				material = Enum.Material.Metal,
				collide = false,
				shadow = false,
			})
			stripe:SetAttribute("Index", index)
		end

		-- 난간 · 손잡이 · 계기판 (앞쪽 = 북쪽)
		for side = -1, 1, 2 do
			block(model, {
				name = "Rail",
				size = Vector3.new(0.5, 0.5, beltLength),
				cframe = at(spec.x + side * (padSpec.sizeX / 2 - 0.4), h + 2.6, spec.z),
				color = W.wood,
				material = Enum.Material.Wood,
			})
			block(model, {
				name = "RailPost",
				size = Vector3.new(0.4, 2.6, 0.4),
				cframe = at(
					spec.x + side * (padSpec.sizeX / 2 - 0.4),
					h + 1.3,
					spec.z + beltLength / 2 - 0.3
				),
				color = W.wood,
				material = Enum.Material.Wood,
			})
		end
		block(model, {
			name = "Handle",
			size = Vector3.new(padSpec.sizeX - 0.4, 0.35, 0.35),
			cframe = at(spec.x, h + 3.9, spec.z + beltLength / 2),
			color = W.iron,
			material = Enum.Material.Metal,
			shape = Enum.PartType.Cylinder,
		})
		block(model, {
			name = "Console",
			size = Vector3.new(3, 1.4, 1.2),
			cframe = at(spec.x, h + 4.2, spec.z + beltLength / 2 + 0.6)
				* CFrame.Angles(math.rad(-25), 0, 0),
			color = W.stoneDark,
			material = Enum.Material.Metal,
		})
		local lamp = block(model, {
			name = "Lamp",
			size = Vector3.new(0.6, 0.6, 0.6),
			cframe = at(spec.x, h + 4.8, spec.z + beltLength / 2 + 0.4),
			color = W.gold,
			material = Enum.Material.Neon,
			shape = Enum.PartType.Ball,
			collide = false,
			transparency = 0.6,
		})
		lamp:SetAttribute("Base", 0.6)
		sparks(lamp, "Coins", W.gold)

		-- 풀무 (아코디언 3단) — 발판 동쪽
		local bx = spec.x + padSpec.bellowsOffsetX
		block(model, {
			name = "BellowsBase",
			size = Vector3.new(2.6, 0.6, 3.6),
			cframe = at(bx, 0.3, spec.z),
			color = W.wood,
			material = Enum.Material.Wood,
		})
		for layer = 1, 3 do
			local part = block(model, {
				name = "BellowsLayer",
				size = Vector3.new(2.4 - layer * 0.1, 0.7, 3.2 - layer * 0.15),
				cframe = at(bx, 0.6 + 0.35 + (layer - 1) * 0.7, spec.z),
				color = if layer % 2 == 0 then { 150, 106, 76 } else W.leather,
				material = Enum.Material.Fabric,
			})
			part:SetAttribute("Layer", layer)
		end

		-- 풀무에서 큰 관까지 짧은 관
		local path = World.pipePath(padIndex)
		local y = World.PIPE.height
		if #path >= 2 then
			cylinderBetween(
				model,
				"Pipe",
				Vector3.new(path[1][1], y, path[1][2]),
				Vector3.new(path[2][1], y, path[2][2]),
				World.PIPE.diameter
			)
		end

		model.PrimaryPart = pad
		model.Parent = treadmills
	end

	-- 큰 관 (남북) + 화덕으로 가는 관 (동쪽)
	local zs: { number } = {}
	for _, spec in World.TREADMILL_PADS do
		table.insert(zs, spec.z)
	end
	table.insert(zs, World.PIPE.feedZ)
	local minZ, maxZ = math.min(table.unpack(zs)), math.max(table.unpack(zs))
	local y = World.PIPE.height
	cylinderBetween(
		parent,
		"MainPipe",
		Vector3.new(World.PIPE.mainX, y, minZ),
		Vector3.new(World.PIPE.mainX, y, maxZ),
		World.PIPE.diameter * 1.4
	)
	cylinderBetween(
		parent,
		"FeedPipe",
		Vector3.new(World.PIPE.mainX, y, World.PIPE.feedZ),
		Vector3.new(World.FORGE.x - World.FORGE.sizeX / 2, y, World.PIPE.feedZ),
		World.PIPE.diameter * 1.4
	)
end

--------------------------------------------------------------------------------
-- 명예의 벽 · 진열대
--------------------------------------------------------------------------------

local function buildHonorWall(parent: Instance)
	local spec = World.RANKING_WALL
	local honor = folder(parent, "Honor")

	block(honor, {
		name = "HonorStone",
		size = Vector3.new(2, spec.height, spec.width),
		cframe = at(spec.x, spec.height / 2, spec.z),
		color = W.stone,
		material = Enum.Material.Slate,
	})
	-- 액자 (위·아래·양옆)
	local frameX = spec.x - 1.1
	for _, piece in
		{
			{ spec.width + 0.8, spec.height - 0.6 },
			{ spec.width + 0.8, 0.6 },
		}
	do
		block(honor, {
			name = "HonorFrame",
			size = Vector3.new(0.4, 0.5, piece[1]),
			cframe = at(frameX, piece[2], spec.z),
			color = W.wood,
			material = Enum.Material.Wood,
		})
	end
	for side = -1, 1, 2 do
		block(honor, {
			name = "HonorFrame",
			size = Vector3.new(0.4, spec.height - 0.6, 0.5),
			cframe = at(frameX, spec.height / 2, spec.z + side * (spec.width / 2 + 0.15)),
			color = W.wood,
			material = Enum.Material.Wood,
		})
	end
	block(honor, {
		name = "HonorBoard",
		size = Vector3.new(0.2, spec.height - 1.6, spec.width - 0.6),
		cframe = at(frameX - 0.05, spec.height / 2, spec.z),
		color = W.stoneDark,
		material = Enum.Material.SmoothPlastic,
	})
	-- 양옆 횃불
	for index, side in { -1, 1 } do
		local z = spec.z + side * (spec.width / 2 + 2)
		block(honor, {
			name = "HonorTorchPost",
			size = Vector3.new(0.6, 6, 0.6),
			cframe = at(spec.x - 1.5, 3, z),
			color = W.wood,
			material = Enum.Material.Wood,
		})
		local bowl = block(honor, {
			name = `HonorTorch{index}`,
			size = Vector3.new(0.8, 1.6, 1.6),
			cframe = at(spec.x - 1.5, 6.3, z) * CFrame.Angles(0, 0, math.rad(90)),
			color = W.iron,
			material = Enum.Material.Metal,
			shape = Enum.PartType.Cylinder,
		})
		fire(bowl, 3, 6)
		light(bowl, "TorchLight", W.ember, 12, 1.1)
	end
end

local function buildShowcase(parent: Instance)
	local spec = World.SHOWCASE
	local showcase = folder(parent, "Showcase")

	local base = block(showcase, {
		name = "ShowcaseBase",
		size = Vector3.new(4, 3, 4),
		cframe = at(spec.x, 1.5, spec.z),
		color = W.stone,
		material = Enum.Material.Slate,
	})
	block(showcase, {
		name = "ShowcaseGlass",
		size = Vector3.new(3.4, 5.6, 3.4),
		cframe = at(spec.x, 3 + 2.8, spec.z),
		color = W.glass,
		material = Enum.Material.Glass,
		transparency = 0.75,
	})
	block(showcase, {
		name = "ShowcaseCap",
		size = Vector3.new(3.8, 0.4, 3.8),
		cframe = at(spec.x, 3 + 5.8, spec.z),
		color = W.iron,
		material = Enum.Material.Metal,
	})
	block(showcase, {
		name = "ShowcasePlaque",
		size = Vector3.new(0.2, 1.2, 3.4),
		cframe = at(spec.x - 2.1, 1.8, spec.z),
		color = W.gold,
		material = Enum.Material.Metal,
	})
	light(base, "ShowcaseLight", W.gold, 10, 0.8)
	base:SetAttribute(World.ATTR.ownerName, "")
	base:SetAttribute(World.ATTR.swordId, "")
	base:SetAttribute(World.ATTR.swordLevel, 0)
	showcaseBase = base
end

--------------------------------------------------------------------------------

local function buildLobby(): Folder
	local lobby = Instance.new("Folder")
	lobby.Name = World.LOBBY_FOLDER

	buildGround(lobby)
	buildSpawn(lobby)
	for index, torch in World.TORCHES do
		buildTorch(lobby, torch.x, torch.z, index)
	end
	buildSigns(lobby)
	buildMountains(lobby)
	buildForge(lobby)
	buildGate(lobby)
	buildTreadmills(lobby)
	buildHonorWall(lobby)
	buildShowcase(lobby)

	lobby:SetAttribute(World.ATTR.treadmillUsers, 0)
	lobby.Parent = Workspace
	return lobby
end

-- 로비 폴더에서 러닝머신 발판을 찾는다 (직접 지은 로비든 Studio 에서 꾸민 로비든 같다).
-- 발판은 TreadmillTier 속성이 있는 파트다. 모델 안에 "Pad" 로 있어도 되고 폴더 바로 아래 있어도 된다.
local function collectPads(lobby: Instance)
	pads = {}

	local treadmills = lobby:FindFirstChild(World.TREADMILL_FOLDER)
	if treadmills == nil then
		warn(
			"[WorldService] 로비에 Treadmills 폴더가 없습니다. 러닝머신이 동작하지 않습니다."
		)
		return
	end

	for _, child in treadmills:GetChildren() do
		local part: Instance? = child
		if child:IsA("Model") then
			part = child:FindFirstChild("Pad")
		end
		if part == nil or not part:IsA("BasePart") then
			continue
		end

		local tierId = part:GetAttribute(World.TREADMILL_TIER_ATTRIBUTE)
		local tier = if type(tierId) == "string" then EconomyConfig.treadmillTier(tierId) else nil
		if tier == nil then
			warn(
				`[WorldService] 러닝머신 발판 {child.Name} 의 단계를 알 수 없습니다`
			)
			continue
		end

		table.insert(pads, {
			part = part,
			tier = tier,
			bounds = {
				x = part.Position.X,
				z = part.Position.Z,
				sizeX = part.Size.X,
				sizeZ = part.Size.Z,
				topY = part.Position.Y + part.Size.Y / 2,
				reach = World.TREADMILL_PAD.reach,
			},
		})
	end
end

