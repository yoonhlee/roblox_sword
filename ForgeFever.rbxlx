        <Item class="ModuleScript" referent="3">
          <Properties>
            <string name="Name">Achievements</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Achievements — 업적 정의.

	각 업적은 PlayerData 만 보고 달성 여부를 판단하는 순수 함수(check)를 가진다.
	서버가 강화/배틀 직후에 전부 한 번씩 돌려 보고, 새로 달성된 것만 보상을 준다.

	표시 문자열은 Locale 의 "achv.<id>.name" / "achv.<id>.desc" 키를 쓴다.
]]

export type PlayerDataLike = {
	gold: number,
	shards: number,
	protectTickets: number,
	weapon: { level: number },
	stats: {
		enhanceTries: number,
		enhanceSuccess: number,
		destroyed: number,
		highestLevel: number,
		battleWins: number,
		battleLosses: number,
		rating: number,
		bestKeepStreak: number,
		ticketsUsed: number,
	},
	codex: { [string]: boolean },
	daily: { streak: number },
}

export type Achievement = {
	id: string,
	gold: number,
	check: (data: PlayerDataLike) -> boolean,
}

local function countCodex(data: PlayerDataLike): number
	local count = 0
	for _, unlocked in data.codex do
		if unlocked then
			count += 1
		end
	end
	return count
end

local Achievements = {}

Achievements.List = {
	{
		id = "firstSwing",
		gold = 100,
		check = function(data)
			return data.stats.enhanceTries >= 1
		end,
	},
	{
		id = "firstBreak",
		gold = 200,
		check = function(data)
			return data.stats.destroyed >= 1
		end,
	},
	{
		id = "reach5",
		gold = 300,
		check = function(data)
			return data.stats.highestLevel >= 5
		end,
	},
	{
		id = "reach10",
		gold = 800,
		check = function(data)
			return data.stats.highestLevel >= 10
		end,
	},
	{
		id = "reach15",
		gold = 3000,
		check = function(data)
			return data.stats.highestLevel >= 15
		end,
	},
	{
		id = "reach20",
		gold = 20000,
		check = function(data)
			return data.stats.highestLevel >= 20
		end,
	},
	{
		id = "tries100",
		gold = 400,
		check = function(data)
			return data.stats.enhanceTries >= 100
		end,
	},
	{
		id = "tries1000",
		gold = 2500,
		check = function(data)
			return data.stats.enhanceTries >= 1000
		end,
	},
	{
		id = "break10",
		gold = 600,
		check = function(data)
			return data.stats.destroyed >= 10
		end,
	},
	{
		id = "break50",
		gold = 3000,
		check = function(data)
			return data.stats.destroyed >= 50
		end,
	},
	{
		id = "keepStreak10",
		gold = 1200,
		check = function(data)
			return data.stats.bestKeepStreak >= 10
		end,
	},
	{
		-- 방지권을 한 번도 쓰지 않고 15강에 도달
		id = "pureFifteen",
		gold = 5000,
		check = function(data)
			return data.stats.highestLevel >= 15 and data.stats.ticketsUsed == 0
		end,
	},
	{
		id = "firstBattle",
		gold = 100,
		check = function(data)
			return data.stats.battleWins + data.stats.battleLosses >= 1
		end,
	},
	{
		id = "win10",
		gold = 500,
		check = function(data)
			return data.stats.battleWins >= 10
		end,
	},
	{
		id = "win100",
		gold = 4000,
		check = function(data)
			return data.stats.battleWins >= 100
		end,
	},
	{
		id = "rating1200",
		gold = 2000,
		check = function(data)
			return data.stats.rating >= 1200
		end,
	},
	{
		id = "streak7",
		gold = 1500,
		check = function(data)
			return data.daily.streak >= 7
		end,
	},
	{
		id = "hoard100k",
		gold = 2000,
		check = function(data)
			return data.gold >= 100000
		end,
	},
	{
		id = "shards1000",
		gold = 1000,
		check = function(data)
			return data.shards >= 1000
		end,
	},
	{
		id = "codex10",
		gold = 1500,
		check = function(data)
			return countCodex(data) >= 10
		end,
	},
} :: { Achievement }

function Achievements.count(): number
	return #Achievements.List
end

return Achievements
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">BattleConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	BattleConfig — 배틀 승률/보상/레이팅/어뷰징 방지 수치.
	배틀로 무기가 파괴되거나 레벨이 내려가는 일은 없다. 걸리는 건 골드와 레이팅뿐.
]]

local BattleConfig = {}

-- 승률 공식: P(A승) = 1 / (1 + 10 ^ ((LvB - LvA) / K))
BattleConfig.K = 4

-- 보상
BattleConfig.BASE_REWARD = 30
BattleConfig.LEVEL_BONUS_PER_LEVEL = 0.1 -- 상대 레벨 1당 +10%
BattleConfig.UPSET_MULTIPLIER_CAP = 3 -- 역전 배율(1 / P(승))의 상한
BattleConfig.LOSER_REWARD = 5 -- 패자 참가 보상

-- 레이팅 (Elo)
BattleConfig.START_RATING = 1000
BattleConfig.ELO_K = 24

-- 어뷰징 방지
BattleConfig.DAILY_BATTLE_REWARD_CAP = 30 -- 하루 보상 지급 횟수 상한(초과 시 배틀은 가능, 보상 0)
BattleConfig.PER_OPPONENT_DAILY_CAP = 3 -- 같은 상대와 하루 보상 최대 횟수
BattleConfig.COOLDOWN_SECONDS = 10 -- 배틀 쿨다운
BattleConfig.INVITE_TIMEOUT_SECONDS = 15 -- 무응답은 거절로 처리
BattleConfig.NEW_ACCOUNT_AGE_DAYS = 3 -- Player.AccountAge 기준
BattleConfig.NEW_ACCOUNT_REWARD_MULTIPLIER = 0.5 -- 부계정 파밍 방지

return BattleConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">EconomyConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EconomyConfig — 골드 획득처/소비처 수치.
	Phase 4 의 시뮬레이션(tools/simulate_economy.luau)이 이 값을 그대로 읽는다.
	수치 변경은 시뮬레이션 결과를 보고 개발자 승인을 받은 뒤에만.
]]

local EconomyConfig = {}

EconomyConfig.STARTING_GOLD = 100
EconomyConfig.STARTING_SHARDS = 0
EconomyConfig.STARTING_PROTECT_TICKETS = 0

-- 출석: 연속 일수에 따른 골드. 상한을 넘으면 마지막 값을 계속 지급한다.
EconomyConfig.DAILY_LOGIN_GOLD = { 100, 150, 200, 300, 400, 600, 1000 }

-- 플레이 시간 보상
EconomyConfig.PLAYTIME_REWARD_INTERVAL_SECONDS = 15 * 60
EconomyConfig.PLAYTIME_REWARD_GOLD = 120

-- 도감 한 칸 달성 보상
EconomyConfig.CODEX_ENTRY_GOLD = 150

-- 파편 → 방지권 교환은 EnhanceTable.SHARDS_PER_TICKET 참조.
-- 골드로 방지권을 직접 사는 가격
EconomyConfig.PROTECT_TICKET_GOLD_PRICE = 2500

-- 무기 외형 변경 비용
EconomyConfig.SKIN_CHANGE_GOLD_PRICE = 500

-- 게임패스 "골드 획득 +20%"
EconomyConfig.GOLD_BOOST_MULTIPLIER = 1.2

-- 이상 탐지: 이 시간 안에 이만큼 이상 골드가 늘면 로그를 남긴다.
EconomyConfig.ANOMALY_WINDOW_SECONDS = 60
EconomyConfig.ANOMALY_GOLD_DELTA = 200000

return EconomyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">EnhanceTable</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EnhanceTable — 강화 확률/비용/판매가 데이터.
	밸런스 수치는 전부 여기에 두고, 로직(Pure/EnhanceLogic)은 이 데이터를 읽기만 한다.

	Odds[n] = 레벨 n 에서 n+1 로 올리는 1회 시도의 확률(퍼센트)과 비용(골드).
	SellValue[n] = 레벨 n 무기의 판매가(골드).
]]

export type LevelOdds = {
	success: number,
	keep: number,
	destroy: number,
	cost: number,
}

local EnhanceTable = {}

EnhanceTable.MAX_LEVEL = 20

-- 파괴 시 지급 파편 = floor(현재레벨 ^ SHARD_EXPONENT)
EnhanceTable.SHARD_EXPONENT = 1.5
-- 방지권 1개 교환에 필요한 파편 수
EnhanceTable.SHARDS_PER_TICKET = 50

EnhanceTable.Odds = {
	[0] = { success = 100, keep = 0, destroy = 0, cost = 10 },
	[1] = { success = 95, keep = 5, destroy = 0, cost = 20 },
	[2] = { success = 90, keep = 10, destroy = 0, cost = 40 },
	[3] = { success = 85, keep = 15, destroy = 0, cost = 70 },
	[4] = { success = 80, keep = 20, destroy = 0, cost = 110 },
	[5] = { success = 70, keep = 30, destroy = 0, cost = 160 },
	[6] = { success = 65, keep = 35, destroy = 0, cost = 230 },
	[7] = { success = 60, keep = 40, destroy = 0, cost = 320 },
	[8] = { success = 55, keep = 45, destroy = 0, cost = 440 },
	[9] = { success = 50, keep = 50, destroy = 0, cost = 600 },
	[10] = { success = 45, keep = 50, destroy = 5, cost = 800 },
	[11] = { success = 40, keep = 52, destroy = 8, cost = 1050 },
	[12] = { success = 35, keep = 55, destroy = 10, cost = 1350 },
	[13] = { success = 30, keep = 58, destroy = 12, cost = 1700 },
	[14] = { success = 25, keep = 60, destroy = 15, cost = 2100 },
	[15] = { success = 20, keep = 62, destroy = 18, cost = 2600 },
	[16] = { success = 15, keep = 65, destroy = 20, cost = 3200 },
	[17] = { success = 10, keep = 68, destroy = 22, cost = 4000 },
	[18] = { success = 7, keep = 70, destroy = 23, cost = 5000 },
	[19] = { success = 5, keep = 70, destroy = 25, cost = 6500 },
} :: { [number]: LevelOdds }

EnhanceTable.SellValue = {
	[0] = 0,
	[1] = 5,
	[2] = 15,
	[3] = 30,
	[4] = 55,
	[5] = 90,
	[6] = 140,
	[7] = 210,
	[8] = 300,
	[9] = 430,
	[10] = 620,
	[11] = 880,
	[12] = 1250,
	[13] = 1750,
	[14] = 2500,
	[15] = 3500,
	[16] = 5000,
	[17] = 7000,
	[18] = 10000,
	[19] = 15000,
	[20] = 25000,
} :: { [number]: number }

-- 서버 채팅 전체 공지를 띄우는 최소 레벨
EnhanceTable.BROADCAST_MIN_LEVEL = 15

--[[
	확률표가 스스로 일관된지 검사한다.
	서버 시작 시점(EnhanceService.Init)과 Lune 테스트 양쪽에서 호출한다.
	실패 사유 문자열을 반환하고, 문제가 없으면 nil 을 반환한다.
]]
function EnhanceTable.validate(): string?
	for level = 0, EnhanceTable.MAX_LEVEL - 1 do
		local odds = EnhanceTable.Odds[level]
		if not odds then
			return `Odds[{level}] 항목이 없습니다`
		end

		local sum = odds.success + odds.keep + odds.destroy
		if sum ~= 100 then
			return `Odds[{level}] 의 성공+유지+파괴 합이 {sum} 입니다 (100 이어야 함)`
		end

		for key, value in { success = odds.success, keep = odds.keep, destroy = odds.destroy } do
			if value < 0 or value ~= math.floor(value) then
				return `Odds[{level}].{key} 값이 잘못되었습니다: {value}`
			end
		end

		if odds.cost <= 0 or odds.cost ~= math.floor(odds.cost) then
			return `Odds[{level}].cost 값이 잘못되었습니다: {odds.cost}`
		end
	end

	if EnhanceTable.Odds[EnhanceTable.MAX_LEVEL] ~= nil then
		return `최대 레벨({EnhanceTable.MAX_LEVEL})에는 강화 확률이 있으면 안 됩니다`
	end

	for level = 0, EnhanceTable.MAX_LEVEL do
		local sell = EnhanceTable.SellValue[level]
		if sell == nil then
			return `SellValue[{level}] 항목이 없습니다`
		end
		if sell < 0 or sell ~= math.floor(sell) then
			return `SellValue[{level}] 값이 잘못되었습니다: {sell}`
		end
	end

	return nil
end

return EnhanceTable
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Game</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Game — 게임 정체성과 운영에 필요한 전역 상수.
]]

local Game = {}

Game.NAME = "강화의 대장간" -- 표시용 이름은 LocalizationTable 의 "game.title" 을 우선 사용
Game.ID = "ForgeFever" -- 코드/스토어 키에 쓰는 내부 식별자

-- DataStore 이름. Studio 플레이테스트와 라이브 데이터를 절대 섞지 않는다.
Game.DATASTORE_DEV = "ForgeFever_DEV"
Game.DATASTORE_PROD = "ForgeFever_PROD"

-- 랭킹용 OrderedDataStore
Game.ORDERED_STORE_LEVEL = "ForgeFever_Level_v1"
Game.ORDERED_STORE_RATING = "ForgeFever_Rating_v1"

-- 관리자 UserId 목록. [개발자 입력 필요] 본인 UserId 를 넣을 것.
Game.ADMIN_USER_IDS = {} :: { number }

-- 결과 피드를 말하는 오리지널 NPC (대사는 LocalizationTable 의 "npc.*" 키)
Game.NPC_NAME_KEY = "npc.anvilElder.name" -- 모루 영감

Game.DEFAULT_LANGUAGE = "ko"
Game.SUPPORTED_LANGUAGES = { "ko", "en" }

function Game.isAdmin(userId: number): boolean
	for _, id in Game.ADMIN_USER_IDS do
		if id == userId then
			return true
		end
	end
	return false
end

return Game
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Products</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Products — 게임패스 / 개발자 상품 ID.

	[개발자 입력 필요] Roblox 크리에이터 대시보드에서 상품을 만든 뒤 여기 ID 를 채운다.
	ID 가 0 이면 해당 상품은 UI 에 노출되지 않는다(ShopService 가 걸러 냄).

	정책 주의: Robux 로 "확률 결과 자체"를 파는 상품(유료 강화권 뽑기 등)은 만들지 않는다.
	그런 상품이 필요해지면 로블록스의 유료 랜덤 아이템 규정(구매 전 확률 공개)과
	국내 확률형 아이템 표시 규정을 먼저 확인하고 개발자 승인을 받을 것.
]]

local Products = {}

-- 게임패스: 편의/꾸미기 위주
Products.GamePasses = {
	goldBoost = 0, -- 골드 획득 +20%
	extraSkinSlots = 0, -- 무기 외형 슬롯 확장
	vipTag = 0, -- VIP 채팅 태그
}

-- 개발자 상품: 재화/소모품
-- goldAmount / ticketAmount 는 지급량이며 서버에서만 사용한다.
export type DeveloperProduct = {
	key: string,
	productId: number,
	goldAmount: number,
	ticketAmount: number,
}

Products.DeveloperProducts = {
	goldSmall = { key = "goldSmall", productId = 0, goldAmount = 5000, ticketAmount = 0 },
	goldMedium = { key = "goldMedium", productId = 0, goldAmount = 30000, ticketAmount = 0 },
	goldLarge = { key = "goldLarge", productId = 0, goldAmount = 100000, ticketAmount = 0 },
	ticketPack = { key = "ticketPack", productId = 0, goldAmount = 0, ticketAmount = 5 },
} :: { [string]: DeveloperProduct }

-- purchaseHistory 가 무한히 커지지 않도록 유지할 최근 기록 수
Products.PURCHASE_HISTORY_LIMIT = 200

-- productId → 상품 정의 역인덱스 (ProcessReceipt 에서 사용)
function Products.byProductId(productId: number): DeveloperProduct?
	for _, product in Products.DeveloperProducts do
		if product.productId ~= 0 and product.productId == productId then
			return product
		end
	end
	return nil
end

return Products
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Weapons</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Weapons — 무기 종류 데이터. 전부 오리지널 명칭이며, 표시 문자열은
	LocalizationTable 키로만 참조한다(코드에 표시용 한국어를 박지 않는다).

	assetId 는 Studio 에서 만든 모델의 키. 모델 연결 전에는 빈 문자열로 두고
	클라이언트는 기본 외형으로 대체한다.
]]

export type WeaponInfo = {
	id: string,
	nameKey: string, -- LocalizationTable 키
	rarity: "common" | "rare" | "epic" | "legend",
	assetId: string, -- ReplicatedStorage 내 모델 이름 (비어 있으면 기본 외형)
	unlockLevel: number, -- 이 무기를 쓰려면 필요한 최고 강화 기록
}

local Weapons = {}

Weapons.DEFAULT_ID = "ironBlade"

Weapons.List = {
	ironBlade = {
		id = "ironBlade",
		nameKey = "weapon.ironBlade.name",
		rarity = "common",
		assetId = "",
		unlockLevel = 0,
	},
	emberEdge = {
		id = "emberEdge",
		nameKey = "weapon.emberEdge.name",
		rarity = "rare",
		assetId = "",
		unlockLevel = 5,
	},
	tideFang = {
		id = "tideFang",
		nameKey = "weapon.tideFang.name",
		rarity = "rare",
		assetId = "",
		unlockLevel = 8,
	},
	stormNeedle = {
		id = "stormNeedle",
		nameKey = "weapon.stormNeedle.name",
		rarity = "epic",
		assetId = "",
		unlockLevel = 12,
	},
	dawnbreaker = {
		id = "dawnbreaker",
		nameKey = "weapon.dawnbreaker.name",
		rarity = "legend",
		assetId = "",
		unlockLevel = 16,
	},
} :: { [string]: WeaponInfo }

-- 도감이 기록하는 레벨 구간
Weapons.CODEX_MILESTONES = { 5, 10, 15, 20 }

function Weapons.get(id: string): WeaponInfo?
	return Weapons.List[id]
end

return Weapons
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Locale</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Locale — 화면에 보이는 모든 문자열을 키로 관리한다.
	코드 어디에도 표시용 문장을 직접 쓰지 않는다.

	[확인 필요 / Phase 7] 출시 전에는 이 테이블을 Roblox LocalizationTable 로 옮겨
	자동 번역·번역가 워크플로를 쓸 수 있게 한다. 지금은 외부 의존 없이 동작하도록
	순수 Luau 테이블로 둔다. 키 이름은 그대로 유지할 예정이라 이전 비용이 작다.

	치환은 string.format 규칙을 따른다(%s, %d). 언어별로 인자 순서는 같아야 한다.
]]

