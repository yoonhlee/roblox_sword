      <Item class="LocalScript" referent="55">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
--[[
	클라이언트 부트스트랩.
	controllers 폴더의 모듈을 정해진 순서대로 require → Init() → Start() 한다.

	클라이언트는 "요청"과 "표시"만 한다.
	확률 계산, 골드 증감, 레벨 변경은 전부 서버가 결정한다.
	서버 응답을 받기 전에는 어떤 결과 연출도 시작하지 않는다.
]]

type Controller = {
	Name: string?,
	Init: (() -> ())?,
	Start: (() -> ())?,
}

local CONTROLLER_ORDER = {
	"SoundController",
	"EffectsController",
	"HudController",
	"FeedController",
	"OddsTableController",
	"ShopController",
	"SwordController",
	"CollectionController",
	"LobbyController",
	"RaceController",
	"UIController",
	"WorldFxController",
}

local controllersFolder = script:WaitForChild("controllers")

-- 화면 상태·배치 관리는 컨트롤러가 화면을 만들기 전에 준비돼 있어야 한다.
local ScreenManager = require(script:WaitForChild("ui"):WaitForChild("ScreenManager"))
ScreenManager.init()

local function loadController(name: string): Controller
	local module = controllersFolder:WaitForChild(name)
	assert(module:IsA("ModuleScript"), `[Client] 컨트롤러 모듈이 아닙니다: {name}`)
	return require(module) :: Controller
end

local function runStage(stage: "Init" | "Start", controllers: { Controller })
	for _, controller in controllers do
		local fn = if stage == "Init" then controller.Init else controller.Start
		if not fn then
			continue
		end

		local ok, err = xpcall(fn, debug.traceback)
		if not ok then
			warn(`[Client] {controller.Name or "?"}.{stage} 실패:\n{err}`)
		end
	end
end

local controllers: { Controller } = {}
for _, name in CONTROLLER_ORDER do
	local controller = loadController(name)
	controller.Name = controller.Name or name
	table.insert(controllers, controller)
end

runStage("Init", controllers)
runStage("Start", controllers)
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--!strict
--[[
	ClientState — 서버가 보내 준 내 데이터의 로컬 사본.

	클라이언트는 이 값을 "표시"에만 쓴다. 여기 있는 숫자를 고쳐도 게임에는
	아무 영향이 없다(서버가 진짜 값을 들고 있다).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Types = require(Shared:WaitForChild("Types"))
local Locale = require(Shared:WaitForChild("Locale"))

local ClientState = {}

local data: Types.PlayerData? = nil
local odds: Types.DisplayOdds? = nil
local liveOps: { maintenance: boolean, notice: string, event: any } = {
	maintenance = false,
	notice = "",
	event = nil,
}
-- "방지권 사용" 스위치. 강화 요청에 실어 보내고, 화면의 확률 표시도 이 값에 따라 바뀐다.
local useProtect = false
local listeners: { () -> () } = {}

local function notify()
	for _, listener in listeners do
		local ok, err = pcall(listener)
		if not ok then
			warn(`[ClientState] 리스너 오류: {err}`)
		end
	end
end

function ClientState.setData(newData: Types.PlayerData)
	data = newData
	notify()
end

function ClientState.setOdds(newOdds: Types.DisplayOdds)
	odds = newOdds
	notify()
end

function ClientState.getData(): Types.PlayerData?
	return data
end

function ClientState.getOdds(): Types.DisplayOdds?
	return odds
end

-- 착용 중인 검 (데이터가 아직 없으면 nil)
function ClientState.getEquipped(): Types.SwordState?
	if data == nil or type(data.swords) ~= "table" then
		return nil
	end
	return data.swords[data.equippedId]
end

-- 가진 검 수 (데이터가 아직 없으면 1)
function ClientState.getSwordCount(): number
	if data == nil or type(data.swords) ~= "table" then
		return 1
	end

	local count = 0
	for _ in data.swords do
		count += 1
	end
	return math.max(1, count)
end

function ClientState.getUseProtect(): boolean
	return useProtect
end

function ClientState.setUseProtect(value: boolean)
	useProtect = value
	notify()
end

-- 방지권이 실제로 효과를 내는 상태인지 (스위치가 켜져 있고 방지권이 1개 이상)
function ClientState.isProtectActive(): boolean
	return useProtect and data ~= nil and data.protectTickets > 0
end

function ClientState.getLanguage(): string
	if data and data.settings and data.settings.language then
		return data.settings.language
	end
	return Locale.DEFAULT_LANGUAGE
end

function ClientState.setLiveOps(config: any)
	liveOps = {
		maintenance = config.maintenance == true,
		notice = if type(config.notice) == "string" then config.notice else "",
		event = config.event,
	}
	notify()
end

function ClientState.getLiveOps()
	return liveOps
end

function ClientState.onChanged(listener: () -> ())
	table.insert(listeners, listener)
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="57">
          <Properties>
            <string name="Name">controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">CollectionController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	CollectionController — 기록 창: 도감 / 랭킹 / 설정 탭 (통합 기획서 5-5·8절).

	도감: 20칸 격자(검 1종 = 1칸). 가진 검은 이름·등급 색 테두리·역대 최고 레벨(레벨 색)·
	      5/10/15/20강 기념 점 4개. 아직 없는 검은 어두운 "?" 칸, 아직 만들지 않은 칸은 "준비 중".
	랭킹: 최고 강화 상위 목록 (배틀 레이팅 순위는 폐지, 대체는 D7 미정).
	설정: 소리, 언어.
	도감은 서버에 따로 묻지 않고 복제받은 데이터(swords, codex)로 그린다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))
local Weapons = require(Shared:WaitForChild("Config"):WaitForChild("Weapons"))

local client = script.Parent.Parent
local ClientState = require(client:WaitForChild("ClientState"))
local ui = client:WaitForChild("ui")
local Theme = require(ui:WaitForChild("Theme"))
local Components = require(ui:WaitForChild("Components"))
local ScreenManager = require(ui:WaitForChild("ScreenManager"))

local CollectionController = {}
CollectionController.Name = "CollectionController"

local C = Theme.color
local CODEX_SLOTS = 20 -- 기본 검 20종 (지금 정의된 검이 적으면 나머지는 "준비 중")
local RANK_KIND = "level"

type Tab = "codex" | "rank" | "settings"

local gui: ScreenGui
local panel: Frame
local tabs: Components.Tabs
local content: Frame
local open = false
local activeTab: Tab = "codex"

local boardRemote: RemoteFunction
local settingRemote: RemoteFunction

local function codexCell(
	parent: Instance,
	language: string,
	weaponId: string?,
	data: any,
	order: number
)
	local info = if weaponId then Weapons.get(weaponId) else nil
	local sword = if weaponId and data then data.swords[weaponId] else nil

	local cell = Components.frame(parent, {
		BackgroundColor3 = if sword then C.sub else C.bg,
		BackgroundTransparency = if sword then 0.1 else 0.3,
		LayoutOrder = order,
	})
	Components.corner(cell, 10)

	if info == nil then
		-- 아직 만들지 않은 검 칸 (D22)
		Components.stroke(cell, C.line, 1)
		local soon = Components.label(cell, {
			text = Locale.get(language, "ui.codexSoon"),
			size = Theme.text.small,
			color = C.disabled,
			align = Enum.TextXAlignment.Center,
		})
		soon.Size = UDim2.fromScale(1, 1)
		return
	end

	local rarityColor = Theme.rarityColor(info.rarity)
	Components.stroke(cell, if sword then rarityColor else Theme.shade(rarityColor, -0.6), 2)

	if sword == nil then
		local mark = Components.label(cell, {
			text = "?",
			font = Theme.font.display,
			size = Theme.text.big,
			color = Theme.shade(rarityColor, -0.4),
			align = Enum.TextXAlignment.Center,
		})
		mark.Size = UDim2.new(1, 0, 0.62, 0)
		local rarity = Components.label(cell, {
			text = Locale.get(language, `rarity.{info.rarity}`),
			size = Theme.text.small,
			color = C.muted,
			align = Enum.TextXAlignment.Center,
		})
		rarity.Position = UDim2.fromScale(0, 0.62)
		rarity.Size = UDim2.new(1, 0, 0.3, 0)
		return
	end

	local name = Components.label(cell, {
		text = Locale.get(language, info.nameKey),
		size = Theme.text.small,
		font = Theme.font.bodyBold,
		align = Enum.TextXAlignment.Center,
	})
	name.Position = UDim2.fromOffset(4, 4)
	name.Size = UDim2.new(1, -8, 0, 22)

	local best = Components.label(cell, {
		text = Format.level(sword.bestLevel),
		font = Theme.font.display,
		size = Theme.text.title,
		color = Theme.heatColor(sword.bestLevel),
		outline = true,
		align = Enum.TextXAlignment.Center,
	})
	best.Position = UDim2.new(0, 0, 0.32, 0)
	best.Size = UDim2.new(1, 0, 0.34, 0)

	-- 기념 점 4개 (5·10·15·20강)
	local dots = Components.frame(
		cell,
		{ Position = UDim2.new(0, 0, 1, -18), Size = UDim2.new(1, 0, 0, 12) }
	)
	local dotList = Components.list(dots, "horizontal", 5, Enum.HorizontalAlignment.Center)
	dotList.VerticalAlignment = Enum.VerticalAlignment.Center
	for index, milestone in Weapons.CODEX_MILESTONES do
		local reached = data.codex[`{weaponId}:{milestone}`] == true
		local dot = Components.frame(dots, {
			Size = UDim2.fromOffset(10, 10),
			BackgroundColor3 = if reached then Theme.heatColor(milestone) else C.bg,
			BackgroundTransparency = 0,
			LayoutOrder = index,
		})
		Components.round(dot)
		Components.stroke(dot, C.line, 1)
	end
end

local function renderCodex()
	local language = ClientState.getLanguage()
	local data = ClientState.getData()

	Components.clear(content)
	local holder = Components.frame(content)
	local scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.ScrollBarThickness = 6
	scroll.ScrollBarImageColor3 = C.line
	scroll.Parent = holder

	local grid = Instance.new("UIGridLayout")
	grid.CellPadding = UDim2.fromOffset(8, 8)
	grid.CellSize = UDim2.new(0.2, -8, 0, 104)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = scroll

	if data == nil then
		return
	end

	for slot = 1, CODEX_SLOTS do
		codexCell(scroll, language, Weapons.Order[slot], data, slot)
	end
end

local function renderRanking()
	local language = ClientState.getLanguage()
	Components.clear(content)

	local title = Components.label(content, {
		text = Locale.get(language, `ui.rank.{RANK_KIND}`),
		font = Theme.font.display,
		size = Theme.text.label,
		color = C.gold,
	})
	title.Size = UDim2.new(1, 0, 0, 30)

	local holder = Components.frame(
		content,
		{ Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34) }
	)
	local scroll = Components.scroller(holder, 4)
	Components.label(scroll, { text = "...", color = C.muted })

	task.spawn(function()
		local ok, entries = pcall(function()
			return boardRemote:InvokeServer(RANK_KIND)
		end)
		if not open or activeTab ~= "rank" then
			return
		end

		Components.clear(scroll)
		if not ok or type(entries) ~= "table" or #entries == 0 then
			Components.label(
				scroll,
				{ text = Locale.get(language, "ui.rank.empty"), color = C.muted }
			)
			return
		end

		local myUserId = Players.LocalPlayer.UserId
		for index, entry in entries do
			local mine = entry.userId == myUserId
			local row = Components.frame(scroll, {
				Size = UDim2.new(1, -8, 0, 40),
				BackgroundColor3 = if mine then Theme.shade(C.ember, -0.5) else C.sub,
				BackgroundTransparency = 0.3,
				LayoutOrder = index,
			})
			Components.corner(row, 8)
			local medal = if entry.rank == 1
				then C.gold
				elseif entry.rank == 2 then Color3.fromRGB(216, 216, 216)
				elseif entry.rank == 3 then Color3.fromRGB(217, 154, 106)
				else C.muted
			local rank = Components.label(row, {
				text = `{entry.rank}`,
				font = Theme.font.display,
				size = Theme.text.label,
				color = medal,
				align = Enum.TextXAlignment.Center,
			})
			rank.Size = UDim2.new(0, 48, 1, 0)
			local name = Components.label(row, {
				text = tostring(entry.name),
				font = Theme.font.bodyBold,
				color = if mine then C.ember else C.text,
			})
			name.Position = UDim2.fromOffset(52, 0)
			name.Size = UDim2.new(1, -140, 1, 0)
			local value = Components.label(row, {
				text = Format.level(entry.value),
				font = Theme.font.display,
				size = Theme.text.label,
				color = Theme.heatColor(entry.value),
				outline = true,
				align = Enum.TextXAlignment.Right,
			})
			value.AnchorPoint = Vector2.new(1, 0)
			value.Position = UDim2.new(1, -12, 0, 0)
			value.Size = UDim2.new(0, 80, 1, 0)
		end
	end)
end

local function applySetting(key: string, value: any)
	task.spawn(function()
		pcall(function()
			settingRemote:InvokeServer(key, value)
		end)
	end)
end

local function renderSettings()
	local language = ClientState.getLanguage()
	local data = ClientState.getData()
	Components.clear(content)
	if data == nil then
		return
	end

	local list = Components.frame(content)
	Components.list(list, "vertical", 10)

	local sfx = Components.button(list, {
		text = Locale.get(language, if data.settings.sfx then "ui.sfxOn" else "ui.sfxOff"),
		style = if data.settings.sfx then "primary" else "secondary",
		order = 1,
	})
	sfx.Activated:Connect(function()
		applySetting("sfx", not data.settings.sfx)
	end)

	local lang = Components.button(
		list,
		{ text = Locale.get(language, "ui.language"), style = "secondary", order = 2 }
	)
	lang.Activated:Connect(function()
		applySetting("language", if ClientState.getLanguage() == "ko" then "en" else "ko")
	end)
end

local function refresh()
	if not open then
		return
	end
	local language = ClientState.getLanguage()
	for key, button in tabs.buttons do
		button.Text = Locale.get(language, `ui.tab.{key}`)
	end
	tabs.select(activeTab)

	if activeTab == "codex" then
		renderCodex()
	elseif activeTab == "rank" then
		renderRanking()
	else
		renderSettings()
	end
end

local function build()
	gui = ScreenManager.createScreen("ForgeRecords", 10)
	gui.Enabled = false

	panel = Components.panel(gui, { Name = "Panel" })
	Components.closeButton(panel, function()
		ScreenManager.closeModal()
	end)

	local tabHolder = Components.frame(
		panel,
		{ Position = UDim2.fromOffset(16, 8), Size = UDim2.new(1, -80, 0, Theme.rowHeight) }
	)
	tabs = Components.tabs(tabHolder, { "codex", "rank", "settings" }, function(key)
		activeTab = key :: Tab
		refresh()
	end)

	content = Components.frame(panel, {
		Position = UDim2.fromOffset(16, 8 + Theme.rowHeight + 12),
		Size = UDim2.new(1, -32, 1, -(8 + Theme.rowHeight + 12 + 14)),
	})
end

local function place()
	local layout = ScreenManager.getLayout()
	if layout then
		ScreenManager.place(panel, layout.modal)
	end
end

function CollectionController.Init()
	build()

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	boardRemote = remotesFolder:WaitForChild(Remotes.Functions.GetLeaderboard) :: RemoteFunction
	settingRemote = remotesFolder:WaitForChild(Remotes.Functions.SetSetting) :: RemoteFunction

	ScreenManager.registerModal("records", function()
		open = true
		gui.Enabled = true
		refresh()
	end, function()
		open = false
		gui.Enabled = false
	end)

	ScreenManager.onLayout(place)
end

function CollectionController.Start()
	-- 설정을 바꾸면 서버가 데이터를 다시 내려 주므로 그때 갱신한다 (랭킹은 다시 묻지 않는다).
	ClientState.onChanged(function()
		if open and activeTab ~= "rank" then
			refresh()
		end
	end)
end

return CollectionController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">EffectsController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	EffectsController — 강화 결과 연출 (통합 기획서 8-1절 결정 3).

	서버 응답을 받은 뒤 UIController 가 playReveal 을 부른다. 순서:
	  1) 망치질: 강화하기 "전" 레벨이 높을수록 길고 횟수가 많다
	     (0~9강 0.5초·1번, 10~14강 1초·2번, 15강 이상 2초·3번 — Config/VisualConfig.Reveal)
	     15강 이상은 망치질하는 동안 화면이 점점 어두워진다.
	  2) 결과 공개: onReveal 을 불러 화면 숫자를 바꾸고, 결과별 연출
	     성공 = 주황 번쩍 + 레벨 숫자가 튀어 오름 + 불티 / 유지 = 흔들림 /
	     실패 = 붉게 번쩍 + 조각 + "+10" / 방지 = 하늘색 고리가 퍼짐 / 20강 = 크게 하얗게
	  3) onDone
	망치질 도중 화면을 누르면(skip) 바로 결과로 넘어간다.
	외부 에셋 없이 UI 요소의 움직임만으로 만든다. 소리는 SoundController 의 자리만 부른다.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualConfig = require(Shared:WaitForChild("Config"):WaitForChild("VisualConfig"))
local VisualLogic = require(Shared:WaitForChild("Pure"):WaitForChild("VisualLogic"))

local client = script.Parent.Parent
local ui = client:WaitForChild("ui")
local Theme = require(ui:WaitForChild("Theme"))
local Components = require(ui:WaitForChild("Components"))
local ScreenManager = require(ui:WaitForChild("ScreenManager"))
local SoundController = require(script.Parent:WaitForChild("SoundController"))

local EffectsController = {}
EffectsController.Name = "EffectsController"

local C = Theme.color

local stage: Frame? = nil
local labelScale: UIScale? = nil
local flash: Frame? = nil
local dimmer: Frame? = nil

local playing = false
local skipped = false

-- UIController 가 자기 화면 요소를 넘겨 준다.
function EffectsController.bind(stageFrame: Frame, label: TextLabel)
	stage = stageFrame

	local scale = label:FindFirstChildOfClass("UIScale")
	if scale == nil then
		local created = Instance.new("UIScale")
		created.Parent = label
		scale = created
	end
	labelScale = scale
end

local function flashScreen(color: Color3, strength: number, duration: number?)
	local overlay = flash
	if overlay == nil then
		return
	end
	overlay.BackgroundColor3 = color
	overlay.BackgroundTransparency = 1 - strength
	TweenService:Create(
		overlay,
		TweenInfo.new(duration or 0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 1 }
	):Play()
end

local function setDim(amount: number, duration: number)
	local overlay = dimmer
	if overlay == nil then
		return
	end
	TweenService:Create(overlay, TweenInfo.new(duration, Enum.EasingStyle.Sine), {
		BackgroundTransparency = 1 - amount,
	}):Play()
end

local function punchLabel(peak: number, duration: number)
	local scale = labelScale
	if scale == nil then
		return
	end
	scale.Scale = peak
	TweenService
		:Create(scale, TweenInfo.new(duration, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = 1,
		})
		:Play()
end

local function shake(intensity: number, duration: number)
	local frame = stage
	if frame == nil then
		return
	end

	local origin = frame.Position
	local steps = math.max(2, math.floor(duration / 0.04))

	task.spawn(function()
		for step = 1, steps do
			local decay = 1 - step / steps
			frame.Position = origin
				+ UDim2.fromOffset(
					(math.random() - 0.5) * 2 * intensity * decay,
					(math.random() - 0.5) * 2 * intensity * decay
				)
			task.wait(0.04)
		end
		frame.Position = origin
	end)
end

-- 무대 가운데(또는 아래)에서 작은 조각들이 튀어 나간다 (불티·쇳조각)
local function burst(count: number, color: Color3, fromBottom: boolean?, spread: number?)
	local frame = stage
	if frame == nil then
		return
	end

	local originY = if fromBottom then 0.8 else 0.5
	for _ = 1, count do
		local piece = Instance.new("Frame")
		piece.BackgroundColor3 = color
		piece.BorderSizePixel = 0
		piece.AnchorPoint = Vector2.new(0.5, 0.5)
		piece.Position = UDim2.fromScale(0.5, originY)
		local size = math.random(4, 9)
		piece.Size = UDim2.fromOffset(size, size)
		piece.Rotation = math.random(0, 360)
		piece.ZIndex = 20
		piece.Parent = frame

		local angle = if fromBottom
			then -math.pi / 2 + (math.random() - 0.5) * math.pi * 0.9
			else math.random() * math.pi * 2
		local distance = math.random(50, spread or 170)

		local tween = TweenService:Create(
			piece,
			TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{
				Position = UDim2.new(
					0.5,
					math.cos(angle) * distance,
					originY,
					math.sin(angle) * distance
				),
				BackgroundTransparency = 1,
				Rotation = piece.Rotation + math.random(-180, 180),
			}
		)
		tween.Completed:Connect(function()
			piece:Destroy()
		end)
		tween:Play()
	end
end

-- 방지권: 하늘색 고리가 퍼진다
local function ring(color: Color3)
	local frame = stage
	if frame == nil then
		return
	end

	local circle = Instance.new("Frame")
	circle.BackgroundTransparency = 1
	circle.AnchorPoint = Vector2.new(0.5, 0.5)
	circle.Position = UDim2.fromScale(0.5, 0.55)
	circle.Size = UDim2.fromOffset(40, 40)
	circle.ZIndex = 19
	circle.Parent = frame
	Components.round(circle)
	local stroke = Components.stroke(circle, color, 6)

	local tween = TweenService:Create(
		circle,
		TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Size = UDim2.fromOffset(260, 260),
		}
	)
	TweenService:Create(stroke, TweenInfo.new(0.6), { Transparency = 1 }):Play()
	tween.Completed:Connect(function()
		circle:Destroy()
	end)
	tween:Play()
end

-- 망치질 한 번
local function strike(level: number)
	SoundController.play("hammer")
	punchLabel(0.88, 0.18)
	flashScreen(Theme.heatColor(level), 0.12, 0.15)
	burst(6, C.gold, true, 110)
end

local function playResult(outcome: string, newLevel: number, isMax: boolean)
	local frame = stage

	if isMax then
		SoundController.play("max")
		punchLabel(1.6, 0.6)
		flashScreen(C.white, 0.6, 0.8)
		burst(30, C.gold, false, 220)
		if frame then
			Components.floatText(frame, "+20", C.white, UDim2.fromScale(0.5, 0.4), Theme.text.big)
		end
		return
	end

	SoundController.play(outcome)

	if outcome == "success" then
		punchLabel(1.35, 0.4)
		flashScreen(Theme.heatColor(newLevel), 0.28)
		burst(16, Theme.heatColor(newLevel), false, 170)
	elseif outcome == "keep" then
		shake(6, 0.22)
	elseif outcome == "fail" then
		punchLabel(0.7, 0.45)
		flashScreen(C.fail, 0.42)
		burst(14, Color3.fromRGB(200, 190, 180), false, 180)
		shake(14, 0.45)
		if frame then
			Components.floatText(
				frame,
				`+{newLevel}`,
				C.fail,
				UDim2.fromScale(0.5, 0.45),
				Theme.text.big
			)
		end
	elseif outcome == "protected" then
		punchLabel(1.15, 0.35)
		flashScreen(C.protect, 0.25)
		ring(C.protect)
	end
end

--[[
	강화 결과 연출 전체.
	startLevel: 강화하기 전 레벨 (망치질 길이 결정)
	onReveal: 결과를 화면에 반영할 때 부른다 (레벨 숫자 바꾸기, 피드 한 줄)
	onDone:   연출이 끝났을 때
]]
function EffectsController.playReveal(
	startLevel: number,
	outcome: string,
	newLevel: number,
	isMax: boolean,
	onReveal: () -> (),
	onDone: () -> ()
)
	local step = VisualLogic.reveal(startLevel, VisualConfig.Reveal)
	playing = true
	skipped = false

	task.spawn(function()
		local interval = step.seconds / step.strikes
		local darkens = step.strikes >= 3

		if darkens then
			setDim(0.45, step.seconds)
		end

		for index = 1, step.strikes do
			if skipped then
				break
			end
			strike(startLevel)

			-- 다음 망치질까지 조금씩 쉬며 건너뛰기를 확인한다
			local waited = 0
			local target = if index == step.strikes then interval * 0.6 else interval
			while waited < target and not skipped do
				waited += task.wait(0.03)
			end
		end

		if darkens then
			setDim(0, 0.15)
		end

		local ok, err = pcall(onReveal)
		if not ok then
			warn(`[EffectsController] 결과 반영 오류: {err}`)
		end
		playResult(outcome, newLevel, isMax)

		playing = false
		task.wait(0.25)
		onDone()
	end)
end

-- 망치질 도중에 누르면 바로 결과로
function EffectsController.skip()
	if playing then
		skipped = true
	end
end

function EffectsController.isPlaying(): boolean
	return playing
end

function EffectsController.Init()
	local overlay = ScreenManager.createOverlay("ForgeFlash", 20)

	local flashFrame = Instance.new("Frame")
	flashFrame.Name = "Flash"
	flashFrame.BackgroundColor3 = C.white
	flashFrame.BackgroundTransparency = 1
	flashFrame.BorderSizePixel = 0
	flashFrame.Size = UDim2.fromScale(1, 1)
	flashFrame.Active = false
	flashFrame.Parent = overlay
	flash = flashFrame

	-- 15강 이상 망치질 때 "주변이" 어두워지도록 대장간 패널(5)보다 아래 층에 둔다.
	local dimOverlay = ScreenManager.createOverlay("ForgeRevealDim", 3)
	local dimFrame = Instance.new("Frame")
	dimFrame.Name = "Dim"
	dimFrame.BackgroundColor3 = C.black
	dimFrame.BackgroundTransparency = 1
	dimFrame.BorderSizePixel = 0
	dimFrame.Size = UDim2.fromScale(1, 1)
	dimFrame.Active = false
	dimFrame.Parent = dimOverlay
	dimmer = dimFrame
end

function EffectsController.Start() end

return EffectsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">FeedController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	FeedController — 결과 피드 (모루 영감의 대사, 통합 기획서 8절).

	보이는 곳이 화면 상태에 따라 바뀐다.
	  대장간: 패널 왼쪽 아래 칸에 최근 몇 줄 (ForgeLayout 의 feed 자리)
	  로비:   위쪽 가운데 한 줄 (최근 것 하나, 6초 뒤 흐려짐). 공지 배너가 떠 있으면 숨는다
	  경주:   숨김
	최근 7줄을 기억한다. 기본 채팅창에도 같은 내용을 띄운다(시스템 메시지·서버 공지).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local client = script.Parent.Parent
local ClientState = require(client:WaitForChild("ClientState"))
local ui = client:WaitForChild("ui")
local Theme = require(ui:WaitForChild("Theme"))
local Components = require(ui:WaitForChild("Components"))
local ScreenManager = require(ui:WaitForChild("ScreenManager"))
local ForgeLayout = require(ui:WaitForChild("ForgeLayout"))

local FeedController = {}
FeedController.Name = "FeedController"

local MAX_LINES = 7
local LINE_HEIGHT = 24
local LOBBY_FADE_SECONDS = 6

local C = Theme.color

local OUTCOME_COLOR: { [string]: Color3 } = {
	system = C.text,
	success = C.ember,
	keep = C.keep,
	fail = C.fail,
	protected = C.protect,
	max = C.white,
	broadcast = Color3.fromRGB(180, 255, 190),
}

type Line = { text: string, color: Color3 }

local lines: { Line } = {}

local gui: ScreenGui
local forgeBox: Frame
local forgeList: Frame
local lobbyLine: TextLabel
local lobbyFadeToken = 0
local forgeCapacity = 3 -- 대장간 피드 칸에 들어가는 줄 수 (배치 때 다시 계산)

-- 다른 컨트롤러가 "배너가 떠 있는지" 알려 주는 함수 (HudController 가 등록)
local isBannerVisible: () -> boolean = function()
	return false
end

local function redrawForge()
	Components.clear(forgeList)

	-- 칸 높이에 들어가는 만큼만, 최근 것이 맨 아래
	local first = math.max(1, #lines - forgeCapacity + 1)
	for index = first, #lines do
		local line = lines[index]
		local label = Components.label(forgeList, {
			text = line.text,
			color = line.color,
			size = Theme.text.small,
			order = index,
			height = LINE_HEIGHT,
		})
		label.TextTruncate = Enum.TextTruncate.AtEnd
	end
end

local function place()
	local layout = ScreenManager.getLayout()
	if layout == nil then
		return
	end

	local forge = ForgeLayout.compute(layout.forgePanel)
	ScreenManager.place(forgeBox, forge.feedAbsolute)
	forgeList.Size = UDim2.new(1, -16, 1, -12)
	forgeCapacity = math.max(1, math.floor((forge.feedAbsolute.h - 12) / LINE_HEIGHT))
	ScreenManager.place(lobbyLine, layout.feedLobby)
	redrawForge()
end

local function render()
	local mode = ScreenManager.getMode()
	gui.Enabled = not ScreenManager.isRacing()
	forgeBox.Visible = mode == "forge"
	lobbyLine.Visible = mode == "lobby" and not isBannerVisible() and lobbyLine.Text ~= ""
end

local function showInLobby(line: Line)
	lobbyLine.Text = line.text
	lobbyLine.TextColor3 = line.color
	lobbyLine.TextTransparency = 0
	lobbyLine.BackgroundTransparency = 0.25
	render()

	lobbyFadeToken += 1
	local token = lobbyFadeToken
	task.delay(LOBBY_FADE_SECONDS, function()
		if token ~= lobbyFadeToken then
			return
		end
		TweenService:Create(lobbyLine, TweenInfo.new(0.8), {
			TextTransparency = 1,
			BackgroundTransparency = 1,
		}):Play()
	end)
end

--[[
	기본 채팅창에도 같은 내용을 띄운다.
	TextChannel:DisplaySystemMessage() 는 공식 문서상 클라이언트에서만 호출할 수 있고,
	그 메시지는 이 플레이어에게만 보인다.
]]
local function displayInChat(text: string)
	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		return
	end

	local channels = TextChatService:FindFirstChild("TextChannels")
	local general = channels and channels:FindFirstChild("RBXGeneral")

	if general and general:IsA("TextChannel") then
		local ok, err = pcall(function()
			general:DisplaySystemMessage(text)
		end)
		if not ok then
			warn(`[FeedController] 채팅 표시 실패: {err}`)
		end
	end
end

local function push(text: string, color: Color3)
	local line = { text = text, color = color }
	table.insert(lines, line)
	while #lines > MAX_LINES do
		table.remove(lines, 1)
	end

	redrawForge()
	showInLobby(line)
end

-- 강화 결과 한 줄. 서버 응답을 받은 뒤(연출이 끝난 뒤)에만 호출한다.
function FeedController.pushOutcome(outcome: string)
	local language = ClientState.getLanguage()
	local npc = Locale.get(language, "npc.anvilElder.name")

	local variants = Locale.variantCount(language, `feed.{outcome}`)
	local key = if variants > 0
		then `feed.{outcome}.{math.random(1, variants)}`
		else `feed.{outcome}.1`

	push(`{npc}: {Locale.get(language, key)}`, OUTCOME_COLOR[outcome] or C.text)
end

function FeedController.pushRaw(text: string, color: Color3?)
	push(text, color or C.text)
end

function FeedController.setBannerCheck(check: () -> boolean)
	isBannerVisible = check
	render()
end

function FeedController.Init()
	gui = ScreenManager.createScreen("ForgeFeed", 6)

	forgeBox = Components.frame(gui, {
		Name = "ForgeFeed",
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.25,
	})
	Components.corner(forgeBox, 10)
	forgeList = Components.frame(forgeBox, {
		Position = UDim2.fromOffset(8, 6),
	})
	local listLayout = Components.list(forgeList, "vertical", 0)
	listLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom

	lobbyLine = Components.label(gui, {
		size = Theme.text.small,
		font = Theme.font.bodyBold,
		align = Enum.TextXAlignment.Center,
	})
	lobbyLine.Name = "LobbyLine"
	lobbyLine.BackgroundColor3 = C.bg
	lobbyLine.BackgroundTransparency = 1
	Components.corner(lobbyLine, 10)

	ScreenManager.onLayout(place)
	ScreenManager.onStateChanged(render)
	ClientState.onChanged(render)
	render()
end

function FeedController.Start()
	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	local feedRemote = remotesFolder:WaitForChild(Remotes.Events.FeedMessage) :: RemoteEvent

	feedRemote.OnClientEvent:Connect(function(payload: any)
		if type(payload) ~= "table" then
			return
		end

		if payload.kind == "broadcast" then
			local language = ClientState.getLanguage()
			local text = Locale.get(
				language,
				"feed.broadcast",
				tostring(payload.playerName),
				Locale.get(language, tostring(payload.weaponKey)),
				tonumber(payload.level) or 0
			)
			push(text, OUTCOME_COLOR.broadcast)
			displayInChat(text)
		elseif payload.kind == "system" and type(payload.text) == "string" then
			-- 채팅 명령어의 응답 등. 채팅창과 피드 양쪽에 남긴다.
			push(payload.text, OUTCOME_COLOR.system)
			displayInChat(payload.text)
		end
	end)
end

return FeedController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	HudController — 위쪽 왼쪽 재화 칩(골드 · 파편 · 방지권)과 공지·점검 배너 (통합 기획서 8-1절).

	- 칩은 모양과 색이 고정이다: 골드 = 금색 동그라미, 파편 = 하늘색 마름모, 방지권 = 초록 방패 모양.
	- 큰 숫자는 줄여 쓴다(1.2억 / 120M). 정확한 값은 대장간 화면과 채팅 /정보 에서 볼 수 있다.
	- 골드가 늘면 칩이 잠깐 커졌다 돌아오고 "+N" 이 떠오른다.
	- 로비·대장간에서 보이고 경주 중에는 숨는다.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))

local client = script.Parent.Parent
local ClientState = require(client:WaitForChild("ClientState"))
local ui = client:WaitForChild("ui")
local Theme = require(ui:WaitForChild("Theme"))
local Components = require(ui:WaitForChild("Components"))
local ScreenManager = require(ui:WaitForChild("ScreenManager"))

local HudController = {}
HudController.Name = "HudController"

local gui: ScreenGui
local chipRow: Frame
local goldChip: Components.Chip
local shardChip: Components.Chip
local ticketChip: Components.Chip
local banner: TextLabel

local lastGold: number? = nil

local function pop(frame: GuiObject)
	local scale = frame:FindFirstChildOfClass("UIScale")
	if scale == nil then
		scale = Instance.new("UIScale")
		scale.Parent = frame
	end
	local uiScale = scale :: UIScale
	uiScale.Scale = 1.12
	TweenService:Create(uiScale, Theme.motion.pop, { Scale = 1 }):Play()
end

local function place()
	local layout = ScreenManager.getLayout()
	if layout == nil then
		return
	end

	ScreenManager.place(chipRow, layout.chips)

	-- 배너: 로비에서는 피드 한 줄 자리, 대장간에서는 칩 오른쪽 위 띠 전체
	local mode = ScreenManager.getMode()
	if mode == "lobby" then
		ScreenManager.place(banner, layout.feedLobby)
	else
		local x = layout.chips.x + layout.chips.w + 8
		ScreenManager.place(banner, {
			x = x,
			y = layout.chips.y,
			w = layout.width - layout.chips.x - x,
			h = layout.chips.h,
		})
	end
end

local function render()
	local language = ClientState.getLanguage()
	local data = ClientState.getData()

	gui.Enabled = not ScreenManager.isRacing()

	if data then
		goldChip.value.Text = Format.short(data.gold, language)
		shardChip.value.Text = Format.short(data.shards, language)
		ticketChip.value.Text = Format.short(data.protectTickets, language)

		local previous = lastGold
		if previous ~= nil and data.gold > previous then
			pop(goldChip.frame)
			Components.floatText(
				goldChip.frame,
				"+" .. Format.short(data.gold - previous, language),
				Theme.color.gold,
				UDim2.new(0.5, 0, 1, 26),
				Theme.text.label
			)
		end
		lastGold = data.gold
	else
		goldChip.value.Text = "-"
		shardChip.value.Text = "-"
		ticketChip.value.Text = "-"
	end

	local liveOps = ClientState.getLiveOps()
	if liveOps.maintenance then
		banner.Visible = true
		banner.Text = Locale.get(language, "ui.maintenance")
	elseif liveOps.notice ~= "" then
		banner.Visible = true
		banner.Text = liveOps.notice
	else
		banner.Visible = false
	end

	place()
end

-- 피드가 배너와 같은 자리를 쓰므로, 배너가 떠 있는지 알려 준다.
function HudController.isBannerVisible(): boolean
	return banner ~= nil and banner.Visible
end

function HudController.Init()
	gui = ScreenManager.createScreen("ForgeHud", 4)

	chipRow = Components.frame(gui, { Name = "Chips" })
	Components.list(chipRow, "horizontal", 8)

	goldChip = Components.chip(chipRow, "coin", Theme.color.gold)
	shardChip = Components.chip(chipRow, "shard", Theme.color.shard)
	ticketChip = Components.chip(chipRow, "ticket", Theme.color.ticket)
	for index, chip in { goldChip, shardChip, ticketChip } do
		chip.frame.Size = UDim2.new(1 / 3, -6, 1, 0)
		chip.frame.LayoutOrder = index
	end

	banner = Components.label(gui, {
		size = Theme.text.small,
		color = Theme.color.gold,
		font = Theme.font.bodyBold,
		align = Enum.TextXAlignment.Center,
		wrap = true,
	})
	banner.Name = "Banner"
	banner.BackgroundColor3 = Theme.color.bg
	banner.BackgroundTransparency = 0.15
	banner.Visible = false
	Components.corner(banner, 10)
	Components.stroke(banner, Theme.color.ember, 1.5)

	ScreenManager.onLayout(place)
	ScreenManager.onStateChanged(render)
	ClientState.onChanged(render)
	render()
end

function HudController.Start() end

return HudController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">LobbyController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	LobbyController — 로비에서 보이는 화면 (통합 기획서 4·6·8-1절).

	왼쪽: 메뉴 타일 4개 (대장간 · 검 · 도감 · 상점). 태블릿·PC 는 세로 한 줄,
	      화면이 낮은 휴대폰은 재화 칩 아래 가로 한 줄 (Pure/UILayout 이 정한다).
	오른쪽 위: "경주" 버튼과 상태 한 줄. 대기 중이면 버튼이 "대기 취소"로 바뀌고 남은 시간·인원과 막대.
	아래 가운데: 풀무 러닝머신 위에 있을 때 20초 진행 막대.
	가운데와 왼쪽 아래(조이스틱)·오른쪽 아래(점프)는 비운다.

	"착용 검의 최대 거리·최대 보상" 은 서버와 같은 Pure/RaceLogic 으로 계산한 안내용 값이다.
	실제 거리·보상·트레드밀 수입은 전부 서버가 정한다.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Pure = Shared:WaitForChild("Pure")
local Format = require(Pure:WaitForChild("Format"))
local EnhanceLogic = require(Pure:WaitForChild("EnhanceLogic"))
local RaceLogic = require(Pure:WaitForChild("RaceLogic"))

local ConfigFolder = Shared:WaitForChild("Config")
local EnhanceTable = require(ConfigFolder:WaitForChild("EnhanceTable"))
local RaceConfig = require(ConfigFolder:WaitForChild("RaceConfig"))

local client = script.Parent.Parent
local ClientState = require(client:WaitForChild("ClientState"))
local ui = client:WaitForChild("ui")
local Theme = require(ui:WaitForChild("Theme"))
local Components = require(ui:WaitForChild("Components"))
local ScreenManager = require(ui:WaitForChild("ScreenManager"))

local controllers = script.Parent
local FeedController = require(controllers:WaitForChild("FeedController"))
local SoundController = require(controllers:WaitForChild("SoundController"))

local LobbyController = {}
LobbyController.Name = "LobbyController"

local C = Theme.color

local CURVE: RaceLogic.Curve = {
	minTime = RaceConfig.MIN_TIME_SECONDS,
	maxTime = RaceConfig.MAX_TIME_SECONDS,
	maxLevel = EnhanceTable.MAX_LEVEL,
	accel = RaceConfig.CHASER_ACCEL,
	headStart = RaceConfig.HEAD_START,
	baseSpeed = RaceConfig.BASE_SPEED,
}

type MenuEntry = { key: string, glyph: Components.Glyph, textKey: string, button: TextButton? }

local MENU: { MenuEntry } = {
	{ key = "forge", glyph = "anvil", textKey = "ui.menu.forge" },
	{ key = "swords", glyph = "sword", textKey = "ui.swords" },
	{ key = "records", glyph = "book", textKey = "ui.menu.codex" },
	{ key = "shop", glyph = "bag", textKey = "ui.shop" },
}

local gui: ScreenGui
local menuFrame: Frame
local raceFrame: Frame
local raceButton: TextButton
local raceStatus: TextLabel
local queueBar: Components.ProgressBar
local treadmillFrame: Frame
local treadmillLabel: TextLabel
local treadmillBar: Components.ProgressBar

local joinRemote: RemoteFunction
local leaveRemote: RemoteFunction

local busy = false
local queued = false
local queueCount = 0
local queueDeadline = 0
local queueWindow = RaceConfig.MATCH_WINDOW_SECONDS

local onPad = false
local padProgress = 0
local padInterval = 0
local padGold = 0

local function raceInfoText(language: string): string
	local sword = ClientState.getEquipped()
	if sword == nil then
		return ""
	end

	local level = sword.level
	local maxDistance = RaceLogic.maxDistance(level, CURVE)
	local odds = EnhanceTable.Odds[level]
	local multiplier =
		RaceLogic.rewardMultiplier(level, if odds then odds.success else 0, RaceConfig.Multiplier)
	local cost =
		EnhanceLogic.cost(level, 1, EnhanceTable.COST_BASE, EnhanceTable.SWORD_COUNT_EXPONENT)
	local maxReward = RaceLogic.reward(cost, multiplier, maxDistance, maxDistance)

	return Locale.get(
		language,
		"ui.race.infoShort",
		Format.comma(math.floor(maxDistance)),
		Format.short(maxReward, language)
	)
end

local function place()
	local layout = ScreenManager.getLayout()
	if layout == nil then
		return
	end

	ScreenManager.place(menuFrame, layout.menu)
	local size = 60
	local gap = 8
	for index, entry in MENU do
		local button = entry.button
		if button then
			local column, row
			if layout.menuColumns == 1 then
				column, row = 0, index - 1
			elseif layout.menuColumns == 2 then
				column, row = (index - 1) % 2, math.floor((index - 1) / 2)
			else
				column, row = index - 1, 0
			end
			button.Position = UDim2.fromOffset(column * (size + gap), row * (size + gap))
			button.Size = UDim2.fromOffset(size, size)
		end
	end

	ScreenManager.place(raceFrame, layout.raceCluster)
	ScreenManager.place(treadmillFrame, layout.lobbyStatus)
end

local function render()
	local language = ClientState.getLanguage()
	gui.Enabled = ScreenManager.getMode() == "lobby"

	for _, entry in MENU do
		if entry.button then
			Components.setTileText(entry.button, Locale.get(language, entry.textKey))
		end
	end

	raceButton.Text = "      "
		.. Locale.get(language, if queued then "ui.race.cancel" else "ui.race.match")
	Components.setStyle(raceButton, if queued then "secondary" else "primary")

	if queued then
		local left = math.max(0, queueDeadline - os.clock())
		raceStatus.Text = Locale.get(language, "ui.race.queue", math.ceil(left), queueCount)
		raceStatus.TextColor3 = C.ember
		queueBar.frame.Visible = true
		queueBar.set(if queueWindow > 0 then left / queueWindow else 0)
	else
		raceStatus.Text = raceInfoText(language)
		raceStatus.TextColor3 = C.muted
		queueBar.frame.Visible = false
	end

	treadmillFrame.Visible = onPad
	if onPad then
		treadmillLabel.Text = Locale.get(
			language,
			"ui.treadmill.progress",
			math.floor(padProgress),
			padInterval,
			Format.comma(padGold)
		)
		treadmillBar.set(if padInterval > 0 then padProgress / padInterval else 0)
	end
end

local function showError(reason: string)
	FeedController.pushRaw(Locale.get(ClientState.getLanguage(), `error.{reason}`), C.fail)
end

local function requestMatch()
	if busy then
		return
	end
	busy = true

	local remote = if queued then leaveRemote else joinRemote
	local ok, response = pcall(function()
		return remote:InvokeServer()
	end)
	busy = false

	if not ok or type(response) ~= "table" then
		showError("unknown")
	elseif response.ok ~= true then
		showError(tostring(response.reason))
	end
	-- 대기열에 들어갔는지는 서버가 RaceUpdate(kind = "queue") 로 알려 준다.
end

local function onMenu(key: string)
	SoundController.play("click")
	if key == "forge" then
		ScreenManager.setForgeOpen(true)
	else
		ScreenManager.openModal(key)
	end
end

local function build()
	gui = ScreenManager.createScreen("ForgeLobby", 4)

	menuFrame = Components.frame(gui, { Name = "Menu" })
	for index, entry in MENU do
		local button = Components.tile(menuFrame, entry.glyph, "", 60, index)
		entry.button = button
		button.Activated:Connect(function()
			onMenu(entry.key)
		end)
	end

	raceFrame = Components.frame(gui, { Name = "Race" })
	raceButton = Components.button(raceFrame, { style = "primary", size = Theme.text.label })
	raceButton.Size = UDim2.new(1, 0, 0, 60)
	local flag = Components.frame(raceButton, {
		Size = UDim2.fromOffset(30, 30),
		Position = UDim2.new(0, 12, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
	})
	Components.glyph(flag, "flag", C.white)

	raceStatus = Components.label(raceFrame, {
		size = Theme.text.small,
		font = Theme.font.bodyBold,
		align = Enum.TextXAlignment.Center,
		wrap = true,
	})
	raceStatus.Position = UDim2.fromOffset(0, 66)
	raceStatus.Size = UDim2.new(1, 0, 0, 30)
	raceStatus.BackgroundColor3 = C.bg
	raceStatus.BackgroundTransparency = 0.25
	Components.corner(raceStatus, 8)

	queueBar = Components.progressBar(raceFrame, C.ember, 8)
	queueBar.frame.Position = UDim2.new(0, 6, 0, 98)
	queueBar.frame.Size = UDim2.new(1, -12, 0, 8)

	treadmillFrame = Components.frame(gui, {
		Name = "Treadmill",
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.2,
		Visible = false,
	})
	Components.corner(treadmillFrame, 10)
	Components.stroke(treadmillFrame, C.gold, 1.5)
	treadmillLabel = Components.label(treadmillFrame, {
		size = Theme.text.small,
		font = Theme.font.bodyBold,
		color = C.gold,
		align = Enum.TextXAlignment.Center,
	})
	treadmillLabel.Position = UDim2.fromOffset(0, 2)
	treadmillLabel.Size = UDim2.new(1, 0, 0, 22)
	treadmillBar = Components.progressBar(treadmillFrame, C.gold, 10)
	treadmillBar.frame.Position = UDim2.new(0, 10, 1, -16)
	treadmillBar.frame.Size = UDim2.new(1, -20, 0, 10)

	raceButton.Activated:Connect(function()
		SoundController.play("click")
		task.spawn(requestMatch)
	end)
end

local function onRaceUpdate(payload: any)
	if type(payload) ~= "table" then
		return
	end
	if payload.kind == "queue" then
		queued = payload.queued == true
		queueCount = tonumber(payload.count) or 0
		local left = tonumber(payload.secondsLeft) or 0
		queueDeadline = os.clock() + left
		queueWindow = math.max(left, 0.001)
		render()
	elseif payload.kind == "lineup" or payload.kind == "lobby" then
		queued = false
		render()
	end
end

local function onTreadmillUpdate(payload: any)
	if type(payload) ~= "table" then
		return
	end

	onPad = payload.onPad == true
	padProgress = tonumber(payload.progress) or 0
	padInterval = tonumber(payload.interval) or 0
	padGold = tonumber(payload.gold) or 0

	local paid = tonumber(payload.paid) or 0
	if paid > 0 then
		SoundController.play("coin")
		FeedController.pushRaw(
			Locale.get(ClientState.getLanguage(), "ui.treadmill.paid", Format.comma(paid)),
			C.gold
		)
		Components.floatText(
			treadmillFrame,
			"+" .. Format.comma(paid),
			C.gold,
			UDim2.new(0.5, 0, 0, -10),
			Theme.text.title
		)
	end
	render()
end

function LobbyController.Init()
	build()

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	joinRemote = remotesFolder:WaitForChild(Remotes.Functions.JoinRace) :: RemoteFunction
	leaveRemote = remotesFolder:WaitForChild(Remotes.Functions.LeaveRaceQueue) :: RemoteFunction

	local raceRemote = remotesFolder:WaitForChild(Remotes.Events.RaceUpdate) :: RemoteEvent
	raceRemote.OnClientEvent:Connect(onRaceUpdate)
	local treadmillRemote =
		remotesFolder:WaitForChild(Remotes.Events.TreadmillUpdate) :: RemoteEvent
	treadmillRemote.OnClientEvent:Connect(onTreadmillUpdate)

	ScreenManager.onLayout(place)
	ScreenManager.onStateChanged(render)
	ClientState.onChanged(render)
	render()
end

-- 지금 경주 대기 중인지 (월드 연출이 쓴다)
function LobbyController.isQueued(): boolean
	return queued
end

function LobbyController.Start()
	-- 대기 중에는 남은 시간과 막대를 다시 그린다.
	task.spawn(function()
		while true do
			task.wait(0.2)
			if queued then
				render()
			end
		end
	end)
end

return LobbyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">OddsTableController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	OddsTableController — 확률표 창 (통합 기획서 3·8절).

	대장간 화면의 "확률표" 버튼(글자가 있는 버튼)으로 언제든 연다.
	표에 보이는 값은 "지금 실제로 적용되는" 최종 확률과 비용이다.
	  - 기본값: shared/Config/EnhanceTable
	  - 확률 버프 이벤트가 있으면 성공 + / 유지 - (실패는 그대로)
	  - 방지권을 켜 두었고 방지권이 있으면 실패 0%, 그만큼 유지
	  - 비용에는 가진 검 수 할증이 들어간다
	서버와 같은 Pure/EnhanceLogic 함수로 계산하므로 실제 판정과 어긋나지 않는다.
	1구간(실패 없음)과 2구간(실패하면 +10) 사이에 구분 줄이 있고, 지금 레벨 줄은 주황으로 강조한다.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Pure = Shared:WaitForChild("Pure")
local Format = require(Pure:WaitForChild("Format"))
local EnhanceLogic = require(Pure:WaitForChild("EnhanceLogic"))
local EnhanceTable = require(Shared:WaitForChild("Config"):WaitForChild("EnhanceTable"))

local client = script.Parent.Parent
local ClientState = require(client:WaitForChild("ClientState"))
local ui = client:WaitForChild("ui")
local Theme = require(ui:WaitForChild("Theme"))
local Components = require(ui:WaitForChild("Components"))
local ScreenManager = require(ui:WaitForChild("ScreenManager"))

local OddsTableController = {}
OddsTableController.Name = "OddsTableController"

local C = Theme.color
local ROW_HEIGHT = 30
local COLUMNS = { 0.14, 0.2, 0.2, 0.2, 0.26 }
local HEADER_KEYS =
	{ "ui.column.level", "ui.column.success", "ui.column.keep", "ui.column.fail", "ui.column.cost" }

local gui: ScreenGui
local panel: Frame
local titleLabel: TextLabel
local stateLabel: TextLabel
local header: Frame
local headerCells: { TextLabel } = {}
local scroller: ScrollingFrame
local open = false

local function makeRow(parent: Instance, order: number, highlight: boolean): Frame
	local row = Components.frame(parent, {
		BackgroundColor3 = if highlight then Theme.shade(C.ember, -0.45) else C.sub,
		BackgroundTransparency = if highlight then 0 else 0.55,
		Size = UDim2.new(1, -8, 0, ROW_HEIGHT),
		LayoutOrder = order,
	})
	Components.corner(row, 6)
	Components.list(row, "horizontal", 0)
	return row
end

local function cell(
	row: Instance,
	index: number,
	text: string,
	color: Color3,
	bold: boolean?
): TextLabel
	local label = Components.label(row, {
		text = text,
		color = color,
		size = Theme.text.small,
		font = if bold then Theme.font.bodyBold else Theme.font.body,
		align = Enum.TextXAlignment.Center,
		order = index,
		height = ROW_HEIGHT,
	})
	label.Size = UDim2.new(COLUMNS[index], 0, 1, 0)
	return label
end

local function build()
	gui = ScreenManager.createScreen("ForgeOddsTable", 10)
	gui.Enabled = false

	panel = Components.panel(gui, { Name = "Panel" })
	Components.closeButton(panel, function()
		ScreenManager.closeModal()
	end)

	local body = Components.frame(
		panel,
		{ Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -32, 1, -24) }
	)

	titleLabel = Components.label(body, {
		font = Theme.font.display,
		size = Theme.text.title,
		color = C.gold,
		outline = true,
		height = 40,
	})
	titleLabel.Size = UDim2.new(1, -56, 0, 40)

	stateLabel = Components.label(
		body,
		{ size = Theme.text.small, color = C.event, wrap = true, height = 40 }
	)
	stateLabel.Position = UDim2.fromOffset(0, 40)

	header = Components.frame(
		body,
		{ Position = UDim2.fromOffset(0, 84), Size = UDim2.new(1, -8, 0, ROW_HEIGHT) }
	)
	Components.list(header, "horizontal", 0)
	for index in HEADER_KEYS do
		headerCells[index] = cell(header, index, "", C.muted, true)
	end

	local scrollHolder = Components.frame(body, {
		Position = UDim2.fromOffset(0, 84 + ROW_HEIGHT + 4),
		Size = UDim2.new(1, 0, 1, -(84 + ROW_HEIGHT + 4)),
	})
	scroller = Components.scroller(scrollHolder, 3)
end

local function place()
	local layout = ScreenManager.getLayout()
	if layout then
		ScreenManager.place(panel, layout.modal)
	end
end

local function refresh()
	if not open then
		return
	end

	local language = ClientState.getLanguage()
	local sword = ClientState.getEquipped()
	local currentLevel = if sword then sword.level else -1
	local swordCount = ClientState.getSwordCount()

	titleLabel.Text = Locale.get(language, "ui.oddsTableTitle")
	for index, key in HEADER_KEYS do
		headerCells[index].Text = Locale.get(language, key)
	end

	-- 지금 적용 중인 것: 이벤트(성공 +, 유지 -), 방지권(실패 → 유지)
	local event = ClientState.getLiveOps().event
	local buff = 0
	local notes: { string } = {}
	if type(event) == "table" and type(event.successBuff) == "number" then
		buff = event.successBuff
		table.insert(
			notes,
			Locale.get(language, "ui.eventActive", Locale.get(language, tostring(event.nameKey)))
		)
	end
	local protectActive = ClientState.isProtectActive()
	table.insert(
		notes,
		Locale.get(language, if protectActive then "ui.oddsProtectOn" else "ui.protectNote")
	)
	stateLabel.Text = table.concat(notes, "  ·  ")
	stateLabel.TextColor3 = if protectActive then C.protect else C.muted

	Components.clear(scroller)
	local order = 0

	for level = 0, EnhanceTable.MAX_LEVEL do
		-- 1구간과 2구간 사이 구분 줄
		if level == EnhanceTable.SAFE_LEVEL then
			order += 1
			local divider = Components.label(scroller, {
				text = Locale.get(language, "ui.zone2"),
				size = Theme.text.small,
				color = C.fail,
				font = Theme.font.bodyBold,
				align = Enum.TextXAlignment.Center,
				order = order,
				height = 24,
			})
			divider.Size = UDim2.new(1, -8, 0, 24)
		elseif level == 0 then
			order += 1
			local divider = Components.label(scroller, {
				text = Locale.get(language, "ui.zone1"),
				size = Theme.text.small,
				color = C.muted,
				font = Theme.font.bodyBold,
				align = Enum.TextXAlignment.Center,
				order = order,
				height = 24,
			})
			divider.Size = UDim2.new(1, -8, 0, 24)
		end

		order += 1
		local isCurrent = level == currentLevel
		local row = makeRow(scroller, order, isCurrent)
		cell(row, 1, Format.level(level), Theme.heatColor(level), true)

		local base = EnhanceTable.Odds[level]
		if base then
			local entry = EnhanceLogic.applyBuff(base, buff)
			if protectActive then
				entry = EnhanceLogic.applyProtect(entry)
			end
			local cost = EnhanceLogic.cost(
				level,
				swordCount,
				EnhanceTable.COST_BASE,
				EnhanceTable.SWORD_COUNT_EXPONENT
			)

			cell(row, 2, Format.percent(entry.success), C.ember, isCurrent)
			cell(row, 3, Format.percent(entry.keep), C.keep, isCurrent)
			cell(
				row,
				4,
				Format.percent(entry.fail),
				if entry.fail > 0 then C.fail else C.muted,
				isCurrent
			)
			cell(row, 5, Format.short(cost, language), C.text, isCurrent)
		else
			for index = 2, 5 do
				cell(row, index, "-", C.muted)
			end
		end
	end
end

function OddsTableController.Init()
	build()

	ScreenManager.registerModal("odds", function()
		open = true
		gui.Enabled = true
		refresh()
	end, function()
		open = false
		gui.Enabled = false
	end)

	ScreenManager.onLayout(place)
end

function OddsTableController.Start()
	ClientState.onChanged(refresh)
end

return OddsTableController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">RaceController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	RaceController — 경주 화면 (통합 기획서 4·8-1절 결정 8).

	출발선에 선 순간부터 로비로 돌아올 때까지:
	  출발 전   화면 가운데 3 · 2 · 1 · 출발!
	  달리는 중 위쪽 가운데 진행 막대: 참가자 전원의 위치 점(나는 크고 주황), 추격자(빨강).
	            내 거리 / 내 최대 거리, 남은 사람 n/m, 추격자와의 간격(30칸 아래면 빨갛게 + 화면 가장자리 맥박)
	  탈락 후   결과 카드(순위·거리·최대 거리 대비 %·보상이 0부터 올라감), "다음 사람"·"로비로"
	  판 종료   순위표(상위 5명 + 내 순위), 자동 복귀 카운트다운
	특수 능력 버튼 자리(D16)는 점프 버튼 왼쪽에 만들어 두고 지금은 숨긴다.

	클라이언트는 표시만 한다. 진행 막대의 점·간격은 내 화면에 보이는 위치로 계산한 참고 값이고,
	결과(인정 거리·순위·보상)는 서버가 보낸 값을 그대로 보여 준다. 서버로 보내는 것은 "로비로" 하나뿐이다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))
local World = require(Shared:WaitForChild("Config"):WaitForChild("World"))

local client = script.Parent.Parent
local ClientState = require(client:WaitForChild("ClientState"))
local ui = client:WaitForChild("ui")
local Theme = require(ui:WaitForChild("Theme"))
local Components = require(ui:WaitForChild("Components"))
local ScreenManager = require(ui:WaitForChild("ScreenManager"))

local controllers = script.Parent
local FeedController = require(controllers:WaitForChild("FeedController"))
local SoundController = require(controllers:WaitForChild("SoundController"))

local RaceController = {}
RaceController.Name = "RaceController"

local C = Theme.color
local MAX_RANK_ROWS = 5
local HUD_INTERVAL = 0.08
local GO_TEXT_SECONDS = 1
local DANGER_GAP = 30

type Entrant = { userId: number, name: string, level: number, alive: boolean, dot: Frame? }

type RaceView = {
	id: number,
	originZ: number,
	level: number,
	maxDistance: number,
	entrants: { Entrant },
}

local phase: "none" | "lineup" | "racing" | "out" = "none"
local view: RaceView? = nil
local goAt = 0
local startedAt = 0
local spectateUserId: number? = nil
local resultPayload: any = nil
local finishedPayload: any = nil
local returnAt = 0
local chaserPart: BasePart? = nil
local lastCountdown = -1

local gui: ScreenGui
local hud: Frame
local distanceLabel: TextLabel
local aliveLabel: TextLabel
local track: Frame
local trackFill: Frame
local chaserMark: Frame
local dotsLayer: Frame
local gapLabel: TextLabel
local countdownLabel: TextLabel
local abilitySlot: Frame
local resultCard: Frame
local resultTitle: TextLabel
local resultBody: TextLabel
local rewardLabel: TextLabel
local nextButton: TextButton
local lobbyButton: TextButton

local edgeGui: ScreenGui
local edgeFrames: { Frame } = {}

local lobbyRemote: RemoteFunction

--------------------------------------------------------------------------------
-- 만들기
--------------------------------------------------------------------------------

local function build()
	gui = ScreenManager.createScreen("ForgeRace", 6)
	gui.Enabled = false

	hud = Components.panel(gui, { Name = "Hud", BackgroundColor3 = C.bg })
	distanceLabel = Components.label(
		hud,
		{ font = Theme.font.display, size = Theme.text.label, outline = true }
	)
	distanceLabel.Position = UDim2.fromOffset(14, 6)
	distanceLabel.Size = UDim2.new(0.6, -14, 0, 26)
	aliveLabel = Components.label(hud, {
		font = Theme.font.bodyBold,
		size = Theme.text.small,
		color = C.muted,
		align = Enum.TextXAlignment.Right,
	})
	aliveLabel.Position = UDim2.new(0.6, 0, 0, 6)
	aliveLabel.Size = UDim2.new(0.4, -14, 0, 26)

	track = Components.frame(hud, {
		BackgroundColor3 = C.sub,
		BackgroundTransparency = 0,
		Position = UDim2.fromOffset(14, 36),
		Size = UDim2.new(1, -28, 0, 12),
	})
	Components.round(track)
	trackFill = Components.frame(track, {
		BackgroundColor3 = Theme.shade(C.ember, -0.3),
		BackgroundTransparency = 0,
		Size = UDim2.fromScale(0, 1),
	})
	Components.round(trackFill)
	chaserMark = Components.frame(track, {
		BackgroundColor3 = C.fail,
		BackgroundTransparency = 0,
		Size = UDim2.new(0, 6, 1, 10),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		ZIndex = 3,
	})
	Components.corner(chaserMark, 3)
	dotsLayer = Components.frame(track, { ZIndex = 4 })

	gapLabel = Components.label(
		hud,
		{ font = Theme.font.bodyBold, size = Theme.text.small, align = Enum.TextXAlignment.Center }
	)
	gapLabel.Position = UDim2.new(0, 0, 1, -24)
	gapLabel.Size = UDim2.new(1, 0, 0, 22)

	countdownLabel = Components.label(gui, {
		font = Theme.font.display,
		size = 120,
		color = C.ember,
		outline = true,
		align = Enum.TextXAlignment.Center,
	})
	countdownLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	countdownLabel.Size = UDim2.fromOffset(400, 150)
	countdownLabel.Visible = false
	local countStroke = countdownLabel:FindFirstChildOfClass("UIStroke")
	if countStroke then
		countStroke.Thickness = 5
	end
	local countScale = Instance.new("UIScale")
	countScale.Parent = countdownLabel

	-- 특수 능력 버튼 자리 (D16 미정이라 숨김)
	abilitySlot = Components.frame(gui, { Name = "AbilitySlot", Visible = false })

	resultCard = Components.panel(gui, { Name = "Result", Visible = false })
	resultTitle = Components.label(
		resultCard,
		{ font = Theme.font.display, size = Theme.text.title, color = C.ember, outline = true }
	)
	resultTitle.Position = UDim2.fromOffset(16, 10)
	resultTitle.Size = UDim2.new(0.5, -16, 0, 34)
	rewardLabel = Components.label(resultCard, {
		font = Theme.font.display,
		size = Theme.text.title,
		color = C.gold,
		outline = true,
		align = Enum.TextXAlignment.Right,
	})
	rewardLabel.Position = UDim2.new(0.5, 0, 0, 10)
	rewardLabel.Size = UDim2.new(0.5, -16, 0, 34)
	resultBody =
		Components.label(resultCard, { size = Theme.text.small, color = C.muted, wrap = true })
	resultBody.TextYAlignment = Enum.TextYAlignment.Top
	resultBody.Position = UDim2.fromOffset(16, 48)
	resultBody.Size = UDim2.new(1, -32, 1, -(48 + Theme.touchHeight + 20))

	nextButton = Components.button(resultCard, { style = "secondary", size = Theme.text.body })
	nextButton.AnchorPoint = Vector2.new(0, 1)
	nextButton.Position = UDim2.new(0, 16, 1, -12)
	nextButton.Size = UDim2.new(0.5, -20, 0, Theme.touchHeight)
	lobbyButton = Components.button(resultCard, { style = "primary", size = Theme.text.body })
	lobbyButton.AnchorPoint = Vector2.new(1, 1)
	lobbyButton.Position = UDim2.new(1, -16, 1, -12)
	lobbyButton.Size = UDim2.new(0.5, -20, 0, Theme.touchHeight)

	-- 추격자가 가까울 때 화면 가장자리가 붉게 맥박친다
	edgeGui = ScreenManager.createOverlay("ForgeRaceEdge", 2)
	edgeGui.Enabled = false
	local sides = {
		{ UDim2.new(1, 0, 0.2, 0), UDim2.fromScale(0, 0), 90 },
		{ UDim2.new(1, 0, 0.2, 0), UDim2.fromScale(0, 0.8), -90 },
		{ UDim2.new(0.15, 0, 1, 0), UDim2.fromScale(0, 0), 0 },
		{ UDim2.new(0.15, 0, 1, 0), UDim2.fromScale(0.85, 0), 180 },
	}
	for _, side in sides do
		local frame = Instance.new("Frame")
		frame.BorderSizePixel = 0
		frame.BackgroundColor3 = C.fail
		frame.Size = side[1]
		frame.Position = side[2]
		frame.Parent = edgeGui
		local gradient = Instance.new("UIGradient")
		gradient.Transparency = NumberSequence.new(0.2, 1)
		gradient.Rotation = side[3]
		gradient.Parent = frame
		table.insert(edgeFrames, frame)
	end
end

local function place()
	local layout = ScreenManager.getLayout()
	if layout == nil then
		return
	end
	ScreenManager.place(hud, layout.raceHud)
	ScreenManager.place(abilitySlot, layout.raceAbility)
	ScreenManager.place(resultCard, layout.raceResult)
	countdownLabel.Position = UDim2.fromOffset(layout.width / 2, layout.height * 0.4)
end

--------------------------------------------------------------------------------
-- 참가자 · 관전
--------------------------------------------------------------------------------

local function findEntrant(userId: number?): Entrant?
	local current = view
	if current == nil or userId == nil then
		return nil
	end
	for _, entrant in current.entrants do
		if entrant.userId == userId then
			return entrant
		end
	end
	return nil
end

local function rootOf(player: Player?): BasePart?
	local character = if player then player.Character else nil
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function setCameraSubject(player: Player?)
	local camera = Workspace.CurrentCamera
	if camera == nil then
		return
	end
	local target = player or Players.LocalPlayer
	local character = target.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

local function nextAlive(after: number?): number?
	local current = view
	if current == nil then
		return nil
	end
	local localId = Players.LocalPlayer.UserId
	local entrants = current.entrants
	local count = #entrants
	local startIndex = 0
	for index, entrant in entrants do
		if entrant.userId == after then
			startIndex = index
			break
		end
	end
	for offset = 1, count do
		local entrant = entrants[(startIndex + offset - 1) % count + 1]
		if
			entrant.alive
			and entrant.userId ~= localId
			and Players:GetPlayerByUserId(entrant.userId) ~= nil
		then
			return entrant.userId
		end
	end
	return nil
end

local function spectate(userId: number?)
	spectateUserId = userId
	setCameraSubject(if userId then Players:GetPlayerByUserId(userId) else nil)
end

local function findChaser(): BasePart?
	local current = view
	if current == nil then
		return nil
	end
	local cached = chaserPart
	if cached and cached.Parent ~= nil then
		return cached
	end
	local races = Workspace:FindFirstChild(World.RACES_FOLDER)
	local folder = if races
		then races:FindFirstChild(`{World.RACE_FOLDER_PREFIX}{current.id}`)
		else nil
	local part = if folder then folder:FindFirstChild(World.CHASER_NAME) else nil
	if part and part:IsA("BasePart") then
		chaserPart = part
		return part
	end
	return nil
end

-- 진행 막대의 참가자 점 (처음 한 번 만든다)
local function buildDots()
	Components.clear(dotsLayer)
	local current = view
	if current == nil then
		return
	end
	local localId = Players.LocalPlayer.UserId
	for _, entrant in current.entrants do
		local mine = entrant.userId == localId
		local size = if mine then 18 else 12
		local dot = Components.frame(dotsLayer, {
			BackgroundColor3 = if mine then C.ember else Theme.heatColor(entrant.level),
			BackgroundTransparency = 0,
			Size = UDim2.fromOffset(size, size),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			ZIndex = if mine then 6 else 5,
		})
		Components.round(dot)
		Components.stroke(dot, C.outline, if mine then 3 else 2)
		entrant.dot = dot
	end
end

--------------------------------------------------------------------------------
-- 그리기
--------------------------------------------------------------------------------

local function resultText(language: string): string
	local lines: { string } = {}

	local result = resultPayload
	if type(result) == "table" then
		local distance = tonumber(result.distance) or 0
		local maxDistance = tonumber(result.maxDistance) or 0
		local ratio = if maxDistance > 0 then math.min(1, distance / maxDistance) else 0
		table.insert(
			lines,
			Locale.get(
				language,
				"ui.race.result",
				tonumber(result.racerCount) or 1,
				tonumber(result.rank) or 1,
				Format.comma(distance),
				Format.ratio(ratio, 0)
			)
		)
		local bonus = tonumber(result.bonus) or 0
		if bonus > 0 then
			table.insert(lines, Locale.get(language, "ui.race.bonus", Format.comma(bonus)))
		end
	end

	local finished = finishedPayload
	if type(finished) == "table" and type(finished.ranking) == "table" then
		table.insert(
			lines,
			Locale.get(language, "ui.race.finished", math.max(0, math.ceil(returnAt - os.clock())))
		)
		local localId = Players.LocalPlayer.UserId
		local shownMine = false
		for index, row in finished.ranking do
			if type(row) ~= "table" then
				continue
			end
			local mine = row.userId == localId
			if index <= MAX_RANK_ROWS or (mine and not shownMine) then
				table.insert(
					lines,
					Locale.get(
						language,
						"ui.race.rankRow",
						tonumber(row.rank) or index,
						tostring(row.name),
						tonumber(row.level) or 0,
						Format.comma(tonumber(row.distance) or 0)
					)
				)
				if mine then
					shownMine = true
				end
			end
		end
	else
		local watched = findEntrant(spectateUserId)
		if watched then
			table.insert(
				lines,
				Locale.get(language, "ui.race.spectating", watched.name, watched.level)
			)
		end
	end

	return table.concat(lines, "\n")
end

local function setEdge(danger: boolean)
	edgeGui.Enabled = danger
	if danger then
		local pulse = 0.25 + 0.25 * math.sin(os.clock() * 8)
		for _, frame in edgeFrames do
			frame.BackgroundTransparency = pulse
		end
	end
end

local function render()
	local language = ClientState.getLanguage()
	local current = view

	gui.Enabled = phase ~= "none"
	if phase == "none" or current == nil then
		setEdge(false)
		return
	end

	local now = os.clock()

	-- 카운트다운
	if phase == "lineup" then
		local number = math.max(1, math.ceil(goAt - now))
		countdownLabel.Visible = true
		countdownLabel.Text = tostring(number)
		if number ~= lastCountdown then
			lastCountdown = number
			SoundController.play("tick")
			local scale = countdownLabel:FindFirstChildOfClass("UIScale") :: UIScale
			scale.Scale = 1.5
			TweenService:Create(scale, Theme.motion.pop, { Scale = 1 }):Play()
		end
	elseif phase == "racing" and now - startedAt < GO_TEXT_SECONDS then
		countdownLabel.Visible = true
		countdownLabel.Text = Locale.get(language, "ui.race.go")
	else
		countdownLabel.Visible = false
	end

	-- 진행 막대
	local localPlayer = Players.LocalPlayer
	local watched = localPlayer
	if phase == "out" and spectateUserId ~= nil then
		watched = Players:GetPlayerByUserId(spectateUserId) or localPlayer
	end

	local chaser = findChaser()
	local chaserFront = if chaser
		then chaser.Position.Z + chaser.Size.Z / 2 - current.originZ
		else -30

	local trackMax = math.max(current.maxDistance, 1)
	local positions: { [number]: number } = {}
	local aliveCount = 0
	for _, entrant in current.entrants do
		if entrant.alive then
			aliveCount += 1
		end
		local root = rootOf(Players:GetPlayerByUserId(entrant.userId))
		if root then
			local distance = math.max(0, root.Position.Z - current.originZ)
			positions[entrant.userId] = distance
			trackMax = math.max(trackMax, distance * 1.05)
		end
	end

	for _, entrant in current.entrants do
		local dot = entrant.dot
		if dot then
			local distance = positions[entrant.userId]
			dot.Visible = distance ~= nil and entrant.alive
			if distance then
				dot.Position = UDim2.fromScale(math.clamp(distance / trackMax, 0, 1), 0.5)
			end
		end
	end
	chaserMark.Position = UDim2.fromScale(math.clamp(chaserFront / trackMax, 0, 1), 0.5)

	local myDistance = positions[watched.UserId] or 0
	trackFill.Size = UDim2.fromScale(math.clamp(myDistance / trackMax, 0, 1), 1)

	if watched == localPlayer then
		distanceLabel.Text = Locale.get(
			language,
			"ui.race.distance",
			Format.comma(math.floor(myDistance)),
			Format.comma(math.floor(current.maxDistance))
		)
	else
		distanceLabel.Text =
			Locale.get(language, "ui.race.distanceOnly", Format.comma(math.floor(myDistance)))
	end
	aliveLabel.Text = Locale.get(language, "ui.race.alive", aliveCount, #current.entrants)

	local gap = math.max(0, math.floor(myDistance - chaserFront))
	gapLabel.Text = Locale.get(language, "ui.race.gap", Format.comma(gap))
	local danger = phase == "racing" and gap < DANGER_GAP
	gapLabel.TextColor3 = if danger then C.fail else C.text
	setEdge(danger)

	-- 결과 카드
	resultCard.Visible = phase == "out"
	if phase == "out" then
		resultTitle.Text = Locale.get(language, "ui.race.caught")
		resultBody.Text = resultText(language)
		nextButton.Text = Locale.get(language, "ui.race.next")
		lobbyButton.Text = Locale.get(language, "ui.race.toLobby")
		nextButton.Visible = finishedPayload == nil and nextAlive(spectateUserId) ~= nil
	end
end

-- 보상 숫자가 0 부터 올라간다 (0.8초)
local function countUpReward(amount: number)
	local language = ClientState.getLanguage()
	task.spawn(function()
		local duration = 0.8
		local started = os.clock()
		while true do
			local t = math.min(1, (os.clock() - started) / duration)
			local eased = 1 - (1 - t) ^ 3
			rewardLabel.Text = "+" .. Format.short(math.floor(amount * eased), language)
			if t >= 1 then
				break
			end
			task.wait(0.03)
		end
		if amount > 0 then
			SoundController.play("coin")
		end
	end)
end

--------------------------------------------------------------------------------
-- 서버 알림
--------------------------------------------------------------------------------

local function leaveRaceView()
	phase = "none"
	view = nil
	spectateUserId = nil
	resultPayload = nil
	finishedPayload = nil
	chaserPart = nil
	lastCountdown = -1
	Components.clear(dotsLayer)

	setCameraSubject(nil)
	ScreenManager.setMode("lobby")
	render()
end

local function onLineup(payload: any)
	local entrants: { Entrant } = {}
	if type(payload.entrants) == "table" then
		for _, entry in payload.entrants do
			if type(entry) == "table" and type(entry.userId) == "number" then
				table.insert(entrants, {
					userId = entry.userId,
					name = tostring(entry.name),
					level = tonumber(entry.level) or 0,
					alive = true,
				})
			end
		end
	end

	view = {
		id = tonumber(payload.raceId) or 0,
		originZ = tonumber(payload.originZ) or 0,
		level = tonumber(payload.level) or 0,
		maxDistance = tonumber(payload.maxDistance) or 0,
		entrants = entrants,
	}

	phase = "lineup"
	goAt = os.clock() + (tonumber(payload.countdown) or 0)
	spectateUserId = nil
	resultPayload = nil
	finishedPayload = nil
	chaserPart = nil
	lastCountdown = -1
	rewardLabel.Text = ""

	buildDots()
	setCameraSubject(nil)
	ScreenManager.setMode("race")
	render()
end

local function onRaceUpdate(payload: any)
	if type(payload) ~= "table" then
		return
	end

	local kind = payload.kind
	if kind == "lineup" then
		onLineup(payload)
		return
	elseif kind == "lobby" then
		leaveRaceView()
		return
	end

	local current = view
	if current == nil or payload.raceId ~= current.id then
		return
	end

	if kind == "start" then
		if phase == "lineup" then
			phase = "racing"
			startedAt = os.clock()
			SoundController.play("go")
		end
	elseif kind == "eliminated" then
		local entrant = findEntrant(tonumber(payload.userId))
		if entrant then
			entrant.alive = false
		end
		if phase == "out" and spectateUserId == payload.userId then
			spectate(nextAlive(spectateUserId))
		end
	elseif kind == "result" then
		phase = "out"
		resultPayload = payload
		local mine = findEntrant(Players.LocalPlayer.UserId)
		if mine then
			mine.alive = false
		end

		SoundController.play("caught")
		local reward = tonumber(payload.reward) or 0
		FeedController.pushRaw(
			Locale.get(
				ClientState.getLanguage(),
				"ui.race.rewardFeed",
				Format.comma(reward),
				Format.comma(tonumber(payload.distance) or 0)
			),
			C.gold
		)
		countUpReward(reward)
		ScreenManager.setMode("raceOut")
		spectate(nextAlive(nil))
	elseif kind == "finished" then
		finishedPayload = payload
		returnAt = os.clock() + (tonumber(payload.returnIn) or 0)
		if phase == "out" then
			spectate(nil)
		end
	end

	render()
end

local function requestLobby()
	local ok, response = pcall(function()
		return lobbyRemote:InvokeServer()
	end)
	if ok and type(response) == "table" and response.ok == true then
		leaveRaceView()
		return
	end
	local reason = if ok and type(response) == "table" then tostring(response.reason) else "unknown"
	FeedController.pushRaw(Locale.get(ClientState.getLanguage(), `error.{reason}`), C.fail)
end

function RaceController.Init()
	build()

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	lobbyRemote = remotesFolder:WaitForChild(Remotes.Functions.ReturnToLobby) :: RemoteFunction
	local raceRemote = remotesFolder:WaitForChild(Remotes.Events.RaceUpdate) :: RemoteEvent
	raceRemote.OnClientEvent:Connect(onRaceUpdate)

	nextButton.Activated:Connect(function()
		SoundController.play("click")
		spectate(nextAlive(spectateUserId))
		render()
	end)
	lobbyButton.Activated:Connect(function()
		SoundController.play("click")
		task.spawn(requestLobby)
	end)

	ScreenManager.onLayout(place)
	render()
end

function RaceController.Start()
	task.spawn(function()
		while true do
			task.wait(HUD_INTERVAL)
			if phase == "none" then
				continue
			end
			if phase == "out" and spectateUserId ~= nil and finishedPayload == nil then
				if Players:GetPlayerByUserId(spectateUserId) == nil then
					spectate(nextAlive(spectateUserId))
				end
			end
			local ok, err = pcall(render)
			if not ok then
				warn(`[RaceController] 화면 갱신 오류: {err}`)
			end
		end
	end)
end

-- 지금 경주 화면인지 (월드 연출이 쓴다)
function RaceController.isActive(): boolean
	return phase ~= "none"
end

return RaceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ShopController — 상점 창 (통합 기획서 7·8절).

	위: Robux 로 사는 방지권 상품 카드 (확정 1개 / 확정 묶음 / 확률형)
	아래: 파편으로 하는 방지권 뽑기 (Robux 가 닿지 않는다)

	클라이언트는 상품 ID 를 모른다. "이 항목을 사고 싶다"는 키만 보내고 구매창·지급·뽑기는 서버가 한다.

	확률 공개 (로블록스 유료 확률형 정책, 기획서 P10):
	- 확률형 상품과 파편 뽑기는 사기 전에 모든 결과와 확률(%, 합계 100)을 버튼 바로 아래에 항상 보여 준다.
	  이 숫자는 서버가 보낸 값이다. 숨겨진 창이나 아이콘 뒤에 두지 않는다.
	- 천장 포인트(꽝 3번이면 방지권 1개)는 규칙과 현재 점수(막대 n/3)를 함께 보여 주고,
	  다음 꽝에서 천장이 차는 상태면 꽝 줄의 설명을 "방지권을 받는다"로 바꿔 보여 준다.
	아직 등록되지 않았거나 내용이 비어 있는 상품은 서버가 목록에서 빼므로 여기 오지 않는다.
	유료 확률형이 제한된 유저에게는 서버가 확률형 상품을 보내지 않는다.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Pure = Shared:WaitForChild("Pure")
local Format = require(Pure:WaitForChild("Format"))
local DrawLogic = require(Pure:WaitForChild("DrawLogic"))

local client = script.Parent.Parent
local ClientState = require(client:WaitForChild("ClientState"))
local ui = client:WaitForChild("ui")
local Theme = require(ui:WaitForChild("Theme"))
local Components = require(ui:WaitForChild("Components"))
local ScreenManager = require(ui:WaitForChild("ScreenManager"))

local controllers = script.Parent
local FeedController = require(controllers:WaitForChild("FeedController"))
local SoundController = require(controllers:WaitForChild("SoundController"))

local ShopController = {}
ShopController.Name = "ShopController"

local C = Theme.color
local PERCENT_DECIMALS = 2

local gui: ScreenGui
local panel: Frame
local titleLabel: TextLabel
local noticeLabel: TextLabel
local scroller: ScrollingFrame

local itemsRemote: RemoteFunction
local promptRemote: RemoteFunction
local shardRemote: RemoteFunction

local shopState: any = nil
local loading = false
local drawing = false
local open = false

local function showError(reason: string)
	FeedController.pushRaw(Locale.get(ClientState.getLanguage(), `error.{reason}`), C.fail)
end

local function line(
	parent: Instance,
	text: string,
	color: Color3,
	order: number,
	bold: boolean?,
	height: number?
): TextLabel
	local label = Components.label(parent, {
		text = text,
		color = color,
		size = Theme.text.small,
		font = if bold then Theme.font.bodyBold else Theme.font.body,
		wrap = height ~= nil,
		order = order,
		height = height,
	})
	label.Size = UDim2.new(1, -8, 0, height or 24)
	return label
end

local function outcomeText(language: string, outcome: any, missKey: string, ...: any): string
	local percent = Format.percent(tonumber(outcome.percent) or 0, PERCENT_DECIMALS)
	local tickets = tonumber(outcome.tickets) or 0
	if tickets > 0 then
		return Locale.get(language, "shop.outcomeTickets", tickets, percent)
	end
	return `{Locale.get(language, missKey, ...)}  {percent}`
end

local function requestPurchase(key: string)
	local ok, response = pcall(function()
		return promptRemote:InvokeServer(key)
	end)
	if not ok or type(response) ~= "table" then
		showError("unknown")
	elseif response.ok ~= true then
		showError(tostring(response.reason))
	end
end

local render: () -> ()

local function requestShardDraw()
	if drawing then
		return
	end
	drawing = true
	render()

	local ok, response = pcall(function()
		return shardRemote:InvokeServer()
	end)
	drawing = false

	if not ok or type(response) ~= "table" then
		showError("unknown")
	elseif response.ok ~= true then
		showError(tostring(response.reason))
	else
		local language = ClientState.getLanguage()
		local tickets = tonumber(response.tickets) or 0
		if tickets > 0 then
			SoundController.play("success")
			FeedController.pushRaw(Locale.get(language, "shop.shardDrawWin", tickets), C.ticket)
		else
			SoundController.play("keep")
			FeedController.pushRaw(Locale.get(language, "shop.shardDrawMiss"), C.muted)
		end
	end
	render()
end

-- 상품 카드 하나
local function productCard(
	language: string,
	item: any,
	order: number,
	pity: {
		points: number,
		perMiss: number,
		threshold: number,
		tickets: number,
	}
)
	local isRandom = item.kind == "random"
	local card = Components.panel(scroller, {
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.bg,
		LayoutOrder = order,
	})
	Components.padding(card, 12)
	Components.list(card, "vertical", 6)

	local head = Components.frame(card, { Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 1 })
	local icon = Components.frame(head, {
		Size = UDim2.fromOffset(36, 36),
		Position = UDim2.new(0, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
	})
	Components.glyph(icon, "ticket", C.ticket)
	local title = Components.label(head, {
		text = Locale.get(language, `shop.{tostring(item.key)}`, tonumber(item.ticketAmount) or 0),
		font = Theme.font.display,
		size = Theme.text.label,
		outline = true,
	})
	title.Position = UDim2.fromOffset(44, 0)
	title.Size = UDim2.new(1, -44, 1, 0)

	if isRandom and type(item.outcomes) == "table" then
		-- 사기 전에 모든 결과와 확률 (합계 100%)
		line(card, Locale.get(language, "shop.oddsTitle"), C.muted, 2, true)
		local pityNext = DrawLogic.isPityNext(pity.points, pity.perMiss, pity.threshold)
		for index, outcome in item.outcomes do
			local text = if pityNext
				then outcomeText(language, outcome, "shop.outcomeMissPity", pity.tickets)
				else outcomeText(language, outcome, "shop.outcomeMiss", pity.perMiss)
			line(
				card,
				text,
				if (tonumber(outcome.tickets) or 0) > 0 then C.ticket else C.text,
				2 + index
			)
		end

		local gauge = Components.frame(card, { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 50 })
		local gaugeLabel = Components.label(gauge, {
			text = Locale.get(language, "shop.pityShort", pity.points, pity.threshold),
			size = Theme.text.small,
			font = Theme.font.bodyBold,
			color = C.ember,
		})
		gaugeLabel.Size = UDim2.new(0.42, 0, 1, 0)
		local bar = Components.progressBar(gauge, C.ember, 12)
		bar.frame.AnchorPoint = Vector2.new(0, 0.5)
		bar.frame.Position = UDim2.new(0.44, 0, 0.5, 0)
		bar.frame.Size = UDim2.new(0.56, 0, 0, 12)
		bar.set(if pity.threshold > 0 then pity.points / pity.threshold else 0)

		line(
			card,
			Locale.get(
				language,
				"shop.pity",
				pity.points,
				pity.threshold,
				pity.perMiss,
				pity.threshold,
				pity.tickets
			),
			C.muted,
			51,
			false,
			44
		)
	end

	local buy = Components.button(
		card,
		{ text = Locale.get(language, "shop.buy"), style = "primary", order = 99 }
	)
	local key = tostring(item.key)
	buy.Activated:Connect(function()
		SoundController.play("click")
		task.spawn(requestPurchase, key)
	end)
end

render = function()
	if not open then
		return
	end

	local language = ClientState.getLanguage()
	local data = ClientState.getData()

	titleLabel.Text = Locale.get(language, "ui.shopTitle")
	noticeLabel.Text = Locale.get(language, "shop.notice")
	Components.clear(scroller)

	local state = shopState
	if type(state) ~= "table" then
		line(
			scroller,
			Locale.get(language, if loading then "ui.loading" else "ui.shopEmpty"),
			C.muted,
			1,
			false,
			60
		)
		return
	end

	local items = if type(state.items) == "table" then state.items else {}
	local shardDraw = if type(state.shardDraw) == "table" then state.shardDraw else nil

	if #items == 0 and shardDraw == nil then
		-- 빈 상태: 지금은 상품 ID·수치가 미정이라 이게 정상이다
		local empty = Components.panel(
			scroller,
			{ Size = UDim2.new(1, -8, 0, 150), BackgroundColor3 = C.bg, LayoutOrder = 1 }
		)
		local icon = Components.frame(empty, {
			Size = UDim2.fromOffset(56, 56),
			Position = UDim2.new(0.5, 0, 0, 16),
			AnchorPoint = Vector2.new(0.5, 0),
		})
		Components.glyph(icon, "bag", C.gold)
		local soon = Components.label(empty, {
			text = Locale.get(language, "ui.shopEmpty"),
			font = Theme.font.display,
			size = Theme.text.label,
			color = C.gold,
			align = Enum.TextXAlignment.Center,
		})
		soon.Position = UDim2.fromOffset(0, 80)
		local promise = Components.label(empty, {
			text = Locale.get(language, "shop.promise"),
			size = Theme.text.small,
			color = C.muted,
			align = Enum.TextXAlignment.Center,
			wrap = true,
		})
		promise.Position = UDim2.fromOffset(12, 108)
		promise.Size = UDim2.new(1, -24, 0, 36)
		return
	end

	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	local pity = {
		points = if data then data.pityPoints else 0,
		perMiss = tonumber(state.pityPerMiss) or 1,
		threshold = tonumber(state.pityThreshold) or 0,
		tickets = tonumber(state.pityTickets) or 0,
	}

	if #items > 0 then
		line(scroller, Locale.get(language, "shop.sectionPaid"), C.ember, nextOrder(), true)
	end
	for _, item in items do
		if type(item) == "table" and type(item.key) == "string" then
			productCard(language, item, nextOrder(), pity)
		end
	end

	if shardDraw ~= nil and type(shardDraw.outcomes) == "table" then
		local cost = tonumber(shardDraw.cost) or 0
		local shards = if data then data.shards else 0
		local affordable = shards >= cost and not drawing

		line(scroller, Locale.get(language, "shop.sectionFree"), C.ember, nextOrder(), true)
		local card = Components.panel(scroller, {
			Size = UDim2.new(1, -8, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = C.bg,
			LayoutOrder = nextOrder(),
		})
		Components.padding(card, 12)
		Components.list(card, "vertical", 6)

		line(
			card,
			Locale.get(language, "shop.shardOwned", Format.comma(shards)),
			if affordable then C.shard else C.fail,
			1,
			true
		)
		line(card, Locale.get(language, "shop.oddsTitle"), C.muted, 2, true)
		for index, outcome in shardDraw.outcomes do
			line(card, outcomeText(language, outcome, "shop.outcomeMissFree"), C.text, 2 + index)
		end
		local draw = Components.button(
			card,
			{ text = Locale.get(language, "shop.shardDraw", cost), style = "primary", order = 99 }
		)
		Components.setEnabled(draw, affordable)
		draw.Activated:Connect(function()
			if draw.Active then
				SoundController.play("click")
				task.spawn(requestShardDraw)
			end
		end)
	end
end

local function refresh()
	loading = true
	render()
	local ok, state = pcall(function()
		return itemsRemote:InvokeServer()
	end)
	loading = false
	shopState = if ok and type(state) == "table" then state else nil
	render()
end

local function build()
	gui = ScreenManager.createScreen("ForgeShop", 10)
	gui.Enabled = false

	panel = Components.panel(gui, { Name = "Panel" })
	Components.closeButton(panel, function()
		ScreenManager.closeModal()
	end)

	titleLabel = Components.label(
		panel,
		{ font = Theme.font.display, size = Theme.text.title, color = C.gold, outline = true }
	)
	titleLabel.Position = UDim2.fromOffset(16, 12)
	titleLabel.Size = UDim2.new(1, -80, 0, 40)

	local holder = Components.frame(
		panel,
		{ Position = UDim2.fromOffset(16, 58), Size = UDim2.new(1, -32, 1, -58 - 48) }
	)
	scroller = Components.scroller(holder, 10)

	noticeLabel = Components.label(panel, { size = Theme.text.small, color = C.muted, wrap = true })
	noticeLabel.AnchorPoint = Vector2.new(0, 1)
	noticeLabel.Position = UDim2.new(0, 16, 1, -8)
	noticeLabel.Size = UDim2.new(1, -32, 0, 36)
end

local function place()
	local layout = ScreenManager.getLayout()
	if layout then
		ScreenManager.place(panel, layout.modal)
	end
end

function ShopController.Init()
	build()

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	itemsRemote = remotesFolder:WaitForChild(Remotes.Functions.GetShopItems) :: RemoteFunction
	promptRemote = remotesFolder:WaitForChild(Remotes.Functions.PromptPurchase) :: RemoteFunction
	shardRemote = remotesFolder:WaitForChild(Remotes.Functions.ShardDraw) :: RemoteFunction

	ScreenManager.registerModal("shop", function()
		open = true
		gui.Enabled = true
		task.spawn(refresh)
	end, function()
		open = false
		gui.Enabled = false
	end)

	ScreenManager.onLayout(place)
	-- 천장 포인트나 파편이 바뀌면(구매·뽑기 직후) 열려 있는 상점을 바로 다시 그린다.
	ClientState.onChanged(render)
end

function ShopController.Start() end

return ShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">SoundController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	SoundController — 결과 연출 사운드.

	설정(sfx)을 존중하는 재생 창구. 음원이 없으면 아무 일도 하지 않는다.
	다른 컨트롤러는 이 함수만 호출한다.
]]

local SoundService = game:GetService("SoundService")

local ClientState = require(script.Parent.Parent:WaitForChild("ClientState"))

local SoundController = {}
SoundController.Name = "SoundController"

--[[
	[개발자 입력 필요] 소리 에셋 ID 를 채운다 ("rbxassetid://숫자"). 비어 있으면 재생하지 않는다.
	느낌은 디자인 시안(통합 기획서 8-2절)의 "소리 자리" 표를 따른다.
]]
local SOUND_IDS: { [string]: string } = {
	success = "", -- 강화 성공
	keep = "", -- 유지
	fail = "", -- 실패 (치익 식는 소리)
	protected = "", -- 방지권이 막음
	max = "", -- 20강
	hammer = "", -- 망치질 "깡"
	click = "", -- 버튼
	coin = "", -- 금화 짤랑 (러닝머신·경주 보상)
	tick = "", -- 카운트다운 째깍
	go = "", -- 출발
	caught = "", -- 잡힘
}

local cache: { [string]: Sound } = {}

function SoundController.play(key: string)
	local data = ClientState.getData()
	if data and data.settings and data.settings.sfx == false then
		return
	end

	local assetId = SOUND_IDS[key]
	if assetId == nil or assetId == "" then
		return
	end

	local sound = cache[key]
	if sound == nil then
		sound = Instance.new("Sound")
		sound.SoundId = assetId
		sound.Parent = SoundService
		cache[key] = sound
	end

	sound:Play()
end

function SoundController.Init() end

function SoundController.Start() end

return SoundController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">SwordController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	SwordController — 검 보관함 창 (통합 기획서 5절).

	왼쪽: 가진 검 카드(등급 색 띠, 이름, 레벨 색 숫자, 착용 표시). 누르면 그 검을 착용한다.
	오른쪽: 새 검 뽑기. 가격(모자라면 빨간 글씨), "지금 내 기준" 등급별·검별 확률(합계 100%),
	        두 번 눌러야 골드를 쓰는 버튼. 뽑으면 등급 색으로 새 검이 나타난다.

	확률은 서버가 실제 뽑기에 쓰는 것과 같은 Pure/SwordLogic 함수로 만든다.
	클라이언트는 "착용할 검 id" 와 "뽑기 요청"만 보낸다. 가격·결과는 서버가 정한다.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Pure = Shared:WaitForChild("Pure")
local Format = require(Pure:WaitForChild("Format"))
local EnhanceLogic = require(Pure:WaitForChild("EnhanceLogic"))
local SwordLogic = require(Pure:WaitForChild("SwordLogic"))

local ConfigFolder = Shared:WaitForChild("Config")
local Weapons = require(ConfigFolder:WaitForChild("Weapons"))
local EnhanceTable = require(ConfigFolder:WaitForChild("EnhanceTable"))

local client = script.Parent.Parent
local ClientState = require(client:WaitForChild("ClientState"))
local ui = client:WaitForChild("ui")
local Theme = require(ui:WaitForChild("Theme"))
local Components = require(ui:WaitForChild("Components"))
local ScreenManager = require(ui:WaitForChild("ScreenManager"))

local controllers = script.Parent
local FeedController = require(controllers:WaitForChild("FeedController"))
local SoundController = require(controllers:WaitForChild("SoundController"))

local SwordController = {}
SwordController.Name = "SwordController"

local C = Theme.color
local RARITY_OF = Weapons.rarityMap()

local gui: ScreenGui
local panel: Frame
local titleLabel: TextLabel
local listTitle: TextLabel
local listScroller: ScrollingFrame
local drawScroller: ScrollingFrame
local buyButton: TextButton
local revealCard: Frame
local revealName: TextLabel
local revealRarity: TextLabel
local revealIcon: Frame

local equipRemote: RemoteFunction
local drawRemote: RemoteFunction

local open = false
local busy = false
local confirming = false -- 뽑기 버튼을 한 번 누른 상태 (두 번째에 실제로 요청)

local refresh: () -> ()

local function showError(reason: string)
	FeedController.pushRaw(Locale.get(ClientState.getLanguage(), `error.{reason}`), C.fail)
end

local function displayName(language: string, weaponId: string, sword: any): string
	if sword and sword.customName and sword.customName ~= "" then
		return sword.customName
	end
	local info = Weapons.get(weaponId)
	return if info then Locale.get(language, info.nameKey) else weaponId
end

local function swordCard(
	parent: Instance,
	language: string,
	weaponId: string,
	sword: any,
	equipped: boolean,
	order: number
)
	local info = Weapons.get(weaponId)
	if info == nil then
		return
	end

	local card = Instance.new("TextButton")
	card.Text = ""
	card.AutoButtonColor = false
	card.BackgroundColor3 = if equipped then Theme.shade(C.ember, -0.5) else C.sub
	card.BorderSizePixel = 0
	card.Size = UDim2.new(1, -8, 0, 64)
	card.LayoutOrder = order
	card.Parent = parent
	Components.corner(card)
	Components.stroke(card, if equipped then C.ember else C.line, if equipped then 2 else 1)

	local strip = Components.frame(card, {
		BackgroundColor3 = Theme.rarityColor(info.rarity),
		BackgroundTransparency = 0,
		Size = UDim2.new(0, 8, 1, -16),
		Position = UDim2.fromOffset(8, 8),
	})
	Components.corner(strip, 4)

	local icon = Components.frame(card, {
		Size = UDim2.fromOffset(36, 36),
		Position = UDim2.new(0, 24, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
	})
	Components.glyph(icon, "sword", Theme.heatColor(sword.level))

	local name = Components.label(card, {
		text = displayName(language, weaponId, sword),
		font = Theme.font.bodyBold,
		size = Theme.text.body,
	})
	name.Position = UDim2.fromOffset(68, 8)
	name.Size = UDim2.new(1, -150, 0, 24)

	local sub = Components.label(card, {
		text = Locale.get(language, `rarity.{info.rarity}`)
			.. (if equipped then "  ·  " .. Locale.get(language, "ui.equipped") else ""),
		size = Theme.text.small,
		color = if equipped then C.ember else C.muted,
	})
	sub.Position = UDim2.fromOffset(68, 34)
	sub.Size = UDim2.new(1, -150, 0, 22)

	local level = Components.label(card, {
		text = Format.level(sword.level),
		font = Theme.font.display,
		size = Theme.text.big,
		color = Theme.heatColor(sword.level),
		outline = true,
		align = Enum.TextXAlignment.Right,
	})
	level.AnchorPoint = Vector2.new(1, 0.5)
	level.Position = UDim2.new(1, -12, 0.5, 0)
	level.Size = UDim2.fromOffset(80, 44)

	if not equipped then
		card.Activated:Connect(function()
			if busy then
				return
			end
			busy = true
			local ok, response = pcall(function()
				return equipRemote:InvokeServer(weaponId)
			end)
			busy = false
			if not ok or type(response) ~= "table" then
				showError("unknown")
			elseif response.ok ~= true then
				showError(tostring(response.reason))
			else
				ClientState.setOdds(response.odds)
				SoundController.play("click")
			end
		end)
	end
end

-- 확률 한 줄: 이름 · 막대 · %
local function oddsRow(
	parent: Instance,
	text: string,
	percent: number,
	color: Color3,
	order: number,
	strong: boolean
)
	local row = Components.frame(parent, { Size = UDim2.new(1, -8, 0, 26), LayoutOrder = order })
	local name = Components.label(row, {
		text = text,
		size = Theme.text.small,
		color = if strong then C.text else C.muted,
		font = if strong then Theme.font.bodyBold else Theme.font.body,
	})
	name.Size = UDim2.new(0.5, 0, 1, 0)

	local bar = Components.progressBar(row, color, 10)
	bar.frame.AnchorPoint = Vector2.new(0, 0.5)
	bar.frame.Position = UDim2.new(0.5, 0, 0.5, 0)
	bar.frame.Size = UDim2.new(0.3, 0, 0, 10)
	bar.set(percent / 100)

	local value = Components.label(row, {
		text = Format.percent(percent, SwordLogic.PERCENT_DECIMALS),
		size = Theme.text.small,
		font = Theme.font.bodyBold,
		color = color,
		align = Enum.TextXAlignment.Right,
	})
	value.Size = UDim2.new(0.2, 0, 1, 0)
	value.Position = UDim2.new(0.8, 0, 0, 0)
end

local function showReveal(weaponId: string)
	local info = Weapons.get(weaponId)
	if info == nil then
		return
	end
	local language = ClientState.getLanguage()
	local color = Theme.rarityColor(info.rarity)

	revealName.Text = Locale.get(language, info.nameKey)
	revealRarity.Text = Locale.get(language, `rarity.{info.rarity}`)
	revealRarity.TextColor3 = color
	Components.clear(revealIcon)
	Components.glyph(revealIcon, "sword", color)
	local stroke = revealCard:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
	end

	local scale = revealCard:FindFirstChildOfClass("UIScale") :: UIScale
	scale.Scale = 0.3
	revealCard.Visible = true
	TweenService:Create(scale, Theme.motion.pop, { Scale = 1 }):Play()

	task.delay(2.4, function()
		revealCard.Visible = false
	end)
end

local function requestDraw()
	if busy then
		return
	end
	busy = true
	confirming = false
	refresh()

	local ok, response = pcall(function()
		return drawRemote:InvokeServer()
	end)

	busy = false

	if not ok or type(response) ~= "table" then
		showError("unknown")
	elseif response.ok ~= true then
		showError(tostring(response.reason))
	else
		local language = ClientState.getLanguage()
		local info = Weapons.get(tostring(response.swordId))
		if info then
			FeedController.pushRaw(
				Locale.get(
					language,
					"ui.drawResult",
					Locale.get(language, info.nameKey),
					Locale.get(language, `rarity.{info.rarity}`)
				),
				Theme.rarityColor(info.rarity)
			)
		end
		ClientState.setOdds(response.odds)
		SoundController.play("success")
		showReveal(tostring(response.swordId))
	end

	refresh()
end

function refresh()
	if not open then
		return
	end

	local language = ClientState.getLanguage()
	local data = ClientState.getData()

	titleLabel.Text = Locale.get(language, "ui.swordsTitle")
	listTitle.Text = Locale.get(language, "ui.swordListTitle")

	Components.clear(listScroller)
	Components.clear(drawScroller)

	if data == nil then
		Components.label(
			listScroller,
			{ text = Locale.get(language, "error.not_ready"), color = C.muted }
		)
		return
	end

	-- 가진 검
	local swordCount = 0
	for index, weaponId in Weapons.Order do
		local sword = data.swords[weaponId]
		if sword ~= nil then
			swordCount += 1
			swordCard(listScroller, language, weaponId, sword, data.equippedId == weaponId, index)
		end
	end

	-- 새 검 뽑기
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	Components.label(drawScroller, {
		text = Locale.get(language, "ui.drawTitle"),
		font = Theme.font.display,
		size = Theme.text.label,
		color = C.gold,
		order = nextOrder(),
	})
	Components.label(drawScroller, {
		text = Locale.get(language, "ui.drawDesc"),
		size = Theme.text.small,
		color = C.muted,
		wrap = true,
		order = nextOrder(),
		height = 70,
	}).Size =
		UDim2.new(1, -8, 0, 70)

	local drawTable =
		SwordLogic.buildDrawTable(Weapons.Order, RARITY_OF, Weapons.DRAW_WEIGHTS, data.swords)
	if #drawTable.entries == 0 then
		Components.label(
			drawScroller,
			{ text = Locale.get(language, "ui.drawNone"), color = C.muted, order = nextOrder() }
		)
		buyButton.Visible = false
		return
	end
	buyButton.Visible = true

	local price = SwordLogic.slotPrice(
		EnhanceLogic.cost(
			Weapons.SLOT_PRICE_LEVEL,
			math.max(1, swordCount),
			EnhanceTable.COST_BASE,
			EnhanceTable.SWORD_COUNT_EXPONENT
		),
		Weapons.SLOT_PRICE_MULTIPLIER
	)
	local affordable = data.gold >= price

	Components.label(drawScroller, {
		text = Locale.get(language, "ui.drawPrice", Format.comma(price)),
		font = Theme.font.bodyBold,
		color = if affordable then C.gold else C.fail,
		order = nextOrder(),
	})

	-- 확률: 등급별 합계, 그다음 검별. 전부 합치면 100%.
	Components.label(drawScroller, {
		text = Locale.get(language, "ui.drawOddsTitle"),
		size = Theme.text.small,
		color = C.text,
		font = Theme.font.bodyBold,
		order = nextOrder(),
	})
	for _, share in drawTable.rarities do
		oddsRow(
			drawScroller,
			Locale.get(language, `rarity.{share.rarity}`),
			share.percent,
			Theme.rarityColor(share.rarity),
			nextOrder(),
			true
		)
	end
	for _, entry in drawTable.entries do
		local info = Weapons.get(entry.id)
		oddsRow(
			drawScroller,
			"· " .. (if info then Locale.get(language, info.nameKey) else entry.id),
			entry.percent,
			Theme.rarityColor(entry.rarity),
			nextOrder(),
			false
		)
	end

	buyButton.Text = if confirming
		then Locale.get(language, "ui.drawConfirm", Format.comma(price))
		else Locale.get(language, "ui.drawBuy")
	Components.setStyle(buyButton, if confirming then "danger" else "primary")
	Components.setEnabled(buyButton, affordable and not busy)
end

local function build()
	gui = ScreenManager.createScreen("ForgeSwords", 10)
	gui.Enabled = false

	panel = Components.panel(gui, { Name = "Panel" })
	Components.closeButton(panel, function()
		ScreenManager.closeModal()
	end)

	titleLabel = Components.label(
		panel,
		{ font = Theme.font.display, size = Theme.text.title, color = C.gold, outline = true }
	)
	titleLabel.Position = UDim2.fromOffset(16, 12)
	titleLabel.Size = UDim2.new(1, -80, 0, 40)

	-- 왼쪽: 가진 검
	local left = Components.frame(
		panel,
		{ Position = UDim2.fromOffset(16, 58), Size = UDim2.new(0.46, -20, 1, -70) }
	)
	listTitle = Components.label(
		left,
		{ size = Theme.text.small, color = C.muted, font = Theme.font.bodyBold }
	)
	local listHolder = Components.frame(
		left,
		{ Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 1, -26) }
	)
	listScroller = Components.scroller(listHolder, 6)

	-- 오른쪽: 뽑기
	local right = Components.panel(panel, {
		Position = UDim2.new(0.46, 4, 0, 58),
		Size = UDim2.new(0.54, -20, 1, -70),
		BackgroundColor3 = C.bg,
	})
	local drawHolder = Components.frame(right, {
		Position = UDim2.fromOffset(12, 10),
		Size = UDim2.new(1, -24, 1, -(Theme.touchHeight + 30)),
	})
	drawScroller = Components.scroller(drawHolder, 4)

	buyButton = Components.button(right, { style = "primary", size = Theme.text.label })
	buyButton.AnchorPoint = Vector2.new(0.5, 1)
	buyButton.Position = UDim2.new(0.5, 0, 1, -10)
	buyButton.Size = UDim2.new(1, -24, 0, Theme.touchHeight)
	buyButton.Activated:Connect(function()
		if busy or not buyButton.Active then
			return
		end
		if confirming then
			task.spawn(requestDraw)
		else
			SoundController.play("click")
			confirming = true
			refresh()
		end
	end)

	-- 새 검 공개 카드
	revealCard = Components.panel(panel, {
		Name = "Reveal",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(300, 220),
		Visible = false,
		ZIndex = 20,
		BackgroundColor3 = C.bg,
	})
	local revealScale = Instance.new("UIScale")
	revealScale.Parent = revealCard
	local revealTitle = Components.label(revealCard, {
		text = "",
		font = Theme.font.display,
		size = Theme.text.label,
		color = C.gold,
		align = Enum.TextXAlignment.Center,
		outline = true,
	})
	revealTitle.Name = "RevealTitle"
	revealTitle.Position = UDim2.fromOffset(0, 12)
	revealIcon = Components.frame(revealCard, {
		Size = UDim2.fromOffset(90, 90),
		Position = UDim2.new(0.5, 0, 0, 44),
		AnchorPoint = Vector2.new(0.5, 0),
	})
	revealName = Components.label(revealCard, {
		font = Theme.font.display,
		size = Theme.text.title,
		align = Enum.TextXAlignment.Center,
		outline = true,
	})
	revealName.Position = UDim2.fromOffset(0, 140)
	revealRarity = Components.label(
		revealCard,
		{ font = Theme.font.bodyBold, size = Theme.text.body, align = Enum.TextXAlignment.Center }
	)
	revealRarity.Position = UDim2.fromOffset(0, 178)
	for _, child in revealCard:GetDescendants() do
		if child:IsA("GuiObject") then
			child.ZIndex = 21
		end
	end
end

local function place()
	local layout = ScreenManager.getLayout()
	if layout then
		ScreenManager.place(panel, layout.modal)
	end
end

function SwordController.Init()
	build()

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	equipRemote = remotesFolder:WaitForChild(Remotes.Functions.EquipSword) :: RemoteFunction
	drawRemote = remotesFolder:WaitForChild(Remotes.Functions.BuySwordSlot) :: RemoteFunction

	ScreenManager.registerModal("swords", function()
		open = true
		confirming = false
		gui.Enabled = true
		local title = revealCard:FindFirstChild("RevealTitle")
		if title and title:IsA("TextLabel") then
			title.Text = Locale.get(ClientState.getLanguage(), "ui.drawNew")
		end
		refresh()
	end, function()
		open = false
		confirming = false
		revealCard.Visible = false
		gui.Enabled = false
	end)

	ScreenManager.onLayout(place)
end

function SwordController.Start()
	-- 착용·뽑기·강화로 데이터가 바뀌면 열려 있는 창을 다시 그린다.
	ClientState.onChanged(refresh)
end

return SwordController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	UIController — 대장간 화면 (강화의 중심, 통합 기획서 8·8-1절).

	왼쪽 무대: 검 이름(누르면 이름 짓기) · 검 미리보기 자리 · 큰 레벨 숫자(쇠 달구는 색) · 피드 칸(FeedController)
	오른쪽 조작부: 구간 안내 · 이벤트 · 확률 글자와 막대 · 방지권 토글 + "확률표" 버튼 ·
	              비용과 지금 몇 번 가능한지 · 아래 줄 [검][기록][상점] + 큰 강화 버튼

	규칙:
	- 숫자는 서버가 보낸 값이거나 서버와 같은 Pure/ 함수로 계산한 값이다.
	- 확률(성공/유지/실패 %)과 비용은 항상 보인다. 방지권이 효과를 내면 바뀐 확률(실패 0)을 바로 보여 준다.
	- 요청 중에는 버튼을 잠근다. 연출은 서버 응답을 받은 뒤에만 시작하고, 결과 숫자는 연출이 공개할 때 바뀐다.
	- 표시 문자열은 전부 Locale 키를 거친다.

	이 컨트롤러는 접속 직후 상태 받기(GetState)와 데이터 복제·라이브 운영 이벤트 수신도 맡는다.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Pure = Shared:WaitForChild("Pure")
local Format = require(Pure:WaitForChild("Format"))
local EnhanceLogic = require(Pure:WaitForChild("EnhanceLogic"))

local ConfigFolder = Shared:WaitForChild("Config")
local Weapons = require(ConfigFolder:WaitForChild("Weapons"))
local EnhanceTable = require(ConfigFolder:WaitForChild("EnhanceTable"))

local client = script.Parent.Parent
local ClientState = require(client:WaitForChild("ClientState"))
local ui = client:WaitForChild("ui")
local Theme = require(ui:WaitForChild("Theme"))
local Components = require(ui:WaitForChild("Components"))
local ScreenManager = require(ui:WaitForChild("ScreenManager"))
local ForgeLayout = require(ui:WaitForChild("ForgeLayout"))

local controllers = script.Parent
local FeedController = require(controllers:WaitForChild("FeedController"))
local SoundController = require(controllers:WaitForChild("SoundController"))
local EffectsController = require(controllers:WaitForChild("EffectsController"))
local HudController = require(controllers:WaitForChild("HudController"))

local UIController = {}
UIController.Name = "UIController"

local C = Theme.color
local GAP = 6
local ROW = {
	title = 40,
	info = 24,
	odds = 26,
	bar = 22,
	protect = 60,
	cost = 26,
}

local gui: ScreenGui
local panel: Frame
local leftColumn: Frame
local rightColumn: Frame

local nameButton: TextButton
local rarityTag: TextLabel
local stage: Frame
local previewSlot: Frame
local levelLabel: TextLabel
local tierLabel: TextLabel

local titleLabel: TextLabel
local infoLabel: TextLabel
local eventLabel: TextLabel
local oddsLabel: TextLabel
local oddsBar: Components.OddsBar
local protectButton: TextButton
local tableButton: TextButton
local costLabel: TextLabel
local bottomRow: Frame
local swordsTile: TextButton
local recordsTile: TextButton
local shopTile: TextButton
local enhanceButton: TextButton
local tutorialBubble: Frame
local tutorialText: TextLabel
local skipCatcher: TextButton

local renamePanel: Frame
local renameTitle: TextLabel
local renameBox: TextBox
local renameConfirm: TextButton
local renameCancel: TextButton

local enhanceRemote: RemoteFunction
local renameRemote: RemoteFunction

local busy = false
-- 연출 중에는 결과가 공개되기 전 레벨을 계속 보여 준다 (복제된 데이터가 먼저 도착해도)
local revealLevel: number? = nil
local errorText: string? = nil
local errorToken = 0

--------------------------------------------------------------------------------
-- 만들기
--------------------------------------------------------------------------------

local function build()
	gui = ScreenManager.createScreen("ForgeMain", 5)

	panel = Components.panel(gui, { Name = "ForgePanel" })
	Components.closeButton(panel, function()
		SoundController.play("click")
		ScreenManager.setForgeOpen(false)
	end)

	-- 왼쪽 무대
	leftColumn = Components.frame(panel, { Name = "Left" })

	nameButton = Instance.new("TextButton")
	nameButton.Name = "WeaponName"
	nameButton.BackgroundTransparency = 1
	nameButton.AutoButtonColor = false
	nameButton.Font = Theme.font.display
	nameButton.TextSize = Theme.text.title
	nameButton.TextColor3 = C.text
	nameButton.TextXAlignment = Enum.TextXAlignment.Left
	nameButton.TextTruncate = Enum.TextTruncate.AtEnd
	nameButton.Size = UDim2.new(1, -96, 0, ForgeLayout.NAME_ROW)
	nameButton.Parent = leftColumn
	Components.stroke(nameButton, C.outline, Theme.strokeText, true)

	rarityTag = Components.label(leftColumn, {
		size = Theme.text.small,
		font = Theme.font.bodyBold,
		align = Enum.TextXAlignment.Center,
		height = 26,
	})
	rarityTag.AnchorPoint = Vector2.new(1, 0)
	rarityTag.Position = UDim2.new(1, 0, 0, 7)
	rarityTag.Size = UDim2.fromOffset(88, 26)
	rarityTag.BackgroundTransparency = 0
	Components.corner(rarityTag, 13)

	stage = Components.frame(panel, {
		Name = "Stage",
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.35,
	})
	Components.corner(stage, 12)

	-- 3D 검 미리보기가 들어갈 자리 (월드 쪽 SwordPreview 가 채운다)
	previewSlot = Components.frame(stage, { Name = "PreviewSlot" })

	tierLabel = Components.label(stage, {
		size = Theme.text.small,
		font = Theme.font.bodyBold,
		align = Enum.TextXAlignment.Center,
		color = C.muted,
	})
	tierLabel.AnchorPoint = Vector2.new(0.5, 1)

	levelLabel = Components.label(stage, {
		font = Theme.font.display,
		size = Theme.text.huge,
		align = Enum.TextXAlignment.Center,
		outline = true,
	})
	levelLabel.Name = "Level"
	levelLabel.AnchorPoint = Vector2.new(0.5, 1)
	levelLabel.TextTruncate = Enum.TextTruncate.None
	local levelStroke = levelLabel:FindFirstChildOfClass("UIStroke")
	if levelStroke then
		levelStroke.Thickness = 4
	end

	-- 오른쪽 조작부
	rightColumn = Components.frame(panel, { Name = "Right" })

	titleLabel = Components.label(rightColumn, {
		font = Theme.font.display,
		size = Theme.text.title,
		color = C.gold,
		outline = true,
	})
	infoLabel = Components.label(rightColumn, { size = Theme.text.small, color = C.muted })
	eventLabel = Components.label(rightColumn, {
		size = Theme.text.small,
		color = C.event,
		font = Theme.font.bodyBold,
		align = Enum.TextXAlignment.Right,
	})
	oddsLabel =
		Components.label(rightColumn, { size = Theme.text.label, font = Theme.font.bodyBold })
	oddsBar = Components.oddsBar(rightColumn, ROW.bar)

	protectButton = Components.button(rightColumn, { style = "secondary", size = Theme.text.body })
	tableButton = Components.button(rightColumn, { style = "secondary", size = Theme.text.body })
	local tableIcon = Components.frame(tableButton, {
		Size = UDim2.fromOffset(24, 24),
		Position = UDim2.new(0, 10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
	})
	Components.glyph(tableIcon, "table", C.gold)

	costLabel =
		Components.label(rightColumn, { size = Theme.text.body, font = Theme.font.bodyBold })

	bottomRow = Components.frame(rightColumn, { Name = "Bottom" })
	swordsTile = Components.tile(bottomRow, "sword", "", 60)
	recordsTile = Components.tile(bottomRow, "book", "", 60)
	shopTile = Components.tile(bottomRow, "bag", "", 60)
	enhanceButton = Components.button(bottomRow, { style = "primary", size = Theme.text.big })

	-- 첫 강화 안내 말풍선 (강화 버튼 위)
	tutorialBubble = Components.frame(panel, {
		Name = "Tutorial",
		BackgroundColor3 = C.gold,
		BackgroundTransparency = 0,
		Visible = false,
		ZIndex = 8,
	})
	Components.corner(tutorialBubble, 10)
	tutorialText = Components.label(tutorialBubble, {
		size = Theme.text.small,
		color = C.ink,
		font = Theme.font.bodyBold,
		align = Enum.TextXAlignment.Center,
		wrap = true,
	})
	tutorialText.Size = UDim2.new(1, -12, 1, 0)
	tutorialText.Position = UDim2.fromOffset(6, 0)
	tutorialText.ZIndex = 9
	local tail = Components.frame(tutorialBubble, {
		BackgroundColor3 = C.gold,
		BackgroundTransparency = 0,
		Size = UDim2.fromOffset(14, 14),
		Position = UDim2.new(0.5, 0, 1, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = 45,
		ZIndex = 8,
	})
	tail.Name = "Tail"

	-- 망치질 연출 중 아무 데나 누르면 건너뛴다
	skipCatcher = Instance.new("TextButton")
	skipCatcher.Name = "SkipCatcher"
	skipCatcher.Text = ""
	skipCatcher.BackgroundTransparency = 1
	skipCatcher.AutoButtonColor = false
	skipCatcher.Size = UDim2.fromScale(1, 1)
	skipCatcher.ZIndex = 30
	skipCatcher.Visible = false
	skipCatcher.Parent = panel
	skipCatcher.Activated:Connect(function()
		EffectsController.skip()
	end)

	-- 이름 짓기 창
	renamePanel = Components.panel(gui, { Name = "Rename", Visible = false, ZIndex = 40 })
	renamePanel.AnchorPoint = Vector2.new(0.5, 0.5)
	Components.padding(renamePanel, 16)
	Components.list(renamePanel, "vertical", 10)

	renameTitle =
		Components.label(renamePanel, { size = Theme.text.body, color = C.muted, order = 1 })

	renameBox = Instance.new("TextBox")
	renameBox.BackgroundColor3 = C.sub
	renameBox.BorderSizePixel = 0
	renameBox.Font = Theme.font.bodyBold
	renameBox.TextSize = Theme.text.label
	renameBox.TextColor3 = C.text
	renameBox.PlaceholderColor3 = C.muted
	renameBox.ClearTextOnFocus = false
	renameBox.Text = ""
	renameBox.Size = UDim2.new(1, 0, 0, Theme.touchHeight)
	renameBox.LayoutOrder = 2
	renameBox.Parent = renamePanel
	Components.corner(renameBox)

	local renameRow = Components.frame(
		renamePanel,
		{ Size = UDim2.new(1, 0, 0, Theme.touchHeight), LayoutOrder = 3 }
	)
	Components.list(renameRow, "horizontal", 8)
	renameCancel =
		Components.button(renameRow, { style = "secondary", width = UDim.new(0.5, -4), order = 1 })
	renameConfirm =
		Components.button(renameRow, { style = "primary", width = UDim.new(0.5, -4), order = 2 })
end

--------------------------------------------------------------------------------
-- 배치
--------------------------------------------------------------------------------

local function place()
	local layout = ScreenManager.getLayout()
	if layout == nil then
		return
	end

	local rect = layout.forgePanel
	ScreenManager.place(panel, rect)
	local inner = ForgeLayout.compute(rect)

	local function put(object: GuiObject, x: number, y: number, w: number, h: number)
		object.Position = UDim2.fromOffset(x, y)
		object.Size = UDim2.fromOffset(w, h)
	end

	put(leftColumn, inner.left.x, inner.left.y, inner.left.w, ForgeLayout.NAME_ROW)
	put(stage, inner.stage.x, inner.stage.y, inner.stage.w, inner.stage.h)

	local stageH = inner.stage.h
	levelLabel.Size = UDim2.new(1, 0, 0, math.min(110, stageH * 0.55))
	levelLabel.Position = UDim2.new(0.5, 0, 1, -24)
	tierLabel.Size = UDim2.new(1, 0, 0, 22)
	tierLabel.Position = UDim2.new(0.5, 0, 1, -4)
	previewSlot.Size = UDim2.new(1, 0, 1, 0)

	-- 오른쪽 줄 높이 계산: 고정 줄을 위에서부터 쌓고 남는 높이를 아래 줄(강화 버튼)에
	local right = inner.right
	put(rightColumn, right.x, right.y, right.w, right.h)

	local fixed = ROW.title + ROW.info + ROW.odds + ROW.bar + ROW.protect + ROW.cost + GAP * 6
	local bottomH = math.clamp(right.h - fixed, 64, 96)

	local y = 0
	titleLabel.Position = UDim2.fromOffset(0, y)
	titleLabel.Size = UDim2.new(1, -56, 0, ROW.title) -- 오른쪽 위 X 자리 비움
	y += ROW.title + GAP

	infoLabel.Position = UDim2.fromOffset(0, y)
	infoLabel.Size = UDim2.new(0.55, 0, 0, ROW.info)
	eventLabel.Position = UDim2.new(0.55, 0, 0, y)
	eventLabel.Size = UDim2.new(0.45, 0, 0, ROW.info)
	y += ROW.info + GAP

	oddsLabel.Position = UDim2.fromOffset(0, y)
	oddsLabel.Size = UDim2.new(1, 0, 0, ROW.odds)
	y += ROW.odds + GAP

	oddsBar.frame.Position = UDim2.fromOffset(0, y)
	oddsBar.frame.Size = UDim2.new(1, 0, 0, ROW.bar)
	y += ROW.bar + GAP

	local tableWidth = math.min(150, math.floor(right.w * 0.36))
	protectButton.Position = UDim2.fromOffset(0, y)
	protectButton.Size = UDim2.new(1, -(tableWidth + 8), 0, ROW.protect)
	tableButton.Position = UDim2.new(1, -tableWidth, 0, y)
	tableButton.Size = UDim2.fromOffset(tableWidth, ROW.protect)
	y += ROW.protect + GAP

	costLabel.Position = UDim2.fromOffset(0, y)
	costLabel.Size = UDim2.new(1, 0, 0, ROW.cost)

	-- 아래 줄: 오른쪽 맨 아래에 붙인다
	bottomRow.Position = UDim2.new(0, 0, 1, -bottomH)
	bottomRow.Size = UDim2.new(1, 0, 0, bottomH)
	local tileSize = math.min(bottomH, 72)
	for index, tile in { swordsTile, recordsTile, shopTile } do
		tile.Size = UDim2.fromOffset(tileSize, tileSize)
		tile.Position = UDim2.new(0, (index - 1) * (tileSize + 6), 1, -tileSize)
	end
	local enhanceLeft = 3 * (tileSize + 6)
	enhanceButton.Position = UDim2.fromOffset(enhanceLeft, 0)
	enhanceButton.Size = UDim2.new(1, -enhanceLeft, 1, 0)

	-- 안내 말풍선: 강화 버튼 바로 위
	local bubbleW = math.min(280, right.w - enhanceLeft)
	tutorialBubble.Size = UDim2.fromOffset(bubbleW, 44)
	tutorialBubble.Position = UDim2.fromOffset(
		right.x + enhanceLeft + (right.w - enhanceLeft - bubbleW) / 2,
		right.y + right.h - bottomH - 44 - 10
	)

	renamePanel.Position = UDim2.fromOffset(rect.x + rect.w / 2, rect.y + rect.h / 2)
	renamePanel.Size =
		UDim2.fromOffset(math.min(440, rect.w - 40), 16 * 2 + 28 + 10 + Theme.touchHeight * 2 + 10)
end

--------------------------------------------------------------------------------
-- 그리기
--------------------------------------------------------------------------------

local function weaponDisplayName(language: string, sword: any): string
	if sword == nil then
		return ""
	end
	if sword.customName and sword.customName ~= "" then
		return sword.customName
	end
	local info = Weapons.get(sword.id)
	return if info then Locale.get(language, info.nameKey) else sword.id
end

local function render()
	local language = ClientState.getLanguage()
	local data = ClientState.getData()
	local mode = ScreenManager.getMode()

	gui.Enabled = mode == "forge"

	titleLabel.Text = Locale.get(language, "ui.forgeTitle")
	tableButton.Text = "      " .. Locale.get(language, "ui.oddsTable")
	Components.setTileText(swordsTile, Locale.get(language, "ui.swords"))
	Components.setTileText(recordsTile, Locale.get(language, "ui.records"))
	Components.setTileText(shopTile, Locale.get(language, "ui.shop"))
	renameTitle.Text = Locale.get(language, "ui.renamePrompt")
	renameConfirm.Text = Locale.get(language, "ui.rename")
	renameCancel.Text = Locale.get(language, "ui.cancel")
	FeedController.setBannerCheck(HudController.isBannerVisible)

	if data == nil then
		enhanceButton.Text = Locale.get(language, "ui.loading")
		Components.setEnabled(enhanceButton, false)
		return
	end

	local sword = ClientState.getEquipped()
	local level = revealLevel or (if sword then sword.level else 0)
	local info = if sword then Weapons.get(sword.id) else nil

	nameButton.Text = weaponDisplayName(language, sword)
	if info then
		rarityTag.Text = Locale.get(language, `rarity.{info.rarity}`)
		rarityTag.BackgroundColor3 = Theme.rarityColor(info.rarity)
		rarityTag.TextColor3 = C.ink
		rarityTag.Visible = true
	else
		rarityTag.Visible = false
	end

	levelLabel.Text = Format.level(level)
	levelLabel.TextColor3 = Theme.heatColor(level)
	tierLabel.Text = Locale.get(language, Theme.heatTier(level).nameKey)
	tierLabel.TextColor3 = Theme.heatColor(level)

	-- 첫 강화 3번 안내
	local tries = data.stats.enhanceTries
	if tries < 3 then
		tutorialBubble.Visible = true
		tutorialText.Text = Locale.get(language, `tutorial.step{tries + 1}`)
	else
		tutorialBubble.Visible = false
	end

	-- 확률 (연출 중이면 공개 전 확률을 계속 보여 준다: setOdds 를 공개 때 부른다)
	local odds = ClientState.getOdds()
	local useProtect = ClientState.getUseProtect()
	local inSecondZone = level >= EnhanceTable.SAFE_LEVEL

	protectButton.Text = Locale.get(
		language,
		if inSecondZone then "ui.protectToggle" else "ui.protectIdle",
		Locale.get(language, if useProtect then "ui.on" else "ui.off"),
		data.protectTickets
	)
	Components.setStyle(protectButton, if useProtect then "primary" else "secondary")

	if odds == nil then
		oddsLabel.Text = ""
		costLabel.Text = ""
		eventLabel.Visible = false
		return
	end

	eventLabel.Visible = odds.eventName ~= nil
	if odds.eventName ~= nil then
		eventLabel.Text =
			Locale.get(language, "ui.eventActive", Locale.get(language, odds.eventName))
	end

	if odds.cost <= 0 then
		infoLabel.Text = Locale.get(language, "ui.zoneMax")
		oddsLabel.Text = Locale.get(language, "ui.maxLevel")
		oddsBar.set(1, 0, 0)
		costLabel.Text = ""
		enhanceButton.Text = Locale.get(language, "ui.maxShort")
		Components.setEnabled(enhanceButton, false)
		return
	end

	infoLabel.Text = Locale.get(language, if inSecondZone then "ui.zone2" else "ui.zone1")

	-- 방지권이 효과를 내는 동안에는 바뀐 확률(실패 0, 그만큼 유지)을 보여 준다.
	local shown: EnhanceLogic.Odds = odds
	if ClientState.isProtectActive() then
		shown = EnhanceLogic.applyProtect(odds)
	end

	oddsLabel.Text = Locale.get(
		language,
		"ui.odds",
		Format.percent(shown.success),
		Format.percent(shown.keep),
		Format.percent(shown.fail)
	)
	oddsBar.set(shown.success, shown.keep, shown.fail)

	local times = math.floor(data.gold / odds.cost)
	if errorText then
		costLabel.Text = errorText
		costLabel.TextColor3 = C.fail
	elseif times <= 0 then
		costLabel.Text = Locale.get(language, "ui.costShort", Format.comma(odds.cost))
		costLabel.TextColor3 = C.fail
	else
		costLabel.Text =
			Locale.get(language, "ui.costTimes", Format.comma(odds.cost), Format.comma(times))
		costLabel.TextColor3 = C.text
	end

	if busy then
		enhanceButton.Text = Locale.get(language, "ui.enhancing")
		Components.setEnabled(enhanceButton, false)
	else
		enhanceButton.Text = Locale.get(language, "ui.enhance")
		Components.setEnabled(enhanceButton, times > 0)
	end
end

local function showError(reason: string)
	errorText = Locale.get(ClientState.getLanguage(), `error.{reason}`)
	errorToken += 1
	local token = errorToken
	render()
	task.delay(3, function()
		if token == errorToken then
			errorText = nil
			render()
		end
	end)
end

--------------------------------------------------------------------------------
-- 요청
--------------------------------------------------------------------------------

local function requestEnhance()
	if busy then
		return
	end

	local odds = ClientState.getOdds()
	local sword = ClientState.getEquipped()
	if odds == nil or sword == nil or odds.cost <= 0 then
		return
	end

	local startLevel = sword.level
	busy = true
	revealLevel = startLevel
	errorText = nil
	render()

	local ok, response = pcall(function()
		return enhanceRemote:InvokeServer(ClientState.getUseProtect())
	end)

	if not ok or type(response) ~= "table" or response.ok ~= true then
		busy = false
		revealLevel = nil
		showError(if ok and type(response) == "table" then tostring(response.reason) else "unknown")
		return
	end

	-- 서버 응답을 받은 뒤에만 연출을 시작한다. 결과는 연출이 "공개"할 때 화면에 반영한다.
	local outcome = tostring(response.result)
	local newLevel = tonumber(response.newLevel) or startLevel
	local isMax = outcome == "success" and newLevel >= EnhanceTable.MAX_LEVEL
	local pendingOdds = response.odds

	skipCatcher.Visible = true
	EffectsController.playReveal(startLevel, outcome, newLevel, isMax, function()
		revealLevel = nil
		if type(pendingOdds) == "table" then
			ClientState.setOdds(pendingOdds)
		end
		FeedController.pushOutcome(outcome)
		if isMax then
			FeedController.pushOutcome("max")
		end
		render()
	end, function()
		skipCatcher.Visible = false
		busy = false
		render()
	end)
end

local function requestRename()
	local text = renameBox.Text
	renamePanel.Visible = false

	if text == "" then
		return
	end

	local ok, response = pcall(function()
		return renameRemote:InvokeServer(text)
	end)

	if not ok or type(response) ~= "table" then
		showError("unknown")
		return
	end
	if response.ok ~= true then
		showError(tostring(response.reason))
		return
	end

	-- 서버가 돌려준 "필터링을 통과한" 이름만 화면에 쓴다.
	FeedController.pushRaw(
		Locale.get(ClientState.getLanguage(), "ui.renamed", response.name),
		C.ember
	)
	render()
end

--------------------------------------------------------------------------------

function UIController.Init()
	build()

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	enhanceRemote = remotesFolder:WaitForChild(Remotes.Functions.Enhance) :: RemoteFunction
	renameRemote = remotesFolder:WaitForChild(Remotes.Functions.RenameWeapon) :: RemoteFunction

	local dataChanged = remotesFolder:WaitForChild(Remotes.Events.DataChanged) :: RemoteEvent
	dataChanged.OnClientEvent:Connect(function(data: any)
		if type(data) == "table" then
			ClientState.setData(data)
		end
	end)

	local liveOpsRemote = remotesFolder:WaitForChild(Remotes.Events.LiveOpsChanged) :: RemoteEvent
	liveOpsRemote.OnClientEvent:Connect(function(config: any)
		if type(config) == "table" then
			ClientState.setLiveOps(config)
		end
	end)

	ScreenManager.onLayout(place)
	ScreenManager.onStateChanged(render)
	ClientState.onChanged(render)

	enhanceButton.Activated:Connect(function()
		if enhanceButton.Active then
			task.spawn(requestEnhance)
		end
	end)

	protectButton.Activated:Connect(function()
		SoundController.play("click")
		ClientState.setUseProtect(not ClientState.getUseProtect())
	end)

	tableButton.Activated:Connect(function()
		SoundController.play("click")
		ScreenManager.openModal("odds")
	end)
	swordsTile.Activated:Connect(function()
		SoundController.play("click")
		ScreenManager.openModal("swords")
	end)
	recordsTile.Activated:Connect(function()
		SoundController.play("click")
		ScreenManager.openModal("records")
	end)
	shopTile.Activated:Connect(function()
		SoundController.play("click")
		ScreenManager.openModal("shop")
	end)

	nameButton.Activated:Connect(function()
		local sword = ClientState.getEquipped()
		renameBox.Text = if sword and sword.customName then sword.customName else ""
		renamePanel.Visible = true
	end)
	renameConfirm.Activated:Connect(function()
		task.spawn(requestRename)
	end)
	renameCancel.Activated:Connect(function()
		renamePanel.Visible = false
	end)

	EffectsController.bind(stage, levelLabel)
	render()
end

-- 3D 검 미리보기를 넣을 자리 (월드 쪽 컨트롤러가 쓴다)
function UIController.getPreviewSlot(): Frame
	return previewSlot
end

-- 지금 화면에 보이는 레벨 (강화 연출 중에는 공개 전 레벨). 미리보기 검 색을 맞추는 데 쓴다.
function UIController.getDisplayLevel(): number
	if revealLevel then
		return revealLevel
	end
	local sword = ClientState.getEquipped()
	return if sword then sword.level else 0
end

function UIController.Start()
	-- 접속 직후 현재 상태를 한 번 받아 온다 (프로필 로드가 아직 끝나지 않았을 수 있어 잠시 재시도).
	task.spawn(function()
		local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
		local stateRemote = remotesFolder:WaitForChild(Remotes.Functions.GetState) :: RemoteFunction

		for _ = 1, 30 do
			local ok, response = pcall(function()
				return stateRemote:InvokeServer()
			end)

			if ok and type(response) == "table" and response.ok == true then
				if type(response.liveOps) == "table" then
					ClientState.setLiveOps(response.liveOps)
				end
				ClientState.setData(response.data)
				ClientState.setOdds(response.odds)
				return
			end

			task.wait(1)
		end

		warn("[UIController] 상태를 받아 오지 못했습니다")
	end)
end

return UIController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">WorldFxController</string>
              <string name="Source"><![CDATA[--!strict
--[[
	WorldFxController — 불씨 광장과 쇳물 수로의 움직임·글자 (통합 기획서 8-2절, 시안 "움직임 목록").

	서버는 블록과 "상태 속성"만 만든다. 이 컨트롤러가 각 기기에서:
	  광장  모루 영감 망치질(2.4초) + 모루 불티 / 화덕 흔들림, 러닝머신 인원만큼 불이 커짐 / 횃불 흔들림 /
	        풀무 러닝머신: 벨트 흐름·풀무 펌프·관 속 불씨·지급 때 금화와 "+100" / 발판 위 안내판 /
	        쇳물 관문: 고리 12칸 숨쉬기·카운트다운·마지막 3초·출발 빛기둥, 전광판, 쇳물 폭포 /
	        표지판 글자 / 명예의 벽 / 최고 검 진열대 회전·명패 / 15강·20강 자랑 연출과 모루 영감 말풍선 /
	        "강화하기" 근접 버튼 / 내 캐릭터가 태어날 때 불티
	  코스  출발 화로 3·2·1 / 출발 쇠창살 내려감 / 쇳물 해일의 출렁이는 꼭대기·끓는 앞면·녹은 바닥
	  화면  대장간 화면의 3D 검 미리보기 (천천히 돈다)
	전부 보기만 하는 장식이다. 판정·보상과 관계없다. 카메라가 광장에서 멀면 광장 연출을 멈춘다.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local SwordModel = require(Shared:WaitForChild("SwordModel"))
local Format = require(Shared:WaitForChild("Pure"):WaitForChild("Format"))

local ConfigFolder = Shared:WaitForChild("Config")
local World = require(ConfigFolder:WaitForChild("World"))
local Palette = require(ConfigFolder:WaitForChild("Palette"))
local Weapons = require(ConfigFolder:WaitForChild("Weapons"))
local EconomyConfig = require(ConfigFolder:WaitForChild("EconomyConfig"))
local RaceConfig = require(ConfigFolder:WaitForChild("RaceConfig"))

local client = script.Parent.Parent
local ClientState = require(client:WaitForChild("ClientState"))
local ui = client:WaitForChild("ui")
local Theme = require(ui:WaitForChild("Theme"))
local ScreenManager = require(ui:WaitForChild("ScreenManager"))

local controllers = script.Parent
local UIController = require(controllers:WaitForChild("UIController"))

local WorldFxController = {}
WorldFxController.Name = "WorldFxController"

local A = World.ATTR
local LOBBY_RANGE = 220 -- 카메라가 광장 가운데에서 이보다 멀면 광장 연출을 멈춘다
local HAMMER_CYCLE = 2.4

local function rgb(values: { number }): Color3
	return Color3.fromRGB(values[1], values[2], values[3])
end

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

-- 연출용 부품을 담는 이 기기 전용 폴더
local fxFolder = Instance.new("Folder")
fxFolder.Name = "ForgeLocalFx"

local lobby: Instance? = nil
local textRefreshers: { () -> () } = {} -- 언어가 바뀌면 다시 그릴 글자들

--------------------------------------------------------------------------------
-- 공용
--------------------------------------------------------------------------------

local function surfaceText(
	part: BasePart,
	face: Enum.NormalId,
	pixelsPerStud: number
): (SurfaceGui, Frame)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "ForgeText"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud
	gui.LightInfluence = 0
	gui.Adornee = part
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromScale(1, 1)
	holder.Parent = gui
	return gui, holder
end

local function textLabel(
	parent: Instance,
	text: string,
	color: Color3,
	font: Enum.Font,
	size: UDim2,
	position: UDim2?
): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position or UDim2.new()
	label.Font = font
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Thickness = 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent = label
	label.Parent = parent
	return label
end

-- 세계 위에 떠올랐다 사라지는 글자 ("+100")
local function floatWorldText(at: BasePart, text: string, color: Color3)
	local billboard = Instance.new("BillboardGui")
	billboard.Adornee = at
	billboard.Size = UDim2.fromOffset(160, 50)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 80
	billboard.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local label = textLabel(billboard, text, color, Theme.font.display, UDim2.fromScale(1, 1))

	local tween = TweenService:Create(
		billboard,
		TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			StudsOffset = Vector3.new(0, 7, 0),
		}
	)
	TweenService:Create(label, TweenInfo.new(1.2), { TextTransparency = 1 }):Play()
	tween.Completed:Connect(function()
		billboard:Destroy()
	end)
	tween:Play()
end

-- 땅에서 솟았다 사라지는 빛기둥 (관문 출발, 로비 복귀)
local function lightPillar(center: Vector3, radius: number)
	local pillar = Instance.new("Part")
	pillar.Anchored = true
	pillar.CanCollide = false
	pillar.CanQuery = false
	pillar.CanTouch = false
	pillar.CastShadow = false
	pillar.Material = Enum.Material.Neon
	pillar.Color = rgb(Palette.WORLD.moltenHot)
	pillar.Shape = Enum.PartType.Cylinder
	pillar.Size = Vector3.new(0.2, radius * 2, radius * 2)
	pillar.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))
	pillar.Transparency = 0.3
	pillar.Parent = fxFolder

	local height = 30
	local up = TweenService:Create(
		pillar,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Size = Vector3.new(height, radius * 2, radius * 2),
			CFrame = CFrame.new(center + Vector3.new(0, height / 2, 0))
				* CFrame.Angles(0, 0, math.rad(90)),
		}
	)
	up.Completed:Connect(function()
		local fade = TweenService:Create(pillar, TweenInfo.new(0.4), { Transparency = 1 })
		fade.Completed:Connect(function()
			pillar:Destroy()
		end)
		fade:Play()
	end)
	up:Play()
end

-- 한 번 터지는 입자 (불티·연기). parent 파트에 붙였다가 잠시 뒤 지운다.
local function puff(parent: BasePart, color: Color3, count: number, speed: number, size: number)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.4
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new(size, 0)
	emitter.Parent = parent
	emitter:Emit(count)
	task.delay(1.5, function()
		emitter:Destroy()
	end)
end

-- 캐릭터에 주황 외곽선 (이 기기에서만 보인다)
local function outline(character: Model, name: string): Highlight
	local existing = character:FindFirstChild(name)
	if existing and existing:IsA("Highlight") then
		return existing
	end
	local highlight = Instance.new("Highlight")
	highlight.Name = name
	highlight.Adornee = character
	highlight.FillTransparency = 1
	highlight.OutlineColor = rgb(Palette.WORLD.ember)
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = character
	return highlight
end

local function lobbyNearby(): boolean
	local camera = Workspace.CurrentCamera
	return camera ~= nil and camera.Focus.Position.Magnitude < LOBBY_RANGE
end

--------------------------------------------------------------------------------
-- 모루 영감 · 화덕 · 횃불
--------------------------------------------------------------------------------

type Forge = {
	arm: Model?,
	armBase: CFrame?,
	anvilSparks: ParticleEmitter?,
	anvilGlow: PointLight?,
	furnaceLight: PointLight?,
	furnaceFire: Fire?,
	chimneyTop: BasePart?,
	head: BasePart?,
	bubble: BillboardGui?,
	bubbleText: TextLabel?,
	flareUntil: number,
	lastStrikeCycle: number,
}

local forge: Forge = { flareUntil = 0, lastStrikeCycle = -1 }
local torches: { { light: PointLight, base: number } } = {}

local function setupForge(lobbyFolder: Instance)
	local forgeFolder = lobbyFolder:FindFirstChild("Forge")
	if forgeFolder == nil then
		return
	end

	local npc = forgeFolder:FindFirstChild("AnvilElder")
	local arm = if npc then npc:FindFirstChild("HammerArm") else nil
	if arm and arm:IsA("Model") then
		forge.arm = arm
		forge.armBase = arm:GetPivot()
	end
	local head = if npc then npc:FindFirstChild("Head") else nil
	if head and head:IsA("BasePart") then
		forge.head = head
		local bubble = Instance.new("BillboardGui")
		bubble.Adornee = head
		bubble.Size = UDim2.fromOffset(260, 70)
		bubble.StudsOffset = Vector3.new(0, 3.2, 0)
		bubble.MaxDistance = 140
		bubble.Enabled = false
		bubble.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
		local frame = Instance.new("Frame")
		frame.BackgroundColor3 = Theme.color.text
		frame.Size = UDim2.fromScale(1, 1)
		frame.Parent = bubble
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 12)
		corner.Parent = frame
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, -16, 1, -8)
		label.Position = UDim2.fromOffset(8, 4)
		label.Font = Theme.font.bodyBold
		label.TextScaled = true
		label.TextWrapped = true
		label.TextColor3 = Theme.color.ink
		label.Parent = frame
		forge.bubble = bubble
		forge.bubbleText = label
	end

	local anvilTop = forgeFolder:FindFirstChild("AnvilTop")
	if anvilTop then
		local emitter = anvilTop:FindFirstChild("Sparks")
		forge.anvilSparks = if emitter and emitter:IsA("ParticleEmitter") then emitter else nil
		local glow = anvilTop:FindFirstChild("AnvilGlow")
		forge.anvilGlow = if glow and glow:IsA("PointLight") then glow else nil

		-- "강화하기" 근접 버튼: 글자를 내 언어로, 누르면 대장간 화면
		local prompt = anvilTop:FindFirstChild("ForgePrompt")
		if prompt and prompt:IsA("ProximityPrompt") then
			local function refreshPrompt()
				local language = ClientState.getLanguage()
				prompt.ActionText = Locale.get(language, "world.prompt.forge")
				prompt.ObjectText = Locale.get(language, "world.prompt.object")
				prompt.Enabled = ScreenManager.getMode() == "lobby"
			end
			refreshPrompt()
			table.insert(textRefreshers, refreshPrompt)
			ScreenManager.onStateChanged(refreshPrompt)
			prompt.Triggered:Connect(function()
				ScreenManager.setForgeOpen(true)
			end)
		end
	end

	local mouth = forgeFolder:FindFirstChild("FurnaceMouth")
	local furnaceLight = if mouth then mouth:FindFirstChild("FurnaceLight") else nil
	forge.furnaceLight = if furnaceLight and furnaceLight:IsA("PointLight")
		then furnaceLight
		else nil
	local flame = forgeFolder:FindFirstChild("FurnaceFlame")
	local furnaceFire = if flame then flame:FindFirstChild("FurnaceFire") else nil
	forge.furnaceFire = if furnaceFire and furnaceFire:IsA("Fire") then furnaceFire else nil
	local chimneyTop = forgeFolder:FindFirstChild("ChimneyTop")
	forge.chimneyTop = if chimneyTop and chimneyTop:IsA("BasePart") then chimneyTop else nil

	for _, descendant in lobbyFolder:GetDescendants() do
		if descendant:IsA("PointLight") and descendant.Name == "TorchLight" then
			table.insert(torches, { light = descendant, base = descendant.Brightness })
		end
	end
end

local function say(text: string, seconds: number)
	local bubble, label = forge.bubble, forge.bubbleText
	if bubble == nil or label == nil then
		return
	end
	label.Text = text
	bubble.Enabled = true
	local token = os.clock()
	bubble:SetAttribute("Token", token)
	task.delay(seconds, function()
		if bubble:GetAttribute("Token") == token then
			bubble.Enabled = false
		end
	end)
end

-- 망치질: 들어 올리고(0.6초) 빠르게 내려치고(0.12초) 쉰다
local function hammerAngle(t: number): number
	local rest, raised = 25, 110
	if t < 0.6 then
		local p = t / 0.6
		return rest + (raised - rest) * (1 - (1 - p) ^ 2)
	elseif t < 0.72 then
		local p = (t - 0.6) / 0.12
		return raised + (rest - raised) * p * p
	end
	return rest
end

local furnaceSize = 4
local lastFlicker = 0

local function stepForge(now: number, dt: number)
	local arm, base = forge.arm, forge.armBase
	if arm and base then
		local cycle = math.floor(now / HAMMER_CYCLE)
		local t = now - cycle * HAMMER_CYCLE
		arm:PivotTo(base * CFrame.Angles(math.rad(hammerAngle(t)), 0, 0))

		if t >= 0.72 and forge.lastStrikeCycle ~= cycle then
			forge.lastStrikeCycle = cycle
			if forge.anvilSparks then
				forge.anvilSparks:Emit(12)
			end
			local glow = forge.anvilGlow
			if glow then
				glow.Brightness = 2.5
				TweenService:Create(glow, TweenInfo.new(0.25), { Brightness = 0 }):Play()
			end
		end
	end

	-- 화덕: 러닝머신 위 인원만큼 커지고, 자랑 연출 중에는 크게 치솟는다
	local users = 0
	local lobbyFolder = lobby
	if lobbyFolder then
		users = tonumber(lobbyFolder:GetAttribute(A.treadmillUsers)) or 0
	end
	local target = 4 + math.min(4, users) * 1.5
	if now < forge.flareUntil then
		target *= 2
	end
	furnaceSize += (target - furnaceSize) * math.min(1, dt * 1.5)

	local fire = forge.furnaceFire
	if fire then
		fire.Size = furnaceSize
	end

	if now - lastFlicker > 0.12 then
		lastFlicker = now
		local light = forge.furnaceLight
		if light then
			light.Range = 16 + furnaceSize * 1.6
			light.Brightness = (1.8 + furnaceSize * 0.08) * (0.85 + math.random() * 0.3)
		end
		for _, torch in torches do
			torch.light.Brightness = torch.base * (0.8 + math.random() * 0.4)
		end
	end
end

-- 20강: 굴뚝에서 흰·금 불기둥 5초
local function chimneyPillar()
	local top = forge.chimneyTop
	if top == nil then
		return
	end
	local pillar = Instance.new("Part")
	pillar.Anchored = true
	pillar.CanCollide = false
	pillar.CanQuery = false
	pillar.CanTouch = false
	pillar.CastShadow = false
	pillar.Material = Enum.Material.Neon
	pillar.Color = Color3.fromRGB(255, 244, 200)
	pillar.Shape = Enum.PartType.Cylinder
	local height = 60
	local base = top.Position + Vector3.new(0, 0.5, 0)
	local function frameFor(h: number): CFrame
		return CFrame.new(base + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	end
	pillar.Size = Vector3.new(0.1, 3, 3)
	pillar.CFrame = frameFor(0.1)
	pillar.Parent = fxFolder

	local up = TweenService:Create(
		pillar,
		TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Size = Vector3.new(height, 3, 3),
			CFrame = frameFor(height),
		}
	)
	up:Play()
	task.delay(5.5, function()
		local fade = TweenService:Create(pillar, TweenInfo.new(1), { Transparency = 1 })
		fade.Completed:Connect(function()
			pillar:Destroy()
		end)
		fade:Play()
	end)
end

-- 서버 공지(15강 이상 성공)를 받으면 광장 연출
local function onBroadcast(payload: any)
	local level = tonumber(payload.level) or 0
	local language = ClientState.getLanguage()
	local name = tostring(payload.playerName)
	local weapon = Locale.get(language, tostring(payload.weaponKey))

	forge.flareUntil = os.clock() + 2.3
	if level >= 20 then
		say(Locale.get(language, "npc.shout.max", name, weapon), 4)
		chimneyPillar()
	else
		say(Locale.get(language, "npc.shout.high", name, weapon, level), 3)
	end
end

--------------------------------------------------------------------------------
-- 풀무 러닝머신
--------------------------------------------------------------------------------

type Treadmill = {
	index: number,
	pad: BasePart,
	stripes: { BasePart },
	stripeBase: { CFrame },
	bellows: { { part: BasePart, size: Vector3, cframe: CFrame, layer: number } },
	lamp: BasePart?,
	coins: ParticleEmitter?,
	lastPaid: number,
	phase: number,
	nextEmber: number,
}

local treadmills: { Treadmill } = {}
-- 내가 올라선 발판의 진행 (서버가 나에게만 보내는 TreadmillUpdate)
local myPadProgress = 0
local myOnPad = false

local function isMyPad(pad: BasePart): boolean
	if not myOnPad then
		return false
	end
	local character = Players.LocalPlayer.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	if root == nil or not root:IsA("BasePart") then
		return false
	end
	local offset = root.Position - pad.Position
	return math.abs(offset.X) <= pad.Size.X / 2 and math.abs(offset.Z) <= pad.Size.Z / 2
end
local beltLength = World.TREADMILL_PAD.sizeZ - 2

local function setupTreadmills(lobbyFolder: Instance)
	local folder = lobbyFolder:FindFirstChild(World.TREADMILL_FOLDER)
	if folder == nil then
		return
	end

	for _, model in folder:GetChildren() do
		if not model:IsA("Model") then
			continue
		end
		local pad = model:FindFirstChild("Pad")
		if pad == nil or not pad:IsA("BasePart") then
			continue
		end

		local entry: Treadmill = {
			index = tonumber(model:GetAttribute("PadIndex")) or 0,
			pad = pad,
			stripes = {},
			stripeBase = {},
			bellows = {},
			lamp = nil,
			coins = nil,
			lastPaid = tonumber(pad:GetAttribute(A.paidAt)) or 0,
			phase = 0,
			nextEmber = 0,
		}
		for _, child in model:GetChildren() do
			if child:IsA("BasePart") then
				if child.Name == "BeltStripe" then
					table.insert(entry.stripes, child)
				elseif child.Name == "BellowsLayer" then
					table.insert(entry.bellows, {
						part = child,
						size = child.Size,
						cframe = child.CFrame,
						layer = tonumber(child:GetAttribute("Layer")) or 1,
					})
				elseif child.Name == "Lamp" then
					entry.lamp = child
					local coins = child:FindFirstChild("Coins")
					entry.coins = if coins and coins:IsA("ParticleEmitter") then coins else nil
				end
			end
		end
		table.sort(entry.stripes, function(a, b)
			return (tonumber(a:GetAttribute("Index")) or 0)
				< (tonumber(b:GetAttribute("Index")) or 0)
		end)
		for index, stripe in entry.stripes do
			entry.stripeBase[index] = stripe.CFrame
		end

		-- 발판 위 안내판 (내 언어로)
		local tierId = pad:GetAttribute(World.TREADMILL_TIER_ATTRIBUTE)
		local tier = if type(tierId) == "string" then EconomyConfig.treadmillTier(tierId) else nil
		if tier then
			local billboard = Instance.new("BillboardGui")
			billboard.Adornee = pad
			billboard.Size = UDim2.fromOffset(220, 56)
			billboard.StudsOffset = Vector3.new(0, 8, 0)
			billboard.MaxDistance = 120
			billboard.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
			local frame = Instance.new("Frame")
			frame.BackgroundColor3 = Theme.color.bg
			frame.BackgroundTransparency = 0.25
			frame.Size = UDim2.fromScale(1, 1)
			frame.Parent = billboard
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 10)
			corner.Parent = frame
			local label = textLabel(
				frame,
				"",
				Theme.color.gold,
				Theme.font.bodyBold,
				UDim2.new(1, -12, 1, -8),
				UDim2.fromOffset(6, 4)
			)
			local function refresh()
				label.Text = Locale.get(
					ClientState.getLanguage(),
					"ui.treadmill.label",
					tier.intervalSeconds,
					Format.comma(tier.gold)
				)
			end
			refresh()
			table.insert(textRefreshers, refresh)
		end

		table.insert(treadmills, entry)
	end
end

-- 관을 따라 화덕으로 굴러가는 불씨 구슬
local function sendEmber(index: number)
	local path = World.pipePath(index)
	if #path < 2 then
		return
	end
	local y = World.PIPE.height + 0.4
	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(0.7, 0.7, 0.7)
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.CastShadow = false
	ball.Material = Enum.Material.Neon
	ball.Color = rgb(Palette.WORLD.moltenHot)
	ball.Position = Vector3.new(path[1][1], y, path[1][2])
	ball.Parent = fxFolder

	task.spawn(function()
		for step = 2, #path do
			local target = Vector3.new(path[step][1], y, path[step][2])
			local distance = (target - ball.Position).Magnitude
			local tween = TweenService:Create(
				ball,
				TweenInfo.new(distance / 16, Enum.EasingStyle.Linear),
				{ Position = target }
			)
			tween:Play()
			tween.Completed:Wait()
		end
		ball:Destroy()
	end)
end

local function stepTreadmills(now: number, dt: number)
	local server = serverNow()
	for _, entry in treadmills do
		local occupied = entry.pad:GetAttribute(A.occupied) == true

		if occupied then
			-- 벨트 줄무늬가 뒤로(-Z) 흐른다: 0.45초에 한 칸
			entry.phase = (entry.phase + dt / 0.45) % #entry.stripes
			local spacing = beltLength / math.max(1, #entry.stripes)
			for index, stripe in entry.stripes do
				local base = entry.stripeBase[index]
				local offset = -((entry.phase * spacing) % beltLength)
				local localZ = (base.Position.Z - entry.pad.Position.Z) + offset
				if localZ < -beltLength / 2 then
					localZ += beltLength
				end
				stripe.CFrame =
					CFrame.new(base.Position.X, base.Position.Y, entry.pad.Position.Z + localZ)
			end

			-- 풀무: 0.9초 주기로 접혔다 펴진다
			local squeeze = 0.55 + 0.45 * (0.5 + 0.5 * math.cos(now / 0.9 * math.pi * 2))
			for _, layer in entry.bellows do
				local height = layer.size.Y * squeeze
				local baseY = layer.cframe.Position.Y
					- layer.size.Y / 2
					- (layer.layer - 1) * layer.size.Y
				layer.part.Size = Vector3.new(layer.size.X, height, layer.size.Z)
				layer.part.CFrame = CFrame.new(
					layer.cframe.Position.X,
					baseY + (layer.layer - 0.5) * height,
					layer.cframe.Position.Z
				)
			end

			if now >= entry.nextEmber then
				entry.nextEmber = now + 1.6
				sendEmber(entry.index)
			end

			local lamp = entry.lamp
			if lamp then
				if isMyPad(entry.pad) then
					-- 내 발판: 20초에 걸쳐 점점 밝아진다
					lamp.Transparency = 0.65 - 0.6 * math.clamp(myPadProgress, 0, 1)
				else
					lamp.Transparency = 0.15 + 0.15 * math.sin(now * 4)
				end
			end
		else
			local lamp = entry.lamp
			if lamp then
				lamp.Transparency = 0.6
			end
		end

		-- 지급 순간: 계기판 번쩍 + 금화 + "+100" (주변 모두에게 보인다)
		local paidAt = tonumber(entry.pad:GetAttribute(A.paidAt)) or 0
		if paidAt > entry.lastPaid then
			entry.lastPaid = paidAt
			if server - paidAt < 3 then
				local lamp = entry.lamp
				if lamp then
					lamp.Transparency = 0
					if entry.coins then
						entry.coins:Emit(10)
					end
				end
				local tierId = entry.pad:GetAttribute(World.TREADMILL_TIER_ATTRIBUTE)
				local tier = if type(tierId) == "string"
					then EconomyConfig.treadmillTier(tierId)
					else nil
				floatWorldText(
					entry.pad,
					"+" .. Format.comma(if tier then tier.gold else 0),
					Theme.color.gold
				)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- 쇳물 관문
--------------------------------------------------------------------------------

type Gate = {
	model: Model,
	segments: { BasePart },
	segmentSizes: { Vector3 },
	runes: { BasePart },
	runeBases: { { size: Vector3, cframe: CFrame } },
	fountain: ParticleEmitter?,
	nextFountain: number,
	nextOutlineCheck: number,
	falls: { BasePart },
	boardLabel: TextLabel?,
	ringCenter: Vector3,
	lastLaunch: number,
}

local gate: Gate? = nil

local function setupGate(lobbyFolder: Instance)
	local model = lobbyFolder:FindFirstChild("Gate")
	if model == nil or not model:IsA("Model") then
		return
	end

	local entry: Gate = {
		model = model,
		segments = {},
		segmentSizes = {},
		runes = {},
		runeBases = {},
		fountain = nil,
		nextFountain = 0,
		nextOutlineCheck = 0,
		falls = {},
		boardLabel = nil,
		ringCenter = Vector3.new(World.GATE.ringX, 0.3, World.GATE.ringZ),
		lastLaunch = tonumber(model:GetAttribute(A.launchAt)) or 0,
	}
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") then
			if child.Name == "RingSegment" then
				table.insert(entry.segments, child)
			elseif child.Name == "Rune" then
				table.insert(entry.runes, child)
			elseif string.sub(child.Name, 1, 10) == "MoltenFall" then
				table.insert(entry.falls, child)
			elseif child.Name == "Board" then
				local _, holder = surfaceText(child, Enum.NormalId.Front, 30)
				local background = Instance.new("Frame")
				background.BackgroundColor3 = Theme.color.bg
				background.BackgroundTransparency = 0.1
				background.Size = UDim2.fromScale(1, 1)
				background.Parent = holder
				entry.boardLabel = textLabel(
					holder,
					"",
					Theme.color.gold,
					Theme.font.display,
					UDim2.new(1, -20, 1, -16),
					UDim2.fromOffset(10, 8)
				)
			end
		end
	end
	table.sort(entry.segments, function(a, b)
		return (tonumber(a:GetAttribute("Index")) or 0) < (tonumber(b:GetAttribute("Index")) or 0)
	end)
	for index, segment in entry.segments do
		entry.segmentSizes[index] = segment.Size
	end
	for index, rune in entry.runes do
		entry.runeBases[index] = { size = rune.Size, cframe = rune.CFrame }
	end

	-- 마지막 3초에 원 가장자리에서 솟는 불티 분수 (보이지 않는 받침에 붙인다)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(World.GATE.ringRadius * 2, 0.2, World.GATE.ringRadius * 2)
	holder.Position = entry.ringCenter
	holder.Parent = fxFolder
	local fountain = Instance.new("ParticleEmitter")
	fountain.Color = ColorSequence.new(rgb(Palette.WORLD.moltenHot))
	fountain.LightEmission = 1
	fountain.Rate = 0
	fountain.Lifetime = NumberRange.new(0.6, 1)
	fountain.Speed = NumberRange.new(10, 16)
	fountain.SpreadAngle = Vector2.new(15, 15)
	fountain.Acceleration = Vector3.new(0, -25, 0)
	fountain.Size = NumberSequence.new(0.3, 0)
	fountain.EmissionDirection = Enum.NormalId.Top
	fountain.Parent = holder
	entry.fountain = fountain

	gate = entry
end

-- 기둥 문양을 아래에서 fill(0~1) 만큼 채운다
local function fillRunes(entry: Gate, fill: number)
	for index, rune in entry.runes do
		local base = entry.runeBases[index]
		if base then
			local height = math.max(0.3, base.size.Y * fill)
			local bottom = base.cframe.Position.Y - base.size.Y / 2
			rune.Size = Vector3.new(base.size.X, height, base.size.Z)
			rune.CFrame =
				CFrame.new(base.cframe.Position.X, bottom + height / 2, base.cframe.Position.Z)
		end
	end
end

-- 대기 중일 때 원 안에 선 사람에게 주황 외곽선
local function updateRingOutlines(active: boolean)
	local spec = World.GATE
	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character == nil then
			continue
		end
		local root = character:FindFirstChild("HumanoidRootPart")
		local inside = false
		if active and root and root:IsA("BasePart") then
			local dx, dz = root.Position.X - spec.ringX, root.Position.Z - spec.ringZ
			inside = dx * dx + dz * dz <= spec.ringRadius * spec.ringRadius
				and root.Position.Y <= spec.ringReach
		end
		local existing = character:FindFirstChild("ForgeRingOutline")
		if inside and existing == nil then
			outline(character, "ForgeRingOutline")
		elseif not inside and existing then
			existing:Destroy()
		end
	end
end

local function stepGate(now: number)
	local entry = gate
	if entry == nil then
		return
	end
	local language = ClientState.getLanguage()
	local count = tonumber(entry.model:GetAttribute(A.queueCount)) or 0
	local departAt = tonumber(entry.model:GetAttribute(A.departAt)) or 0
	local remaining = math.max(0, departAt - serverNow())
	local window = RaceConfig.MATCH_WINDOW_SECONDS
	local molten = rgb(Palette.WORLD.molten)
	local hot = rgb(Palette.WORLD.moltenHot)

	if count > 0 and departAt > 0 then
		-- 대기 중: 남은 시간만큼 고리가 켜져 있고 한 칸씩 꺼진다
		local lit = math.ceil(remaining / window * #entry.segments)
		local finalSeconds = remaining <= RaceConfig.LINEUP_SECONDS
		for index, segment in entry.segments do
			local on = index <= lit
			segment.Transparency = if on then 0.05 else 0.85
			segment.Color = if finalSeconds then Color3.new(1, 0.92, 0.75) else hot
			-- 마지막 3초에는 고리가 조금 커진다
			local size = entry.segmentSizes[index]
			if size then
				segment.Size = if finalSeconds
					then Vector3.new(size.X * 1.12, size.Y, size.Z * 1.6)
					else size
			end
		end
		-- 기둥 문양이 아래에서 위로 차오른다 (출발에 가까울수록 높이)
		fillRunes(entry, 1 - remaining / window)
		for _, rune in entry.runes do
			rune.Transparency = if finalSeconds then 0 else 0.15
		end
		if finalSeconds and entry.fountain and now >= entry.nextFountain then
			entry.nextFountain = now + 0.08
			entry.fountain:Emit(4)
		end
		if entry.boardLabel then
			entry.boardLabel.Text = Locale.get(
				language,
				"world.board.queue",
				math.ceil(remaining),
				count,
				RaceConfig.MATCH_FULL_COUNT
			)
		end
	else
		-- 대기 없음: 천천히 숨 쉰다 (2.6초)
		local breathe = 0.5 + 0.5 * math.sin(now / 2.6 * math.pi * 2)
		for index, segment in entry.segments do
			segment.Transparency = 0.35 + 0.45 * breathe
			segment.Color = molten
			local size = entry.segmentSizes[index]
			if size then
				segment.Size = size
			end
		end
		fillRunes(entry, 1)
		for _, rune in entry.runes do
			rune.Transparency = 0.2 + 0.5 * breathe
		end
		if entry.boardLabel then
			entry.boardLabel.Text = Locale.get(language, "world.board.idle")
		end
	end

	-- 쇳물 폭포: 줄마다 다른 박자로 밝기가 바뀐다
	for index, fall in entry.falls do
		fall.Transparency = 0.1 + 0.35 * (0.5 + 0.5 * math.sin(now * (1.6 + index * 0.4) + index))
	end

	if now >= entry.nextOutlineCheck then
		entry.nextOutlineCheck = now + 0.2
		updateRingOutlines(count > 0)
	end

	local launchAt = tonumber(entry.model:GetAttribute(A.launchAt)) or 0
	if launchAt > entry.lastLaunch then
		entry.lastLaunch = launchAt
		if serverNow() - launchAt < 3 then
			lightPillar(entry.ringCenter, World.GATE.ringRadius)
		end
	end
end

--------------------------------------------------------------------------------
-- 표지판 · 명예의 벽 · 진열대
--------------------------------------------------------------------------------

local function setupSigns(lobbyFolder: Instance)
	for _, child in lobbyFolder:GetChildren() do
		if child:IsA("BasePart") and child:GetAttribute(A.signKey) then
			local key = tostring(child:GetAttribute(A.signKey))
			local _, holder = surfaceText(child, Enum.NormalId.Front, 30)
			local label = textLabel(
				holder,
				"",
				Theme.color.gold,
				Theme.font.display,
				UDim2.new(1, -16, 1, -12),
				UDim2.fromOffset(8, 6)
			)
			local function refresh()
				label.Text = Locale.get(ClientState.getLanguage(), key)
			end
			refresh()
			table.insert(textRefreshers, refresh)
		end
	end
end

local honorRows: { TextLabel } = {}
local honorTitle: TextLabel? = nil
local boardRemote: RemoteFunction? = nil

local function refreshHonor()
	local title = honorTitle
	local remote = boardRemote
	if title == nil or remote == nil then
		return
	end
	local language = ClientState.getLanguage()
	title.Text = Locale.get(language, "world.honor.title")

	local ok, entries = pcall(function()
		return remote:InvokeServer("level")
	end)
	local list = if ok and type(entries) == "table" then entries else {}

	for index, row in honorRows do
		local entry = list[index]
		if entry then
			row.Text = `{entry.rank}. {entry.name}   +{entry.value}`
			row.TextColor3 = Theme.heatColor(tonumber(entry.value) or 0)
		elseif index == 1 then
			row.Text = Locale.get(language, "world.honor.empty")
			row.TextColor3 = Theme.color.muted
		else
			row.Text = ""
		end
	end
end

local function setupHonor(lobbyFolder: Instance)
	local honor = lobbyFolder:FindFirstChild("Honor")
	local board = if honor then honor:FindFirstChild("HonorBoard") else nil
	if board == nil or not board:IsA("BasePart") then
		return
	end
	local _, holder = surfaceText(board, Enum.NormalId.Left, 24)
	honorTitle = textLabel(
		holder,
		"",
		Theme.color.gold,
		Theme.font.display,
		UDim2.new(1, -20, 0.14, 0),
		UDim2.new(0, 10, 0.02, 0)
	)
	for index = 1, 10 do
		local row = textLabel(
			holder,
			"",
			Theme.color.text,
			Theme.font.bodyBold,
			UDim2.new(1, -40, 0.07, 0),
			UDim2.new(0, 20, 0.18 + (index - 1) * 0.08, 0)
		)
		row.TextXAlignment = Enum.TextXAlignment.Left
		honorRows[index] = row
	end
	table.insert(textRefreshers, function()
		task.spawn(refreshHonor)
	end)

	task.spawn(function()
		while true do
			refreshHonor()
			task.wait(60)
		end
	end)
end

type Showcase = {
	base: BasePart,
	folder: Instance,
	plaque: TextLabel?,
	sword: Model?,
	pivot: CFrame?,
	lastLevel: number,
}
local showcase: Showcase? = nil

local function refreshShowcaseText()
	local entry = showcase
	if entry == nil or entry.plaque == nil then
		return
	end
	local language = ClientState.getLanguage()
	local owner = tostring(entry.base:GetAttribute(A.ownerName) or "")
	local swordId = tostring(entry.base:GetAttribute(A.swordId) or "")
	local level = tonumber(entry.base:GetAttribute(A.swordLevel)) or 0
	local info = Weapons.get(swordId)
	local plaque = entry.plaque :: TextLabel
	if owner == "" or info == nil then
		plaque.Text = Locale.get(language, "world.showcase.empty")
	else
		plaque.Text = Locale.get(language, "world.showcase.title")
			.. "\n"
			.. Locale.get(
				language,
				"world.showcase.line",
				owner,
				Locale.get(language, info.nameKey),
				level
			)
	end
	plaque.TextColor3 = Theme.heatColor(level)
end

local function setupShowcase(lobbyFolder: Instance)
	local folder = lobbyFolder:FindFirstChild("Showcase")
	local base = if folder then folder:FindFirstChild("ShowcaseBase") else nil
	local plaquePart = if folder then folder:FindFirstChild("ShowcasePlaque") else nil
	if folder == nil or base == nil or not base:IsA("BasePart") then
		return
	end

	local entry: Showcase = {
		base = base,
		folder = folder,
		plaque = nil,
		sword = nil,
		pivot = nil,
		lastLevel = tonumber(base:GetAttribute(A.swordLevel)) or 0,
	}
	if plaquePart and plaquePart:IsA("BasePart") then
		local _, holder = surfaceText(plaquePart, Enum.NormalId.Left, 40)
		local label = textLabel(
			holder,
			"",
			Theme.color.gold,
			Theme.font.bodyBold,
			UDim2.new(1, -8, 1, -6),
			UDim2.fromOffset(4, 3)
		)
		label.TextWrapped = true
		entry.plaque = label
	end
	showcase = entry

	local function track(child: Instance)
		if child:IsA("Model") and child.Name == "ShowcaseSword" then
			entry.sword = child
			entry.pivot = child:GetPivot()
		end
	end
	for _, child in folder:GetChildren() do
		track(child)
	end
	folder.ChildAdded:Connect(track)

	base:GetAttributeChangedSignal(A.swordLevel):Connect(function()
		local level = tonumber(base:GetAttribute(A.swordLevel)) or 0
		if level > entry.lastLevel and level > 0 then
			say(Locale.get(ClientState.getLanguage(), "npc.shout.record"), 3)
			local glass = folder:FindFirstChild("ShowcaseGlass")
			if glass and glass:IsA("BasePart") then
				local original = glass.Transparency
				glass.Transparency = 0.15
				TweenService:Create(glass, TweenInfo.new(0.8), { Transparency = original }):Play()
				puff(glass, rgb(Palette.WORLD.gold), 24, 10, 0.3)
			end
		end
		entry.lastLevel = level
		refreshShowcaseText()
	end)
	base:GetAttributeChangedSignal(A.ownerName):Connect(refreshShowcaseText)
	refreshShowcaseText()
	table.insert(textRefreshers, refreshShowcaseText)
end

local function stepShowcase(now: number)
	local entry = showcase
	if entry == nil then
		return
	end
	local sword, pivot = entry.sword, entry.pivot
	if sword and pivot and sword.Parent ~= nil then
		sword:PivotTo(
			pivot
				* CFrame.new(0, 0.3 * math.sin(now / 3 * math.pi * 2), 0)
				* CFrame.Angles(0, now / 8 * math.pi * 2, 0)
		)
	end
end

--------------------------------------------------------------------------------
-- 코스: 출발 화로 · 쇠창살 · 쇳물 해일 장식
--------------------------------------------------------------------------------

type Course = {
	id: number,
	folder: Instance?,
	chaser: BasePart?,
	crests: { BasePart },
	front: BasePart?,
	trail: BasePart?,
	goAt: number,
	started: boolean,
}

local course: Course? = nil

local function localPart(color: Color3, size: Vector3, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Size = size
	part.Shape = shape or Enum.PartType.Block
	part.Parent = fxFolder
	return part
end

local function clearCourse()
	local current = course
	if current == nil then
		return
	end
	for _, crest in current.crests do
		crest:Destroy()
	end
	if current.front then
		current.front:Destroy()
	end
	if current.trail then
		current.trail:Destroy()
	end
	course = nil
end

local function findCourseFolder(id: number): Instance?
	local races = Workspace:FindFirstChild(World.RACES_FOLDER)
	return if races then races:FindFirstChild(`{World.RACE_FOLDER_PREFIX}{id}`) else nil
end

local function onRaceUpdate(payload: any)
	if type(payload) ~= "table" then
		return
	end
	if payload.kind == "lineup" then
		clearCourse()
		local crests: { BasePart } = {}
		for _ = 1, 5 do
			table.insert(
				crests,
				localPart(rgb(Palette.WORLD.moltenHot), Vector3.new(9, 9, 9), Enum.PartType.Ball)
			)
		end
		course = {
			id = tonumber(payload.raceId) or 0,
			folder = nil,
			chaser = nil,
			crests = crests,
			front = localPart(Color3.fromRGB(255, 224, 112), Vector3.new(1, 1, 1)),
			trail = localPart(rgb(Palette.WORLD.molten), Vector3.new(1, 0.2, 1)),
			goAt = os.clock() + (tonumber(payload.countdown) or 0),
			started = false,
		}
	elseif payload.kind == "start" then
		local current = course
		if current and current.folder then
			current.started = true
			for _, child in current.folder:GetChildren() do
				if child:IsA("BasePart") and child.Name == "StartBar" then
					TweenService:Create(
						child,
						TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
						{
							CFrame = child.CFrame - Vector3.new(0, 9, 0),
						}
					):Play()
				end
			end
		end
	elseif payload.kind == "eliminated" then
		-- 잡힌 사람: 주황 외곽선과 함께 굳고 연기 한 번
		local player = Players:GetPlayerByUserId(tonumber(payload.userId) or 0)
		local character = if player then player.Character else nil
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
		if character and root and root:IsA("BasePart") then
			local highlight = outline(character, "ForgeCaughtOutline")
			puff(root, Color3.fromRGB(110, 100, 104), 18, 6, 1.2)
			task.delay(2.5, function()
				highlight:Destroy()
			end)
		end
	elseif payload.kind == "lobby" then
		clearCourse()
		-- 로비로 돌아올 때 빛기둥 속에서 나타난다
		task.delay(0.1, function()
			local character = Players.LocalPlayer.Character
			local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
			if root and root:IsA("BasePart") then
				lightPillar(root.Position - Vector3.new(0, 2.5, 0), 3)
			end
		end)
	end
end

local function stepCourse(now: number)
	local current = course
	if current == nil then
		return
	end

	if current.folder == nil or current.folder.Parent == nil then
		current.folder = findCourseFolder(current.id)
		local folder = current.folder
		if folder then
			local chaser = folder:FindFirstChild(World.CHASER_NAME)
			current.chaser = if chaser and chaser:IsA("BasePart") then chaser else nil
		end
	end
	local folder = current.folder
	if folder == nil then
		return
	end

	-- 출발 화로: 남은 3·2·1초에 하나씩 켜진다
	if not current.started then
		local left = current.goAt - now
		for index = 1, 3 do
			local bowl = folder:FindFirstChild(`StartBrazier{index}`)
			local flame = if bowl then bowl:FindFirstChild("CountFire") else nil
			if flame and flame:IsA("Fire") then
				local shouldBurn = left <= (4 - index)
				if flame.Enabled ~= shouldBurn then
					flame.Enabled = shouldBurn
				end
			end
		end
	end

	-- 쇳물 해일 장식: 출렁이는 꼭대기, 끓는 앞면, 지나간 자리의 녹은 바닥
	local chaser = current.chaser
	if chaser and chaser.Parent ~= nil then
		local size = chaser.Size
		local front = chaser.Position.Z + size.Z / 2
		local topY = chaser.Position.Y + size.Y / 2
		local floorY = chaser.Position.Y - size.Y / 2
		for index, crest in current.crests do
			local x = chaser.Position.X - size.X / 2 + (index - 0.5) * size.X / #current.crests
			local bob = math.sin(now * (2 * math.pi / (1.1 + index * 0.1)) + index) * 2
			crest.Position = Vector3.new(x, topY + bob, chaser.Position.Z)
		end
		local hot = current.front
		if hot then
			hot.Size = Vector3.new(size.X, size.Y, 1)
			hot.CFrame = CFrame.new(chaser.Position.X, chaser.Position.Y, front + 0.5)
			hot.Transparency = 0.25 + 0.2 * math.sin(now * 9)
		end
		local trail = current.trail
		if trail then
			local startZ = front - 200
			local length = math.max(1, front - startZ)
			trail.Size = Vector3.new(size.X - 4, 0.2, length)
			trail.CFrame = CFrame.new(chaser.Position.X, floorY + 0.15, startZ + length / 2)
		end
	end
end

--------------------------------------------------------------------------------
-- 대장간 화면의 3D 검 미리보기
--------------------------------------------------------------------------------

local previewFrame: ViewportFrame? = nil
local previewModel: Model? = nil
local previewSignature = ""
local previewLength = 4

local function setupPreview()
	local slot = UIController.getPreviewSlot()
	local frame = Instance.new("ViewportFrame")
	frame.Name = "SwordPreview"
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromScale(1, 0.82)
	frame.Ambient = Color3.fromRGB(150, 130, 130)
	frame.LightColor = Color3.fromRGB(255, 220, 190)
	frame.LightDirection = Vector3.new(-1, -1, -1)
	frame.Parent = slot

	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.Parent = frame
	frame.CurrentCamera = camera
	previewFrame = frame
end

local function refreshPreview()
	local frame = previewFrame
	if frame == nil then
		return
	end
	local sword = ClientState.getEquipped()
	if sword == nil then
		return
	end
	local level = UIController.getDisplayLevel()
	local signature = `{sword.id}:{level}`
	if signature == previewSignature then
		return
	end
	previewSignature = signature

	local old = previewModel
	if old then
		old:Destroy()
	end
	local model = SwordModel.build(
		sword.id,
		level,
		{ cframe = CFrame.new(), anchored = true, effects = false }
	)
	model.Parent = frame
	previewModel = model
	previewLength = SwordModel.length(sword.id)

	local camera = frame.CurrentCamera
	if camera then
		local center = Vector3.new(0, previewLength * 0.42, 0)
		camera.CFrame = CFrame.lookAt(center + Vector3.new(0, 0, previewLength * 2.1), center)
	end
end

local function stepPreview(now: number)
	local model = previewModel
	if model == nil or ScreenManager.getMode() ~= "forge" then
		return
	end
	-- 비스듬히 세워 천천히 돈다
	local center = CFrame.new(0, previewLength * 0.42, 0)
	model:PivotTo(
		center
			* CFrame.Angles(0, now * 0.8, math.rad(-28))
			* CFrame.new(0, -previewLength * 0.42, 0)
	)
end

--------------------------------------------------------------------------------
-- 내 캐릭터가 태어날 때 불티
--------------------------------------------------------------------------------

local function spawnSparkle(character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if root == nil or not root:IsA("BasePart") then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(rgb(Palette.WORLD.ember))
	emitter.LightEmission = 1
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.4, 0.6)
	emitter.Speed = NumberRange.new(8, 12)
	emitter.SpreadAngle = Vector2.new(180, 10)
	emitter.Size = NumberSequence.new(0.25, 0)
	emitter.EmissionDirection = Enum.NormalId.Bottom
	emitter.Parent = root
	emitter:Emit(30)
	task.delay(1.5, function()
		emitter:Destroy()
	end)
end

--------------------------------------------------------------------------------

local lastLanguage = ""

function WorldFxController.Init()
	fxFolder.Parent = Workspace
	setupPreview()

	local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FOLDER_NAME)
	boardRemote = remotesFolder:WaitForChild(Remotes.Functions.GetLeaderboard) :: RemoteFunction

	local worldEvent = remotesFolder:WaitForChild(Remotes.Events.WorldEvent) :: RemoteEvent
	worldEvent.OnClientEvent:Connect(function(payload: any)
		if type(payload) == "table" and payload.kind == "openForge" then
			ScreenManager.setForgeOpen(true)
		end
	end)

	local feedRemote = remotesFolder:WaitForChild(Remotes.Events.FeedMessage) :: RemoteEvent
	feedRemote.OnClientEvent:Connect(function(payload: any)
		if type(payload) == "table" and payload.kind == "broadcast" then
			onBroadcast(payload)
		end
	end)

	local raceRemote = remotesFolder:WaitForChild(Remotes.Events.RaceUpdate) :: RemoteEvent
	raceRemote.OnClientEvent:Connect(onRaceUpdate)

	local treadmillRemote =
		remotesFolder:WaitForChild(Remotes.Events.TreadmillUpdate) :: RemoteEvent
	treadmillRemote.OnClientEvent:Connect(function(payload: any)
		if type(payload) ~= "table" then
			return
		end
		myOnPad = payload.onPad == true
		local interval = tonumber(payload.interval) or 0
		myPadProgress = if interval > 0 then (tonumber(payload.progress) or 0) / interval else 0
	end)

	ClientState.onChanged(function()
		refreshPreview()
		local language = ClientState.getLanguage()
		if language ~= lastLanguage then
			lastLanguage = language
			for _, refresh in textRefreshers do
				pcall(refresh)
			end
		end
	end)

	local player = Players.LocalPlayer
	player.CharacterAdded:Connect(function(character)
		task.spawn(spawnSparkle, character)
	end)
end

function WorldFxController.Start()
	task.spawn(function()
		local found = Workspace:WaitForChild(World.LOBBY_FOLDER, 60)
		if found == nil then
			warn("[WorldFxController] 로비를 찾지 못했습니다")
			return
		end
		lobby = found
		-- 서버가 다 지은 뒤 복제되도록 잠깐 기다린다
		task.wait(1)
		setupForge(found)
		setupTreadmills(found)
		setupGate(found)
		setupSigns(found)
		setupHonor(found)
		setupShowcase(found)
	end)

	local last = os.clock()
	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		local dt = math.min(0.1, now - last)
		last = now

		local ok, err = pcall(function()
			if lobby and lobbyNearby() then
				stepForge(now, dt)
				stepTreadmills(now, dt)
				stepGate(now)
				stepShowcase(now)
			end
			stepCourse(now)
			stepPreview(now)
		end)
		if not ok then
			warn(`[WorldFxController] 연출 오류: {err}`)
		end
	end)

	-- 연출 중 바뀐 레벨을 미리보기에 반영 (공개 시점에 맞춰)
	task.spawn(function()
		while true do
			task.wait(0.25)
			refreshPreview()
		end
	end)
end

return WorldFxController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="70">
          <Properties>
            <string name="Name">ui</string>
          </Properties>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Components — 모든 화면이 쓰는 부품 (통합 기획서 8-1절 공통 규칙).

	- 닫기는 언제나 오른쪽 위 빨간 네모 X
	- 못 누르는 버튼은 회색 (setEnabled)
	- 모든 버튼은 누르면 살짝 작아졌다 돌아온다
	- 밝은 버튼의 글자는 흰색 + 검은 테두리 (결정 2)
	- 아이콘은 이미지 없이 도형으로 그린다 (결정 6). 이미지 ID 가 생기면 iconImage 자리에 넣는다.

	크기는 전부 "디자인 칸"이다. ScreenGui 의 UIScale 이 실제 화면에 맞춰 곱한다.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent:WaitForChild("Theme"))

local Components = {}

export type ButtonStyle = "primary" | "secondary" | "danger" | "ghost"

local C = Theme.color

--------------------------------------------------------------------------------
-- 기본 장식
--------------------------------------------------------------------------------

function Components.corner(parent: Instance, radius: number?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or Theme.radius)
	corner.Parent = parent
	return corner
end

function Components.round(parent: Instance)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = parent
	return corner
end

function Components.padding(parent: Instance, all: number, horizontal: number?)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, all)
	pad.PaddingBottom = UDim.new(0, all)
	pad.PaddingLeft = UDim.new(0, horizontal or all)
	pad.PaddingRight = UDim.new(0, horizontal or all)
	pad.Parent = parent
	return pad
end

-- 테두리 선 (Border) 또는 글자 테두리 (Contextual)
function Components.stroke(parent: Instance, color: Color3, thickness: number, onText: boolean?)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness
	stroke.ApplyStrokeMode = if onText
		then Enum.ApplyStrokeMode.Contextual
		else Enum.ApplyStrokeMode.Border
	stroke.Parent = parent
	return stroke
end

function Components.list(
	parent: Instance,
	direction: "vertical" | "horizontal",
	gap: number,
	align: Enum.HorizontalAlignment?
): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = if direction == "vertical"
		then Enum.FillDirection.Vertical
		else Enum.FillDirection.Horizontal
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, gap)
	if align then
		layout.HorizontalAlignment = align
	end
	if direction == "horizontal" then
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
	end
	layout.Parent = parent
	return layout
end

-- 위는 밝고 아래로 갈수록 어두운 입체감 (버튼·칩)
function Components.bevel(parent: Instance, strength: number?)
	local gradient = Instance.new("UIGradient")
	local bottom = 1 - (strength or 0.25)
	gradient.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(bottom, bottom, bottom))
	gradient.Rotation = 90
	gradient.Parent = parent
	return gradient
end

--------------------------------------------------------------------------------
-- 틀
--------------------------------------------------------------------------------

function Components.frame(parent: Instance, props: { [string]: any }?): Frame
	local frame = Instance.new("Frame")
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Size = UDim2.fromScale(1, 1)
	if props then
		for key, value in props do
			(frame :: any)[key] = value
		end
	end
	frame.Parent = parent
	return frame
end

-- 창 바탕: 어두운 쇳빛 + 얇은 테두리
function Components.panel(parent: Instance, props: { [string]: any }?): Frame
	local frame = Components.frame(parent, props)
	frame.BackgroundColor3 = C.panel
	frame.BackgroundTransparency = 0.04
	Components.corner(frame, Theme.radiusLarge)
	Components.stroke(frame, C.line, 1.5)
	return frame
end

--------------------------------------------------------------------------------
-- 글자
--------------------------------------------------------------------------------

export type LabelOptions = {
	text: string?,
	size: number?, -- Theme.text 의 값
	color: Color3?,
	font: Enum.Font?,
	outline: boolean?, -- 굵은 검은 테두리 (밝은 큰 글씨용)
	align: Enum.TextXAlignment?,
	wrap: boolean?,
	order: number?,
	height: number?,
}

function Components.label(parent: Instance, options: LabelOptions?): TextLabel
	local o = options or {}
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Font = o.font or Theme.font.body
	label.TextSize = o.size or Theme.text.body
	label.TextColor3 = o.color or C.text
	label.Text = o.text or ""
	label.TextXAlignment = o.align or Enum.TextXAlignment.Left
	label.TextWrapped = o.wrap == true
	label.TextTruncate = if o.wrap then Enum.TextTruncate.None else Enum.TextTruncate.AtEnd
	label.Size = UDim2.new(1, 0, 0, o.height or math.ceil((o.size or Theme.text.body) * 1.35))
	label.LayoutOrder = o.order or 0
	if o.outline then
		Components.stroke(label, C.outline, Theme.strokeText, true)
	end
	label.Parent = parent
	return label
end

--------------------------------------------------------------------------------
-- 버튼
--------------------------------------------------------------------------------

local STYLE_COLORS: { [string]: { bg: Color3, text: Color3, outline: boolean } } = {
	primary = { bg = C.ember, text = C.white, outline = true },
	secondary = { bg = C.sub, text = C.text, outline = false },
	danger = { bg = C.danger, text = C.white, outline = true },
	ghost = { bg = C.panel, text = C.muted, outline = false },
}

-- 누르면 살짝 작아졌다 돌아온다
local function attachPress(button: GuiButton)
	local scale = Instance.new("UIScale")
	scale.Parent = button

	button.MouseButton1Down:Connect(function()
		if button.Active then
			TweenService:Create(scale, Theme.motion.press, { Scale = 0.94 }):Play()
		end
	end)
	local function release()
		TweenService:Create(scale, Theme.motion.release, { Scale = 1 }):Play()
	end
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)
end

export type ButtonOptions = {
	text: string?,
	style: ButtonStyle?,
	size: number?,
	order: number?,
	height: number?,
	width: UDim?, -- 기본은 부모 너비 전체
}

function Components.button(parent: Instance, options: ButtonOptions?): TextButton
	local o = options or {}
	local style = o.style or "secondary"
	local colors = STYLE_COLORS[style]

	local button = Instance.new("TextButton")
	button.AutoButtonColor = false
	button.BorderSizePixel = 0
	button.BackgroundColor3 = colors.bg
	button.Font = Theme.font.display
	button.TextSize = o.size or Theme.text.label
	button.TextColor3 = colors.text
	button.Text = o.text or ""
	button.TextWrapped = true
	button.Size = UDim2.new(o.width or UDim.new(1, 0), UDim.new(0, o.height or Theme.touchHeight))
	button.LayoutOrder = o.order or 0
	button:SetAttribute("Style", style)

	Components.corner(button)
	Components.bevel(button)
	Components.stroke(button, Theme.shade(colors.bg, -0.5), 2)
	if colors.outline then
		Components.stroke(button, C.outline, Theme.strokeText, true)
	end
	attachPress(button)

	button.Parent = parent
	return button
end

-- 버튼을 누를 수 있게/없게 (못 누르면 회색, 관례)
function Components.setEnabled(button: TextButton, enabled: boolean)
	local style = button:GetAttribute("Style")
	local colors = STYLE_COLORS[if type(style) == "string" then style else "secondary"]
		or STYLE_COLORS.secondary

	button.Active = enabled
	button.AutoButtonColor = false
	button.BackgroundColor3 = if enabled then colors.bg else C.disabled
	button.TextColor3 = if enabled then colors.text else C.muted
end

-- 버튼 스타일 바꾸기 (토글 켜짐/꺼짐 등)
function Components.setStyle(button: TextButton, style: ButtonStyle)
	button:SetAttribute("Style", style)
	Components.setEnabled(button, button.Active)
end

-- 오른쪽 위 빨간 네모 X (모든 창의 닫기, 관례)
function Components.closeButton(parent: Instance, onClose: () -> ()): TextButton
	local button = Components.button(
		parent,
		{ text = "X", style = "danger", size = Theme.text.title, height = 44 }
	)
	button.Size = UDim2.fromOffset(44, 44)
	button.AnchorPoint = Vector2.new(1, 0)
	button.Position = UDim2.new(1, -Theme.space.sm, 0, Theme.space.sm)
	button.ZIndex = 5
	button.Activated:Connect(onClose)
	return button
end

--------------------------------------------------------------------------------
-- 도형 아이콘 (이미지 없이)
--------------------------------------------------------------------------------

local function block(
	parent: Instance,
	color: Color3,
	x: number,
	y: number,
	w: number,
	h: number,
	rotation: number?
): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(x, y)
	f.Size = UDim2.fromScale(w, h)
	f.Rotation = rotation or 0
	f.Parent = parent
	return f
end

export type Glyph =
	"coin"
	| "shard"
	| "ticket"
	| "anvil"
	| "sword"
	| "book"
	| "bag"
	| "flag"
	| "table"

--[[
	도형으로 그린 작은 아이콘. 정사각형 틀 안에 그린다.
	coin=골드(동그라미), shard=파편(마름모), ticket=방지권(방패 모양), anvil=대장간, sword=검,
	book=도감, bag=상점, flag=경주, table=확률표
]]
function Components.glyph(parent: Instance, kind: Glyph, color: Color3?): Frame
	local holder = Instance.new("Frame")
	holder.Name = "Glyph"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromScale(1, 1)
	local ratio = Instance.new("UIAspectRatioConstraint")
	ratio.AspectRatio = 1
	ratio.Parent = holder
	holder.Parent = parent

	local main = color or C.text
	local dark = Theme.shade(main, -0.45)

	if kind == "coin" then
		local outer = block(holder, main, 0.5, 0.5, 0.8, 0.8)
		Components.round(outer)
		Components.stroke(outer, dark, 2)
		local inner = block(holder, Theme.shade(main, 0.25), 0.5, 0.5, 0.42, 0.42)
		Components.round(inner)
	elseif kind == "shard" then
		local gem = block(holder, main, 0.5, 0.5, 0.56, 0.56, 45)
		Components.stroke(gem, dark, 2)
		block(holder, Theme.shade(main, 0.35), 0.42, 0.42, 0.14, 0.14, 45)
	elseif kind == "ticket" then
		local top = block(holder, main, 0.5, 0.4, 0.66, 0.5)
		Components.corner(top, 4)
		local tip = block(holder, main, 0.5, 0.64, 0.46, 0.46, 45)
		tip.ZIndex = top.ZIndex
		block(holder, Theme.shade(main, 0.35), 0.5, 0.42, 0.1, 0.36)
	elseif kind == "anvil" then
		block(holder, main, 0.5, 0.36, 0.86, 0.18)
		block(holder, main, 0.5, 0.56, 0.3, 0.26)
		block(holder, main, 0.5, 0.78, 0.66, 0.16)
		block(holder, main, 0.12, 0.4, 0.14, 0.1)
	elseif kind == "sword" then
		block(holder, main, 0.5, 0.36, 0.13, 0.62)
		block(holder, Theme.shade(main, 0.3), 0.5, 0.36, 0.04, 0.56)
		block(holder, main, 0.5, 0.7, 0.5, 0.09)
		block(holder, dark, 0.5, 0.84, 0.1, 0.2)
	elseif kind == "book" then
		local left = block(holder, main, 0.3, 0.52, 0.36, 0.66)
		Components.corner(left, 3)
		local right = block(holder, Theme.shade(main, -0.15), 0.7, 0.52, 0.36, 0.66)
		Components.corner(right, 3)
		block(holder, dark, 0.5, 0.52, 0.05, 0.68)
	elseif kind == "bag" then
		local body = block(holder, main, 0.5, 0.6, 0.72, 0.6)
		Components.corner(body, 6)
		local handle = block(holder, Color3.new(0, 0, 0), 0.5, 0.26, 0.36, 0.24)
		handle.BackgroundTransparency = 1
		Components.corner(handle, 8)
		Components.stroke(handle, main, 3)
		block(holder, Theme.shade(main, 0.3), 0.5, 0.6, 0.18, 0.18, 45)
	elseif kind == "flag" then
		block(holder, dark, 0.28, 0.52, 0.07, 0.8)
		block(holder, main, 0.56, 0.3, 0.5, 0.32)
	elseif kind == "table" then
		local sheet = block(holder, main, 0.5, 0.5, 0.74, 0.74)
		Components.corner(sheet, 4)
		for row = 1, 3 do
			block(holder, dark, 0.5, 0.22 + row * 0.16, 0.56, 0.05)
		end
	end

	return holder
end

--[[
	메뉴 타일: 정사각형 버튼 안에 도형 아이콘 + 짧은 이름. 로비 왼쪽 메뉴와 대장간 아래 줄에 쓴다.
	size 는 한 변(디자인 칸). 글자는 가장 작은 단계(17)라 60칸 타일에 들어간다.
]]
function Components.tile(
	parent: Instance,
	glyph: Glyph,
	text: string,
	size: number,
	order: number?
): TextButton
	local button = Components.button(parent, { style = "secondary", order = order, height = size })
	button.Size = UDim2.fromOffset(size, size)
	button.Text = ""

	local icon = Components.frame(button, {
		Size = UDim2.new(0.56, 0, 0.56, 0),
		Position = UDim2.new(0.5, 0, 0, 3),
		AnchorPoint = Vector2.new(0.5, 0),
	})
	Components.glyph(icon, glyph, C.gold)
	Components.iconImage(icon, nil)

	local caption = Components.label(button, {
		text = text,
		size = Theme.text.small,
		font = Theme.font.bodyBold,
		align = Enum.TextXAlignment.Center,
	})
	caption.Name = "Caption"
	caption.AnchorPoint = Vector2.new(0, 1)
	caption.Position = UDim2.new(0, 0, 1, -2)
	caption.Size = UDim2.new(1, 0, 0, 20)

	return button
end

-- 타일 이름 바꾸기 (언어 변경)
function Components.setTileText(button: TextButton, text: string)
	local caption = button:FindFirstChild("Caption")
	if caption and caption:IsA("TextLabel") then
		caption.Text = text
	end
end

-- 나중에 이미지 아이콘을 넣을 자리. assetId 가 비어 있으면 숨겨지고 도형 아이콘이 보인다.
function Components.iconImage(parent: Instance, assetId: string?): ImageLabel
	local image = Instance.new("ImageLabel")
	image.Name = "IconImage"
	image.BackgroundTransparency = 1
	image.Size = UDim2.fromScale(1, 1)
	image.Image = assetId or ""
	image.Visible = assetId ~= nil and assetId ~= ""
	image.ZIndex = 3
	image.Parent = parent
	return image
end

--------------------------------------------------------------------------------
-- 재화 칩 · 진행 막대 · 확률 막대 · 탭
--------------------------------------------------------------------------------

export type Chip = { frame: Frame, value: TextLabel }

-- 재화 칩: 도형 아이콘 + 숫자 (색·모양 고정)
function Components.chip(parent: Instance, glyph: Glyph, color: Color3): Chip
	local frame = Components.frame(parent, {
		BackgroundTransparency = 0.15,
		BackgroundColor3 = C.bg,
	})
	Components.corner(frame, 18)
	Components.stroke(frame, Theme.shade(color, -0.35), 2)

	local icon = Components.frame(frame, {
		Size = UDim2.new(0, 28, 0, 28),
		Position = UDim2.new(0, 4, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
	})
	Components.glyph(icon, glyph, color)

	local value = Components.label(frame, {
		font = Theme.font.display,
		size = Theme.text.label,
		color = Theme.color.white,
		outline = true,
	})
	value.Position = UDim2.fromOffset(38, 0)
	value.Size = UDim2.new(1, -44, 1, 0)

	return { frame = frame, value = value }
end

export type ProgressBar = { frame: Frame, fill: Frame, set: (ratio: number) -> () }

function Components.progressBar(parent: Instance, color: Color3, height: number?): ProgressBar
	local frame = Components.frame(parent, {
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.1,
		Size = UDim2.new(1, 0, 0, height or 14),
	})
	Components.round(frame)
	Components.stroke(frame, C.line, 1.5)

	local fill = Components.frame(frame, {
		BackgroundColor3 = color,
		BackgroundTransparency = 0,
		Size = UDim2.fromScale(0, 1),
	})
	Components.round(fill)
	Components.bevel(fill, 0.3)

	local function set(ratio: number)
		fill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
	end

	return { frame = frame, fill = fill, set = set }
end

export type OddsBar = {
	frame: Frame,
	set: (success: number, keep: number, fail: number) -> (),
}

--[[
	강화 확률 막대: 성공(주황) · 유지(회색) · 실패(빨강) 세 칸이 비율대로 한 줄.
	방지권을 켜면 실패 칸이 줄어 사라지고 유지 칸이 늘어나는 게 움직임으로 보인다.
]]
function Components.oddsBar(parent: Instance, height: number?): OddsBar
	local frame = Components.frame(parent, {
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0,
		Size = UDim2.new(1, 0, 0, height or 22),
		ClipsDescendants = true,
	})
	Components.round(frame)
	Components.stroke(frame, C.line, 1.5)

	local inner = Components.frame(frame)
	local listLayout = Components.list(inner, "horizontal", 0)
	listLayout.VerticalAlignment = Enum.VerticalAlignment.Center

	local function segment(color: Color3, order: number): Frame
		local seg = Components.frame(inner, {
			BackgroundColor3 = color,
			BackgroundTransparency = 0,
			Size = UDim2.fromScale(0, 1),
			LayoutOrder = order,
		})
		Components.bevel(seg, 0.3)
		return seg
	end

	local success = segment(C.success, 1)
	local keep = segment(C.keep, 2)
	local fail = segment(C.fail, 3)

	local function set(s: number, k: number, f: number)
		local total = math.max(1e-6, s + k + f)
		TweenService:Create(success, Theme.motion.fade, { Size = UDim2.fromScale(s / total, 1) })
			:Play()
		TweenService:Create(keep, Theme.motion.fade, { Size = UDim2.fromScale(k / total, 1) })
			:Play()
		TweenService:Create(fail, Theme.motion.fade, { Size = UDim2.fromScale(f / total, 1) })
			:Play()
	end

	return { frame = frame, set = set }
end

export type Tabs = {
	frame: Frame,
	buttons: { [string]: TextButton },
	select: (key: string) -> (),
}

function Components.tabs(parent: Instance, keys: { string }, onSelect: (key: string) -> ()): Tabs
	local frame = Components.frame(parent, { Size = UDim2.new(1, 0, 0, Theme.rowHeight) })
	Components.list(frame, "horizontal", Theme.space.sm)

	local buttons: { [string]: TextButton } = {}
	local function selectTab(key: string)
		for name, button in buttons do
			Components.setStyle(button, if name == key then "primary" else "ghost")
		end
	end

	for index, key in keys do
		local button = Components.button(frame, {
			style = "ghost",
			order = index,
			height = Theme.rowHeight,
			width = UDim.new(1 / #keys, -Theme.space.sm),
		})
		button.Activated:Connect(function()
			selectTab(key)
			onSelect(key)
		end)
		buttons[key] = button
	end

	return { frame = frame, buttons = buttons, select = selectTab }
end

-- 스크롤 목록
function Components.scroller(parent: Instance, gap: number?): ScrollingFrame
	local scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.ScrollBarThickness = 6
	scroll.ScrollBarImageColor3 = C.line
	scroll.Parent = parent
	Components.list(scroll, "vertical", gap or Theme.space.sm)
	return scroll
end

-- 목록 안의 자식(레이아웃 제외)을 지운다
function Components.clear(parent: Instance)
	for _, child in parent:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

--[[
	떠오르며 사라지는 글자 ("+100" 등). parent 안 (x, y) 에서 시작한다.
]]
function Components.floatText(
	parent: Instance,
	text: string,
	color: Color3,
	position: UDim2,
	size: number?
)
	local label = Components.label(parent, {
		text = text,
		font = Theme.font.display,
		size = size or Theme.text.title,
		color = color,
		outline = true,
		align = Enum.TextXAlignment.Center,
	})
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = position
	label.Size = UDim2.fromOffset(200, 40)
	label.ZIndex = 20

	local tween = TweenService:Create(
		label,
		TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = position - UDim2.fromOffset(0, 46), TextTransparency = 1 }
	)
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		TweenService:Create(stroke, TweenInfo.new(1.2), { Transparency = 1 }):Play()
	end
	tween.Completed:Connect(function()
		label:Destroy()
	end)
	tween:Play()
end

return Components
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">ForgeLayout</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ForgeLayout — 대장간 화면 안쪽 배치 (디자인 칸).

	대장간 패널(UILayout 의 forgePanel) 하나를 왼쪽 무대(검 미리보기·레벨·피드)와
	오른쪽 조작부(확률·방지권·비용·강화 버튼)로 나눈다. 피드는 다른 ScreenGui(FeedController)가
	그리므로 화면 전체 기준 위치(feedAbsolute)도 같이 돌려준다.
]]

local ForgeLayout = {}

export type Rect = { x: number, y: number, w: number, h: number }

export type Result = {
	padding: number,
	left: Rect, -- 패널 안 좌표
	stage: Rect, -- 검 미리보기 + 레벨 (패널 안 좌표)
	feed: Rect, -- 패널 안 좌표
	feedAbsolute: Rect, -- 화면 전체 좌표
	right: Rect, -- 패널 안 좌표
}

ForgeLayout.NAME_ROW = 40

function ForgeLayout.compute(panel: Rect): Result
	local pad = 16
	local leftWidth = math.floor(panel.w * 0.38)
	local innerHeight = panel.h - 2 * pad

	local left = { x = pad, y = pad, w = leftWidth - pad, h = innerHeight }
	local feedHeight = math.clamp(math.floor(panel.h * 0.3), 84, 150)
	local feed = { x = pad, y = panel.h - pad - feedHeight, w = left.w, h = feedHeight }
	local stageTop = left.y + ForgeLayout.NAME_ROW + 6
	local stage = { x = pad, y = stageTop, w = left.w, h = math.max(60, feed.y - 8 - stageTop) }
	local right =
		{ x = leftWidth + pad, y = pad, w = panel.w - leftWidth - 2 * pad, h = innerHeight }

	return {
		padding = pad,
		left = left,
		stage = stage,
		feed = feed,
		feedAbsolute = { x = panel.x + feed.x, y = panel.y + feed.y, w = feed.w, h = feed.h },
		right = right,
	}
end

return ForgeLayout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">ScreenManager</string>
              <string name="Source"><![CDATA[--!strict
--[[
	ScreenManager — 화면 상태와 배치를 한 곳에서 정한다 (통합 기획서 8-1절).

	화면 상태 (mode)
	  lobby   로비를 돌아다닌다. 가장자리 HUD 만. 이동 컨트롤 보임
	  forge   대장간 화면이 열려 있다. 이동 컨트롤 숨김
	  race    경주 중(출발선 ~ 탈락 전). 경주 HUD 만. 이동 컨트롤 보임
	  raceOut 탈락 후 관전·결과. 이동 컨트롤 숨김
	큰 창(확률표·검·기록·상점)은 상태와 따로 "modal" 로 하나만 열린다. 열려 있으면 이동 컨트롤을 숨긴다.

	배치: 모든 ScreenGui 는 ScreenInsets = CoreUISafeInsets 를 쓴다(로블록스 위쪽 버튼·노치를 피함).
	그 영역 크기로 Pure/UILayout 을 계산하고, 등록된 ScreenGui 마다 UIScale = 배율을 건다.
	컨트롤러는 onLayout 으로 구역 사각형을 받아 자기 화면을 그 자리에 놓는다.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VisualConfig = require(Shared:WaitForChild("Config"):WaitForChild("VisualConfig"))
local UILayout = require(Shared:WaitForChild("Pure"):WaitForChild("UILayout"))

local ScreenManager = {}

export type Mode = "lobby" | "forge" | "race" | "raceOut"

type ModalSpec = {
	onOpen: () -> (),
	onClose: () -> (),
}

local mode: Mode = "forge" -- 처음 접속하면 대장간이 열린 채 시작한다 (첫 강화 안내)
local modal: string? = nil
local modals: { [string]: ModalSpec } = {}
local layout: UILayout.Layout? = nil

local scales: { UIScale } = {}
local layoutListeners: { (UILayout.Layout) -> () } = {}
local stateListeners: { () -> () } = {}

local probe: ScreenGui? = nil
local dimGui: ScreenGui? = nil

local function playerGui(): PlayerGui
	return Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
end

local function safeCall(callback: (...any) -> (), ...: any)
	local ok, err = pcall(callback, ...)
	if not ok then
		warn(`[ScreenManager] 리스너 오류: {err}`)
	end
end

local function applyTouchControls()
	local hideControls = modal ~= nil or mode == "forge" or mode == "raceOut"
	local ok, err = pcall(function()
		GuiService.TouchControlsEnabled = not hideControls
	end)
	if not ok then
		warn(`[ScreenManager] 이동 컨트롤 표시를 바꾸지 못했습니다: {err}`)
	end
end

local function notifyState()
	applyTouchControls()

	local dim = dimGui
	if dim then
		dim.Enabled = modal ~= nil
	end

	for _, listener in stateListeners do
		safeCall(listener)
	end
end

local function recompute()
	local gui = probe
	if gui == nil then
		return
	end

	local size = gui.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then
		return
	end

	local computed =
		UILayout.compute(size.X, size.Y, UserInputService.TouchEnabled, VisualConfig.Layout)
	layout = computed

	for _, scale in scales do
		scale.Scale = computed.scale
	end
	for _, listener in layoutListeners do
		safeCall(listener, computed)
	end
end

--------------------------------------------------------------------------------
-- 등록
--------------------------------------------------------------------------------

--[[
	화면용 ScreenGui 를 만든다. 로블록스 위쪽 버튼과 노치를 피하고(CoreUISafeInsets),
	배율이 자동으로 걸린다.
]]
function ScreenManager.createScreen(name: string, displayOrder: number): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = displayOrder

	local scale = Instance.new("UIScale")
	scale.Scale = if layout then layout.scale else 1
	scale.Parent = gui
	table.insert(scales, scale)

	gui.Parent = playerGui()
	return gui
end

-- 화면 전체를 덮는 장식용(눌리지 않는) ScreenGui. 번쩍임·어둡게 덮기 등에 쓴다.
function ScreenManager.createOverlay(name: string, displayOrder: number): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.ScreenInsets = Enum.ScreenInsets.None
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = displayOrder
	gui.Parent = playerGui()
	return gui
end

function ScreenManager.onLayout(listener: (UILayout.Layout) -> ())
	table.insert(layoutListeners, listener)
	if layout then
		safeCall(listener, layout)
	end
end

function ScreenManager.onStateChanged(listener: () -> ())
	table.insert(stateListeners, listener)
end

function ScreenManager.getLayout(): UILayout.Layout?
	return layout
end

-- 사각형 하나를 GuiObject 의 위치·크기로 (디자인 칸 단위, UIScale 이 배율을 곱한다)
function ScreenManager.place(object: GuiObject, rect: UILayout.Rect)
	object.AnchorPoint = Vector2.zero
	object.Position = UDim2.fromOffset(rect.x, rect.y)
	object.Size = UDim2.fromOffset(rect.w, rect.h)
end

--------------------------------------------------------------------------------
-- 상태
--------------------------------------------------------------------------------

function ScreenManager.getMode(): Mode
	return mode
end

function ScreenManager.setMode(newMode: Mode)
	if mode == newMode then
		return
	end
	mode = newMode
	-- 경주로 들어가면 열려 있던 창은 닫는다.
	if (newMode == "race" or newMode == "raceOut") and modal ~= nil then
		ScreenManager.closeModal()
		return
	end
	notifyState()
end

function ScreenManager.isRacing(): boolean
	return mode == "race" or mode == "raceOut"
end

-- 대장간을 열고 닫는다 (경주 중에는 무시)
function ScreenManager.setForgeOpen(open: boolean)
	if ScreenManager.isRacing() then
		return
	end
	ScreenManager.setMode(if open then "forge" else "lobby")
end

function ScreenManager.isForgeOpen(): boolean
	return mode == "forge"
end

--[[
	큰 창 등록. 이름 하나에 여는 함수·닫는 함수.
	열 때는 다른 창을 먼저 닫는다(한 번에 하나만).
]]
function ScreenManager.registerModal(name: string, onOpen: () -> (), onClose: () -> ())
	modals[name] = { onOpen = onOpen, onClose = onClose }
end

function ScreenManager.getModal(): string?
	return modal
end

function ScreenManager.openModal(name: string)
	if ScreenManager.isRacing() then
		return
	end

	local spec = modals[name]
	if spec == nil then
		warn(`[ScreenManager] 등록되지 않은 창: {name}`)
		return
	end

	if modal == name then
		return
	end
	if modal ~= nil then
		local previous = modals[modal]
		if previous then
			safeCall(previous.onClose)
		end
	end

	modal = name
	safeCall(spec.onOpen)
	notifyState()
end

function ScreenManager.closeModal()
	local current = modal
	if current == nil then
		return
	end

	modal = nil
	local spec = modals[current]
	if spec then
		safeCall(spec.onClose)
	end
	notifyState()
end

function ScreenManager.toggleModal(name: string)
	if modal == name then
		ScreenManager.closeModal()
	else
		ScreenManager.openModal(name)
	end
end

--------------------------------------------------------------------------------

-- 부트스트랩이 컨트롤러보다 먼저 한 번 부른다.
function ScreenManager.init()
	if probe ~= nil then
		return
	end

	-- 안전 영역 크기를 재는 보이지 않는 화면
	local measure = Instance.new("ScreenGui")
	measure.Name = "ForgeLayoutProbe"
	measure.ResetOnSpawn = false
	measure.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	measure.Parent = playerGui()
	probe = measure

	-- 큰 창 뒤를 어둡게. 누르면 창이 닫힌다.
	local dim = ScreenManager.createOverlay("ForgeDim", 9)
	dim.Enabled = false
	local dimButton = Instance.new("TextButton")
	dimButton.Name = "Dim"
	dimButton.Text = ""
	dimButton.AutoButtonColor = false
	dimButton.BackgroundColor3 = Color3.new(0, 0, 0)
	dimButton.BackgroundTransparency = 0.45
	dimButton.BorderSizePixel = 0
	dimButton.Size = UDim2.fromScale(1, 1)
	dimButton.Parent = dim
	dimButton.Activated:Connect(function()
		ScreenManager.closeModal()
	end)
	dimGui = dim

	measure:GetPropertyChangedSignal("AbsoluteSize"):Connect(recompute)
	recompute()
	applyTouchControls()
end

return ScreenManager
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Theme — 화면에서 쓰는 색·글꼴·크기·움직임 (통합 기획서 8-1절).

	숫자 색표는 shared/Config/Palette 에 있고, 여기서는 Color3 로 바꿔 둔다.
	컨트롤러는 색 숫자를 직접 쓰지 않고 Theme 만 쓴다.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ConfigFolder = Shared:WaitForChild("Config")
local Palette = require(ConfigFolder:WaitForChild("Palette"))
local VisualConfig = require(ConfigFolder:WaitForChild("VisualConfig"))
local VisualLogic = require(Shared:WaitForChild("Pure"):WaitForChild("VisualLogic"))

local Theme = {}

local function rgb(values: { number }): Color3
	return Color3.fromRGB(values[1], values[2], values[3])
end

Theme.rgb = rgb

local ui = Palette.UI

Theme.color = {
	bg = rgb(ui.bg),
	panel = rgb(ui.panel),
	sub = rgb(ui.sub),
	line = rgb(ui.line),
	text = rgb(ui.text),
	muted = rgb(ui.muted),
	ember = rgb(ui.ember),
	emberDark = rgb(ui.emberDark),
	ink = rgb(ui.ink),
	outline = rgb(ui.outline),
	disabled = rgb(ui.disabled),
	danger = rgb(ui.danger),
	gold = rgb(ui.gold),
	shard = rgb(ui.shard),
	ticket = rgb(ui.ticket),
	success = rgb(ui.success),
	keep = rgb(ui.keep),
	fail = rgb(ui.fail),
	protect = rgb(ui.protect),
	event = rgb(ui.event),
	white = Color3.new(1, 1, 1),
	black = Color3.new(0, 0, 0),
}

--[[
	글꼴. 제목·숫자는 둥글고 두꺼운 카툰체, 설명은 기본체 (결정 7).
	한글이 카툰 글꼴에 없으면 로블록스가 다른 글꼴로 대신 보여 준다 → Studio 에서 확인할 것.
]]
Theme.font = {
	display = Enum.Font.FredokaOne,
	body = Enum.Font.BuilderSans,
	bodyBold = Enum.Font.BuilderSansBold,
}

Theme.text = VisualConfig.Text

Theme.space = {
	xs = 4,
	sm = 8,
	md = 12,
	lg = 16,
	xl = 24,
}

Theme.radius = 10
Theme.radiusLarge = 14
-- 버튼 높이 (디자인 칸). 60 × 최소 배율 0.74 ≈ 44px. 목록 안의 줄 버튼은 52 (폰 대부분에서 44px 안팎).
Theme.touchHeight = 60
Theme.rowHeight = 52
Theme.strokeText = 2 -- 굵은 글자 테두리 두께

Theme.motion = {
	press = TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	release = TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	fade = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
	pop = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	slow = TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
}

-- 검 등급 색
function Theme.rarityColor(rarity: string): Color3
	local values = Palette.RARITY[rarity]
	return if values then rgb(values) else Theme.color.muted
end

-- 레벨 색 단계 (쇠를 달구는 색, 결정 4)
function Theme.heatTier(level: number): Palette.HeatTier
	return VisualLogic.heatTier(level, Palette.HEAT_TIERS)
end

function Theme.heatColor(level: number): Color3
	return rgb(Theme.heatTier(level).rgb)
end

-- 같은 색을 조금 밝게(amount > 0) 또는 어둡게(amount < 0)
function Theme.shade(color: Color3, amount: number): Color3
	if amount >= 0 then
		return color:Lerp(Color3.new(1, 1, 1), amount)
	end
	return color:Lerp(Color3.new(0, 0, 0), -amount)
end

return Theme
]]></string>
